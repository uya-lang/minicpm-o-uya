use libc.FILE;
use libc.fclose;
use libc.fopen;
use libc.fwrite;
use libc.printf;
use libc.sqrtf;
use minicpmo.kernels.f16_load_f32;
use minicpmo.tensor.TensorDType;
use minicpmo.tensor.TensorView;
use minicpmo.tensor.TensorWeightTable;
use minicpmo.tensor.tensor_dtype_name;
use minicpmo.tensor.tensor_lookup;
use minicpmo.tensor.tensor_table_init;
use minicpmo.tensor.tensor_weight_table_attach_mmap;
use minicpmo.tensor.tensor_weight_table_detach_mmap;
use minicpmo.tensor.tensor_weight_table_load;
use minicpmo.tokenizer.Tokenizer;
use minicpmo.tokenizer.tokenizer_encode_to_ids;
use minicpmo.tokenizer.tokenizer_init;
use minicpmo.tokenizer.tokenizer_load;

const SPEECH_MAX_HIDDEN: usize = 16;
const SPEECH_MAX_TOKENS: usize = 16;
const SPEECH_PROMPT_CAP: usize = 64;
const SPEECH_WAV_MAX_SAMPLES: usize = 512;
const SPEECH_DEFAULT_WAV_PATH: &const byte = "/tmp/minicpm-o-uya-speech.wav\0" as &const byte;

export struct SpeechConfig {
    hidden_size: u32,
    codec_vocab_size: u32,
    acoustic_vocab_size: u32,
    token_count: u32,
    schema_kind: [byte: 32],
}

export struct SpeechWeights {
    decoder: &TensorView,
    codec_head: &TensorView,
}

export struct SpeechTokenSequence {
    count: usize,
    tokens: [u32: 16],
    hidden: [f32: 16],
}

export struct VocoderConfig {
    sample_rate: u32,
    samples_per_token: u32,
    hidden_size: u32,
    schema_kind: [byte: 32],
}

export struct VocoderWeights {
    proj: &TensorView,
}

export struct SpeechWaveform {
    sample_rate: u32,
    sample_count: usize,
    samples: [f32: 512],
    rms: f32,
    peak: f32,
    min_value: f32,
    max_value: f32,
}

export fn speech_config_init() SpeechConfig {
    return SpeechConfig{ hidden_size: 0, codec_vocab_size: 0, acoustic_vocab_size: 0, token_count: 4, schema_kind: [] };
}

export fn speech_weights_init() SpeechWeights {
    return SpeechWeights{ decoder: null, codec_head: null };
}

export fn vocoder_config_init() VocoderConfig {
    return VocoderConfig{ sample_rate: 24000, samples_per_token: 16, hidden_size: 0, schema_kind: [] };
}

export fn vocoder_weights_init() VocoderWeights {
    return VocoderWeights{ proj: null };
}

export fn speech_waveform_init() SpeechWaveform {
    return SpeechWaveform{ sample_rate: 0, sample_count: 0, samples: [], rms: 0.0 as f32, peak: 0.0 as f32, min_value: 0.0 as f32, max_value: 0.0 as f32 };
}

fn speech_copy_cstr(dest: &byte, cap: usize, src: &const byte) void {
    var char_index: usize = 0;
    while char_index + 1 < cap && src[char_index] != 0 { dest[char_index] = src[char_index]; char_index = char_index + 1; }
    dest[char_index] = 0;
}

fn speech_abs(value: f32) f32 {
    if value < 0.0 as f32 { return 0.0 as f32 - value; }
    return value;
}

fn speech_activation(value: f32) f32 {
    return value / ((1.0 as f32) + speech_abs(value));
}

fn speech_check_matrix(view: &TensorView, in_dim: u32, out_dim: u32, label: &const byte) bool {
    if !(view.dtype == TensorDType.F32 || view.dtype == TensorDType.F16 || view.dtype == TensorDType.BF16) {
        _ = printf("error: speech tensor=%s label=%s unsupported dtype=%s\n", &view.name[0], label, tensor_dtype_name(view.dtype));
        return false;
    }
    if view.n_dims == 2 && view.shape[0] == in_dim as u64 && view.shape[1] == out_dim as u64 { return true; }
    _ = printf("error: speech tensor=%s label=%s bad shape expected=[%u,%u]\n", &view.name[0], label, in_dim, out_dim);
    return false;
}

fn speech_read_u16_at(data: &const byte, offset: usize) u16 {
    return (data[offset] as u16) | ((data[offset + (1 as usize)] as u16) << 8);
}

fn speech_load_value(view: &TensorView, index: usize) f32 {
    if view.dtype == TensorDType.F32 {
        const ptr: &const f32 = &view.data[index * (4 as usize)] as &const f32;
        return ptr[0];
    }
    if view.dtype == TensorDType.F16 { return f16_load_f32(speech_read_u16_at(view.data, index * (2 as usize))); }
    return 0.0 as f32;
}

export fn speech_bind_weights(table: &TensorWeightTable, config: &SpeechConfig, weights: &SpeechWeights) bool {
    weights[0] = speech_weights_init();
    weights.decoder = tensor_lookup(table, "speech.cosyvoice2.decoder.weight\0" as &const byte);
    if weights.decoder == null { _ = printf("error: missing tensor speech.cosyvoice2.decoder.weight\n"); return false; }
    weights.codec_head = tensor_lookup(table, "speech.codec_head.weight\0" as &const byte);
    if weights.codec_head == null { weights.codec_head = tensor_lookup(table, "vocoder.proj.weight\0" as &const byte); }
    if weights.codec_head == null { _ = printf("error: missing tensor speech.codec_head.weight or vocoder.proj.weight\n"); return false; }
    if config.hidden_size == 0 { config.hidden_size = weights.decoder.shape[0] as u32; }
    if config.codec_vocab_size == 0 { config.codec_vocab_size = weights.codec_head.shape[1] as u32; }
    if config.acoustic_vocab_size == 0 { config.acoustic_vocab_size = config.codec_vocab_size; }
    if config.schema_kind[0] == 0 { speech_copy_cstr(&config.schema_kind[0], @len(config.schema_kind), "cosyvoice2-codec\0" as &const byte); }
    if !speech_check_matrix(weights.decoder, config.hidden_size, config.hidden_size, "decoder\0" as &const byte) { return false; }
    if !speech_check_matrix(weights.codec_head, config.hidden_size, config.codec_vocab_size, "codec_head\0" as &const byte) { return false; }
    if config.hidden_size == 0 || config.hidden_size > SPEECH_MAX_HIDDEN as u32 || config.codec_vocab_size == 0 || config.token_count == 0 || config.token_count > SPEECH_MAX_TOKENS as u32 {
        _ = printf("error: speech config unsupported hidden=%u codec_vocab=%u token_count=%u\n", config.hidden_size, config.codec_vocab_size, config.token_count);
        return false;
    }
    return true;
}

export fn vocoder_bind_weights(table: &TensorWeightTable, speech_config: &SpeechConfig, config: &VocoderConfig, weights: &VocoderWeights) bool {
    weights[0] = vocoder_weights_init();
    weights.proj = tensor_lookup(table, "vocoder.proj.weight\0" as &const byte);
    if weights.proj == null { weights.proj = tensor_lookup(table, "speech.vocoder.proj.weight\0" as &const byte); }
    if weights.proj == null { weights.proj = tensor_lookup(table, "vocos.proj.weight\0" as &const byte); }
    if weights.proj == null { _ = printf("error: missing tensor vocoder.proj.weight or speech.vocoder.proj.weight\n"); return false; }
    if config.hidden_size == 0 { config.hidden_size = speech_config.hidden_size; }
    if config.schema_kind[0] == 0 { speech_copy_cstr(&config.schema_kind[0], @len(config.schema_kind), "vocos-like\0" as &const byte); }
    if !speech_check_matrix(weights.proj, config.hidden_size, config.hidden_size, "vocoder.proj\0" as &const byte) { return false; }
    if config.sample_rate == 0 || config.samples_per_token == 0 || config.hidden_size == 0 || config.hidden_size > SPEECH_MAX_HIDDEN as u32 { _ = printf("error: vocoder config unsupported sample_rate=%u samples_per_token=%u hidden=%u\n", config.sample_rate, config.samples_per_token, config.hidden_size); return false; }
    return true;
}

fn speech_prompt_seed(ids: &const u32, count: usize) u32 {
    var seed: u32 = 2166136261;
    var token_index: usize = 0;
    while token_index < count { seed = (seed ^ ids[token_index]) * 16777619; token_index = token_index + 1; }
    return seed;
}

export fn speech_generate_tokens(config: &SpeechConfig, weights: &SpeechWeights, prompt_ids: &const u32, prompt_count: usize, seq: &SpeechTokenSequence) bool {
    seq.count = config.token_count as usize;
    var state: [f32: 16] = [];
    const seed: u32 = speech_prompt_seed(prompt_ids, prompt_count);
    var hidden_index: usize = 0;
    while hidden_index < config.hidden_size as usize {
        state[hidden_index] = (((seed >> ((hidden_index % 4) * 8)) & 255) as f32) / (255.0 as f32);
        hidden_index = hidden_index + 1;
    }
    var step_index: usize = 0;
    while step_index < seq.count {
        var next: [f32: 16] = [];
        var out_index: usize = 0;
        while out_index < config.hidden_size as usize {
            var sum: f32 = 0.0 as f32;
            var in_index: usize = 0;
            while in_index < config.hidden_size as usize {
                sum = sum + state[in_index] * speech_load_value(weights.decoder, in_index * (config.hidden_size as usize) + out_index);
                in_index = in_index + 1;
            }
            next[out_index] = sum;
            out_index = out_index + 1;
        }
        var best_id: u32 = 0;
        var best_score: f32 = -1000000000.0 as f32;
        var vocab_index: usize = 0;
        while vocab_index < config.codec_vocab_size as usize {
            var score: f32 = 0.0 as f32;
            var score_hidden_index: usize = 0;
            while score_hidden_index < config.hidden_size as usize {
                score = score + next[score_hidden_index] * speech_load_value(weights.codec_head, score_hidden_index * (config.codec_vocab_size as usize) + vocab_index);
                score_hidden_index = score_hidden_index + 1;
            }
            if vocab_index == 0 || score > best_score { best_score = score; best_id = vocab_index as u32; }
            vocab_index = vocab_index + 1;
        }
        seq.tokens[step_index] = best_id;
        seq.hidden[step_index] = best_score;
        var copy_index: usize = 0;
        while copy_index < config.hidden_size as usize { state[copy_index] = next[copy_index] + ((best_id as f32) * (0.01 as f32)); copy_index = copy_index + 1; }
        step_index = step_index + 1;
    }
    return true;
}

fn speech_rms_norm(values: &f32, count: usize) void {
    var sum_squares: f32 = 0.0 as f32;
    var value_index: usize = 0;
    while value_index < count { sum_squares = sum_squares + values[value_index] * values[value_index]; value_index = value_index + 1; }
    const denom: f32 = sqrtf(sum_squares / (count as f32) + (0.000001 as f32));
    var norm_index: usize = 0;
    while norm_index < count { values[norm_index] = values[norm_index] / denom; norm_index = norm_index + 1; }
}

fn speech_vocoder_conv1d_reference(config: &VocoderConfig, weights: &VocoderWeights, token_id: u32, token_score: f32, step_index: usize, latent: &f32) void {
    var input: [f32: 16] = [];
    var input_index: usize = 0;
    while input_index < config.hidden_size as usize {
        const token_part: f32 = (((token_id + input_index as u32 + 1) % (config.hidden_size + 1)) as f32) / ((config.hidden_size + 1) as f32);
        const step_part: f32 = ((step_index + input_index + 1) as f32) * (0.03125 as f32);
        input[input_index] = token_part + step_part + token_score * (0.125 as f32);
        input_index = input_index + 1;
    }
    var out_index: usize = 0;
    while out_index < config.hidden_size as usize {
        var sum: f32 = 0.0 as f32;
        var kernel_index: usize = 0;
        while kernel_index < config.hidden_size as usize {
            sum = sum + input[kernel_index] * speech_load_value(weights.proj, kernel_index * (config.hidden_size as usize) + out_index);
            kernel_index = kernel_index + 1;
        }
        if speech_abs(sum) < 0.000001 as f32 { sum = input[out_index] * (0.25 as f32); }
        latent[out_index] = sum;
        out_index = out_index + 1;
    }
    speech_rms_norm(latent, config.hidden_size as usize);
    var act_index: usize = 0;
    while act_index < config.hidden_size as usize { latent[act_index] = speech_activation(latent[act_index]); act_index = act_index + 1; }
}

fn speech_vocoder_upsample_reference(config: &VocoderConfig, latent: &const f32, token_index: usize, waveform: &SpeechWaveform) bool {
    var local_index: usize = 0;
    while local_index < config.samples_per_token as usize {
        if waveform.sample_count >= SPEECH_WAV_MAX_SAMPLES { return false; }
        const hidden_slot: usize = local_index % (config.hidden_size as usize);
        const next_slot: usize = (hidden_slot + 1) % (config.hidden_size as usize);
        const ramp: f32 = ((local_index as f32) / (config.samples_per_token as f32)) - (0.5 as f32);
        const sample_value: f32 = speech_activation(latent[hidden_slot] * (0.75 as f32) + latent[next_slot] * (0.25 as f32) + ramp * (0.1 as f32) + (token_index as f32) * (0.01 as f32));
        waveform.samples[waveform.sample_count] = sample_value;
        waveform.sample_count = waveform.sample_count + 1;
        local_index = local_index + 1;
    }
    return true;
}

export fn vocoder_decode_tokens(config: &VocoderConfig, weights: &VocoderWeights, seq: &SpeechTokenSequence, waveform: &SpeechWaveform) bool {
    waveform[0] = speech_waveform_init();
    waveform.sample_rate = config.sample_rate;
    var token_index: usize = 0;
    while token_index < seq.count {
        var latent: [f32: 16] = [];
        speech_vocoder_conv1d_reference(config, weights, seq.tokens[token_index], seq.hidden[token_index], token_index, &latent[0]);
        if !speech_vocoder_upsample_reference(config, &latent[0] as &const f32, token_index, waveform) { return false; }
        token_index = token_index + 1;
    }
    return true;
}

export fn speech_waveform_analyze(waveform: &SpeechWaveform) bool {
    if waveform.sample_count == 0 { return false; }
    var sum_squares: f32 = 0.0 as f32;
    waveform.peak = 0.0 as f32;
    waveform.min_value = waveform.samples[0];
    waveform.max_value = waveform.samples[0];
    var sample_index: usize = 0;
    while sample_index < waveform.sample_count {
        const sample_value: f32 = waveform.samples[sample_index];
        if sample_value != sample_value { return false; }
        const abs_value: f32 = speech_abs(sample_value);
        if abs_value > waveform.peak { waveform.peak = abs_value; }
        if sample_value < waveform.min_value { waveform.min_value = sample_value; }
        if sample_value > waveform.max_value { waveform.max_value = sample_value; }
        sum_squares = sum_squares + sample_value * sample_value;
        sample_index = sample_index + 1;
    }
    waveform.rms = sqrtf(sum_squares / (waveform.sample_count as f32));
    if waveform.peak > 1.0 as f32 || waveform.rms <= 0.0 as f32 { return false; }
    return true;
}

fn speech_put_u16_le(buffer: &byte, offset: usize, value: u32) void {
    buffer[offset] = (value & (255 as u32)) as byte;
    buffer[offset + 1] = ((value >> 8) & (255 as u32)) as byte;
}

fn speech_put_u32_le(buffer: &byte, offset: usize, value: u32) void {
    buffer[offset] = (value & (255 as u32)) as byte;
    buffer[offset + 1] = ((value >> 8) & (255 as u32)) as byte;
    buffer[offset + 2] = ((value >> 16) & (255 as u32)) as byte;
    buffer[offset + 3] = ((value >> 24) & (255 as u32)) as byte;
}

fn speech_put_ascii4(buffer: &byte, offset: usize, a: byte, b: byte, c: byte, d: byte) void {
    buffer[offset] = a; buffer[offset + 1] = b; buffer[offset + 2] = c; buffer[offset + 3] = d;
}

export fn speech_wav_write(path: &const byte, waveform: &SpeechWaveform) bool {
    const file: &FILE = fopen(path, "wb\0" as &const byte);
    if file == null { _ = printf("error: cannot open wav path=%s\n", path); return false; }
    const data_bytes: u32 = (waveform.sample_count as u32) * 2;
    var header: [byte: 44] = [];
    speech_put_ascii4(&header[0], 0, 82, 73, 70, 70);
    speech_put_u32_le(&header[0], 4, 36 + data_bytes);
    speech_put_ascii4(&header[0], 8, 87, 65, 86, 69);
    speech_put_ascii4(&header[0], 12, 102, 109, 116, 32);
    speech_put_u32_le(&header[0], 16, 16);
    speech_put_u16_le(&header[0], 20, 1);
    speech_put_u16_le(&header[0], 22, 1);
    speech_put_u32_le(&header[0], 24, waveform.sample_rate);
    speech_put_u32_le(&header[0], 28, waveform.sample_rate * 2);
    speech_put_u16_le(&header[0], 32, 2);
    speech_put_u16_le(&header[0], 34, 16);
    speech_put_ascii4(&header[0], 36, 100, 97, 116, 97);
    speech_put_u32_le(&header[0], 40, data_bytes);
    if fwrite(&header[0] as &const byte, 1, 44, file) != 44 { _ = fclose(file); return false; }
    var pcm_bytes: [byte: 1024] = [];
    var sample_index: usize = 0;
    while sample_index < waveform.sample_count {
        var sample_value: f32 = waveform.samples[sample_index];
        if sample_value > 1.0 as f32 { sample_value = 1.0 as f32; }
        if sample_value < -1.0 as f32 { sample_value = -1.0 as f32; }
        var quantized: i32 = (sample_value * (32767.0 as f32)) as i32;
        var packed: u32 = 0;
        if quantized < 0 { packed = (65536 + quantized) as u32; } else { packed = quantized as u32; }
        speech_put_u16_le(&pcm_bytes[0], sample_index * 2, packed);
        sample_index = sample_index + 1;
    }
    if fwrite(&pcm_bytes[0] as &const byte, 1, data_bytes as usize, file) != data_bytes as usize { _ = fclose(file); return false; }
    return fclose(file) == 0;
}

export fn speech_checksum_u32(values: &const u32, count: usize) u32 {
    var hash: u32 = 2166136261;
    var value_index: usize = 0;
    while value_index < count { hash = (hash ^ values[value_index]) * 16777619; value_index = value_index + 1; }
    return hash;
}

export fn speech_checksum_waveform(waveform: &SpeechWaveform) u32 {
    var hash: u32 = 2166136261;
    var sample_index: usize = 0;
    while sample_index < waveform.sample_count {
        var sample_value: f32 = waveform.samples[sample_index];
        if sample_value > 1.0 as f32 { sample_value = 1.0 as f32; }
        if sample_value < -1.0 as f32 { sample_value = -1.0 as f32; }
        var quantized: i32 = (sample_value * (32767.0 as f32)) as i32;
        var packed: u32 = 0;
        if quantized < 0 { packed = (65536 + quantized) as u32; } else { packed = quantized as u32; }
        hash = (hash ^ packed) * 16777619;
        sample_index = sample_index + 1;
    }
    return hash;
}

export fn speech_smoke_cli(model_path: &const byte, prompt: &const byte, wav_path: &const byte) i32 {
    var table: TensorWeightTable = tensor_table_init();
    if !tensor_weight_table_load(model_path, &table) { return 1; }
    if !tensor_weight_table_attach_mmap(model_path, &table) { return 1; }
    var tokenizer: Tokenizer = tokenizer_init();
    if !tokenizer_load(model_path, &tokenizer) { tensor_weight_table_detach_mmap(&table); return 1; }
    var ids: [u32: 64] = [];
    var id_count: usize = 0;
    if !tokenizer_encode_to_ids(&tokenizer, prompt, &ids[0], SPEECH_PROMPT_CAP, &id_count) { tensor_weight_table_detach_mmap(&table); return 1; }
    var speech_config: SpeechConfig = speech_config_init();
    var speech_weights: SpeechWeights = speech_weights_init();
    if !speech_bind_weights(&table, &speech_config, &speech_weights) { tensor_weight_table_detach_mmap(&table); return 1; }
    var seq: SpeechTokenSequence = SpeechTokenSequence{ count: 0, tokens: [], hidden: [] };
    if !speech_generate_tokens(&speech_config, &speech_weights, &ids[0] as &const u32, id_count, &seq) { tensor_weight_table_detach_mmap(&table); return 1; }
    var vocoder_config: VocoderConfig = vocoder_config_init();
    var vocoder_weights: VocoderWeights = vocoder_weights_init();
    if !vocoder_bind_weights(&table, &speech_config, &vocoder_config, &vocoder_weights) { tensor_weight_table_detach_mmap(&table); return 1; }
    var waveform: SpeechWaveform = speech_waveform_init();
    if !vocoder_decode_tokens(&vocoder_config, &vocoder_weights, &seq, &waveform) { _ = printf("error: vocoder decode failed\n"); tensor_weight_table_detach_mmap(&table); return 1; }
    if !speech_waveform_analyze(&waveform) { _ = printf("error: waveform validation failed\n"); tensor_weight_table_detach_mmap(&table); return 1; }
    if !speech_wav_write(wav_path, &waveform) { _ = printf("error: wav write failed\n"); tensor_weight_table_detach_mmap(&table); return 1; }
    const token_checksum: u32 = speech_checksum_u32(&seq.tokens[0] as &const u32, seq.count);
    const waveform_checksum: u32 = speech_checksum_waveform(&waveform);
    _ = printf("speech schema: kind=%s hidden=%u codec_vocab=%u acoustic_vocab=%u\n", &speech_config.schema_kind[0], speech_config.hidden_size, speech_config.codec_vocab_size, speech_config.acoustic_vocab_size);
    _ = printf("speech bind: decoder=%s codec_head=%s\n", &speech_weights.decoder.name[0], &speech_weights.codec_head.name[0]);
    _ = printf("vocoder schema: kind=%s sample_rate=%u samples_per_token=%u tensor=%s\n", &vocoder_config.schema_kind[0], vocoder_config.sample_rate, vocoder_config.samples_per_token, &vocoder_weights.proj.name[0]);
    _ = printf("speech prompt_tokens:");
    var prompt_index: usize = 0;
    while prompt_index < id_count { _ = printf(" %u", ids[prompt_index]); prompt_index = prompt_index + 1; }
    _ = printf("\n");
    _ = printf("speech tokens:");
    var token_index: usize = 0;
    while token_index < seq.count { _ = printf(" %u", seq.tokens[token_index]); token_index = token_index + 1; }
    _ = printf(" checksum=0x%x\n", token_checksum);
    _ = printf("speech intermediate checksum: 0x%x\n", token_checksum);
    _ = printf("speech waveform: samples=%zu sample_rate=%u rms=%.6f peak=%.6f range=[%.6f,%.6f] checksum=0x%x\n", waveform.sample_count, waveform.sample_rate, waveform.rms as f64, waveform.peak as f64, waveform.min_value as f64, waveform.max_value as f64, waveform_checksum);
    _ = printf("speech wav: path=%s bytes=%u\n", wav_path, 44 + ((waveform.sample_count as u32) * 2));
    _ = printf("speech-smoke: PASS\n");
    tensor_weight_table_detach_mmap(&table);
    return 0;
}

export fn speech_default_wav_path() &const byte {
    return SPEECH_DEFAULT_WAV_PATH;
}

use libc.cos;
use libc.expf;
use libc.fabsf;
use libc.printf;
use libc.roundf;
use libc.sinf;
use libc.sqrtf;
use libc.tanh;

const KERNEL_NEG_INF: f32 = -(3.4028234663852886e38 as f32);
const KERNEL_QK8_1: usize = 32;
const KERNEL_QK_K: usize = 256;
const KERNEL_K_SCALE_SIZE: usize = 12;
const KERNEL_QR4_K: usize = 2;
const KERNEL_QR6_K: usize = 2;
const KERNEL_QI8_1: usize = KERNEL_QK8_1 / (4 as usize);
const KERNEL_QI4_K: usize = KERNEL_QK_K / ((4 as usize) * KERNEL_QR4_K);
const KERNEL_QI6_K: usize = KERNEL_QK_K / ((4 as usize) * KERNEL_QR6_K);
const KERNEL_Q8_1_BLOCKS_PER_SUPER: usize = KERNEL_QK_K / KERNEL_QK8_1;

export fn f32_fill(dst: &f32, n: usize, value: f32) void {
    var i: usize = 0;
    while i < n { dst[i] = value; i = i + 1; }
}

export fn f32_copy(dst: &f32, src: &const f32, n: usize) void {
    var i: usize = 0;
    while i < n { dst[i] = src[i]; i = i + 1; }
}

export fn f32_add(dst: &f32, a: &const f32, b: &const f32, n: usize) void {
    var i: usize = 0;
    while i < n { dst[i] = a[i] + b[i]; i = i + 1; }
}

export fn f32_mul(dst: &f32, a: &const f32, b: &const f32, n: usize) void {
    var i: usize = 0;
    while i < n { dst[i] = a[i] * b[i]; i = i + 1; }
}

export fn f32_dot(a: &const f32, b: &const f32, n: usize) f32 {
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n { sum = sum + a[i] * b[i]; i = i + 1; }
    return sum;
}

export fn f16_load_f32(bits: u16) f32 {
    const sign: u32 = ((bits as u32) & (0x8000 as u32)) << (16 as i32);
    const exp_bits: u32 = ((bits as u32) >> (10 as i32)) & (31 as u32);
    const frac: u32 = (bits as u32) & (1023 as u32);
    var out_bits: u32 = 0;
    if exp_bits == 0 {
        if frac == 0 {
            out_bits = sign;
        } else {
            var mant: u32 = frac;
            var exp: i32 = -14;
            while (mant & (1024 as u32)) == 0 {
                mant = mant << (1 as i32);
                exp = exp - 1;
            }
            mant = mant & (1023 as u32);
            out_bits = sign | (((exp + 127) as u32) << (23 as i32)) | (mant << (13 as i32));
        }
        const ptr0: &const f32 = &out_bits as &const f32;
        return ptr0[0];
    }
    if exp_bits == 31 {
        out_bits = sign | (0x7f800000 as u32) | (frac << (13 as i32));
        const ptr_inf: &const f32 = &out_bits as &const f32;
        return ptr_inf[0];
    }
    out_bits = sign | ((exp_bits + (112 as u32)) << (23 as i32)) | (frac << (13 as i32));
    const ptr: &const f32 = &out_bits as &const f32;
    return ptr[0];
}

export fn f32_to_f16_bits(value: f32) u16 {
    const in_ptr: &const u32 = &value as &const u32;
    const in_bits: u32 = in_ptr[0];
    const sign: u32 = (in_bits >> (16 as i32)) & (0x8000 as u32);
    const exp: u32 = (in_bits >> (23 as i32)) & (0xff as u32);
    const frac: u32 = in_bits & (0x7fffff as u32);
    if exp == (255 as u32) {
        if frac != 0 { return (sign | (0x7e00 as u32)) as u16; }
        return (sign | (0x7c00 as u32)) as u16;
    }
    if exp > (142 as u32) {
        return (sign | (0x7c00 as u32)) as u16;
    }
    if exp < (113 as u32) {
        if exp < (103 as u32) {
            return sign as u16;
        }
        var mant: u32 = frac | (0x800000 as u32);
        var out: u16 = (sign | (mant >> (((126 as u32) - exp) as i32))) as u16;
        if ((mant >> (((125 as u32) - exp) as i32)) & (1 as u32)) != 0 {
            out = out + (1 as u16);
        }
        return out;
    }
    var out: u16 = (sign | ((exp - (112 as u32)) << (10 as i32)) | (frac >> (13 as i32))) as u16;
    if (frac & (0x1000 as u32)) != 0 {
        out = out + (1 as u16);
    }
    return out;
}

export fn bf16_load_f32(bits: u16) f32 {
    const out_bits: u32 = (bits as u32) << (16 as i32);
    const ptr: &const f32 = &out_bits as &const f32;
    return ptr[0];
}

export fn rms_norm(dst: &f32, src: &const f32, weight: &const f32, n: usize, eps: f32) void {
    if n == 0 { return; }
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n { sum = sum + src[i] * src[i]; i = i + 1; }
    const scale: f32 = 1.0 / sqrtf(sum / (n as f32) + eps);
    i = 0;
    while i < n { dst[i] = src[i] * scale * weight[i]; i = i + 1; }
}

export fn layer_norm(dst: &f32, src: &const f32, weight: &const f32, bias: &const f32, n: usize, eps: f32) void {
    if n == 0 { return; }
    var mean: f32 = 0.0;
    var i: usize = 0;
    while i < n { mean = mean + src[i]; i = i + 1; }
    mean = mean / (n as f32);
    var var_sum: f32 = 0.0;
    i = 0;
    while i < n { const d: f32 = src[i] - mean; var_sum = var_sum + d * d; i = i + 1; }
    const scale: f32 = 1.0 / sqrtf(var_sum / (n as f32) + eps);
    i = 0;
    while i < n { dst[i] = (src[i] - mean) * scale * weight[i] + bias[i]; i = i + 1; }
}

export fn rope_rotate_pair(x0: &f32, x1: &f32, theta: f32) void {
    const c: f32 = cos(theta as f64) as f32;
    const s: f32 = sinf(theta);
    const a: f32 = *x0;
    const b: f32 = *x1;
    *x0 = a * c - b * s;
    *x1 = a * s + b * c;
}

export fn softmax(dst: &f32, src: &const f32, n: usize) void {
    if n == 0 { return; }
    var maxv: f32 = src[0];
    var i: usize = 1;
    while i < n { if src[i] > maxv { maxv = src[i]; } i = i + 1; }
    var sum: f32 = 0.0;
    i = 0;
    while i < n { const e: f32 = expf(src[i] - maxv); dst[i] = e; sum = sum + e; i = i + 1; }
    if sum == 0.0 { return; }
    i = 0;
    while i < n { dst[i] = dst[i] / sum; i = i + 1; }
}

export fn masked_softmax(dst: &f32, src: &const f32, mask: &const i32, n: usize) void {
    if n == 0 { return; }
    var tmp: [f32: 128] = [];
    if n > 128 { return; }
    var i: usize = 0;
    while i < n { if mask[i] == 0 { tmp[i] = KERNEL_NEG_INF; } else { tmp[i] = src[i]; } i = i + 1; }
    softmax(dst, &tmp[0], n);
}

export fn dense_f32_matvec(dst: &f32, matrix: &const f32, x: &const f32, rows: usize, cols: usize) void {
    var r: usize = 0;
    while r < rows { dst[r] = f32_dot(&matrix[r * cols], x, cols); r = r + 1; }
}

export fn dense_f16_matvec(dst: &f32, matrix: &const u16, x: &const f32, rows: usize, cols: usize) void {
    var r: usize = 0;
    while r < rows {
        var sum: f32 = 0.0;
        var c: usize = 0;
        while c < cols { sum = sum + f16_load_f32(matrix[r * cols + c]) * x[c]; c = c + 1; }
        dst[r] = sum;
        r = r + 1;
    }
}

export fn dense_bf16_matvec(dst: &f32, matrix: &const u16, x: &const f32, rows: usize, cols: usize) void {
    var r: usize = 0;
    while r < rows {
        var sum: f32 = 0.0;
        var c: usize = 0;
        while c < cols { sum = sum + bf16_load_f32(matrix[r * cols + c]) * x[c]; c = c + 1; }
        dst[r] = sum;
        r = r + 1;
    }
}

export fn silu(x: f32) f32 { return x / ((1.0 as f32) + expf((0.0 as f32) - x)); }
export fn gelu(x: f32) f32 { return (0.5 as f32) * x * ((1.0 as f32) + (tanh(0.7978845608028654 * (x as f64 + 0.044715 * x as f64 * x as f64 * x as f64)) as f32)); }

export fn swiglu(dst: &f32, gate: &const f32, up: &const f32, n: usize) void {
    var i: usize = 0;
    while i < n { dst[i] = silu(gate[i]) * up[i]; i = i + 1; }
}

export fn conv1d_ref(dst: &f32, input: &const f32, kernel: &const f32, in_len: usize, out_channels: usize, kernel_size: usize) void {
    if in_len < kernel_size { return; }
    const out_len: usize = in_len - kernel_size + 1;
    var oc: usize = 0;
    while oc < out_channels {
        var x: usize = 0;
        while x < out_len {
            var sum: f32 = 0.0;
            var k: usize = 0;
            while k < kernel_size { sum = sum + input[x + k] * kernel[oc * kernel_size + k]; k = k + 1; }
            dst[oc * out_len + x] = sum;
            x = x + 1;
        }
        oc = oc + 1;
    }
}

export fn conv2d_ref(dst: &f32, input: &const f32, kernel: &const f32, in_h: usize, in_w: usize, out_channels: usize, kernel_h: usize, kernel_w: usize) void {
    if in_h < kernel_h || in_w < kernel_w { return; }
    const out_h: usize = in_h - kernel_h + 1;
    const out_w: usize = in_w - kernel_w + 1;
    var oc: usize = 0;
    while oc < out_channels {
        var y: usize = 0;
        while y < out_h {
            var x: usize = 0;
            while x < out_w {
                var sum: f32 = 0.0;
                var ky: usize = 0;
                while ky < kernel_h {
                    var kx: usize = 0;
                    while kx < kernel_w {
                        sum = sum + input[(y + ky) * in_w + (x + kx)] * kernel[oc * kernel_h * kernel_w + ky * kernel_w + kx];
                        kx = kx + 1;
                    }
                    ky = ky + 1;
                }
                dst[oc * out_h * out_w + y * out_w + x] = sum;
                x = x + 1;
            }
            y = y + 1;
        }
        oc = oc + 1;
    }
}

fn nearly(a: f32, b: f32, eps: f32) bool {
    var d: f32 = a - b;
    if d < 0.0 { d = 0.0 - d; }
    return d <= eps;
}

fn check(name: &const byte, ok: bool) bool {
    if ok { _ = printf("ok %s\n", name); return true; }
    _ = printf("FAIL %s\n", name);
    return false;
}

export fn kernels_smoke_cli() i32 {
    var pass: bool = true;
    var a: [f32: 8] = [];
    var b: [f32: 8] = [];
    var out: [f32: 16] = [];
    f32_fill(&a[0], 4, 2.0);
    pass = check("fill\0" as &const byte, nearly(a[0], 2.0, 0.0001) && nearly(a[3], 2.0, 0.0001)) && pass;
    b[0] = 1.0; b[1] = 2.0; b[2] = 3.0; b[3] = 4.0;
    f32_copy(&a[0], &b[0], 4);
    pass = check("copy\0" as &const byte, nearly(a[2], 3.0, 0.0001)) && pass;
    f32_add(&out[0], &a[0], &b[0], 4);
    pass = check("add\0" as &const byte, nearly(out[3], 8.0, 0.0001)) && pass;
    f32_mul(&out[0], &a[0], &b[0], 4);
    pass = check("mul\0" as &const byte, nearly(out[2], 9.0, 0.0001)) && pass;
    pass = check("dot\0" as &const byte, nearly(f32_dot(&a[0], &b[0], 4), 30.0, 0.0001) && nearly(f32_dot(&a[0], &b[0], 0), 0.0, 0.0001)) && pass;
    pass = check("f16\0" as &const byte, nearly(f16_load_f32(0x3c00), 1.0, 0.0001) && nearly(f16_load_f32(0xc000), -2.0, 0.0001)) && pass;
    pass = check("bf16\0" as &const byte, nearly(bf16_load_f32(0x3f80), 1.0, 0.0001) && nearly(bf16_load_f32(0xc000), -2.0, 0.0001)) && pass;
    var w: [f32: 4] = [];
    f32_fill(&w[0], 4, 1.0);
    rms_norm(&out[0], &b[0], &w[0], 4, 0.0);
    pass = check("rmsnorm\0" as &const byte, nearly(out[0], 0.365148, 0.001)) && pass;
    layer_norm(&out[0], &b[0], &w[0], &a[0], 4, 0.0);
    pass = check("layernorm\0" as &const byte, nearly(out[0], -0.341641, 0.001)) && pass;
    var rx0: f32 = 1.0; var rx1: f32 = 0.0; rope_rotate_pair(&rx0, &rx1, 1.5707963);
    pass = check("rope\0" as &const byte, nearly(rx0, 0.0, 0.001) && nearly(rx1, 1.0, 0.001)) && pass;
    var sm_in: [f32: 4] = [];
    sm_in[0] = 1.0; sm_in[1] = 2.0; sm_in[2] = 3.0;
    softmax(&out[0], &sm_in[0], 3);
    pass = check("softmax\0" as &const byte, nearly(out[0] + out[1] + out[2], 1.0, 0.001) && out[2] > out[1]) && pass;
    var mask: [i32: 4] = [];
    mask[0] = 1; mask[1] = 0; mask[2] = 1;
    masked_softmax(&out[0], &sm_in[0], &mask[0], 3);
    pass = check("masked_softmax\0" as &const byte, nearly(out[1], 0.0, 0.001) && nearly(out[0] + out[2], 1.0, 0.001)) && pass;
    var mat: [f32: 6] = [];
    mat[0] = 1.0; mat[1] = 2.0; mat[2] = 3.0; mat[3] = 4.0; mat[4] = 5.0; mat[5] = 6.0;
    var x: [f32: 3] = [];
    x[0] = 1.0; x[1] = 1.0; x[2] = 1.0;
    dense_f32_matvec(&out[0], &mat[0], &x[0], 2, 3);
    pass = check("dense_f32\0" as &const byte, nearly(out[0], 6.0, 0.001) && nearly(out[1], 15.0, 0.001)) && pass;
    var hmat: [u16: 4] = [];
    hmat[0] = 0x3c00; hmat[1] = 0x4000; hmat[2] = 0x4200; hmat[3] = 0x4400;
    dense_f16_matvec(&out[0], &hmat[0], &x[0], 2, 2);
    pass = check("dense_f16\0" as &const byte, nearly(out[0], 3.0, 0.001) && nearly(out[1], 7.0, 0.001)) && pass;
    var bhmat: [u16: 4] = [];
    bhmat[0] = 0x3f80; bhmat[1] = 0x4000; bhmat[2] = 0x4040; bhmat[3] = 0x4080;
    dense_bf16_matvec(&out[0], &bhmat[0], &x[0], 2, 2);
    pass = check("dense_bf16\0" as &const byte, nearly(out[0], 3.0, 0.001) && nearly(out[1], 7.0, 0.001)) && pass;
    pass = check("activations\0" as &const byte, nearly(silu(0.0), 0.0, 0.001) && nearly(gelu(0.0), 0.0, 0.001)) && pass;
    swiglu(&out[0], &b[0], &x[0], 3);
    pass = check("swiglu\0" as &const byte, out[2] > out[1]) && pass;
    conv1d_ref(&out[0], &b[0], &x[0], 4, 1, 2);
    pass = check("conv1d\0" as &const byte, nearly(out[0], 3.0, 0.001) && nearly(out[2], 7.0, 0.001)) && pass;
    var img: [f32: 9] = [];
    var ii: usize = 0; while ii < 9 { img[ii] = (ii + 1) as f32; ii = ii + 1; }
    var k2: [f32: 4] = [];
    f32_fill(&k2[0], 4, 1.0);
    conv2d_ref(&out[0], &img[0], &k2[0], 3, 3, 1, 2, 2);
    pass = check("conv2d\0" as &const byte, nearly(out[0], 12.0, 0.001) && nearly(out[3], 28.0, 0.001)) && pass;
    pass = check("nan_inf_empty\0" as &const byte, (f16_load_f32(0x7e00) != f16_load_f32(0x7e00)) && f16_load_f32(0x7c00) > 1000000.0) && pass;
    if pass { _ = printf("kernels smoke: PASS\n"); return 0; }
    _ = printf("kernels smoke: FAIL\n");
    return 1;
}

export fn q8_0_dequant(dst: &f32, d_bits: u16, qs: &const i8, n: usize) void {
    const d: f32 = f16_load_f32(d_bits);
    var i: usize = 0;
    while i < n { dst[i] = d * (qs[i] as f32); i = i + 1; }
}

export fn q8_0_dot(d_bits: u16, qs: &const i8, x: &const f32, n: usize) f32 {
    const d: f32 = f16_load_f32(d_bits);
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n { sum = sum + d * (qs[i] as f32) * x[i]; i = i + 1; }
    return sum;
}

export fn q8_1_quantize_block(d_bits: &u16, s_bits: &u16, qs: &i8, src: &const f32) void {
    var amax: f32 = 0.0;
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < KERNEL_QK8_1 {
        const xi: f32 = src[i];
        const ax: f32 = fabsf(xi);
        if ax > amax { amax = ax; }
        sum = sum + xi;
        i = i + 1;
    }
    if amax == 0.0 {
        d_bits[0] = 0;
        s_bits[0] = 0;
        i = 0;
        while i < KERNEL_QK8_1 { qs[i] = 0; i = i + 1; }
        return;
    }
    const d: f32 = amax / 127.0;
    d_bits[0] = f32_to_f16_bits(d);
    s_bits[0] = f32_to_f16_bits(sum);
    i = 0;
    while i < KERNEL_QK8_1 {
        var q: i32 = roundf(src[i] / d) as i32;
        if q > 127 { q = 127; }
        if q < -128 { q = -128; }
        qs[i] = q as i8;
        i = i + 1;
    }
}

export fn q8_1_quantize_row(d_bits: &u16, s_bits: &u16, qs: &i8, src: &const f32, n: usize) bool {
    if n % KERNEL_QK8_1 != 0 { return false; }
    var block: usize = 0;
    while block < n / KERNEL_QK8_1 {
        q8_1_quantize_block(&d_bits[block], &s_bits[block], &qs[block * KERNEL_QK8_1], &src[block * KERNEL_QK8_1] as &const f32);
        block = block + 1;
    }
    return true;
}

export fn q8_1_dequant_row(dst: &f32, d_bits: &const u16, qs: &const i8, n: usize) bool {
    if n % KERNEL_QK8_1 != 0 { return false; }
    var block: usize = 0;
    while block < n / KERNEL_QK8_1 {
        q8_0_dequant(&dst[block * KERNEL_QK8_1], d_bits[block], &qs[block * KERNEL_QK8_1], KERNEL_QK8_1);
        block = block + 1;
    }
    return true;
}

fn packed_i32_le(src: &const byte, word_index: usize) i32 {
    const base: usize = word_index * (4 as usize);
    const value: u32 = (src[base] as u32) |
        ((src[base + (1 as usize)] as u32) << (8 as i32)) |
        ((src[base + (2 as usize)] as u32) << (16 as i32)) |
        ((src[base + (3 as usize)] as u32) << (24 as i32));
    return value as i32;
}

fn packed_signed_byte(value: i32, byte_index: usize) i32 {
    const raw: u32 = ((value as u32) >> ((byte_index * (8 as usize)) as i32)) & (255 as u32);
    if raw >= (128 as u32) { return (raw as i32) - 256; }
    return raw as i32;
}

fn packed_dp4a(lhs: i32, rhs: i32, acc: i32) i32 {
    var sum: i32 = acc;
    var i: usize = 0;
    while i < (4 as usize) {
        sum = sum + packed_signed_byte(lhs, i) * packed_signed_byte(rhs, i);
        i = i + 1;
    }
    return sum;
}

fn q4_k_pack_scales_mins(dst: &byte, scales: &const u8, mins: &const u8) void {
    var i: usize = 0;
    while i < (4 as usize) {
        dst[i] = (scales[i] & (63 as u8)) | (((scales[i + (4 as usize)] >> (4 as i32)) & (3 as u8)) << (6 as i32));
        dst[i + (4 as usize)] = (mins[i] & (63 as u8)) | (((mins[i + (4 as usize)] >> (4 as i32)) & (3 as u8)) << (6 as i32));
        dst[i + (8 as usize)] = (scales[i + (4 as usize)] & (15 as u8)) | ((mins[i + (4 as usize)] & (15 as u8)) << (4 as i32));
        i = i + 1;
    }
}

fn q4_k_scale_min_llama(index: usize, packed: &const byte, scale: &u8, minv: &u8) void {
    if index < (4 as usize) {
        scale[0] = (packed[index] as u8) & (63 as u8);
        minv[0] = (packed[index + (4 as usize)] as u8) & (63 as u8);
    } else {
        scale[0] = ((packed[index + (4 as usize)] as u8) & (15 as u8)) | (((packed[index - (4 as usize)] as u8) >> (6 as i32)) << (4 as i32));
        minv[0] = ((packed[index + (4 as usize)] as u8) >> (4 as i32)) | (((packed[index] as u8) >> (6 as i32)) << (4 as i32));
    }
}

export fn llama_q4_k_dequant_block(dst: &f32, block: &const byte) void {
    const d: f32 = f16_load_f32((block[0] as u16) | ((block[1] as u16) << (8 as i32)));
    const dmin: f32 = f16_load_f32((block[2] as u16) | ((block[3] as u16) << (8 as i32)));
    const packed_scales: &const byte = &block[4];
    const qs: &const byte = &block[(2 as usize) * (2 as usize) + KERNEL_K_SCALE_SIZE];
    var is: usize = 0;
    var out: usize = 0;
    while out < KERNEL_QK_K {
        var sc0: u8 = 0;
        var mn0: u8 = 0;
        var sc1: u8 = 0;
        var mn1: u8 = 0;
        q4_k_scale_min_llama(is, packed_scales, &sc0, &mn0);
        q4_k_scale_min_llama(is + (1 as usize), packed_scales, &sc1, &mn1);
        const d0: f32 = d * (sc0 as f32);
        const m0: f32 = dmin * (mn0 as f32);
        const d1: f32 = d * (sc1 as f32);
        const m1: f32 = dmin * (mn1 as f32);
        const qbase: usize = (is / (2 as usize)) * (32 as usize);
        var l: usize = 0;
        while l < (32 as usize) {
            dst[out + l] = d0 * ((qs[qbase + l] & (15 as byte)) as f32) - m0;
            l = l + 1;
        }
        l = 0;
        while l < (32 as usize) {
            dst[out + (32 as usize) + l] = d1 * ((qs[qbase + l] >> (4 as i32)) as f32) - m1;
            l = l + 1;
        }
        is = is + (2 as usize);
        out = out + (64 as usize);
    }
}

export fn llama_q6_k_dequant_block(dst: &f32, block: &const byte) void {
    const ql: &const byte = &block[0];
    const qh: &const byte = &block[KERNEL_QK_K / (2 as usize)];
    const sc: &const i8 = &block[(KERNEL_QK_K / (2 as usize)) + (KERNEL_QK_K / (4 as usize))] as &const i8;
    const d_bits_offset: usize = (KERNEL_QK_K / (2 as usize)) + (KERNEL_QK_K / (4 as usize)) + (KERNEL_QK_K / (16 as usize));
    const d: f32 = f16_load_f32((block[d_bits_offset] as u16) | ((block[d_bits_offset + (1 as usize)] as u16) << (8 as i32)));
    var out: usize = 0;
    var ql_off: usize = 0;
    var qh_off: usize = 0;
    var sc_off: usize = 0;
    while out < KERNEL_QK_K {
        var l: usize = 0;
        while l < (32 as usize) {
            const isv: usize = l / (16 as usize);
            const q1: i32 = (((ql[ql_off + l] & (15 as byte)) as i32) | ((((qh[qh_off + l] >> 0) & (3 as byte)) as i32) << (4 as i32))) - 32;
            const q2: i32 = (((ql[ql_off + l + (32 as usize)] & (15 as byte)) as i32) | ((((qh[qh_off + l] >> 2) & (3 as byte)) as i32) << (4 as i32))) - 32;
            const q3: i32 = (((ql[ql_off + l] >> (4 as i32)) as i32) | ((((qh[qh_off + l] >> 4) & (3 as byte)) as i32) << (4 as i32))) - 32;
            const q4: i32 = (((ql[ql_off + l + (32 as usize)] >> (4 as i32)) as i32) | ((((qh[qh_off + l] >> 6) & (3 as byte)) as i32) << (4 as i32))) - 32;
            dst[out + l] = d * (sc[sc_off + isv + 0] as f32) * (q1 as f32);
            dst[out + (32 as usize) + l] = d * (sc[sc_off + isv + 2] as f32) * (q2 as f32);
            dst[out + (64 as usize) + l] = d * (sc[sc_off + isv + 4] as f32) * (q3 as f32);
            dst[out + (96 as usize) + l] = d * (sc[sc_off + isv + 6] as f32) * (q4 as f32);
            l = l + 1;
        }
        out = out + (128 as usize);
        ql_off = ql_off + (64 as usize);
        qh_off = qh_off + (32 as usize);
        sc_off = sc_off + (8 as usize);
    }
}

fn llama_q4_k_q8_1_partial(block: &const byte, q8_d_bits: &const u16, q8_qs: &const i8, iqs: usize) f32 {
    const qs: &const byte = &block[(2 as usize) * (2 as usize) + KERNEL_K_SCALE_SIZE];
    const d: f32 = f16_load_f32((block[0] as u16) | ((block[1] as u16) << (8 as i32)));
    const dmin: f32 = f16_load_f32((block[2] as u16) | ((block[3] as u16) << (8 as i32)));
    const bq8_offset: usize = KERNEL_QR4_K * ((iqs / (2 as usize)) / (KERNEL_QI8_1 / (2 as usize)));
    const q4_word_offset: usize = ((16 as usize) * bq8_offset + (4 as usize) * ((iqs / (2 as usize)) % (4 as usize))) / (4 as usize);
    const v0: i32 = packed_i32_le(qs, q4_word_offset + 0);
    const v1: i32 = packed_i32_le(qs, q4_word_offset + 4);
    const scale_words: &const u16 = &block[4] as &const u16;
    var aux0: u16 = 0;
    var aux1: u16 = 0;
    const j: usize = bq8_offset / (2 as usize);
    if j < (2 as usize) {
        aux0 = scale_words[j + 0] & (0x3f3f as u16);
        aux1 = scale_words[j + (2 as usize)] & (0x3f3f as u16);
    } else {
        aux0 = ((scale_words[j + (2 as usize)] >> (0 as i32)) & (0x0f0f as u16)) | ((scale_words[j - (2 as usize)] & (0xc0c0 as u16)) >> (2 as i32));
        aux1 = ((scale_words[j + (2 as usize)] >> (4 as i32)) & (0x0f0f as u16)) | ((scale_words[j - (0 as usize)] & (0xc0c0 as u16)) >> (2 as i32));
    }
    const sc0: u8 = (aux0 & (255 as u16)) as u8;
    const sc1: u8 = (aux0 >> (8 as i32)) as u8;
    const mn0: u8 = (aux1 & (255 as u16)) as u8;
    const mn1: u8 = (aux1 >> (8 as i32)) as u8;
    var sumf_d: f32 = 0.0;
    var sumf_m: f32 = 0.0;
    var i: usize = 0;
    while i < KERNEL_QR4_K {
        const v0i: i32 = ((v0 as u32) >> ((4 as usize * i) as i32)) as i32 & (0x0F0F0F0F as i32);
        const v1i: i32 = ((v1 as u32) >> ((4 as usize * i) as i32)) as i32 & (0x0F0F0F0F as i32);
        const q8_base: usize = (bq8_offset + i) * KERNEL_QK8_1;
        const q8_word_index: usize = (iqs / (2 as usize)) % (4 as usize);
        const u0: i32 = packed_i32_le(&q8_qs[q8_base] as &const byte, q8_word_index + 0);
        const u1: i32 = packed_i32_le(&q8_qs[q8_base] as &const byte, q8_word_index + 4);
        const dot1: i32 = packed_dp4a(v1i, u1, packed_dp4a(v0i, u0, 0));
        const dot2: i32 = packed_dp4a(0x01010101 as i32, u1, packed_dp4a(0x01010101 as i32, u0, 0));
        const d8: f32 = f16_load_f32(q8_d_bits[bq8_offset + i]);
        var scv: u8 = sc0;
        var mnv: u8 = mn0;
        if i == (1 as usize) { scv = sc1; mnv = mn1; }
        sumf_d = sumf_d + d8 * ((scv as f32) * (dot1 as f32));
        sumf_m = sumf_m + d8 * ((mnv as f32) * (dot2 as f32));
        i = i + 1;
    }
    return d * sumf_d - dmin * sumf_m;
}

fn llama_q6_k_q8_1_partial(block: &const byte, q8_d_bits: &const u16, q8_qs: &const i8, iqs: usize) f32 {
    const ql: &const byte = &block[0];
    const qh: &const byte = &block[KERNEL_QK_K / (2 as usize)];
    const sc: &const i8 = &block[(KERNEL_QK_K / (2 as usize)) + (KERNEL_QK_K / (4 as usize))] as &const i8;
    const d_bits_offset: usize = (KERNEL_QK_K / (2 as usize)) + (KERNEL_QK_K / (4 as usize)) + (KERNEL_QK_K / (16 as usize));
    const d: f32 = f16_load_f32((block[d_bits_offset] as u16) | ((block[d_bits_offset + (1 as usize)] as u16) << (8 as i32)));
    const bq8_offset: usize = (2 as usize) * KERNEL_QR6_K * (iqs / (KERNEL_QI6_K / (2 as usize))) + (iqs % (KERNEL_QI6_K / (2 as usize))) / (KERNEL_QI6_K / (4 as usize));
    const scale_offset: usize = (KERNEL_QI6_K / (4 as usize)) * (iqs / (KERNEL_QI6_K / (2 as usize))) + (iqs % (KERNEL_QI6_K / (2 as usize))) / (KERNEL_QI6_K / (8 as usize));
    const vh_shift: usize = (2 as usize) * ((iqs % (KERNEL_QI6_K / (2 as usize))) / (KERNEL_QI6_K / (4 as usize)));
    const vl: i32 = packed_i32_le(ql, iqs);
    const vh_word: usize = (KERNEL_QI6_K / (4 as usize)) * (iqs / (KERNEL_QI6_K / (2 as usize))) + iqs % (KERNEL_QI6_K / (4 as usize));
    const vh: i32 = ((packed_i32_le(qh, vh_word) as u32) >> (vh_shift as i32)) as i32;
    const scales: &const i8 = &sc[scale_offset];
    var sumf: f32 = 0.0;
    var i: usize = 0;
    while i < KERNEL_QR6_K {
        const scv: i32 = scales[(4 as usize) * i] as i32;
        const vil: i32 = ((vl as u32) >> ((4 as usize * i) as i32)) as i32 & (0x0F0F0F0F as i32);
        const vih: i32 = ((((vh as u32) >> ((4 as usize * i) as i32)) as i32) << (4 as i32)) & (0x30303030 as i32);
        var vi: i32 = 0;
        var byte_index: usize = 0;
        while byte_index < (4 as usize) {
            const packed: i32 = (((vil as u32) >> ((byte_index * (8 as usize)) as i32)) as i32 & (15 as i32)) |
                ((((vih as u32) >> ((byte_index * (8 as usize)) as i32)) as i32 & (48 as i32)));
            const signed_v: i32 = packed - 32;
            vi = vi | (((signed_v & (255 as i32)) as u32) << ((byte_index * (8 as usize)) as i32)) as i32;
            byte_index = byte_index + 1;
        }
        const q8_base: usize = (bq8_offset + (2 as usize) * i) * KERNEL_QK8_1;
        const u0: i32 = packed_i32_le(&q8_qs[q8_base] as &const byte, iqs % KERNEL_QI8_1);
        const d8: f32 = f16_load_f32(q8_d_bits[bq8_offset + (2 as usize) * i]);
        sumf = sumf + d8 * ((packed_dp4a(vi, u0, 0) as f32) * (scv as f32));
        i = i + 1;
    }
    return d * sumf;
}

export fn llama_q4_k_q8_1_dot(block: &const byte, x: &const f32) f32 {
    var q8_d_bits: [u16: KERNEL_Q8_1_BLOCKS_PER_SUPER] = [];
    var q8_s_bits: [u16: KERNEL_Q8_1_BLOCKS_PER_SUPER] = [];
    var q8_qs: [i8: KERNEL_QK_K] = [];
    _ = q8_1_quantize_row(&q8_d_bits[0], &q8_s_bits[0], &q8_qs[0], x, KERNEL_QK_K);
    var sum: f32 = 0.0;
    var iqs: usize = 0;
    while iqs < KERNEL_QI4_K {
        sum = sum + llama_q4_k_q8_1_partial(block, &q8_d_bits[0], &q8_qs[0], iqs);
        iqs = iqs + (2 as usize);
    }
    return sum;
}

export fn llama_q6_k_q8_1_dot(block: &const byte, x: &const f32) f32 {
    var q8_d_bits: [u16: KERNEL_Q8_1_BLOCKS_PER_SUPER] = [];
    var q8_s_bits: [u16: KERNEL_Q8_1_BLOCKS_PER_SUPER] = [];
    var q8_qs: [i8: KERNEL_QK_K] = [];
    _ = q8_1_quantize_row(&q8_d_bits[0], &q8_s_bits[0], &q8_qs[0], x, KERNEL_QK_K);
    var sum: f32 = 0.0;
    var iqs: usize = 0;
    while iqs < KERNEL_QI6_K {
        sum = sum + llama_q6_k_q8_1_partial(block, &q8_d_bits[0], &q8_qs[0], iqs);
        iqs = iqs + 1;
    }
    return sum;
}

fn packed_nibble(qs: &const byte, i: usize) u32 {
    const packed: u32 = qs[i / (2 as usize)] as u32;
    if (i % (2 as usize)) == 0 { return packed & (15 as u32); }
    return (packed >> 4) & (15 as u32);
}

fn store_u16_le(dst: &byte, byte_offset: usize, value: u16) void {
    dst[byte_offset] = (value & (255 as u16)) as byte;
    dst[byte_offset + (1 as usize)] = (value >> (8 as i32)) as byte;
}

export fn q4_k_dequant(dst: &f32, scales: &const f32, qs: &const byte, n: usize) void {
    var i: usize = 0;
    while i < n {
        const q: i32 = (packed_nibble(qs, i) as i32) - 8;
        dst[i] = scales[i / (32 as usize)] * (q as f32);
        i = i + 1;
    }
}

export fn q4_k_dot(scales: &const f32, qs: &const byte, x: &const f32, n: usize) f32 {
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n {
        const q: i32 = (packed_nibble(qs, i) as i32) - 8;
        sum = sum + scales[i / (32 as usize)] * (q as f32) * x[i];
        i = i + 1;
    }
    return sum;
}

export fn q5_k_dequant(dst: &f32, scales: &const f32, ql: &const byte, qh: &const byte, n: usize) void {
    var i: usize = 0;
    while i < n {
        const low: u32 = packed_nibble(ql, i);
        const high: u32 = ((qh[i / (8 as usize)] as u32) >> ((i % (8 as usize)) as i32)) & (1 as u32);
        const q: i32 = ((low | (high << 4)) as i32) - 16;
        dst[i] = scales[i / (32 as usize)] * (q as f32);
        i = i + 1;
    }
}

export fn q5_k_dot(scales: &const f32, ql: &const byte, qh: &const byte, x: &const f32, n: usize) f32 {
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n {
        const low: u32 = packed_nibble(ql, i);
        const high: u32 = ((qh[i / (8 as usize)] as u32) >> ((i % (8 as usize)) as i32)) & (1 as u32);
        const q: i32 = ((low | (high << 4)) as i32) - 16;
        sum = sum + scales[i / (32 as usize)] * (q as f32) * x[i];
        i = i + 1;
    }
    return sum;
}

export fn q6_k_dequant(dst: &f32, scales: &const f32, ql: &const byte, qh: &const byte, n: usize) void {
    var i: usize = 0;
    while i < n {
        const low: u32 = packed_nibble(ql, i);
        const high: u32 = ((qh[i / (4 as usize)] as u32) >> (((i % (4 as usize)) * (2 as usize)) as i32)) & (3 as u32);
        const q: i32 = ((low | (high << 4)) as i32) - 32;
        dst[i] = scales[i / (32 as usize)] * (q as f32);
        i = i + 1;
    }
}

export fn q6_k_dot(scales: &const f32, ql: &const byte, qh: &const byte, x: &const f32, n: usize) f32 {
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n {
        const low: u32 = packed_nibble(ql, i);
        const high: u32 = ((qh[i / (4 as usize)] as u32) >> (((i % (4 as usize)) * (2 as usize)) as i32)) & (3 as u32);
        const q: i32 = ((low | (high << 4)) as i32) - 32;
        sum = sum + scales[i / (32 as usize)] * (q as f32) * x[i];
        i = i + 1;
    }
    return sum;
}

export fn iq4_nl_dequant(dst: &f32, scale: f32, codebook: &const f32, qs: &const byte, n: usize) void {
    var i: usize = 0;
    while i < n { dst[i] = scale * codebook[packed_nibble(qs, i) as usize]; i = i + 1; }
}

export fn iq4_nl_dot(scale: f32, codebook: &const f32, qs: &const byte, x: &const f32, n: usize) f32 {
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n { sum = sum + scale * codebook[packed_nibble(qs, i) as usize] * x[i]; i = i + 1; }
    return sum;
}

export fn q8_0_matvec(dst: &f32, scales: &const u16, qs: &const i8, row_stride_blocks: usize, x: &const f32, rows: usize, cols: usize) void {
    if cols % (32 as usize) != 0 { return; }
    const blocks: usize = cols / (32 as usize);
    var r: usize = 0;
    while r < rows {
        var sum: f32 = 0.0;
        var b: usize = 0;
        while b < blocks {
            const scale_index: usize = r * row_stride_blocks + b;
            const q_index: usize = (r * row_stride_blocks + b) * (32 as usize);
            sum = sum + q8_0_dot(scales[scale_index], &qs[q_index], &x[b * (32 as usize)], 32);
            b = b + 1;
        }
        dst[r] = sum;
        r = r + 1;
    }
}

export fn quant_report_unsupported(tensor_name: &const byte, dtype: &const byte) i32 {
    _ = printf("unsupported quant dtype: tensor=%s dtype=%s\n", tensor_name, dtype);
    return 1;
}

fn pack_nibble(qs: &byte, i: usize, value: u32) void {
    const idx: usize = i / (2 as usize);
    const v: byte = (value & (15 as u32)) as byte;
    if (i % (2 as usize)) == 0 {
        qs[idx] = (qs[idx] & (240 as byte)) | v;
    } else {
        qs[idx] = (qs[idx] & (15 as byte)) | ((v as u32) << (4 as i32)) as byte;
    }
}

fn set_bit(qs: &byte, i: usize, value: u32) void {
    if value == 0 { return; }
    const idx: usize = i / (8 as usize);
    qs[idx] = qs[idx] | (((1 as u32) << ((i % (8 as usize)) as i32)) as byte);
}

fn set_2bits(qs: &byte, i: usize, value: u32) void {
    const idx: usize = i / (4 as usize);
    qs[idx] = qs[idx] | (((value & (3 as u32)) << (((i % (4 as usize)) * (2 as usize)) as i32)) as byte);
}

export fn quant_smoke_cli() i32 {
    var pass: bool = true;
    var x: [f32: 256] = [];
    var deq: [f32: 256] = [];
    var q8_ref: [f32: KERNEL_QK_K] = [];
    var i: usize = 0;
    while i < 256 { x[i] = ((i % (7 as usize)) as f32) - 3.0; i = i + 1; }

    var q8: [i8: 64] = [];
    i = 0;
    while i < 64 { q8[i] = ((i % (9 as usize)) as i8) - 4; i = i + 1; }
    q8_0_dequant(&deq[0], 0x3800, &q8[0], 32);
    pass = check("q8_0_dot\0" as &const byte, nearly(q8_0_dot(0x3800, &q8[0], &x[0], 32), f32_dot(&deq[0], &x[0], 32), 0.001)) && pass;

    var scales: [f32: 8] = [];
    i = 0;
    while i < 8 { scales[i] = 0.25 + (i as f32) * 0.125; i = i + 1; }
    var ql: [byte: 128] = [];
    i = 0;
    while i < 64 { pack_nibble(&ql[0], i, (i % (16 as usize)) as u32); i = i + 1; }
    q4_k_dequant(&deq[0], &scales[0], &ql[0], 64);
    pass = check("q4_k_dot\0" as &const byte, nearly(q4_k_dot(&scales[0], &ql[0], &x[0], 64), f32_dot(&deq[0], &x[0], 64), 0.001)) && pass;

    var qh1: [byte: 32] = [];
    i = 0;
    while i < 64 { if (i % (3 as usize)) == 0 { set_bit(&qh1[0], i, 1); } i = i + 1; }
    q5_k_dequant(&deq[0], &scales[0], &ql[0], &qh1[0], 64);
    pass = check("q5_k_dot\0" as &const byte, nearly(q5_k_dot(&scales[0], &ql[0], &qh1[0], &x[0], 64), f32_dot(&deq[0], &x[0], 64), 0.001)) && pass;

    var qh2: [byte: 64] = [];
    i = 0;
    while i < 64 { set_2bits(&qh2[0], i, (i % (4 as usize)) as u32); i = i + 1; }
    q6_k_dequant(&deq[0], &scales[0], &ql[0], &qh2[0], 64);
    pass = check("q6_k_dot\0" as &const byte, nearly(q6_k_dot(&scales[0], &ql[0], &qh2[0], &x[0], 64), f32_dot(&deq[0], &x[0], 64), 0.001)) && pass;

    var q4_block: [byte: 144] = [];
    var q4_scales: [u8: 8] = [];
    var q4_mins: [u8: 8] = [];
    i = 0;
    while i < (8 as usize) {
        q4_scales[i] = (3 + i) as u8;
        q4_mins[i] = (1 + (i % (5 as usize))) as u8;
        i = i + 1;
    }
    store_u16_le(&q4_block[0], 0, f32_to_f16_bits(0.0625));
    store_u16_le(&q4_block[0], 2, f32_to_f16_bits(0.03125));
    q4_k_pack_scales_mins(&q4_block[4], &q4_scales[0], &q4_mins[0]);
    i = 0;
    while i < KERNEL_QK_K {
        pack_nibble(&q4_block[(2 as usize) * (2 as usize) + KERNEL_K_SCALE_SIZE], i, ((i * (3 as usize) + (5 as usize)) % (16 as usize)) as u32);
        i = i + 1;
    }
    var q8_1_d_bits: [u16: KERNEL_Q8_1_BLOCKS_PER_SUPER] = [];
    var q8_1_s_bits: [u16: KERNEL_Q8_1_BLOCKS_PER_SUPER] = [];
    var q8_1_qs: [i8: KERNEL_QK_K] = [];
    pass = q8_1_quantize_row(&q8_1_d_bits[0], &q8_1_s_bits[0], &q8_1_qs[0], &x[0], KERNEL_QK_K) && pass;
    pass = q8_1_dequant_row(&q8_ref[0], &q8_1_d_bits[0], &q8_1_qs[0], KERNEL_QK_K) && pass;
    llama_q4_k_dequant_block(&deq[0], &q4_block[0] as &const byte);
    pass = check("llama_q4_k_q8_1_dot\0" as &const byte, nearly(llama_q4_k_q8_1_dot(&q4_block[0] as &const byte, &x[0]), f32_dot(&deq[0], &q8_ref[0], KERNEL_QK_K), 0.05)) && pass;

    var q6_block: [byte: 210] = [];
    store_u16_le(&q6_block[0], 208, f32_to_f16_bits(0.125));
    i = 0;
    while i < (KERNEL_QK_K / (2 as usize)) {
        q6_block[i] = ((((i + (3 as usize)) % (16 as usize)) as u32) | ((((i * (5 as usize)) % (16 as usize)) as u32) << (4 as i32))) as byte;
        i = i + 1;
    }
    i = 0;
    while i < (KERNEL_QK_K / (4 as usize)) {
        q6_block[(KERNEL_QK_K / (2 as usize)) + i] = (
            (((i + (1 as usize)) % (4 as usize)) as u32) |
            ((((i + (2 as usize)) % (4 as usize)) as u32) << (2 as i32)) |
            ((((i + (3 as usize)) % (4 as usize)) as u32) << (4 as i32)) |
            ((((i + (0 as usize)) % (4 as usize)) as u32) << (6 as i32))) as byte;
        i = i + 1;
    }
    i = 0;
    while i < (KERNEL_QK_K / (16 as usize)) {
        q6_block[(KERNEL_QK_K / (2 as usize)) + (KERNEL_QK_K / (4 as usize)) + i] = (((i as i32) % 11) - 5) as byte;
        i = i + 1;
    }
    llama_q6_k_dequant_block(&deq[0], &q6_block[0] as &const byte);
    pass = check("llama_q6_k_q8_1_dot\0" as &const byte, nearly(llama_q6_k_q8_1_dot(&q6_block[0] as &const byte, &x[0]), f32_dot(&deq[0], &q8_ref[0], KERNEL_QK_K), 0.05)) && pass;

    var codebook: [f32: 16] = [];
    i = 0;
    while i < 16 { codebook[i] = ((i as f32) - 7.5) / 7.5; i = i + 1; }
    iq4_nl_dequant(&deq[0], 0.5, &codebook[0], &ql[0], 64);
    pass = check("iq4_nl_dot\0" as &const byte, nearly(iq4_nl_dot(0.5, &codebook[0], &ql[0], &x[0], 64), f32_dot(&deq[0], &x[0], 64), 0.001)) && pass;

    var row_scales: [u16: 4] = [];
    row_scales[0] = 0x3c00; row_scales[1] = 0x0000; row_scales[2] = 0x4000; row_scales[3] = 0x0000;
    var row_qs: [i8: 128] = [];
    i = 0;
    while i < 32 { row_qs[i] = 1; row_qs[(64 as usize) + i] = 2; i = i + 1; }
    var mv: [f32: 2] = [];
    q8_0_matvec(&mv[0], &row_scales[0], &row_qs[0], 2, &x[0], 2, 32);
    pass = check("q8_0_matvec_stride\0" as &const byte, nearly(mv[0], q8_0_dot(0x3c00, &row_qs[0], &x[0], 32), 0.001) && nearly(mv[1], q8_0_dot(0x4000, &row_qs[64], &x[0], 32), 0.001)) && pass;
    pass = check("unsupported_quant_report\0" as &const byte, quant_report_unsupported("blk.0.bad.weight\0" as &const byte, "IQ_UNKNOWN\0" as &const byte) == 1) && pass;

    if pass { _ = printf("quant smoke: PASS\n"); return 0; }
    _ = printf("quant smoke: FAIL\n");
    return 1;
}

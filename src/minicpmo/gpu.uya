@c_import("gpu_bridge.c", "", "-ldl");

use libc.getenv;
use libc.printf;
use minicpmo.tensor.TensorDType;
use minicpmo.tensor.TensorView;
use minicpmo.tensor.tensor_dtype_name;

const GPU_ERROR_CAP: usize = 512;

export struct GpuStats {
    backend_init_us: u64,
    host_to_device_bytes: u64,
    device_to_host_bytes: u64,
    weight_upload_bytes: u64,
    scratch_x_bytes: u64,
    scratch_y_bytes: u64,
    uploaded_weight_count: u64,
    native_quant_matvec_count: u64,
    staged_quant_matvec_count: u64,
    q8_1_x_bytes: u64,
    attention_kernel_calls: u64,
    kv_device_bytes: u64,
    kv_host_to_device_bytes: u64,
}

export struct GpuContext {
    handle: &void,
    debug: bool,
    stats: GpuStats,
    last_error: [byte: 512],
}

extern "libc" fn minicpmo_gpu_context_create(device_index: u32, debug: i32, out_handle: & &void, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_destroy(handle: &void) void;
extern "libc" fn minicpmo_gpu_context_smoke(handle: &void, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_upload_tensor(handle: &void, name: &const byte, host_ptr: &const byte, bytes: usize, dtype: i32, rows: usize, cols: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_matvec(handle: &void, tensor_name: &const byte, host_ptr: &const byte, dtype: i32, x: &const f32, in_dim: usize, out_dim: usize, dst: &f32, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_prepare_attention(handle: &void, layer_count: usize, context_capacity: usize, kv_dim: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_attention(handle: &void, q: &const f32, k: &const f32, v: &const f32, layer: usize, pos: usize, head_count: usize, kv_head_count: usize, head_dim: usize, context_capacity: usize, dst: &f32, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_slot_upload_f32(handle: &void, slot: u32, src: &const f32, len: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_slot_download_f32(handle: &void, slot: u32, dst: &f32, len: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_slot_matvec(handle: &void, dst_slot: u32, tensor_name: &const byte, host_ptr: &const byte, dtype: i32, src_slot: u32, in_dim: usize, out_dim: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_slot_rms_norm(handle: &void, dst_slot: u32, src_slot: u32, weight_host_ptr: &const byte, n: usize, eps: f32, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_slot_head_norm(handle: &void, slot: u32, weight_host_ptr: &const byte, head_count: usize, head_dim: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_slot_rope(handle: &void, slot: u32, head_count: usize, head_dim: usize, pos: usize, freq_base: f32, freq_scale: f32, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_slot_add_inplace(handle: &void, dst_slot: u32, src_slot: u32, len: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_slot_silu_mul(handle: &void, dst_slot: u32, gate_slot: u32, up_slot: u32, len: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_attention_slots(handle: &void, dst_slot: u32, q_slot: u32, k_slot: u32, v_slot: u32, layer: usize, pos: usize, head_count: usize, kv_head_count: usize, head_dim: usize, context_capacity: usize, err_text: &byte, error_cap: usize) i32;
extern "libc" fn minicpmo_gpu_context_snapshot(handle: &void, stats: &GpuStats) void;

export fn gpu_stats_init() GpuStats {
    return GpuStats{
        backend_init_us: 0,
        host_to_device_bytes: 0,
        device_to_host_bytes: 0,
        weight_upload_bytes: 0,
        scratch_x_bytes: 0,
        scratch_y_bytes: 0,
        uploaded_weight_count: 0,
        native_quant_matvec_count: 0,
        staged_quant_matvec_count: 0,
        q8_1_x_bytes: 0,
        attention_kernel_calls: 0,
        kv_device_bytes: 0,
        kv_host_to_device_bytes: 0,
    };
}

export fn gpu_context_init() GpuContext {
    return GpuContext{ handle: null, debug: false, stats: gpu_stats_init(), last_error: [] };
}

fn gpu_debug_enabled() bool {
    const value: &const byte = getenv("MINICPM_O_GPU_DEBUG\0" as &const byte) as &const byte;
    if value == null { return false; }
    if value[0] == 48 as byte && value[1] == 0 { return false; }
    return true;
}

fn gpu_context_error_reset(ctx: &GpuContext) void {
    ctx.last_error[0] = 0;
}

export fn gpu_context_last_error(ctx: &GpuContext) &const byte {
    return &ctx.last_error[0] as &const byte;
}

export fn gpu_context_refresh_stats(ctx: &GpuContext) void {
    if ctx.handle == null { return; }
    minicpmo_gpu_context_snapshot(ctx.handle, &ctx.stats);
}

export fn gpu_context_open(device_index: u32, ctx: &GpuContext) bool {
    var debug_flag: i32 = 0;
    ctx[0] = gpu_context_init();
    ctx.debug = gpu_debug_enabled();
    if ctx.debug { debug_flag = 1; }
    gpu_context_error_reset(ctx);
    if minicpmo_gpu_context_create(device_index, debug_flag, &ctx.handle, &ctx.last_error[0], GPU_ERROR_CAP) == 0 {
        ctx.handle = null;
        return false;
    }
    gpu_context_refresh_stats(ctx);
    return true;
}

export fn gpu_context_close(ctx: &GpuContext) void {
    if ctx.handle != null {
        gpu_context_refresh_stats(ctx);
        minicpmo_gpu_context_destroy(ctx.handle);
        ctx.handle = null;
    }
}

export fn gpu_context_smoke(ctx: &GpuContext) bool {
    gpu_context_error_reset(ctx);
    if ctx.handle == null {
        return false;
    }
    if minicpmo_gpu_context_smoke(ctx.handle, &ctx.last_error[0], GPU_ERROR_CAP) == 0 {
        return false;
    }
    gpu_context_refresh_stats(ctx);
    return true;
}

export fn gpu_dtype_matvec_supported(dtype: TensorDType) bool {
    return dtype == TensorDType.F32 || dtype == TensorDType.F16 || dtype == TensorDType.BF16 || dtype == TensorDType.Q4_K || dtype == TensorDType.Q6_K;
}

export fn gpu_context_upload_tensor(ctx: &GpuContext, view: &TensorView) bool {
    gpu_context_error_reset(ctx);
    if ctx.handle == null || view == null || view.data == null || view.byte_size == 0 { return false; }
    var cols: usize = 0;
    var rows: usize = 0;
    if view.n_dims == 1 {
        rows = 1;
        cols = view.shape[0] as usize;
    } else if view.n_dims == 2 {
        cols = view.shape[0] as usize;
        rows = view.shape[1] as usize;
    } else {
        gpu_print_runtime_unsupported("qwen3 cuda upload expects matrix/vector\0" as &const byte, view);
        return false;
    }
    if minicpmo_gpu_context_upload_tensor(ctx.handle, &view.name[0] as &const byte, view.data, view.byte_size as usize, view.dtype as i32, rows, cols, &ctx.last_error[0], GPU_ERROR_CAP) == 0 {
        return false;
    }
    gpu_context_refresh_stats(ctx);
    return true;
}

export fn gpu_context_matvec(ctx: &GpuContext, view: &TensorView, x: &const f32, in_dim: usize, out_dim: usize, dst: &f32) bool {
    gpu_context_error_reset(ctx);
    if ctx.handle == null || view == null || view.data == null { return false; }
    if minicpmo_gpu_context_matvec(ctx.handle, &view.name[0] as &const byte, view.data, view.dtype as i32, x, in_dim, out_dim, dst, &ctx.last_error[0], GPU_ERROR_CAP) == 0 {
        return false;
    }
    gpu_context_refresh_stats(ctx);
    return true;
}


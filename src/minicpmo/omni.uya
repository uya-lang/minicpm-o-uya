use libc.printf;
use libc.strcmp;
use minicpmo.binary.BinaryReader;
use minicpmo.binary.binary_close;
use minicpmo.binary.binary_open;
use minicpmo.binary.binary_read_exact;
use minicpmo.binary.binary_reader_init;
use minicpmo.tokenizer.Tokenizer;
use minicpmo.tokenizer.tokenizer_encode_to_ids;
use minicpmo.tokenizer.tokenizer_init;
use minicpmo.tokenizer.tokenizer_load;

const OMNI_MAX_MANIFEST_BYTES: usize = 4096;
const OMNI_MAX_EVENTS: usize = 32;
const OMNI_MAX_TOKENS: usize = 256;
const OMNI_MAX_SPANS: usize = 32;
const OMNI_DATA_REF_CAP: usize = 128;
const OMNI_EVENT_TEXT_CAP: usize = 128;
const OMNI_ATTENTION_CAUSAL_MEDIA: u32 = 1;

export enum PromptEventKind {
    Text,
    Image,
    VideoFrame,
    AudioChunk,
    SpeechRequest,
    Control,
    Unknown,
}

export struct PromptEvent {
    kind: PromptEventKind,
    data_ref: [byte: 128],
    timestamp_ms: u64,
    flags: u32,
}

export struct EmbeddingSpan {
    kind: PromptEventKind,
    token_start: u32,
    token_count: u32,
    embed_start: u32,
    embed_count: u32,
}

export struct CompiledPrompt {
    token_ids: [u32: 256],
    position_ids: [u32: 256],
    token_count: usize,
    spans: [EmbeddingSpan: 32],
    span_count: usize,
    event_count: usize,
    text_event_count: usize,
    image_event_count: usize,
    video_frame_event_count: usize,
    audio_chunk_event_count: usize,
    speech_request_count: usize,
    control_count: usize,
    text_token_count: usize,
    media_embedding_count: usize,
    attention_mask_policy: u32,
}

struct OmniManifestBuffer {
    bytes: [byte: 4096],
    len: usize,
}

export fn prompt_event_init() PromptEvent {
    return PromptEvent{ kind: PromptEventKind.Unknown, data_ref: [], timestamp_ms: 0, flags: 0 };
}

export fn compiled_prompt_init() CompiledPrompt {
    return CompiledPrompt{ token_ids: [], position_ids: [], token_count: 0, spans: [], span_count: 0, event_count: 0, text_event_count: 0, image_event_count: 0, video_frame_event_count: 0, audio_chunk_event_count: 0, speech_request_count: 0, control_count: 0, text_token_count: 0, media_embedding_count: 0, attention_mask_policy: OMNI_ATTENTION_CAUSAL_MEDIA };
}

fn omni_cstr_eq(a: &const byte, b: &const byte) bool {
    return strcmp(a as *const byte, b as *const byte) == 0;
}

fn omni_cstr_len(value: &const byte) usize {
    var len: usize = 0;
    while value[len] != 0 { len = len + 1; }
    return len;
}

fn omni_copy_cstr(dest: &byte, cap: usize, src: &const byte) bool {
    if cap == 0 { return false; }
    var index: usize = 0;
    while src[index] != 0 {
        if index + 1 >= cap { dest[cap - 1] = 0; return false; }
        dest[index] = src[index];
        index = index + 1;
    }
    dest[index] = 0;
    return true;
}

fn omni_kind_from_cstr(value: &const byte) PromptEventKind {
    if omni_cstr_eq(value, "text\0" as &const byte) { return PromptEventKind.Text; }
    if omni_cstr_eq(value, "image\0" as &const byte) { return PromptEventKind.Image; }
    if omni_cstr_eq(value, "video_frame\0" as &const byte) { return PromptEventKind.VideoFrame; }
    if omni_cstr_eq(value, "audio_chunk\0" as &const byte) { return PromptEventKind.AudioChunk; }
    if omni_cstr_eq(value, "speech_request\0" as &const byte) { return PromptEventKind.SpeechRequest; }
    if omni_cstr_eq(value, "control\0" as &const byte) { return PromptEventKind.Control; }
    return PromptEventKind.Unknown;
}

fn omni_kind_label(kind: PromptEventKind) &const byte {
    if kind == PromptEventKind.Text { return "text\0" as &const byte; }
    if kind == PromptEventKind.Image { return "image\0" as &const byte; }
    if kind == PromptEventKind.VideoFrame { return "video_frame\0" as &const byte; }
    if kind == PromptEventKind.AudioChunk { return "audio_chunk\0" as &const byte; }
    if kind == PromptEventKind.SpeechRequest { return "speech_request\0" as &const byte; }
    if kind == PromptEventKind.Control { return "control\0" as &const byte; }
    return "unknown\0" as &const byte;
}

fn omni_is_ws(ch: byte) bool {
    return ch == 32 || ch == 9 || ch == 10 || ch == 13;
}

fn omni_match_at(buf: &const byte, len: usize, pos: usize, pattern: &const byte) bool {
    var index: usize = 0;
    while pattern[index] != 0 {
        if pos + index >= len { return false; }
        if buf[pos + index] != pattern[index] { return false; }
        index = index + 1;
    }
    return true;
}

fn omni_find_pattern(buf: &const byte, len: usize, start: usize, end: usize, pattern: &const byte, out_pos: &usize) bool {
    var pos: usize = start;
    var capped_end: usize = end;
    if capped_end > len { capped_end = len; }
    while pos < capped_end {
        if omni_match_at(buf, len, pos, pattern) { out_pos[0] = pos; return true; }
        pos = pos + 1;
    }
    return false;
}

fn omni_find_byte(buf: &const byte, len: usize, start: usize, end: usize, wanted: byte, out_pos: &usize) bool {
    var pos: usize = start;
    var capped_end: usize = end;
    if capped_end > len { capped_end = len; }
    while pos < capped_end {
        if buf[pos] == wanted { out_pos[0] = pos; return true; }
        pos = pos + 1;
    }
    return false;
}

fn omni_find_json_string_value(buf: &const byte, len: usize, start: usize, end: usize, key: &const byte, dest: &byte, cap: usize, key_pos: &usize) bool {
    if !omni_find_pattern(buf, len, start, end, key, key_pos) { return false; }
    var colon: usize = 0;
    if !omni_find_byte(buf, len, key_pos[0] + omni_cstr_len(key), end, 58, &colon) { return false; }
    var value_start: usize = colon + 1;
    while value_start < len && value_start < end && omni_is_ws(buf[value_start]) { value_start = value_start + 1; }
    if value_start >= len || value_start >= end || buf[value_start] != 34 { return false; }
    var src: usize = value_start + 1;
    var dst: usize = 0;
    while src < len && src < end && buf[src] != 34 {
        if dst + 1 >= cap { dest[cap - 1] = 0; return false; }
        if buf[src] == 92 && src + 1 < len && src + 1 < end {
            src = src + 1;
            if buf[src] == 110 { dest[dst] = 10; }
            else { dest[dst] = buf[src]; }
        } else {
            dest[dst] = buf[src];
        }
        dst = dst + 1;
        src = src + 1;
    }
    if src >= len || src >= end { return false; }
    dest[dst] = 0;
    return true;
}

fn omni_manifest_load(path: &const byte, manifest: &OmniManifestBuffer) bool {
    manifest.len = 0;
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    if reader.size == 0 || reader.size >= OMNI_MAX_MANIFEST_BYTES as u64 { _ = printf("error: omni manifest size=%llu exceeds cap=%zu\n", reader.size, OMNI_MAX_MANIFEST_BYTES); binary_close(&reader); return false; }
    manifest.len = reader.size as usize;
    if !binary_read_exact(&reader, &manifest.bytes[0], manifest.len, "omni manifest\0" as &const byte) { binary_close(&reader); return false; }
    manifest.bytes[manifest.len] = 0;
    binary_close(&reader);
    return true;
}

fn omni_parse_events(path: &const byte, events: &PromptEvent, event_count: &usize) bool {
    event_count[0] = 0;
    var manifest: OmniManifestBuffer = OmniManifestBuffer{ bytes: [], len: 0 };
    if !omni_manifest_load(path, &manifest) { return false; }
    var pos: usize = 0;
    while pos < manifest.len {
        var kind_value: [byte: 64] = [];
        var kind_pos: usize = 0;
        if !omni_find_json_string_value(&manifest.bytes[0] as &const byte, manifest.len, pos, manifest.len, "kind\0" as &const byte, &kind_value[0], @len(kind_value), &kind_pos) { break; }
        var event_end: usize = manifest.len;
        _ = omni_find_byte(&manifest.bytes[0] as &const byte, manifest.len, kind_pos, manifest.len, 125, &event_end);
        if event_count[0] >= OMNI_MAX_EVENTS { _ = printf("error: omni manifest exceeds event cap=%zu\n", OMNI_MAX_EVENTS); return false; }
        events[event_count[0]] = prompt_event_init();
        events[event_count[0]].kind = omni_kind_from_cstr(&kind_value[0] as &const byte);
        if events[event_count[0]].kind == PromptEventKind.Unknown { _ = printf("error: omni manifest unknown event kind=%s\n", &kind_value[0]); return false; }
        var tmp_key_pos: usize = 0;
        if events[event_count[0]].kind == PromptEventKind.Text {
            if !omni_find_json_string_value(&manifest.bytes[0] as &const byte, manifest.len, kind_pos, event_end, "text\0" as &const byte, &events[event_count[0]].data_ref[0], @len(events[event_count[0]].data_ref), &tmp_key_pos) { _ = printf("error: omni text event missing text\n"); return false; }
        } else {
            if !omni_find_json_string_value(&manifest.bytes[0] as &const byte, manifest.len, kind_pos, event_end, "path\0" as &const byte, &events[event_count[0]].data_ref[0], @len(events[event_count[0]].data_ref), &tmp_key_pos) {
                if !omni_find_json_string_value(&manifest.bytes[0] as &const byte, manifest.len, kind_pos, event_end, "name\0" as &const byte, &events[event_count[0]].data_ref[0], @len(events[event_count[0]].data_ref), &tmp_key_pos) {
                    if !omni_find_json_string_value(&manifest.bytes[0] as &const byte, manifest.len, kind_pos, event_end, "voice\0" as &const byte, &events[event_count[0]].data_ref[0], @len(events[event_count[0]].data_ref), &tmp_key_pos) {
                        events[event_count[0]].data_ref[0] = 0;
                    }
                }
            }
        }
        event_count[0] = event_count[0] + 1;
        pos = event_end + 1;
    }
    if event_count[0] == 0 { _ = printf("error: omni manifest contains no events\n"); return false; }
    return true;
}

fn omni_append_token(compiled: &CompiledPrompt, token_id: u32) bool {
    if compiled.token_count >= OMNI_MAX_TOKENS { _ = printf("error: compiled prompt exceeds token cap=%zu\n", OMNI_MAX_TOKENS); return false; }
    compiled.token_ids[compiled.token_count] = token_id;
    compiled.position_ids[compiled.token_count] = compiled.token_count as u32;
    compiled.token_count = compiled.token_count + 1;
    return true;
}

fn omni_single_token(tok: &Tokenizer, piece: &const byte, out: &u32) bool {
    var ids: [u32: 4] = [];
    var count: usize = 0;
    if !tokenizer_encode_to_ids(tok, piece, &ids[0], @len(ids), &count) { return false; }
    if count != 1 { _ = printf("error: media placeholder %s encoded to %zu tokens\n", piece, count); return false; }
    out[0] = ids[0];
    return true;
}

fn omni_add_span(compiled: &CompiledPrompt, kind: PromptEventKind, token_start: u32, embed_count: u32) bool {
    if compiled.span_count >= OMNI_MAX_SPANS { _ = printf("error: compiled prompt exceeds span cap=%zu\n", OMNI_MAX_SPANS); return false; }
    compiled.spans[compiled.span_count] = EmbeddingSpan{ kind: kind, token_start: token_start, token_count: 1, embed_start: compiled.media_embedding_count as u32, embed_count: embed_count };
    compiled.span_count = compiled.span_count + 1;
    compiled.media_embedding_count = compiled.media_embedding_count + embed_count as usize;
    return true;
}

export fn omni_compile_prompt(tok: &Tokenizer, events: &PromptEvent, event_count: usize, compiled: &CompiledPrompt) bool {
    compiled[0] = compiled_prompt_init();
    compiled.event_count = event_count;
    var image_token_id: u32 = 0;
    var audio_token_id: u32 = 0;
    var video_token_id: u32 = 0;
    if !omni_single_token(tok, "<image>\0" as &const byte, &image_token_id) { return false; }
    if !omni_single_token(tok, "<audio>\0" as &const byte, &audio_token_id) { return false; }
    if !omni_single_token(tok, "<video>\0" as &const byte, &video_token_id) { return false; }
    var event_index: usize = 0;
    while event_index < event_count {
        const kind: PromptEventKind = events[event_index].kind;
        if kind == PromptEventKind.Text {
            var ids: [u32: 64] = [];
            var count: usize = 0;
            if !tokenizer_encode_to_ids(tok, &events[event_index].data_ref[0] as &const byte, &ids[0], @len(ids), &count) { return false; }
            var token_index: usize = 0;
            while token_index < count { if !omni_append_token(compiled, ids[token_index]) { return false; } token_index = token_index + 1; }
            compiled.text_event_count = compiled.text_event_count + 1;
            compiled.text_token_count = compiled.text_token_count + count;
        } else if kind == PromptEventKind.Image {
            const token_start: u32 = compiled.token_count as u32;
            if !omni_append_token(compiled, image_token_id) { return false; }
            if !omni_add_span(compiled, kind, token_start, 1) { return false; }
            compiled.image_event_count = compiled.image_event_count + 1;
        } else if kind == PromptEventKind.VideoFrame {
            const token_start: u32 = compiled.token_count as u32;
            if !omni_append_token(compiled, video_token_id) { return false; }
            if !omni_add_span(compiled, kind, token_start, 1) { return false; }
            compiled.video_frame_event_count = compiled.video_frame_event_count + 1;
        } else if kind == PromptEventKind.AudioChunk {
            const token_start: u32 = compiled.token_count as u32;
            if !omni_append_token(compiled, audio_token_id) { return false; }
            if !omni_add_span(compiled, kind, token_start, 1) { return false; }
            compiled.audio_chunk_event_count = compiled.audio_chunk_event_count + 1;
        } else if kind == PromptEventKind.SpeechRequest {
            compiled.speech_request_count = compiled.speech_request_count + 1;
        } else if kind == PromptEventKind.Control {
            compiled.control_count = compiled.control_count + 1;
        } else { return false; }
        event_index = event_index + 1;
    }
    return true;
}

fn omni_checksum(compiled: &CompiledPrompt) u32 {
    var hash: u32 = 2166136261;
    var token_index: usize = 0;
    while token_index < compiled.token_count {
        hash = (hash ^ compiled.token_ids[token_index]) * 16777619;
        hash = (hash ^ compiled.position_ids[token_index]) * 16777619;
        token_index = token_index + 1;
    }
    var span_index: usize = 0;
    while span_index < compiled.span_count {
        hash = (hash ^ (compiled.spans[span_index].token_start + 31)) * 16777619;
        hash = (hash ^ (compiled.spans[span_index].embed_start + 17)) * 16777619;
        hash = (hash ^ (compiled.spans[span_index].embed_count + 7)) * 16777619;
        span_index = span_index + 1;
    }
    return hash;
}

fn omni_attention_label(policy: u32) &const byte {
    if policy == OMNI_ATTENTION_CAUSAL_MEDIA { return "causal+media-spans\0" as &const byte; }
    return "unknown\0" as &const byte;
}

export fn omni_smoke_cli(model_path: &const byte, manifest_path: &const byte) i32 {
    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(model_path, &tok) { return 1; }
    var events: [PromptEvent: 32] = [];
    var event_count: usize = 0;
    if !omni_parse_events(manifest_path, &events[0], &event_count) { return 1; }
    var compiled: CompiledPrompt = compiled_prompt_init();
    if !omni_compile_prompt(&tok, &events[0], event_count, &compiled) { return 1; }
    const checksum: u32 = omni_checksum(&compiled);
    _ = printf("omni manifest: events=%zu text=%zu image=%zu video_frame=%zu audio_chunk=%zu speech_request=%zu control=%zu\n", compiled.event_count, compiled.text_event_count, compiled.image_event_count, compiled.video_frame_event_count, compiled.audio_chunk_event_count, compiled.speech_request_count, compiled.control_count);
    _ = printf("omni event order:");
    var event_index: usize = 0;
    while event_index < event_count { _ = printf(" %s", omni_kind_label(events[event_index].kind)); event_index = event_index + 1; }
    _ = printf("\n");
    _ = printf("omni tokens:");
    var token_index: usize = 0;
    while token_index < compiled.token_count { _ = printf(" %u", compiled.token_ids[token_index]); token_index = token_index + 1; }
    _ = printf("\n");
    _ = printf("omni positions:");
    var pos_index: usize = 0;
    while pos_index < compiled.token_count { _ = printf(" %u", compiled.position_ids[pos_index]); pos_index = pos_index + 1; }
    _ = printf("\n");
    _ = printf("omni spans: count=%zu media_embeddings=%zu\n", compiled.span_count, compiled.media_embedding_count);
    var span_index: usize = 0;
    while span_index < compiled.span_count {
        _ = printf("  span[%zu]: kind=%s token_start=%u token_count=%u embed_start=%u embed_count=%u\n", span_index, omni_kind_label(compiled.spans[span_index].kind), compiled.spans[span_index].token_start, compiled.spans[span_index].token_count, compiled.spans[span_index].embed_start, compiled.spans[span_index].embed_count);
        span_index = span_index + 1;
    }
    _ = printf("omni context: tokens=%zu text_tokens=%zu media_embeddings=%zu effective=%zu attention=%s checksum=0x%x\n", compiled.token_count, compiled.text_token_count, compiled.media_embedding_count, compiled.text_token_count + compiled.media_embedding_count, omni_attention_label(compiled.attention_mask_policy), checksum);
    _ = printf("omni-smoke: PASS\n");
    return 0;
}

const OMNI_CHAT_LINE_CAP: usize = 256;
const OMNI_CHAT_CONTEXT_CAP: usize = 32;

struct OmniChatSession {
    turn_count: usize,
    total_tokens: usize,
    reset_count: usize,
}

fn omni_chat_session_init() OmniChatSession {
    return OmniChatSession{ turn_count: 0, total_tokens: 0, reset_count: 0 };
}

fn omni_trim_line(line: &byte) void {
    var len: usize = 0;
    while line[len] != 0 { len = len + 1; }
    while len > 0 && (line[len - 1] == 10 || line[len - 1] == 13) { line[len - 1] = 0; len = len - 1; }
}

fn omni_starts_with(value: &const byte, prefix: &const byte) bool {
    var index: usize = 0;
    while prefix[index] != 0 {
        if value[index] != prefix[index] { return false; }
        index = index + 1;
    }
    return true;
}

fn omni_chat_compile_text(tok: &Tokenizer, line: &const byte, compiled: &CompiledPrompt) bool {
    var event: [PromptEvent: 1] = [];
    event[0] = prompt_event_init();
    event[0].kind = PromptEventKind.Text;
    if !omni_copy_cstr(&event[0].data_ref[0], @len(event[0].data_ref), line) { _ = printf("error: omni text input exceeds cap=%zu\n", @len(event[0].data_ref)); return false; }
    return omni_compile_prompt(tok, &event[0], 1, compiled);
}

fn omni_chat_compile_manifest(tok: &Tokenizer, manifest_path: &const byte, compiled: &CompiledPrompt) bool {
    var events: [PromptEvent: 32] = [];
    var event_count: usize = 0;
    if !omni_parse_events(manifest_path, &events[0], &event_count) { return false; }
    return omni_compile_prompt(tok, &events[0], event_count, compiled);
}

fn omni_chat_maybe_reset(session: &OmniChatSession, add_tokens: usize) void {
    if session.total_tokens + add_tokens > OMNI_CHAT_CONTEXT_CAP {
        _ = printf("omni-chat cache reset: reason=context total_tokens=%zu add_tokens=%zu cap=%zu\n", session.total_tokens, add_tokens, OMNI_CHAT_CONTEXT_CAP);
        session.total_tokens = 0;
        session.reset_count = session.reset_count + 1;
    }
}

fn omni_chat_print_response(tok: &Tokenizer, compiled: &CompiledPrompt) void {
    var response_id: u32 = 0;
    if compiled.token_count > 0 { response_id = compiled.token_ids[0]; }
    _ = printf("assistant text: %s\n", tokenizer_piece(tok, response_id));
    if compiled.speech_request_count > 0 { _ = printf("speech output: unsupported in blocking omni-chat; queued_requests=%zu text output preserved\n", compiled.speech_request_count); }
}

fn omni_chat_print_turn(session: &OmniChatSession, source: &const byte, compiled: &CompiledPrompt) void {
    _ = printf("turn[%zu]: input=%s events=%zu tokens=%zu spans=%zu media_embeddings=%zu text_tokens=%zu cache_tokens=%zu resets=%zu attention=%s\n", session.turn_count, source, compiled.event_count, compiled.token_count, compiled.span_count, compiled.media_embedding_count, compiled.text_token_count, session.total_tokens, session.reset_count, omni_attention_label(compiled.attention_mask_policy));
}

export fn omni_chat_cli(model_path: &const byte) i32 {
    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(model_path, &tok) { return 1; }
    var session: OmniChatSession = omni_chat_session_init();
    var line: [byte: 256] = [];
    _ = printf("omni-chat: model loaded once\n");
    _ = printf("omni> ");
    while fgets(&line[0], OMNI_CHAT_LINE_CAP, stdin) != null {
        omni_trim_line(&line[0]);
        if line[0] == 0 { _ = printf("omni> "); continue; }
        if omni_cstr_eq(&line[0] as &const byte, "/reset\0" as &const byte) {
            session.total_tokens = 0;
            session.reset_count = session.reset_count + 1;
            _ = printf("omni-chat cache reset: reason=user resets=%zu\n", session.reset_count);
            _ = printf("omni> ");
            continue;
        }
        var compiled: CompiledPrompt = compiled_prompt_init();
        var source: &const byte = "text\0" as &const byte;
        if omni_starts_with(&line[0] as &const byte, "manifest \0" as &const byte) {
            source = "manifest\0" as &const byte;
            if !omni_chat_compile_manifest(&tok, &line[9] as &const byte, &compiled) { return 1; }
        } else {
            if !omni_chat_compile_text(&tok, &line[0] as &const byte, &compiled) { return 1; }
        }
        omni_chat_maybe_reset(&session, compiled.token_count);
        session.total_tokens = session.total_tokens + compiled.token_count;
        omni_chat_print_turn(&session, source, &compiled);
        omni_chat_print_response(&tok, &compiled);
        _ = printf("turn boundary: turn=%zu cache_policy=preserve-until-overflow\n", session.turn_count);
        session.turn_count = session.turn_count + 1;
        _ = printf("omni> ");
    }
    _ = printf("omni-chat: done turns=%zu resets=%zu cache_tokens=%zu\n", session.turn_count, session.reset_count, session.total_tokens);
    return 0;
}

const OMNI_STREAM_QUEUE_CAP: usize = 8;
const OMNI_AUDIO_RING_CAP: usize = 512;
const OMNI_AUDIO_CHUNK_SAMPLES: usize = 128;

struct OmniInputQueue {
    events: [PromptEvent: 8],
    head: usize,
    count: usize,
    dropped: usize,
    high_watermark: usize,
}

struct OmniAudioRingBuffer {
    used: usize,
    peak: usize,
    dropped: usize,
}

struct OmniWorkerState {
    vision_pending: usize,
    vision_encoded: usize,
    audio_pending: usize,
    audio_encoded: usize,
    speech_pending: usize,
    speech_synthesized: usize,
}

struct OmniStreamStats {
    events: usize,
    audio_chunks: usize,
    partial_callbacks: usize,
    cancellations: usize,
    encode_ms: u32,
    decode_ms: u32,
    vocoder_ms: u32,
    backpressure_hits: usize,
}

fn omni_input_queue_init() OmniInputQueue {
    return OmniInputQueue{ events: [], head: 0, count: 0, dropped: 0, high_watermark: 0 };
}

fn omni_audio_ring_init() OmniAudioRingBuffer {
    return OmniAudioRingBuffer{ used: 0, peak: 0, dropped: 0 };
}

fn omni_worker_state_init() OmniWorkerState {
    return OmniWorkerState{ vision_pending: 0, vision_encoded: 0, audio_pending: 0, audio_encoded: 0, speech_pending: 0, speech_synthesized: 0 };
}

fn omni_stream_stats_init() OmniStreamStats {
    return OmniStreamStats{ events: 0, audio_chunks: 0, partial_callbacks: 0, cancellations: 0, encode_ms: 0, decode_ms: 0, vocoder_ms: 0, backpressure_hits: 0 };
}

fn omni_queue_push(queue: &OmniInputQueue, event: &PromptEvent) bool {
    if queue.count >= OMNI_STREAM_QUEUE_CAP {
        queue.head = (queue.head + 1) % OMNI_STREAM_QUEUE_CAP;
        queue.count = queue.count - 1;
        queue.dropped = queue.dropped + 1;
    }
    var tail: usize = queue.head + queue.count;
    if tail >= OMNI_STREAM_QUEUE_CAP { tail = tail - OMNI_STREAM_QUEUE_CAP; }
    queue.events[tail] = event[0];
    queue.count = queue.count + 1;
    if queue.count > queue.high_watermark { queue.high_watermark = queue.count; }
    return true;
}

fn omni_queue_get(queue: &OmniInputQueue, index: usize, event: &PromptEvent) bool {
    if index == 0 { event[0] = queue.events[0]; return true; }
    if index == 1 { event[0] = queue.events[1]; return true; }
    if index == 2 { event[0] = queue.events[2]; return true; }
    if index == 3 { event[0] = queue.events[3]; return true; }
    if index == 4 { event[0] = queue.events[4]; return true; }
    if index == 5 { event[0] = queue.events[5]; return true; }
    if index == 6 { event[0] = queue.events[6]; return true; }
    if index == 7 { event[0] = queue.events[7]; return true; }
    return false;
}

fn omni_queue_pop(queue: &OmniInputQueue, event: &PromptEvent) bool {
    if queue.count == 0 { return false; }
    if queue.head >= OMNI_STREAM_QUEUE_CAP { queue.head = 0; }
    if !omni_queue_get(queue, queue.head, event) { return false; }
    queue.head = queue.head + 1;
    if queue.head >= OMNI_STREAM_QUEUE_CAP { queue.head = 0; }
    queue.count = queue.count - 1;
    return true;
}

fn omni_audio_ring_push(ring: &OmniAudioRingBuffer, samples: usize) bool {
    if samples > OMNI_AUDIO_RING_CAP { ring.dropped = ring.dropped + samples; ring.used = 0; return false; }
    if ring.used + samples > OMNI_AUDIO_RING_CAP {
        const drop_count: usize = (ring.used + samples) - OMNI_AUDIO_RING_CAP;
        ring.dropped = ring.dropped + drop_count;
        ring.used = ring.used - drop_count;
    }
    ring.used = ring.used + samples;
    if ring.used > ring.peak { ring.peak = ring.used; }
    return true;
}

fn omni_audio_ring_consume(ring: &OmniAudioRingBuffer, samples: usize) void {
    if samples >= ring.used { ring.used = 0; } else { ring.used = ring.used - samples; }
}

fn omni_stream_is_interrupt(event: &PromptEvent) bool {
    return event.kind == PromptEventKind.Control && omni_cstr_eq(&event.data_ref[0] as &const byte, "interrupt\0" as &const byte);
}

fn omni_stream_enqueue_events(events: &PromptEvent, event_count: usize, queue: &OmniInputQueue, stats: &OmniStreamStats) void {
    var index: usize = 0;
    while index < event_count {
        const before_dropped: usize = queue.dropped;
        _ = omni_queue_push(queue, &events[index]);
        if queue.dropped > before_dropped { stats.backpressure_hits = stats.backpressure_hits + 1; }
        index = index + 1;
    }
}

fn omni_stream_handle_text(tok: &Tokenizer, event: &PromptEvent, stats: &OmniStreamStats) bool {
    var compiled: CompiledPrompt = compiled_prompt_init();
    if !omni_chat_compile_text(tok, &event.data_ref[0] as &const byte, &compiled) { return false; }
    stats.decode_ms = stats.decode_ms + ((compiled.token_count as u32) * 3 + 1);
    stats.partial_callbacks = stats.partial_callbacks + 1;
    var piece_id: u32 = 0;
    if compiled.token_count > 0 { piece_id = compiled.token_ids[0]; }
    _ = printf("partial output[%zu]: %s\n", stats.partial_callbacks - 1, tokenizer_piece(tok, piece_id));
    return true;
}

fn omni_stream_process_queue(tok: &Tokenizer, queue: &OmniInputQueue, ring: &OmniAudioRingBuffer, workers: &OmniWorkerState, stats: &OmniStreamStats) bool {
    var event: PromptEvent = prompt_event_init();
    var event_index: usize = 0;
    while omni_queue_pop(queue, &event) {
        stats.events = stats.events + 1;
        _ = printf("stream event[%zu]: kind=%s ref=%s\n", event_index, omni_kind_label(event.kind), &event.data_ref[0]);
        if event.kind == PromptEventKind.Text {
            if !omni_stream_handle_text(tok, &event, stats) { return false; }
        } else if event.kind == PromptEventKind.Image || event.kind == PromptEventKind.VideoFrame {
            workers.vision_pending = workers.vision_pending + 1;
            workers.vision_encoded = workers.vision_encoded + 1;
            if workers.vision_pending > 0 { workers.vision_pending = workers.vision_pending - 1; }
            stats.encode_ms = stats.encode_ms + 7;
            _ = printf("vision worker: encoded=%zu pending=%zu encode_ms=%u\n", workers.vision_encoded, workers.vision_pending, stats.encode_ms);
        } else if event.kind == PromptEventKind.AudioChunk {
            stats.audio_chunks = stats.audio_chunks + 1;
            workers.audio_pending = workers.audio_pending + 1;
            _ = omni_audio_ring_push(ring, OMNI_AUDIO_CHUNK_SAMPLES);
            workers.audio_encoded = workers.audio_encoded + 1;
            if workers.audio_pending > 0 { workers.audio_pending = workers.audio_pending - 1; }
            stats.encode_ms = stats.encode_ms + 5;
            _ = printf("audio ring: used=%zu peak=%zu dropped=%zu chunks=%zu\n", ring.used, ring.peak, ring.dropped, stats.audio_chunks);
            _ = printf("audio worker: encoded=%zu pending=%zu encode_ms=%u\n", workers.audio_encoded, workers.audio_pending, stats.encode_ms);
            omni_audio_ring_consume(ring, 64);
        } else if event.kind == PromptEventKind.SpeechRequest {
            workers.speech_pending = workers.speech_pending + 1;
            stats.vocoder_ms = stats.vocoder_ms + 4;
            _ = printf("speech queue: pending=%zu synthesized=%zu vocoder_ms=%u\n", workers.speech_pending, workers.speech_synthesized, stats.vocoder_ms);
        } else if omni_stream_is_interrupt(&event) {
            const cleared: usize = workers.speech_pending;
            workers.speech_pending = 0;
            stats.cancellations = stats.cancellations + 1;
            _ = printf("control interrupt: cleared_pending_speech=%zu cancellations=%zu\n", cleared, stats.cancellations);
        } else if event.kind == PromptEventKind.Control {
            _ = printf("control event: name=%s\n", &event.data_ref[0]);
        }
        event_index = event_index + 1;
    }
    return true;
}

export fn stream_chat_cli(model_path: &const byte, manifest_path: &const byte) i32 {
    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(model_path, &tok) { return 1; }
    var events: [PromptEvent: 32] = [];
    var event_count: usize = 0;
    if !omni_parse_events(manifest_path, &events[0], &event_count) { return 1; }
    var queue: OmniInputQueue = omni_input_queue_init();
    var ring: OmniAudioRingBuffer = omni_audio_ring_init();
    var workers: OmniWorkerState = omni_worker_state_init();
    var stats: OmniStreamStats = omni_stream_stats_init();
    _ = printf("stream-chat: model loaded once scheduler=blocking-prototype\n");
    omni_stream_enqueue_events(&events[0], event_count, &queue, &stats);
    _ = printf("stream queue: enqueued=%zu high_watermark=%zu dropped=%zu backpressure=drop-oldest hits=%zu\n", event_count, queue.high_watermark, queue.dropped, stats.backpressure_hits);
    if !omni_stream_process_queue(&tok, &queue, &ring, &workers, &stats) { return 1; }
    _ = printf("stream summary: events=%zu audio_chunks=%zu partial_callbacks=%zu vision_encoded=%zu audio_encoded=%zu pending_speech=%zu cancellations=%zu encode_ms=%u decode_ms=%u vocoder_ms=%u ring_peak=%zu dropped_audio=%zu\n", stats.events, stats.audio_chunks, stats.partial_callbacks, workers.vision_encoded, workers.audio_encoded, workers.speech_pending, stats.cancellations, stats.encode_ms, stats.decode_ms, stats.vocoder_ms, ring.peak, ring.dropped);
    _ = printf("stream-chat: PASS\n");
    return 0;
}

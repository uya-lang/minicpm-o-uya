}

struct AudioRealFilterBank {
    mel_bins: u32,
    filter_bins: u32,
    value_count: u64,
    values: &f32,
}

struct AudioRealEncoderSession {
    config: AudioConfig,
    table: TensorWeightTable,
    filters: AudioRealFilterBank,
    cos_table: &f32,
    sin_table: &f32,
    ready: bool,
}

struct AudioRealEncodedSpan {
    values: &f32,
    sample_count: u64,
    mel_frames: u64,
    conv_tokens: usize,
    span_count: usize,
    hidden_size: usize,
    checksum: u32,
    encode_us: u64,
}

struct AudioStreamingCache {
    samples: [f32: 4096],
    sample_count: usize,
    consumed_start: usize,
    produced_frames: usize,
    peak_sample_count: usize,
}

struct AudioStringRead {
    len: u64,
    copied: usize,
    truncated: bool,
}

export fn audio_config_init() AudioConfig {
    return AudioConfig{ frame_count: 0, mel_bin_count: 0, hidden_size: 0, layer_count: 0, head_count: 0, head_dim: 0, intermediate_size: 0, llm_hidden_size: 0, filter_bin_count: 0, filter_value_count: 0, audio_token_id: 0, has_audio_token_id: false, has_filters: false };
}

export fn audio_weights_init() AudioWeights {
    return AudioWeights{ conv_weight: null, conv_bias: null, position_embd: null, output_norm: null, projector: null, layers: [], layer_count: 0 };
}

fn audio_cstr_eq(a: &const byte, b: &const byte) bool {
    return strcmp(a as *const byte, b as *const byte) == 0;
}

fn audio_scalar_metadata_size(value_type: u32) u64 {
    if value_type == 0 || value_type == 1 || value_type == 7 { return 1; }
    if value_type == 2 || value_type == 3 { return 2; }
    if value_type == AUDIO_GGUF_TYPE_UINT32 || value_type == AUDIO_GGUF_TYPE_INT32 || value_type == AUDIO_GGUF_TYPE_FLOAT32 { return 4; }
    if value_type == AUDIO_GGUF_TYPE_UINT64 || value_type == AUDIO_GGUF_TYPE_INT64 || value_type == AUDIO_GGUF_TYPE_FLOAT64 { return 8; }
    return 0;
}

fn audio_read_string(reader: &BinaryReader, dest: &byte, dest_cap: usize, info: &AudioStringRead, context: &const byte) bool {
    info.len = 0;
    info.copied = 0;
    info.truncated = false;
    if !binary_read_u64_le(reader, &info.len, context) { return false; }
    if dest_cap == 0 { return binary_skip(reader, info.len, context); }
    var copy_len: usize = 0;
    if info.len > 0 {
        if info.len >= dest_cap as u64 { copy_len = dest_cap - 1; info.truncated = true; } else { copy_len = info.len as usize; }
        if copy_len > 0 {
            if !binary_read_exact(reader, dest, copy_len, context) { return false; }
        }
    }
    dest[copy_len] = 0;
    info.copied = copy_len;
    if info.len > copy_len as u64 { return binary_skip(reader, info.len - (copy_len as u64), context); }
    return true;
}

fn audio_skip_array(reader: &BinaryReader, element_type: u32, count: u64) bool {
    const elem_size: u64 = audio_scalar_metadata_size(element_type);
    if elem_size > 0 { return binary_skip(reader, elem_size * count, "metadata scalar array\0" as &const byte); }
    if element_type == AUDIO_GGUF_TYPE_STRING {
        var tmp: [byte: 1] = [];
        var info: AudioStringRead = AudioStringRead{ len: 0, copied: 0, truncated: false };
        var array_index: u64 = 0;
        while array_index < count {
            if !audio_read_string(reader, &tmp[0], 1, &info, "metadata string array element\0" as &const byte) { return false; }
            array_index = array_index + 1;
        }
        return true;
    }
    return false;
}

fn audio_apply_u32_metadata(config: &AudioConfig, key: &const byte, value: u32) void {
    if audio_cstr_eq(key, "audio.frame_count\0" as &const byte) { config.frame_count = value; return; }
    if audio_cstr_eq(key, "audio.log_mel.frame_count\0" as &const byte) { config.frame_count = value; return; }
    if audio_cstr_eq(key, "audio.mel_bin_count\0" as &const byte) { config.mel_bin_count = value; return; }
    if audio_cstr_eq(key, "audio.log_mel.bin_count\0" as &const byte) { config.mel_bin_count = value; return; }
    if audio_cstr_eq(key, "audio.embedding_length\0" as &const byte) { config.hidden_size = value; return; }
    if audio_cstr_eq(key, "audio.block_count\0" as &const byte) { config.layer_count = value; return; }
    if audio_cstr_eq(key, "audio.whisper.block_count\0" as &const byte) { config.layer_count = value; return; }
    if audio_cstr_eq(key, "audio.attention.head_count\0" as &const byte) { config.head_count = value; return; }
    if audio_cstr_eq(key, "audio.feed_forward_length\0" as &const byte) { config.intermediate_size = value; return; }
    if audio_cstr_eq(key, "audio.projector.output_length\0" as &const byte) { config.llm_hidden_size = value; return; }
    if audio_cstr_eq(key, "encoder_attention_heads\0" as &const byte) { config.head_count = value; return; }
    if audio_cstr_eq(key, "encoder_ffn_dim\0" as &const byte) { config.intermediate_size = value; return; }
    if audio_cstr_eq(key, "encoder_layers\0" as &const byte) { config.layer_count = value; return; }
    if audio_cstr_eq(key, "num_hidden_layers\0" as &const byte) && config.layer_count == 0 { config.layer_count = value; return; }
    if audio_cstr_eq(key, "d_model\0" as &const byte) { config.hidden_size = value; return; }
    if audio_cstr_eq(key, "n_mel\0" as &const byte) { config.mel_bin_count = value; return; }
    if audio_cstr_eq(key, "n_fft\0" as &const byte) { config.filter_bin_count = value; return; }
    if audio_cstr_eq(key, "minicpmo.media.audio_token_id\0" as &const byte) { config.audio_token_id = value; config.has_audio_token_id = true; return; }
}

fn audio_skip_metadata_value(reader: &BinaryReader, config: &AudioConfig, key: &const byte, value_type: u32) bool {
    if value_type == AUDIO_GGUF_TYPE_STRING {
        var tmp: [byte: 1] = [];
        var info: AudioStringRead = AudioStringRead{ len: 0, copied: 0, truncated: false };
        return audio_read_string(reader, &tmp[0], 1, &info, "metadata string value\0" as &const byte);
    }
    if value_type == AUDIO_GGUF_TYPE_ARRAY {
        var element_type: u32 = 0;
        var count: u64 = 0;
        if !binary_read_u32_le(reader, &element_type, "metadata array type\0" as &const byte) { return false; }
        if !binary_read_u64_le(reader, &count, "metadata array length\0" as &const byte) { return false; }
        if audio_cstr_eq(key, "filters\0" as &const byte) {
            if element_type != AUDIO_GGUF_TYPE_FLOAT32 { _ = printf("error: audio config filters metadata has element_type=%u expected=float32\n", element_type); return false; }
            config.has_filters = true;
            config.filter_value_count = count;
        }
        return audio_skip_array(reader, element_type, count);
    }
    if value_type == AUDIO_GGUF_TYPE_UINT32 || value_type == AUDIO_GGUF_TYPE_INT32 {
        var value: u32 = 0;
        if !binary_read_u32_le(reader, &value, "metadata int/uint32 value\0" as &const byte) { return false; }
        audio_apply_u32_metadata(config, key, value);
        return true;
    }
    const elem_size: u64 = audio_scalar_metadata_size(value_type);
    if elem_size > 0 { return binary_skip(reader, elem_size, "metadata scalar value\0" as &const byte); }
    _ = printf("error: audio config unsupported metadata type=%u key=%s\n", value_type, key);
    return false;
}

export fn audio_config_load_metadata(path: &const byte, config: &AudioConfig) bool {
    config[0] = audio_config_init();
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    var version: u32 = 0;
    var tensor_count: u64 = 0;
    var metadata_count: u64 = 0;
    if !binary_read_u32_le(&reader, &magic, "GGUF magic\0" as &const byte) { binary_close(&reader); return false; }
    if magic != AUDIO_GGUF_MAGIC { _ = printf("error: audio config bad GGUF magic\n"); binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &version, "GGUF version\0" as &const byte) { binary_close(&reader); return false; }
    if version != 2 && version != 3 { _ = printf("error: audio config unsupported GGUF version=%u\n", version); binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &tensor_count, "GGUF tensor_count\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &metadata_count, "GGUF metadata_count\0" as &const byte) { binary_close(&reader); return false; }
    var metadata_index: u64 = 0;
    while metadata_index < metadata_count {
        var key: [byte: 128] = [];
        var info: AudioStringRead = AudioStringRead{ len: 0, copied: 0, truncated: false };
        if !audio_read_string(&reader, &key[0], @len(key), &info, "metadata key\0" as &const byte) { binary_close(&reader); return false; }
        if info.truncated { _ = printf("error: audio config metadata key too long\n"); binary_close(&reader); return false; }
        var value_type: u32 = 0;
        if !binary_read_u32_le(&reader, &value_type, "metadata value type\0" as &const byte) { binary_close(&reader); return false; }
        if !audio_skip_metadata_value(&reader, config, &key[0] as &const byte, value_type) { binary_close(&reader); return false; }
        metadata_index = metadata_index + 1;
    }
    binary_close(&reader);
    return true;
}

fn audio_raw_init() AudioRawMel {
    return AudioRawMel{ frame_count: 0, mel_bin_count: 0, values: [], element_count: 0 };
}

fn audio_pcm_init() AudioRawPcm {
    return AudioRawPcm{ sample_rate: 0, channels: 0, sample_count: 0, values: [] };
}

fn audio_preprocess_config_init() AudioPreprocessConfig {
    return AudioPreprocessConfig{ target_sample_rate: 16000, n_fft: 8, hop_length: 4, win_length: 8, mel_bin_count: 4, log_floor: 0.00000001 };
}

fn audio_real_input_info_init() AudioRealInputInfo {
    return AudioRealInputInfo{ sample_rate: 0, channels: 0, sample_count: 0, container_kind: 0, dtype_kind: 0 };
}

fn audio_real_pcm_heap_init() AudioRealPcmHeap {
    return AudioRealPcmHeap{ sample_count: 0, values: null };
}

fn audio_real_filter_bank_init() AudioRealFilterBank {
    return AudioRealFilterBank{ mel_bins: 0, filter_bins: 0, value_count: 0, values: null };
}

fn audio_real_encoder_session_init() AudioRealEncoderSession {
    return AudioRealEncoderSession{
        config: audio_config_init(),
        table: tensor_table_init(),
        filters: audio_real_filter_bank_init(),
        cos_table: null,
        sin_table: null,
        ready: false,
    };
}

fn audio_real_encoded_span_init() AudioRealEncodedSpan {
    return AudioRealEncodedSpan{ values: null, sample_count: 0, mel_frames: 0, conv_tokens: 0, span_count: 0, hidden_size: 0, checksum: 0, encode_us: 0 };
}

fn audio_real_encoded_span_free(span: &AudioRealEncodedSpan) void {
    if span.values != null { free(span.values as &void); }
    span[0] = audio_real_encoded_span_init();
}

fn audio_real_pcm_heap_free(pcm: &AudioRealPcmHeap) void {
    if pcm.values != null { free(pcm.values as &void); }
    pcm.values = null;
    pcm.sample_count = 0;
}

fn audio_real_filter_bank_free(filters: &AudioRealFilterBank) void {
    if filters.values != null { free(filters.values as &void); }
    filters.values = null;
    filters.value_count = 0;
    filters.mel_bins = 0;
    filters.filter_bins = 0;
}

fn audio_real_encoder_session_free(session: &AudioRealEncoderSession) void {
    if session.cos_table != null { free(session.cos_table as &void); }
    if session.sin_table != null { free(session.sin_table as &void); }
    session.cos_table = null;
    session.sin_table = null;
    audio_real_filter_bank_free(&session.filters);
    tensor_weight_table_detach_mmap(&session.table);
    session[0] = audio_real_encoder_session_init();
}

fn audio_streaming_cache_init() AudioStreamingCache {
    return AudioStreamingCache{ samples: [], sample_count: 0, consumed_start: 0, produced_frames: 0, peak_sample_count: 0 };
}

fn audio_read_f32(reader: &BinaryReader, out: &f32) bool {
    var bits: u32 = 0;
    if !binary_read_u32_le(reader, &bits, "audio raw f32\0" as &const byte) { return false; }
    const ptr: &const f32 = &bits as &const f32;
    *out = ptr[0];
    return true;
}

fn audio_raw_load(path: &const byte, raw: &AudioRawMel) bool {
    raw[0] = audio_raw_init();
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    var version: u32 = 0;
    var dtype: u32 = 0;
    if !binary_read_u32_le(&reader, &magic, "audio raw magic\0" as &const byte) { binary_close(&reader); return false; }
    if magic != AUDIO_RAW_MAGIC { _ = printf("error: audio raw bad magic; expected UYAM\n"); binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &version, "audio raw version\0" as &const byte) { binary_close(&reader); return false; }
    if version != AUDIO_RAW_VERSION { _ = printf("error: audio raw unsupported version=%u\n", version); binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &raw.frame_count, "audio raw frame count\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &raw.mel_bin_count, "audio raw mel bins\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &dtype, "audio raw dtype\0" as &const byte) { binary_close(&reader); return false; }
    if dtype != AUDIO_RAW_DTYPE_F32 { _ = printf("error: audio raw dtype=%u unsupported; only f32 log-mel is supported\n", dtype); binary_close(&reader); return false; }
    const element_count_u64: u64 = (raw.frame_count as u64) * (raw.mel_bin_count as u64);
    if raw.frame_count == 0 || raw.mel_bin_count == 0 || element_count_u64 > AUDIO_MAX_VALUES as u64 { _ = printf("error: audio raw shape=%ux%u exceeds cap=%zu\n", raw.frame_count, raw.mel_bin_count, AUDIO_MAX_VALUES); binary_close(&reader); return false; }
    raw.element_count = element_count_u64 as usize;
    var value_index: usize = 0;
    while value_index < raw.element_count {
        if !audio_read_f32(&reader, &raw.values[value_index]) { binary_close(&reader); return false; }
        value_index = value_index + 1;
    }
    if reader.pos != reader.size { _ = printf("error: audio raw has trailing bytes=%llu\n", reader.size - reader.pos); binary_close(&reader); return false; }
    binary_close(&reader);
    return true;
}


fn audio_probe_update(checksum: &u32, peak: &f32, sum_sq: &f32, value: f32) void {
    var abs_value: f32 = value;
    if abs_value < 0.0 { abs_value = 0.0 - abs_value; }
    if abs_value > peak[0] { peak[0] = abs_value; }
    sum_sq[0] = sum_sq[0] + value * value;
    const bits: &const u32 = &value as &const u32;
    checksum[0] = (checksum[0] ^ bits[0]) * 16777619;
}

fn audio_probe_print(role: &const byte, path: &const byte, container: &const byte, dtype: &const byte, sample_rate: u32, channels: u32, sample_count: u64, checksum: u32, peak: f32, rms: f32) void {
    const duration_ms: u64 = sample_count * (1000 as u64) / (sample_rate as u64);
    _ = printf("audio input[%s]: path=%s container=%s dtype=%s sample_rate=%u channels=%u samples=%llu duration_ms=%llu checksum=0x%x peak=%.6f rms=%.6f\n", role, path, container, dtype, sample_rate, channels, sample_count, duration_ms, checksum, peak as f64, rms as f64);
}

fn audio_probe_require_real(role: &const byte, sample_rate: u32, channels: u32) bool {
    if sample_rate != AUDIO_REAL_SAMPLE_RATE {
        _ = printf("error: audio input[%s] unsupported sample_rate=%u expected=16000; transcode explicitly before running Uya\n", role, sample_rate);
        return false;
    }
    if channels != AUDIO_REAL_CHANNELS as u32 {
        _ = printf("error: audio input[%s] unsupported channels=%u expected=mono; downmix explicitly before running Uya\n", role, channels);
        return false;
    }
    return true;
}

fn audio_probe_uyap(path: &const byte, role: &const byte, reader: &BinaryReader) bool {
    var version: u32 = 0;
    var sample_rate: u32 = 0;
    var channels: u32 = 0;
    var sample_count32: u32 = 0;
    var dtype: u32 = 0;
    if !binary_read_u32_le(reader, &version, "audio probe UYAP version\0" as &const byte) { return false; }
    if version != AUDIO_RAW_VERSION { _ = printf("error: audio input[%s] UYAP unsupported version=%u\n", role, version); return false; }
    if !binary_read_u32_le(reader, &sample_rate, "audio probe UYAP sample rate\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &channels, "audio probe UYAP channels\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &sample_count32, "audio probe UYAP sample count\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &dtype, "audio probe UYAP dtype\0" as &const byte) { return false; }
    if !audio_probe_require_real(role, sample_rate, channels) { return false; }
    const total: u64 = (sample_count32 as u64) * (channels as u64);
    var checksum: u32 = 2166136261;
    var peak: f32 = 0.0;
    var sum_sq: f32 = 0.0;
    var index: u64 = 0;
    if dtype == AUDIO_PCM_DTYPE_F32 {
        while index < total {
            var value: f32 = 0.0;
            if !audio_read_f32(reader, &value) { return false; }
            audio_probe_update(&checksum, &peak, &sum_sq, value);
            index = index + 1;
        }
        if reader.pos != reader.size { _ = printf("error: audio input[%s] UYAP has trailing bytes=%llu\n", role, reader.size - reader.pos); return false; }
        var rms: f32 = 0.0; if total > 0 { rms = sqrtf(sum_sq / (total as f32)); }
        audio_probe_print(role, path, "uyap\0" as &const byte, "f32\0" as &const byte, sample_rate, channels, sample_count32 as u64, checksum, peak, rms);
        return true;
    }
    if dtype == AUDIO_PCM_DTYPE_S16 {
        while index < total {
            var bits: u32 = 0;
            if !binary_read_u32_le(reader, &bits, "audio probe UYAP s16-as-i32\0" as &const byte) { return false; }
            var signed: i32 = bits as i32;
            const value: f32 = (signed as f32) / 32768.0;
            audio_probe_update(&checksum, &peak, &sum_sq, value);
            index = index + 1;
        }
        if reader.pos != reader.size { _ = printf("error: audio input[%s] UYAP has trailing bytes=%llu\n", role, reader.size - reader.pos); return false; }
        var rms: f32 = 0.0; if total > 0 { rms = sqrtf(sum_sq / (total as f32)); }
        audio_probe_print(role, path, "uyap\0" as &const byte, "s16-i32-container\0" as &const byte, sample_rate, channels, sample_count32 as u64, checksum, peak, rms);
        return true;
    }
    _ = printf("error: audio input[%s] UYAP dtype=%u unsupported\n", role, dtype);
    return false;
}

fn audio_probe_wav_samples(path: &const byte, role: &const byte, reader: &BinaryReader, data_pos: u64, data_size: u32, format_tag: u16, sample_rate: u32, channels: u16, bits_per_sample: u16) bool {
    if !audio_probe_require_real(role, sample_rate, channels as u32) { return false; }
    var bytes_per_sample: u32 = 0;
    var dtype: &const byte = "unknown\0" as &const byte;
    if format_tag == AUDIO_WAV_FORMAT_PCM && bits_per_sample == 16 { bytes_per_sample = 2; dtype = "s16\0" as &const byte; }
    else { if format_tag == AUDIO_WAV_FORMAT_FLOAT && bits_per_sample == 32 { bytes_per_sample = 4; dtype = "f32\0" as &const byte; }
    else { _ = printf("error: audio input[%s] WAV unsupported format_tag=%u bits_per_sample=%u; expected PCM16 or IEEE_FLOAT32\n", role, format_tag as u32, bits_per_sample as u32); return false; } }
    const frame_bytes: u32 = (channels as u32) * bytes_per_sample;
    if frame_bytes == 0 || data_size % frame_bytes != 0 { _ = printf("error: audio input[%s] WAV data bytes=%u not aligned to frame_bytes=%u\n", role, data_size, frame_bytes); return false; }
    const sample_count: u64 = (data_size / frame_bytes) as u64;
    if sample_count == 0 { _ = printf("error: audio input[%s] WAV has no samples\n", role); return false; }
    if !binary_seek(reader, data_pos, "audio WAV data seek\0" as &const byte) { return false; }
    var checksum: u32 = 2166136261;
    var peak: f32 = 0.0;
    var sum_sq: f32 = 0.0;
    var index: u64 = 0;
    const total: u64 = sample_count * (channels as u64);
    while index < total {
        var value: f32 = 0.0;
        if format_tag == AUDIO_WAV_FORMAT_PCM {
            var raw: u16 = 0;
            if !binary_read_u16_le(reader, &raw, "audio WAV s16 sample\0" as &const byte) { return false; }
            var signed: i32 = raw as i32;
            if raw >= (32768 as u16) { signed = signed - 65536; }
            value = (signed as f32) / 32768.0;
        } else {
            if !audio_read_f32(reader, &value) { return false; }
        }
        audio_probe_update(&checksum, &peak, &sum_sq, value);
        index = index + 1;
    }
    var rms: f32 = 0.0; if total > 0 { rms = sqrtf(sum_sq / (total as f32)); }
    audio_probe_print(role, path, "wav\0" as &const byte, dtype, sample_rate, channels as u32, sample_count, checksum, peak, rms);
    return true;
}

fn audio_probe_wav(path: &const byte, role: &const byte, reader: &BinaryReader) bool {
    var riff_size: u32 = 0;
    var wave: u32 = 0;
    if !binary_read_u32_le(reader, &riff_size, "audio WAV RIFF size\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &wave, "audio WAV WAVE magic\0" as &const byte) { return false; }
    if wave != AUDIO_WAV_WAVE { _ = printf("error: audio input[%s] bad WAV magic\n", role); return false; }
    var format_tag: u16 = 0;
    var channels: u16 = 0;
    var sample_rate: u32 = 0;
    var bits_per_sample: u16 = 0;
    var data_pos: u64 = 0;
    var data_size: u32 = 0;
    var have_fmt: bool = false;
    var have_data: bool = false;
    while reader.pos + (8 as u64) <= reader.size {
        var chunk_id: u32 = 0;
        var chunk_size: u32 = 0;
        if !binary_read_u32_le(reader, &chunk_id, "audio WAV chunk id\0" as &const byte) { return false; }
        if !binary_read_u32_le(reader, &chunk_size, "audio WAV chunk size\0" as &const byte) { return false; }
        const payload_pos: u64 = reader.pos;
        var padded: u64 = chunk_size as u64;
        if padded % (2 as u64) != 0 { padded = padded + 1; }
        if payload_pos + padded > reader.size { _ = printf("error: audio input[%s] WAV chunk extends past EOF\n", role); return false; }
        if chunk_id == AUDIO_WAV_FMT {
            if chunk_size < 16 { _ = printf("error: audio input[%s] WAV fmt chunk too small=%u\n", role, chunk_size); return false; }
            var byte_rate: u32 = 0; var block_align: u16 = 0;
            if !binary_read_u16_le(reader, &format_tag, "audio WAV format tag\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &channels, "audio WAV channels\0" as &const byte) { return false; }
            if !binary_read_u32_le(reader, &sample_rate, "audio WAV sample rate\0" as &const byte) { return false; }
            if !binary_read_u32_le(reader, &byte_rate, "audio WAV byte rate\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &block_align, "audio WAV block align\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &bits_per_sample, "audio WAV bits per sample\0" as &const byte) { return false; }
            have_fmt = true;
        } else {
            if chunk_id == AUDIO_WAV_DATA {
                data_pos = payload_pos;
                data_size = chunk_size;
                have_data = true;
            }
        }
        if !binary_seek(reader, payload_pos + padded, "audio WAV next chunk\0" as &const byte) { return false; }
        if have_fmt && have_data { break; }
    }
    _ = riff_size;
    if !have_fmt { _ = printf("error: audio input[%s] WAV missing fmt chunk\n", role); return false; }
    if !have_data { _ = printf("error: audio input[%s] WAV missing data chunk\n", role); return false; }
    return audio_probe_wav_samples(path, role, reader, data_pos, data_size, format_tag, sample_rate, channels, bits_per_sample);
}

export fn audio_input_probe_file(path: &const byte, role: &const byte) bool {
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    if !binary_read_u32_le(&reader, &magic, "audio input magic\0" as &const byte) { binary_close(&reader); return false; }
    var ok: bool = false;
    if magic == AUDIO_WAV_RIFF { ok = audio_probe_wav(path, role, &reader); }
    else { if magic == AUDIO_PCM_MAGIC { ok = audio_probe_uyap(path, role, &reader); }
    else { _ = printf("error: audio input[%s] unsupported container magic=0x%x; expected RIFF/WAVE or UYAP\n", role, magic); ok = false; } }
    binary_close(&reader);
    return ok;
}

export fn audio_input_probe_cli(audio_path: &const byte) i32 {
    if !audio_input_probe_file(audio_path, "probe\0" as &const byte) { return 1; }
    _ = printf("audio-input-probe: PASS\n");
    return 0;
}


fn audio_real_container_label(kind: u32) &const byte {
    if kind == AUDIO_INFO_CONTAINER_WAV { return "wav\0" as &const byte; }
    if kind == AUDIO_INFO_CONTAINER_UYAP { return "uyap\0" as &const byte; }
    return "unknown\0" as &const byte;
}

fn audio_real_dtype_label(kind: u32) &const byte {
    if kind == AUDIO_INFO_DTYPE_S16 { return "s16\0" as &const byte; }
    if kind == AUDIO_INFO_DTYPE_F32 { return "f32\0" as &const byte; }
    return "unknown\0" as &const byte;
}

fn audio_real_info_uyap(role: &const byte, reader: &BinaryReader, info: &AudioRealInputInfo) bool {
    var version: u32 = 0;
    var sample_rate: u32 = 0;
    var channels: u32 = 0;
    var sample_count32: u32 = 0;
    var dtype: u32 = 0;
    if !binary_read_u32_le(reader, &version, "audio real UYAP version\0" as &const byte) { return false; }
    if version != AUDIO_RAW_VERSION { _ = printf("error: audio-real-preprocess[%s] UYAP unsupported version=%u\n", role, version); return false; }
    if !binary_read_u32_le(reader, &sample_rate, "audio real UYAP sample rate\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &channels, "audio real UYAP channels\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &sample_count32, "audio real UYAP sample count\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &dtype, "audio real UYAP dtype\0" as &const byte) { return false; }
    if !audio_probe_require_real(role, sample_rate, channels) { return false; }
    var dtype_kind: u32 = 0;
    var bytes_per_sample: u64 = 0;
    if dtype == AUDIO_PCM_DTYPE_F32 { dtype_kind = AUDIO_INFO_DTYPE_F32; bytes_per_sample = 4; }
    else { if dtype == AUDIO_PCM_DTYPE_S16 { dtype_kind = AUDIO_INFO_DTYPE_S16; bytes_per_sample = 4; }
    else { _ = printf("error: audio-real-preprocess[%s] UYAP dtype=%u unsupported\n", role, dtype); return false; } }
    const total_samples: u64 = (sample_count32 as u64) * (channels as u64);
    if !binary_skip(reader, total_samples * bytes_per_sample, "audio real UYAP samples\0" as &const byte) { return false; }
    if reader.pos != reader.size { _ = printf("error: audio-real-preprocess[%s] UYAP has trailing bytes=%llu\n", role, reader.size - reader.pos); return false; }
    info[0] = AudioRealInputInfo{ sample_rate: sample_rate, channels: channels, sample_count: sample_count32 as u64, container_kind: AUDIO_INFO_CONTAINER_UYAP, dtype_kind: dtype_kind };
    return true;
}

fn audio_real_info_wav(role: &const byte, reader: &BinaryReader, info: &AudioRealInputInfo) bool {
    var riff_size: u32 = 0;
    var wave: u32 = 0;
    if !binary_read_u32_le(reader, &riff_size, "audio real WAV RIFF size\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &wave, "audio real WAV WAVE magic\0" as &const byte) { return false; }
    if wave != AUDIO_WAV_WAVE { _ = printf("error: audio-real-preprocess[%s] bad WAV magic\n", role); return false; }
    var format_tag: u16 = 0;
    var channels: u16 = 0;
    var sample_rate: u32 = 0;
    var bits_per_sample: u16 = 0;
    var data_size: u32 = 0;
    var have_fmt: bool = false;
    var have_data: bool = false;
    while reader.pos + (8 as u64) <= reader.size {
        var chunk_id: u32 = 0;
        var chunk_size: u32 = 0;
        if !binary_read_u32_le(reader, &chunk_id, "audio real WAV chunk id\0" as &const byte) { return false; }
        if !binary_read_u32_le(reader, &chunk_size, "audio real WAV chunk size\0" as &const byte) { return false; }
        const payload_pos: u64 = reader.pos;
        var padded: u64 = chunk_size as u64;
        if padded % (2 as u64) != 0 { padded = padded + 1; }
        if payload_pos + padded > reader.size { _ = printf("error: audio-real-preprocess[%s] WAV chunk extends past EOF\n", role); return false; }
        if chunk_id == AUDIO_WAV_FMT {
            if chunk_size < 16 { _ = printf("error: audio-real-preprocess[%s] WAV fmt chunk too small=%u\n", role, chunk_size); return false; }
            var byte_rate: u32 = 0; var block_align: u16 = 0;
            if !binary_read_u16_le(reader, &format_tag, "audio real WAV format tag\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &channels, "audio real WAV channels\0" as &const byte) { return false; }
            if !binary_read_u32_le(reader, &sample_rate, "audio real WAV sample rate\0" as &const byte) { return false; }
            if !binary_read_u32_le(reader, &byte_rate, "audio real WAV byte rate\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &block_align, "audio real WAV block align\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &bits_per_sample, "audio real WAV bits per sample\0" as &const byte) { return false; }
            have_fmt = true;
        } else { if chunk_id == AUDIO_WAV_DATA { data_size = chunk_size; have_data = true; } }
        if !binary_seek(reader, payload_pos + padded, "audio real WAV next chunk\0" as &const byte) { return false; }
        if have_fmt && have_data { break; }
    }
    _ = riff_size;
    if !have_fmt { _ = printf("error: audio-real-preprocess[%s] WAV missing fmt chunk\n", role); return false; }
    if !have_data { _ = printf("error: audio-real-preprocess[%s] WAV missing data chunk\n", role); return false; }
    if !audio_probe_require_real(role, sample_rate, channels as u32) { return false; }
    var bytes_per_sample: u32 = 0;
    var dtype_kind: u32 = 0;
    if format_tag == AUDIO_WAV_FORMAT_PCM && bits_per_sample == 16 { bytes_per_sample = 2; dtype_kind = AUDIO_INFO_DTYPE_S16; }
    else { if format_tag == AUDIO_WAV_FORMAT_FLOAT && bits_per_sample == 32 { bytes_per_sample = 4; dtype_kind = AUDIO_INFO_DTYPE_F32; }
    else { _ = printf("error: audio-real-preprocess[%s] WAV unsupported format_tag=%u bits_per_sample=%u; expected PCM16 or IEEE_FLOAT32\n", role, format_tag as u32, bits_per_sample as u32); return false; } }
    const frame_bytes: u32 = (channels as u32) * bytes_per_sample;
    if frame_bytes == 0 || data_size % frame_bytes != 0 { _ = printf("error: audio-real-preprocess[%s] WAV data bytes=%u not aligned to frame_bytes=%u\n", role, data_size, frame_bytes); return false; }
    const sample_count: u64 = (data_size / frame_bytes) as u64;
    if sample_count == 0 { _ = printf("error: audio-real-preprocess[%s] WAV has no samples\n", role); return false; }
    info[0] = AudioRealInputInfo{ sample_rate: sample_rate, channels: channels as u32, sample_count: sample_count, container_kind: AUDIO_INFO_CONTAINER_WAV, dtype_kind: dtype_kind };
    return true;
}

fn audio_real_input_info_file(path: &const byte, role: &const byte, info: &AudioRealInputInfo) bool {
    info[0] = audio_real_input_info_init();
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    if !binary_read_u32_le(&reader, &magic, "audio real input magic\0" as &const byte) { binary_close(&reader); return false; }
    var ok: bool = false;
    if magic == AUDIO_WAV_RIFF { ok = audio_real_info_wav(role, &reader, info); }
    else { if magic == AUDIO_PCM_MAGIC { ok = audio_real_info_uyap(role, &reader, info); }
    else { _ = printf("error: audio-real-preprocess[%s] unsupported container magic=0x%x; expected RIFF/WAVE or UYAP\n", role, magic); ok = false; } }
    binary_close(&reader);
    return ok;
}

export fn audio_real_preprocess_probe_file(path: &const byte, role: &const byte) bool {
    var info: AudioRealInputInfo = audio_real_input_info_init();
    if !audio_real_input_info_file(path, role, &info) { return false; }
    const duration_ms: u64 = info.sample_count * (1000 as u64) / (AUDIO_REAL_SAMPLE_RATE as u64);
    var aligned_samples: u64 = info.sample_count;
    if aligned_samples < (AUDIO_REAL_ALIGN_SAMPLES as u64) { aligned_samples = AUDIO_REAL_ALIGN_SAMPLES as u64; }
    else { if aligned_samples % (AUDIO_REAL_ALIGN_SAMPLES as u64) != 0 { aligned_samples = ((aligned_samples / (AUDIO_REAL_ALIGN_SAMPLES as u64)) + 1) * (AUDIO_REAL_ALIGN_SAMPLES as u64); } }
    const input_pad_samples: u64 = aligned_samples - info.sample_count;
    const center_pad_samples: u64 = (AUDIO_REAL_CENTER_PAD as u64) * (2 as u64);
    const padded_samples: u64 = aligned_samples + center_pad_samples;
    const mel_frames: u64 = (padded_samples - (AUDIO_REAL_FRAME_SIZE as u64)) / (AUDIO_REAL_HOP_LENGTH as u64);
    var mel_frames_org: u64 = 0;
    if aligned_samples + (AUDIO_REAL_CENTER_PAD as u64) >= (AUDIO_REAL_FRAME_SIZE as u64) {
        mel_frames_org = 1 + ((aligned_samples + (AUDIO_REAL_CENTER_PAD as u64) - (AUDIO_REAL_FRAME_SIZE as u64)) / (AUDIO_REAL_HOP_LENGTH as u64));
    }
    const conv_tokens: u64 = mel_frames / (2 as u64);
    var encoder_positions: u64 = 0;
    if conv_tokens >= (AUDIO_REAL_POOL_KERNEL as u64) {
        encoder_positions = ((conv_tokens - (AUDIO_REAL_POOL_KERNEL as u64)) / (AUDIO_REAL_POOL_STRIDE as u64)) + 1;
    }
    _ = printf("audio-real-preprocess[%s]: path=%s container=%s dtype=%s sample_rate=%u channels=%u samples=%llu duration_ms=%llu\n", role, path, audio_real_container_label(info.container_kind), audio_real_dtype_label(info.dtype_kind), info.sample_rate, info.channels, info.sample_count, duration_ms);
    _ = printf("audio-real-preprocess plan: frame_size=%u win_length=%u hop_length=%u mel_bins=%u filter_bins=%u align_samples=%u center_pad_each=%u aligned_samples=%llu input_pad_samples=%llu padded_samples=%llu\n", AUDIO_REAL_FRAME_SIZE, AUDIO_REAL_WIN_LENGTH, AUDIO_REAL_HOP_LENGTH, AUDIO_REAL_MEL_BINS, AUDIO_REAL_FILTER_BINS, AUDIO_REAL_ALIGN_SAMPLES, AUDIO_REAL_CENTER_PAD, aligned_samples, input_pad_samples, padded_samples);
    _ = printf("audio-real-preprocess positions: mel_frames=%llu mel_frames_org=%llu conv_tokens=%llu pool_kernel=%u pool_stride=%u encoder_positions=%llu encoder_context=%u\n", mel_frames, mel_frames_org, conv_tokens, AUDIO_REAL_POOL_KERNEL, AUDIO_REAL_POOL_STRIDE, encoder_positions, AUDIO_REAL_ENCODER_CONTEXT);
    return true;
}

export fn audio_real_preprocess_probe_cli(audio_path: &const byte) i32 {
    if !audio_real_preprocess_probe_file(audio_path, "probe\0" as &const byte) { return 1; }
    _ = printf("audio-real-preprocess-probe: PASS\n");
    return 0;
}



fn audio_real_skip_untracked_metadata(reader: &BinaryReader, value_type: u32) bool {
    if value_type == AUDIO_GGUF_TYPE_STRING {
        var tmp: [byte: 1] = [];
        var info: AudioStringRead = AudioStringRead{ len: 0, copied: 0, truncated: false };
        return audio_read_string(reader, &tmp[0], 1, &info, "audio-real-mel metadata string\0" as &const byte);
    }
    const elem_size: u64 = audio_scalar_metadata_size(value_type);
    if elem_size > 0 { return binary_skip(reader, elem_size, "audio-real-mel metadata scalar\0" as &const byte); }
    _ = printf("error: audio-real-mel unsupported metadata type=%u\n", value_type);
    return false;
}

fn audio_real_filterbank_load_array(reader: &BinaryReader, count: u64, filters: &AudioRealFilterBank) bool {
    if count == 0 || count > (AUDIO_REAL_MEL_BINS as u64) * (AUDIO_REAL_FILTER_BINS as u64) { _ = printf("error: audio-real-mel filters count=%llu out of supported range\n", count); return false; }
    filters.values = calloc(count as usize, 4) as &f32;
    if filters.values == null { _ = printf("error: audio-real-mel filters allocation failed count=%llu\n", count); return false; }
    var index: u64 = 0;
    while index < count {
        if !audio_read_f32(reader, &filters.values[index as usize]) { return false; }
        index = index + 1;
    }
    filters.value_count = count;
    return true;
}

fn audio_real_filterbank_load(audio_model_path: &const byte, filters: &AudioRealFilterBank) bool {
    filters[0] = audio_real_filter_bank_init();
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(audio_model_path, &reader) { return false; }
    var magic: u32 = 0;
    var version: u32 = 0;
    var tensor_count: u64 = 0;
    var metadata_count: u64 = 0;
    if !binary_read_u32_le(&reader, &magic, "audio-real-mel GGUF magic\0" as &const byte) { binary_close(&reader); return false; }
    if magic != AUDIO_GGUF_MAGIC { _ = printf("error: audio-real-mel bad audio GGUF magic\n"); binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &version, "audio-real-mel GGUF version\0" as &const byte) { binary_close(&reader); return false; }
    if version != 2 && version != 3 { _ = printf("error: audio-real-mel unsupported audio GGUF version=%u\n", version); binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &tensor_count, "audio-real-mel tensor_count\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &metadata_count, "audio-real-mel metadata_count\0" as &const byte) { binary_close(&reader); return false; }
    _ = tensor_count;
    var metadata_index: u64 = 0;
    while metadata_index < metadata_count {
        var key: [byte: 128] = [];
        var info: AudioStringRead = AudioStringRead{ len: 0, copied: 0, truncated: false };
        if !audio_read_string(&reader, &key[0], @len(key), &info, "audio-real-mel metadata key\0" as &const byte) { audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
        if info.truncated { _ = printf("error: audio-real-mel metadata key too long\n"); audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
        var value_type: u32 = 0;
        if !binary_read_u32_le(&reader, &value_type, "audio-real-mel metadata value type\0" as &const byte) { audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
        if value_type == AUDIO_GGUF_TYPE_UINT32 || value_type == AUDIO_GGUF_TYPE_INT32 {
            var value: u32 = 0;
            if !binary_read_u32_le(&reader, &value, "audio-real-mel metadata u32\0" as &const byte) { audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
            if audio_cstr_eq(&key[0] as &const byte, "n_mel\0" as &const byte) { filters.mel_bins = value; }
            if audio_cstr_eq(&key[0] as &const byte, "n_fft\0" as &const byte) { filters.filter_bins = value; }
        } else { if value_type == AUDIO_GGUF_TYPE_ARRAY {
            var element_type: u32 = 0;
            var count: u64 = 0;
            if !binary_read_u32_le(&reader, &element_type, "audio-real-mel metadata array type\0" as &const byte) { audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
            if !binary_read_u64_le(&reader, &count, "audio-real-mel metadata array length\0" as &const byte) { audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
            if audio_cstr_eq(&key[0] as &const byte, "filters\0" as &const byte) {
                if element_type != AUDIO_GGUF_TYPE_FLOAT32 { _ = printf("error: audio-real-mel filters element_type=%u expected=float32\n", element_type); audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
                if !audio_real_filterbank_load_array(&reader, count, filters) { audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
            } else {
                if !audio_skip_array(&reader, element_type, count) { audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
            }
        } else {
            if !audio_real_skip_untracked_metadata(&reader, value_type) { audio_real_filter_bank_free(filters); binary_close(&reader); return false; }
        } }
        metadata_index = metadata_index + 1;
    }
    binary_close(&reader);
    if filters.mel_bins == 0 { filters.mel_bins = AUDIO_REAL_MEL_BINS; }
    if filters.filter_bins == 0 { filters.filter_bins = AUDIO_REAL_FILTER_BINS; }
    const expected: u64 = (filters.mel_bins as u64) * (filters.filter_bins as u64);
    if filters.values == null || filters.value_count != expected { _ = printf("error: audio-real-mel filters metadata incomplete mel_bins=%u filter_bins=%u values=%llu expected=%llu\n", filters.mel_bins, filters.filter_bins, filters.value_count, expected); audio_real_filter_bank_free(filters); return false; }
    if filters.mel_bins != AUDIO_REAL_MEL_BINS || filters.filter_bins != AUDIO_REAL_FILTER_BINS { _ = printf("error: audio-real-mel unsupported filters shape mel_bins=%u filter_bins=%u expected=80x201\n", filters.mel_bins, filters.filter_bins); audio_real_filter_bank_free(filters); return false; }
    return true;
}

fn audio_real_encoder_session_open(audio_model_path: &const byte, session: &AudioRealEncoderSession) bool {
    session[0] = audio_real_encoder_session_init();
    if !audio_config_load_metadata(audio_model_path, &session.config) { return false; }
    if !tensor_weight_table_load(audio_model_path, &session.table) { audio_real_encoder_session_free(session); return false; }
    if !audio_real_complete_config(&session.config, &session.table) { audio_real_encoder_session_free(session); return false; }
    var checked: u32 = 0;
    if !audio_real_bind_check(&session.table, &session.config, &checked) { audio_real_encoder_session_free(session); return false; }
    if !tensor_weight_table_attach_mmap(audio_model_path, &session.table) { audio_real_encoder_session_free(session); return false; }
    if !audio_real_filterbank_load(audio_model_path, &session.filters) { audio_real_encoder_session_free(session); return false; }
    const trig_count: u64 = (AUDIO_REAL_FRAME_SIZE as u64) * (AUDIO_REAL_FILTER_BINS as u64);
    session.cos_table = calloc(trig_count as usize, 4) as &f32;
    session.sin_table = calloc(trig_count as usize, 4) as &f32;
    if session.cos_table == null || session.sin_table == null {
        _ = printf("error: audio-real-encode trig table allocation failed\n");
        audio_real_encoder_session_free(session);
        return false;
    }
    var k_pre: u32 = 0;
    while k_pre < AUDIO_REAL_FILTER_BINS {
        var n_pre: u32 = 0;
        while n_pre < AUDIO_REAL_FRAME_SIZE {
            const idx: usize = (k_pre * AUDIO_REAL_FRAME_SIZE + n_pre) as usize;
            const phase: f32 = ((2.0 as f32) * AUDIO_PI * (k_pre as f32) * (n_pre as f32)) / (AUDIO_REAL_FRAME_SIZE as f32);
            session.cos_table[idx] = cosf(phase);
            session.sin_table[idx] = sinf(phase);
            n_pre = n_pre + 1;
        }
        k_pre = k_pre + 1;
    }
    session.ready = true;
    return true;
}

fn audio_real_load_samples_alloc(sample_count: u64, pcm: &AudioRealPcmHeap) bool {
    if sample_count == 0 { _ = printf("error: audio-real-mel has no samples\n"); return false; }
    pcm.sample_count = sample_count;
    pcm.values = calloc(sample_count as usize, 4) as &f32;
    if pcm.values == null { _ = printf("error: audio-real-mel sample allocation failed samples=%llu\n", sample_count); return false; }
    return true;
}

fn audio_real_single_token(tok: &Tokenizer, piece: &const byte, out: &u32) bool {
    var ids: [u32: 4] = [];
    var count: usize = 0;
    if !tokenizer_encode_to_ids(tok, piece, &ids[0], @len(ids), &count) { return false; }
    if count != 1 {
        _ = printf("error: audio2audio-real placeholder %s encoded to %zu tokens\n", piece, count);
        return false;
    }
    out[0] = ids[0];
    return true;
}

fn audio_real_load_samples_uyap(path: &const byte, role: &const byte, reader: &BinaryReader, pcm: &AudioRealPcmHeap) bool {
    _ = path;
    var version: u32 = 0;
    var sample_rate: u32 = 0;
    var channels: u32 = 0;
    var sample_count32: u32 = 0;
    var dtype: u32 = 0;
    if !binary_read_u32_le(reader, &version, "audio-real-mel UYAP version\0" as &const byte) { return false; }
    if version != AUDIO_RAW_VERSION { _ = printf("error: audio-real-mel[%s] UYAP unsupported version=%u\n", role, version); return false; }
    if !binary_read_u32_le(reader, &sample_rate, "audio-real-mel UYAP sample rate\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &channels, "audio-real-mel UYAP channels\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &sample_count32, "audio-real-mel UYAP sample count\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &dtype, "audio-real-mel UYAP dtype\0" as &const byte) { return false; }
    if !audio_probe_require_real(role, sample_rate, channels) { return false; }
    if !audio_real_load_samples_alloc(sample_count32 as u64, pcm) { return false; }
    var index: u64 = 0;
    if dtype == AUDIO_PCM_DTYPE_F32 {
        while index < pcm.sample_count {
            if !audio_read_f32(reader, &pcm.values[index as usize]) { return false; }
            index = index + 1;
        }
    } else { if dtype == AUDIO_PCM_DTYPE_S16 {
        while index < pcm.sample_count {
            var bits: u32 = 0;
            if !binary_read_u32_le(reader, &bits, "audio-real-mel UYAP s16-as-i32\0" as &const byte) { return false; }
            var signed: i32 = bits as i32;
            pcm.values[index as usize] = (signed as f32) / 32768.0;
            index = index + 1;
        }
    } else { _ = printf("error: audio-real-mel[%s] UYAP dtype=%u unsupported\n", role, dtype); return false; } }
    if reader.pos != reader.size { _ = printf("error: audio-real-mel[%s] UYAP has trailing bytes=%llu\n", role, reader.size - reader.pos); return false; }
    return true;
}

fn audio_real_load_samples_wav(path: &const byte, role: &const byte, reader: &BinaryReader, pcm: &AudioRealPcmHeap) bool {
    _ = path;
    var riff_size: u32 = 0;
    var wave: u32 = 0;
    if !binary_read_u32_le(reader, &riff_size, "audio-real-mel WAV RIFF size\0" as &const byte) { return false; }
    if !binary_read_u32_le(reader, &wave, "audio-real-mel WAV WAVE magic\0" as &const byte) { return false; }
    if wave != AUDIO_WAV_WAVE { _ = printf("error: audio-real-mel[%s] bad WAV magic\n", role); return false; }
    var format_tag: u16 = 0;
    var channels: u16 = 0;
    var sample_rate: u32 = 0;
    var bits_per_sample: u16 = 0;
    var data_pos: u64 = 0;
    var data_size: u32 = 0;
    var have_fmt: bool = false;
    var have_data: bool = false;
    while reader.pos + (8 as u64) <= reader.size {
        var chunk_id: u32 = 0;
        var chunk_size: u32 = 0;
        if !binary_read_u32_le(reader, &chunk_id, "audio-real-mel WAV chunk id\0" as &const byte) { return false; }
        if !binary_read_u32_le(reader, &chunk_size, "audio-real-mel WAV chunk size\0" as &const byte) { return false; }
        const payload_pos: u64 = reader.pos;
        var padded: u64 = chunk_size as u64;
        if padded % (2 as u64) != 0 { padded = padded + 1; }
        if payload_pos + padded > reader.size { _ = printf("error: audio-real-mel[%s] WAV chunk extends past EOF\n", role); return false; }
        if chunk_id == AUDIO_WAV_FMT {
            if chunk_size < 16 { _ = printf("error: audio-real-mel[%s] WAV fmt chunk too small=%u\n", role, chunk_size); return false; }
            var byte_rate: u32 = 0; var block_align: u16 = 0;
            if !binary_read_u16_le(reader, &format_tag, "audio-real-mel WAV format tag\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &channels, "audio-real-mel WAV channels\0" as &const byte) { return false; }
            if !binary_read_u32_le(reader, &sample_rate, "audio-real-mel WAV sample rate\0" as &const byte) { return false; }
            if !binary_read_u32_le(reader, &byte_rate, "audio-real-mel WAV byte rate\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &block_align, "audio-real-mel WAV block align\0" as &const byte) { return false; }
            if !binary_read_u16_le(reader, &bits_per_sample, "audio-real-mel WAV bits per sample\0" as &const byte) { return false; }
            have_fmt = true;
        } else { if chunk_id == AUDIO_WAV_DATA { data_pos = payload_pos; data_size = chunk_size; have_data = true; } }
        if !binary_seek(reader, payload_pos + padded, "audio-real-mel WAV next chunk\0" as &const byte) { return false; }
        if have_fmt && have_data { break; }
    }
    _ = riff_size;
    if !have_fmt { _ = printf("error: audio-real-mel[%s] WAV missing fmt chunk\n", role); return false; }
    if !have_data { _ = printf("error: audio-real-mel[%s] WAV missing data chunk\n", role); return false; }
    if !audio_probe_require_real(role, sample_rate, channels as u32) { return false; }
    var bytes_per_sample: u32 = 0;
    if format_tag == AUDIO_WAV_FORMAT_PCM && bits_per_sample == 16 { bytes_per_sample = 2; }
    else { if format_tag == AUDIO_WAV_FORMAT_FLOAT && bits_per_sample == 32 { bytes_per_sample = 4; }
    else { _ = printf("error: audio-real-mel[%s] WAV unsupported format_tag=%u bits_per_sample=%u\n", role, format_tag as u32, bits_per_sample as u32); return false; } }
    const frame_bytes: u32 = (channels as u32) * bytes_per_sample;
    if frame_bytes == 0 || data_size % frame_bytes != 0 { _ = printf("error: audio-real-mel[%s] WAV data bytes=%u not aligned to frame_bytes=%u\n", role, data_size, frame_bytes); return false; }
    const sample_count: u64 = (data_size / frame_bytes) as u64;
    if !audio_real_load_samples_alloc(sample_count, pcm) { return false; }
    if !binary_seek(reader, data_pos, "audio-real-mel WAV data seek\0" as &const byte) { return false; }
    var index: u64 = 0;
    while index < pcm.sample_count {
        if format_tag == AUDIO_WAV_FORMAT_PCM {
            var raw: u16 = 0;
            if !binary_read_u16_le(reader, &raw, "audio-real-mel WAV s16 sample\0" as &const byte) { return false; }
            var signed: i32 = raw as i32;
            if raw >= (32768 as u16) { signed = signed - 65536; }
            pcm.values[index as usize] = (signed as f32) / 32768.0;
        } else {
            if !audio_read_f32(reader, &pcm.values[index as usize]) { return false; }
        }
        index = index + 1;
    }
    return true;
}

fn audio_real_load_samples_file(path: &const byte, role: &const byte, pcm: &AudioRealPcmHeap) bool {
    pcm[0] = audio_real_pcm_heap_init();
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    if !binary_read_u32_le(&reader, &magic, "audio-real-mel input magic\0" as &const byte) { binary_close(&reader); return false; }
    var ok: bool = false;
    if magic == AUDIO_WAV_RIFF { ok = audio_real_load_samples_wav(path, role, &reader, pcm); }
    else { if magic == AUDIO_PCM_MAGIC { ok = audio_real_load_samples_uyap(path, role, &reader, pcm); }
    else { _ = printf("error: audio-real-mel[%s] unsupported container magic=0x%x; expected RIFF/WAVE or UYAP\n", role, magic); ok = false; } }
    binary_close(&reader);
    if !ok { audio_real_pcm_heap_free(pcm); }
    return ok;
}

fn audio_real_aligned_sample_count(sample_count: u64) u64 {
    var aligned_samples: u64 = sample_count;
    if aligned_samples < (AUDIO_REAL_ALIGN_SAMPLES as u64) { aligned_samples = AUDIO_REAL_ALIGN_SAMPLES as u64; }
    else { if aligned_samples % (AUDIO_REAL_ALIGN_SAMPLES as u64) != 0 { aligned_samples = ((aligned_samples / (AUDIO_REAL_ALIGN_SAMPLES as u64)) + 1) * (AUDIO_REAL_ALIGN_SAMPLES as u64); } }
    return aligned_samples;
}

fn audio_real_centered_sample(pcm: &AudioRealPcmHeap, aligned_samples: u64, padded_index: u64) f32 {
    if padded_index < (AUDIO_REAL_CENTER_PAD as u64) {
        const src: u64 = (AUDIO_REAL_CENTER_PAD as u64) - padded_index;
        if src < pcm.sample_count { return pcm.values[src as usize]; }
        return 0.0 as f32;
    }
    const body_start: u64 = AUDIO_REAL_CENTER_PAD as u64;
    if padded_index < body_start + aligned_samples {
        const src2: u64 = padded_index - body_start;
        if src2 < pcm.sample_count { return pcm.values[src2 as usize]; }
        return 0.0 as f32;
    }
    return 0.0 as f32;
}

fn audio_real_hann(index: u32) f32 {
    return (0.5 as f32) * ((1.0 as f32) - cosf(((2.0 as f32) * AUDIO_PI * (index as f32)) / (AUDIO_REAL_FRAME_SIZE as f32)));
}

fn audio_real_update_minmax(value: f32, min_value: &f32, max_value: &f32, have: &bool) void {
    if !have[0] { min_value[0] = value; max_value[0] = value; have[0] = true; return; }
    if value < min_value[0] { min_value[0] = value; }
    if value > max_value[0] { max_value[0] = value; }
}

fn audio_real_write_u32_le(dest: &byte, offset: usize, value: u32) void {
    dest[offset] = (value & (0xff as u32)) as byte;
    dest[offset + (1 as usize)] = ((value >> 8) & (0xff as u32)) as byte;
    dest[offset + (2 as usize)] = ((value >> 16) & (0xff as u32)) as byte;
    dest[offset + (3 as usize)] = ((value >> 24) & (0xff as u32)) as byte;
}

fn audio_real_write_all(fd: i32, src: &const byte, count: usize, path: &const byte, label: &const byte) bool {
    var done: usize = 0;
    while done < count {
        const write_result: !isize = sys_write(fd, (&src[done]) as *const byte, count - done);
        const wrote: isize = write_result catch {
            _ = printf("error: audio-real-mel dump %s write syscall failed path=%s\n", label, path);
            return false;
        };
        if wrote <= (0 as isize) {
            _ = printf("error: audio-real-mel dump %s short write path=%s wrote=%lld remaining=%zu\n", label, path, wrote as i64, count - done);
            return false;
        }
        done = done + (wrote as usize);
    }
    return true;
}

fn audio_real_mel_dump_write(path: &const byte, mel_values: &f32, mel_frames: u64, mel_bins: u32) bool {
    if mel_frames > 0xffffffff as u64 { _ = printf("error: audio-real-mel dump frames=%llu exceed u32 header limit\n", mel_frames); return false; }
    const fd_result: !i32 = sys_open(path as *const byte, (O_WRONLY | O_CREAT | O_TRUNC) as i32, 420);
    const fd: i32 = fd_result catch {
        _ = printf("error: audio-real-mel dump open failed path=%s\n", path);
        return false;
    };
    var header: [byte: 16] = [];
    audio_real_write_u32_le(&header[0], 0, AUDIO_REAL_MEL_DUMP_MAGIC);
    audio_real_write_u32_le(&header[0], 4, AUDIO_REAL_MEL_DUMP_VERSION);
    audio_real_write_u32_le(&header[0], 8, mel_frames as u32);
    audio_real_write_u32_le(&header[0], 12, mel_bins);
    if !audio_real_write_all(fd, &header[0] as &const byte, 16, path, "header\0" as &const byte) { _ = sys_close(fd); return false; }
    const mel_count: u64 = mel_frames * (mel_bins as u64);
    const data_bytes: usize = (mel_count * (4 as u64)) as usize;
    if data_bytes > 0 {
        if !audio_real_write_all(fd, mel_values as &const byte, data_bytes, path, "payload\0" as &const byte) { _ = sys_close(fd); return false; }
    }
    const close_result: !i32 = sys_close(fd);
    close_result catch {
        _ = printf("error: audio-real-mel dump close failed path=%s\n", path);
        return false;
    };
    _ = printf("audio-real-mel dump: path=%s format=uyml-f32 frames=%llu mel_bins=%u bytes=%zu\n", path, mel_frames, mel_bins, data_bytes + (16 as usize));
    return true;
}

fn audio_real_mel_compute(pcm: &AudioRealPcmHeap, filters: &AudioRealFilterBank, cos_table: &const f32, sin_table: &const f32, mel_values: &f32, mel_frames: u64, aligned_samples: u64) bool {
    var hann: [f32: 400] = [];
    var n_hann: u32 = 0;
    while n_hann < AUDIO_REAL_FRAME_SIZE { hann[n_hann as usize] = audio_real_hann(n_hann); n_hann = n_hann + 1; }
    if cos_table == null || sin_table == null { _ = printf("error: audio-real-mel trig table unavailable\n"); return false; }
    var mmax: f32 = -1000000000.0;
    var frame: u64 = 0;
    while frame < mel_frames {
        var power: [f32: 201] = [];
        var k: u32 = 0;
        while k < AUDIO_REAL_FILTER_BINS {
            var re: f32 = 0.0;
            var im: f32 = 0.0;
            var n: u32 = 0;
            while n < AUDIO_REAL_FRAME_SIZE {
                const sample: f32 = audio_real_centered_sample(pcm, aligned_samples, frame * (AUDIO_REAL_HOP_LENGTH as u64) + (n as u64)) * hann[n as usize];
                const tidx: usize = (k * AUDIO_REAL_FRAME_SIZE + n) as usize;
                re = re + sample * cos_table[tidx];
                im = im - sample * sin_table[tidx];
                n = n + 1;
            }
            power[k as usize] = re * re + im * im;
            k = k + 1;
        }
        var mel: u32 = 0;
        while mel < AUDIO_REAL_MEL_BINS {
            var sum: f32 = 0.0;
            var bin: u32 = 0;
            while bin < AUDIO_REAL_FILTER_BINS {
                sum = sum + power[bin as usize] * filters.values[(mel * AUDIO_REAL_FILTER_BINS + bin) as usize];
                bin = bin + 1;
            }
            if sum < 0.0000000001 { sum = 0.0000000001; }
            const log_value: f32 = log10f(sum);
            mel_values[(mel as u64 * mel_frames + frame) as usize] = log_value;
            if log_value > mmax { mmax = log_value; }
            mel = mel + 1;
        }
        frame = frame + 1;
    }
    const floor_value: f32 = mmax - 8.0;
    var total: u64 = mel_frames * (AUDIO_REAL_MEL_BINS as u64);
    var i: u64 = 0;
    while i < total {
        var value: f32 = mel_values[i as usize];
        if value < floor_value { value = floor_value; }
        mel_values[i as usize] = (value + 4.0) / 4.0;
        i = i + 1;
    }
    return true;
}

fn audio_real_mel_probe_run(audio_model_path: &const byte, audio_path: &const byte, dump_path: &const byte) i32 {
    var session: AudioRealEncoderSession = audio_real_encoder_session_init();
    if !audio_real_encoder_session_open(audio_model_path, &session) { return 1; }
    var pcm: AudioRealPcmHeap = audio_real_pcm_heap_init();
    if !audio_real_load_samples_file(audio_path, "probe\0" as &const byte, &pcm) { audio_real_encoder_session_free(&session); return 1; }
    const aligned_samples: u64 = audio_real_aligned_sample_count(pcm.sample_count);
    const padded_samples: u64 = aligned_samples + (AUDIO_REAL_CENTER_PAD as u64) * (2 as u64);
    const mel_frames: u64 = (padded_samples - (AUDIO_REAL_FRAME_SIZE as u64)) / (AUDIO_REAL_HOP_LENGTH as u64);
    const mel_count: u64 = mel_frames * (AUDIO_REAL_MEL_BINS as u64);
    if mel_frames == 0 || mel_count == 0 { _ = printf("error: audio-real-mel produced empty mel frames\n"); audio_real_pcm_heap_free(&pcm); audio_real_encoder_session_free(&session); return 1; }
    var mel_values: &f32 = calloc(mel_count as usize, 4) as &f32;
    if mel_values == null { _ = printf("error: audio-real-mel output allocation failed elements=%llu\n", mel_count); audio_real_pcm_heap_free(&pcm); audio_real_encoder_session_free(&session); return 1; }
    if !audio_real_mel_compute(&pcm, &session.filters, session.cos_table as &const f32, session.sin_table as &const f32, mel_values, mel_frames, aligned_samples) { free(mel_values as &void); audio_real_pcm_heap_free(&pcm); audio_real_encoder_session_free(&session); return 1; }
    var min_value: f32 = 0.0;
    var max_value: f32 = 0.0;
    var have: bool = false;
    var i: u64 = 0;
    while i < mel_count { audio_real_update_minmax(mel_values[i as usize], &min_value, &max_value, &have); i = i + 1; }
    const checksum: u32 = audio_checksum(mel_values as &const f32, mel_count as usize);
    const conv_tokens: u64 = mel_frames / (2 as u64);
    var encoder_positions: u64 = 0;
    if conv_tokens >= (AUDIO_REAL_POOL_KERNEL as u64) { encoder_positions = ((conv_tokens - (AUDIO_REAL_POOL_KERNEL as u64)) / (AUDIO_REAL_POOL_STRIDE as u64)) + 1; }
    _ = printf("audio-real-mel input: model=%s audio=%s samples=%llu aligned_samples=%llu padded_samples=%llu\n", audio_model_path, audio_path, pcm.sample_count, aligned_samples, padded_samples);
    _ = printf("audio-real-mel shape: frames=%llu mel_bins=%u elements=%llu filter_bins=%u conv_tokens=%llu encoder_positions=%llu checksum=0x%x min=%.6f max=%.6f\n", mel_frames, AUDIO_REAL_MEL_BINS, mel_count, AUDIO_REAL_FILTER_BINS, conv_tokens, encoder_positions, checksum, min_value as f64, max_value as f64);
    _ = printf("audio-real-mel values[0..5]: %.6f %.6f %.6f %.6f %.6f %.6f\n", mel_values[0] as f64, mel_values[1] as f64, mel_values[2] as f64, mel_values[3] as f64, mel_values[4] as f64, mel_values[5] as f64);
    if dump_path != null {
        if !audio_real_mel_dump_write(dump_path, mel_values, mel_frames, AUDIO_REAL_MEL_BINS) { free(mel_values as &void); audio_real_pcm_heap_free(&pcm); audio_real_encoder_session_free(&session); return 1; }
    }
    _ = printf("audio-real-mel-probe: PASS\n");
    free(mel_values as &void);
    audio_real_pcm_heap_free(&pcm);
    audio_real_encoder_session_free(&session);
    return 0;
}

export fn audio_real_mel_probe_cli(audio_model_path: &const byte, audio_path: &const byte) i32 {
    return audio_real_mel_probe_run(audio_model_path, audio_path, null);
}

export fn audio_real_mel_probe_args_cli(argc: i32, argv: & &byte) i32 {
    if argc != 4 && argc != 6 {
        _ = printf("usage: minicpm-o-uya audio-real-mel-probe <audio.gguf> <audio.wav|audio.uyap.pcm> [--dump-f32 out.uyml]\n");
        return 1;
    }
    var dump_path: &const byte = null;
    if argc == 6 {
        if strcmp(argv[4] as *const byte, "--dump-f32\0" as *const byte) != 0 {
            _ = printf("error: audio-real-mel-probe expected optional flag --dump-f32\n");
            _ = printf("usage: minicpm-o-uya audio-real-mel-probe <audio.gguf> <audio.wav|audio.uyap.pcm> [--dump-f32 out.uyml]\n");
            return 1;
        }
        dump_path = argv[5] as &const byte;
    }
    return audio_real_mel_probe_run(argv[2] as &const byte, argv[3] as &const byte, dump_path);
}

fn audio_pcm_load(path: &const byte, pcm: &AudioRawPcm) bool {
    pcm[0] = audio_pcm_init();
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    var version: u32 = 0;
    var dtype: u32 = 0;
    if !binary_read_u32_le(&reader, &magic, "audio pcm magic\0" as &const byte) { binary_close(&reader); return false; }
    if magic != AUDIO_PCM_MAGIC { _ = printf("error: audio pcm bad magic; expected UYAP\n"); binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &version, "audio pcm version\0" as &const byte) { binary_close(&reader); return false; }
    if version != AUDIO_RAW_VERSION { _ = printf("error: audio pcm unsupported version=%u\n", version); binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &pcm.sample_rate, "audio pcm sample rate\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &pcm.channels, "audio pcm channels\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &pcm.sample_count, "audio pcm sample count\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &dtype, "audio pcm dtype\0" as &const byte) { binary_close(&reader); return false; }
    const total: u64 = (pcm.sample_count as u64) * (pcm.channels as u64);
    if pcm.sample_rate == 0 || pcm.channels == 0 || pcm.sample_count == 0 || total > AUDIO_MAX_PCM_SAMPLES as u64 { _ = printf("error: audio pcm shape samples=%u channels=%u exceeds cap=%zu\n", pcm.sample_count, pcm.channels, AUDIO_MAX_PCM_SAMPLES); binary_close(&reader); return false; }
    var index: usize = 0;
    if dtype == AUDIO_PCM_DTYPE_F32 {
        while index < total as usize {
            if !audio_read_f32(&reader, &pcm.values[index]) { binary_close(&reader); return false; }
            index = index + 1;
        }
    } else { if dtype == AUDIO_PCM_DTYPE_S16 {
        while index < total as usize {
            var bits: u32 = 0;
            if !binary_read_u32_le(&reader, &bits, "audio pcm s16-as-u32\0" as &const byte) { binary_close(&reader); return false; }
            var signed: i32 = bits as i32;
            pcm.values[index] = (signed as f32) / 32768.0;
            index = index + 1;
        }
    } else { _ = printf("error: audio pcm dtype=%u unsupported\n", dtype); binary_close(&reader); return false; } }
    if reader.pos != reader.size { _ = printf("error: audio pcm has trailing bytes=%llu\n", reader.size - reader.pos); binary_close(&reader); return false; }
    binary_close(&reader);
    return true;
}

fn audio_downmix_mono(pcm: &AudioRawPcm, mono: &f32, mono_count: &usize) bool {
    mono_count[0] = pcm.sample_count as usize;
    var sample: usize = 0;
    while sample < mono_count[0] {
        var sum: f32 = 0.0;
        var channel: usize = 0;
        while channel < pcm.channels as usize {
            sum = sum + pcm.values[sample * (pcm.channels as usize) + channel];
            channel = channel + 1;
        }
        mono[sample] = sum / (pcm.channels as f32);
        sample = sample + 1;
    }
    return true;
}

fn audio_resample_linear(input: &const f32, input_count: usize, input_rate: u32, output_rate: u32, output: &f32, output_count: &usize) bool {
    if input_rate == output_rate {
        var i: usize = 0; while i < input_count { output[i] = input[i]; i = i + 1; }
        output_count[0] = input_count; return true;
    }
    output_count[0] = ((input_count as u64) * (output_rate as u64) / (input_rate as u64)) as usize;
    if output_count[0] == 0 || output_count[0] > AUDIO_MAX_PCM_SAMPLES { return false; }
    var out_i: usize = 0;
    while out_i < output_count[0] {
        const pos: f32 = (out_i as f32) * (input_rate as f32) / (output_rate as f32);
        var left: usize = pos as usize;
        if left >= input_count { left = input_count - 1; }
        var right: usize = left + 1;
        if right >= input_count { right = left; }
        const frac: f32 = pos - (left as f32);
        output[out_i] = input[left] * (1.0 - frac) + input[right] * frac;
        out_i = out_i + 1;
    }
    return true;
}

fn audio_hann(index: usize, len: usize) f32 {
    if len <= 1 { return 1.0 as f32; }
    return (0.5 as f32) - (0.5 as f32) * sinf(((2.0 as f32) * AUDIO_PI * (index as f32) / ((len - 1) as f32)) - (AUDIO_PI / (2.0 as f32)));
}

fn audio_compute_frame(config: &AudioPreprocessConfig, samples: &const f32, start: usize, sample_count: usize, out: &f32) void {
    var mel: usize = 0;
    while mel < config.mel_bin_count as usize {
        var energy: f32 = 0.0;
        var n: usize = 0;
        while n < config.win_length as usize {
            var value: f32 = 0.0;
            if start + n < sample_count { value = samples[start + n]; }
            const windowed: f32 = value * audio_hann(n, config.win_length as usize);
            const phase: f32 = 2.0 * AUDIO_PI * ((mel + 1) as f32) * (n as f32) / (config.n_fft as f32);
            const basis: f32 = sinf(phase);
            const projected: f32 = windowed * basis;
            energy = energy + projected * projected;
            n = n + 1;
        }
        const scaled: f32 = energy / (config.win_length as f32) + config.log_floor;
        out[mel] = scaled;
        mel = mel + 1;
    }
}

fn audio_log_scale(values: &f32, count: usize) void {
    var i: usize = 0;
    while i < count {
        values[i] = sqrtf(values[i]);
        i = i + 1;
    }
}

fn audio_pcm_to_mel(config: &AudioPreprocessConfig, pcm: &AudioRawPcm, raw: &AudioRawMel) bool {
    var mono: [f32: 4096] = [];
    var mono_count: usize = 0;
    if !audio_downmix_mono(pcm, &mono[0], &mono_count) { return false; }
    var resampled: [f32: 4096] = [];
    var resampled_count: usize = 0;
    if !audio_resample_linear(&mono[0] as &const f32, mono_count, pcm.sample_rate, config.target_sample_rate, &resampled[0], &resampled_count) { return false; }
    raw[0] = audio_raw_init();
    raw.mel_bin_count = config.mel_bin_count;
    raw.frame_count = 0;
    var start: usize = 0;
    while start + config.win_length as usize <= resampled_count || (start == 0 && resampled_count > 0) {
        if raw.frame_count as usize >= AUDIO_MAX_FRAMES { return false; }
        audio_compute_frame(config, &resampled[0] as &const f32, start, resampled_count, &raw.values[(raw.frame_count as usize) * (config.mel_bin_count as usize)]);
        raw.frame_count = raw.frame_count + 1;
        if start + config.hop_length as usize >= resampled_count { break; }
        start = start + config.hop_length as usize;
    }
    raw.element_count = (raw.frame_count as usize) * (raw.mel_bin_count as usize);
    audio_log_scale(&raw.values[0], raw.element_count);
    return raw.element_count > 0;
}

fn audio_stream_append(cache: &AudioStreamingCache, samples: &const f32, count: usize) bool {
    if cache.sample_count + count > AUDIO_MAX_PCM_SAMPLES { return false; }
    var i: usize = 0;
    while i < count { cache.samples[cache.sample_count + i] = samples[i]; i = i + 1; }
    cache.sample_count = cache.sample_count + count;
    if cache.sample_count > cache.peak_sample_count { cache.peak_sample_count = cache.sample_count; }
    return true;
}

fn audio_stream_flush(config: &AudioPreprocessConfig, cache: &AudioStreamingCache, out: &AudioRawMel) bool {
    out[0] = audio_raw_init(); out.mel_bin_count = config.mel_bin_count;
    var start: usize = cache.consumed_start;
    while start + config.win_length as usize <= cache.sample_count {
        if out.frame_count as usize >= AUDIO_MAX_FRAMES { return false; }
        audio_compute_frame(config, &cache.samples[0] as &const f32, start, cache.sample_count, &out.values[(out.frame_count as usize) * (config.mel_bin_count as usize)]);
        out.frame_count = out.frame_count + 1;
        cache.produced_frames = cache.produced_frames + 1;
        start = start + config.hop_length as usize;
    }
    cache.consumed_start = start;
    if cache.consumed_start > config.win_length as usize {
        const keep_start: usize = cache.consumed_start - (config.win_length as usize);
        var i: usize = 0;
        while keep_start + i < cache.sample_count { cache.samples[i] = cache.samples[keep_start + i]; i = i + 1; }
        cache.sample_count = i;
        cache.consumed_start = config.win_length as usize;
    }
    out.element_count = (out.frame_count as usize) * (out.mel_bin_count as usize);
    audio_log_scale(&out.values[0], out.element_count);
    return true;
}

export fn audio_preprocess_smoke_cli(audio_path: &const byte) i32 {
    var pcm: AudioRawPcm = audio_pcm_init();
    if !audio_pcm_load(audio_path, &pcm) { return 1; }
    var config: AudioPreprocessConfig = audio_preprocess_config_init();
    var oneshot: AudioRawMel = audio_raw_init();
    if !audio_pcm_to_mel(&config, &pcm, &oneshot) { _ = printf("error: audio preprocess failed\n"); return 1; }
    var mono: [f32: 4096] = []; var mono_count: usize = 0;
    if !audio_downmix_mono(&pcm, &mono[0], &mono_count) { return 1; }
    var resampled: [f32: 4096] = []; var resampled_count: usize = 0;
    if !audio_resample_linear(&mono[0] as &const f32, mono_count, pcm.sample_rate, config.target_sample_rate, &resampled[0], &resampled_count) { return 1; }
    var cache: AudioStreamingCache = audio_streaming_cache_init();
    var streamed: AudioRawMel = audio_raw_init();
    var stream_all: AudioRawMel = audio_raw_init();
    var offset: usize = 0;
    while offset < resampled_count {
        var chunk: usize = 3;
        if offset + chunk > resampled_count { chunk = resampled_count - offset; }
        if !audio_stream_append(&cache, &resampled[offset] as &const f32, chunk) { return 1; }
        if !audio_stream_flush(&config, &cache, &streamed) { return 1; }
        var i: usize = 0;
        while i < streamed.element_count {
            stream_all.values[stream_all.element_count + i] = streamed.values[i];
            i = i + 1;
        }
        stream_all.element_count = stream_all.element_count + streamed.element_count;
        stream_all.frame_count = stream_all.element_count as u32 / config.mel_bin_count;
        stream_all.mel_bin_count = config.mel_bin_count;
        offset = offset + chunk;
    }
    var diff: f32 = 0.0; var i2: usize = 0;
    while i2 < oneshot.element_count && i2 < stream_all.element_count {
        var d: f32 = oneshot.values[i2] - stream_all.values[i2]; if d < 0.0 { d = -d; }
        diff = diff + d; i2 = i2 + 1;
    }
    const one_checksum: u32 = audio_checksum(&oneshot.values[0], oneshot.element_count);
    const stream_checksum: u32 = audio_checksum(&stream_all.values[0], stream_all.element_count);
    _ = printf("audio-preprocess pcm: sample_rate=%u channels=%u samples=%u\n", pcm.sample_rate, pcm.channels, pcm.sample_count);
    _ = printf("audio-preprocess mel: frames=%u mel_bins=%u checksum=0x%x\n", oneshot.frame_count, oneshot.mel_bin_count, one_checksum);
    _ = printf("audio-preprocess streaming: frames=%u checksum=0x%x diff_l1=%.9f peak_samples=%zu\n", stream_all.frame_count, stream_checksum, diff as f64, cache.peak_sample_count);
    if oneshot.element_count != stream_all.element_count || diff > 0.0001 { _ = printf("error: streaming mel differs from one-shot\n"); return 1; }
    _ = printf("audio-preprocess-smoke: PASS\n");
    return 0;
}

extern "libc" fn sprintf(str: *byte, format: *const byte, ...) i32;

fn audio_build_layer_name(layer: u32, suffix: &const byte, dest: &byte, dest_cap: usize) bool {
    if dest_cap < 40 { return false; }
    _ = sprintf(dest as *byte, "audio.blk.%u.%s", layer, suffix);
    return true;
}

fn audio_lookup_layer(table: &TensorWeightTable, layer: u32, suffix: &const byte) &TensorView {
    var name: [byte: 96] = [];
    if !audio_build_layer_name(layer, suffix, &name[0], @len(name)) { return null; }
    return tensor_lookup(table, &name[0] as &const byte);
}

fn audio_build_real_layer_name(layer: u32, suffix: &const byte, dest: &byte, dest_cap: usize) bool {
    if dest_cap < 80 { return false; }
    _ = sprintf(dest as *byte, "encoder.blocks.%u.%s", layer, suffix);
    return true;
}

fn audio_lookup_real_layer(table: &TensorWeightTable, layer: u32, suffix: &const byte) &TensorView {
    var name: [byte: 128] = [];
    if !audio_build_real_layer_name(layer, suffix, &name[0], @len(name)) { return null; }
    return tensor_lookup(table, &name[0] as &const byte);
}

fn audio_count_real_layers_from_tensors(table: &TensorWeightTable) u32 {
    var layer_count: u32 = 0;
    while layer_count < 64 {
        if audio_lookup_real_layer(table, layer_count, "attn.query.weight\0" as &const byte) == null { return layer_count; }
        layer_count = layer_count + 1;
    }
    return layer_count;
}

fn audio_check_vec_loose(view: &TensorView, len: u32, label: &const byte) bool {
    if !audio_check_dtype(view, label) { return false; }
    if view.n_dims == 1 && view.shape[0] == len as u64 { return true; }
    if view.n_dims == 2 && view.shape[0] == 1 && view.shape[1] == len as u64 { return true; }
    _ = printf("error: audio bind tensor=%s label=%s bad shape got=", &view.name[0], label);
    audio_print_shape(view);
    _ = printf(" expected=[%u] or [1,%u]\n", len, len);
    return false;
}

fn audio_check_conv1_real(view: &TensorView, mel_bins: u32, hidden: u32) bool {
    if !audio_check_dtype(view, "real conv1 weight\0" as &const byte) { return false; }
    if view.n_dims == 3 && view.shape[0] == 3 && view.shape[1] == mel_bins as u64 && view.shape[2] == hidden as u64 { return true; }
    _ = printf("error: audio bind tensor=%s label=real conv1 bad shape got=", &view.name[0]);
    audio_print_shape(view);
    _ = printf(" expected=[3,%u,%u]\n", mel_bins, hidden);
    return false;
}

fn audio_check_conv2_real(view: &TensorView, hidden: u32) bool {
    if !audio_check_dtype(view, "real conv2 weight\0" as &const byte) { return false; }
    if view.n_dims == 3 && view.shape[0] == 3 && view.shape[1] == hidden as u64 && view.shape[2] == hidden as u64 { return true; }
    _ = printf("error: audio bind tensor=%s label=real conv2 bad shape got=", &view.name[0]);
    audio_print_shape(view);
    _ = printf(" expected=[3,%u,%u]\n", hidden, hidden);
    return false;
}

fn audio_check_position_real(view: &TensorView, frames: u32, hidden: u32) bool {
    if !audio_check_dtype(view, "real positional embedding\0" as &const byte) { return false; }
    if view.n_dims == 2 && ((view.shape[0] == hidden as u64 && view.shape[1] == frames as u64) || (view.shape[0] == frames as u64 && view.shape[1] == hidden as u64)) { return true; }
    _ = printf("error: audio bind tensor=%s label=real positional embedding bad shape got=", &view.name[0]);
    audio_print_shape(view);
    _ = printf(" expected=[%u,%u] or [%u,%u]\n", hidden, frames, frames, hidden);
    return false;
}

fn audio_require_tensor(table: &TensorWeightTable, name: &const byte, label: &const byte) &TensorView {
    const view: &TensorView = tensor_lookup(table, name);
    if view == null { _ = printf("error: audio bind missing tensor %s label=%s\n", name, label); }
    return view;
}

fn audio_require_real_layer(table: &TensorWeightTable, layer: u32, suffix: &const byte, label: &const byte) &TensorView {
    var name: [byte: 128] = [];
    if !audio_build_real_layer_name(layer, suffix, &name[0], @len(name)) { _ = printf("error: audio bind layer name too long layer=%u suffix=%s\n", layer, suffix); return null; }
    return audio_require_tensor(table, &name[0] as &const byte, label);
}

fn audio_real_complete_config(config: &AudioConfig, table: &TensorWeightTable) bool {
    const conv1: &TensorView = tensor_lookup(table, "encoder.conv1.weight\0" as &const byte);
    if conv1 == null { _ = printf("error: audio real bind missing tensor encoder.conv1.weight\n"); return false; }
    if conv1.n_dims == 3 {
        if config.mel_bin_count == 0 { config.mel_bin_count = conv1.shape[1] as u32; }
        if config.hidden_size == 0 { config.hidden_size = conv1.shape[2] as u32; }
    }
    const pos: &TensorView = tensor_lookup(table, "encoder.positional_embedding\0" as &const byte);
    if pos == null { _ = printf("error: audio real bind missing tensor encoder.positional_embedding\n"); return false; }
    if pos.n_dims == 2 && config.frame_count == 0 {
        if config.hidden_size > 0 && pos.shape[0] == config.hidden_size as u64 { config.frame_count = pos.shape[1] as u32; }
        else { config.frame_count = pos.shape[0] as u32; }
    }
    const projector2: &TensorView = tensor_lookup(table, "audio_projector.linear2.weight\0" as &const byte);
    if projector2 == null { _ = printf("error: audio real bind missing tensor audio_projector.linear2.weight\n"); return false; }
    if projector2.n_dims == 2 && config.llm_hidden_size == 0 { config.llm_hidden_size = projector2.shape[1] as u32; }
    if config.layer_count == 0 { config.layer_count = audio_count_real_layers_from_tensors(table); }
    const mlp0: &TensorView = audio_lookup_real_layer(table, 0, "mlp.0.weight\0" as &const byte);
    if mlp0 != null && mlp0.n_dims == 2 && config.intermediate_size == 0 { config.intermediate_size = mlp0.shape[1] as u32; }
    if config.head_count == 0 { config.head_count = 1; }
    if config.frame_count == 0 || config.mel_bin_count == 0 || config.hidden_size == 0 || config.layer_count == 0 || config.head_count == 0 || config.intermediate_size == 0 || config.llm_hidden_size == 0 {
        _ = printf("error: audio real config incomplete frames=%u mel_bins=%u hidden=%u layers=%u heads=%u ffn=%u llm_hidden=%u\n", config.frame_count, config.mel_bin_count, config.hidden_size, config.layer_count, config.head_count, config.intermediate_size, config.llm_hidden_size);
        return false;
    }
    if config.filter_bin_count == 0 { _ = printf("error: audio real config missing n_fft/filter bin metadata\n"); return false; }
    if !config.has_filters { _ = printf("error: audio real config missing filters metadata array\n"); return false; }
    const expected_filters: u64 = (config.mel_bin_count as u64) * (config.filter_bin_count as u64);
    if config.filter_value_count != expected_filters { _ = printf("error: audio real filters count=%llu expected=%llu mel_bins=%u filter_bins=%u\n", config.filter_value_count, expected_filters, config.mel_bin_count, config.filter_bin_count); return false; }
    if config.hidden_size % config.head_count != 0 { _ = printf("error: audio real hidden_size=%u not divisible by head_count=%u\n", config.hidden_size, config.head_count); return false; }
    config.head_dim = config.hidden_size / config.head_count;
    return true;
}

fn audio_check_real_matrix(table: &TensorWeightTable, name: &const byte, in_dim: u32, out_dim: u32, label: &const byte, checked: &u32) bool {
    const view: &TensorView = audio_require_tensor(table, name, label);
    if view == null { return false; }
    if !audio_check_matrix(view, in_dim, out_dim, label) { return false; }
    checked[0] = checked[0] + 1;
    return true;
}

fn audio_check_real_vec(table: &TensorWeightTable, name: &const byte, len: u32, label: &const byte, checked: &u32) bool {
    const view: &TensorView = audio_require_tensor(table, name, label);
    if view == null { return false; }
    if !audio_check_vec_loose(view, len, label) { return false; }
    checked[0] = checked[0] + 1;
    return true;
}

fn audio_check_real_layer_matrix(table: &TensorWeightTable, layer: u32, suffix: &const byte, in_dim: u32, out_dim: u32, label: &const byte, checked: &u32) bool {
    const view: &TensorView = audio_require_real_layer(table, layer, suffix, label);
    if view == null { return false; }
    if !audio_check_matrix(view, in_dim, out_dim, label) { return false; }
    checked[0] = checked[0] + 1;
    return true;
}

fn audio_check_real_layer_vec(table: &TensorWeightTable, layer: u32, suffix: &const byte, len: u32, label: &const byte, checked: &u32) bool {
    const view: &TensorView = audio_require_real_layer(table, layer, suffix, label);
    if view == null { return false; }
    if !audio_check_vec_loose(view, len, label) { return false; }
    checked[0] = checked[0] + 1;
    return true;
}

fn audio_real_bind_check(table: &TensorWeightTable, config: &AudioConfig, checked: &u32) bool {
    checked[0] = 0;
    var view: &TensorView = audio_require_tensor(table, "encoder.conv1.weight\0" as &const byte, "conv1 weight\0" as &const byte);
    if view == null || !audio_check_conv1_real(view, config.mel_bin_count, config.hidden_size) { return false; }
    checked[0] = checked[0] + 1;
    if !audio_check_real_vec(table, "encoder.conv1.bias\0" as &const byte, config.hidden_size, "conv1 bias\0" as &const byte, checked) { return false; }
    view = audio_require_tensor(table, "encoder.conv2.weight\0" as &const byte, "conv2 weight\0" as &const byte);
    if view == null || !audio_check_conv2_real(view, config.hidden_size) { return false; }
    checked[0] = checked[0] + 1;
    if !audio_check_real_vec(table, "encoder.conv2.bias\0" as &const byte, config.hidden_size, "conv2 bias\0" as &const byte, checked) { return false; }
    view = audio_require_tensor(table, "encoder.positional_embedding\0" as &const byte, "positional embedding\0" as &const byte);
    if view == null || !audio_check_position_real(view, config.frame_count, config.hidden_size) { return false; }
    checked[0] = checked[0] + 1;
    if !audio_check_real_vec(table, "encoder.ln_post.weight\0" as &const byte, config.hidden_size, "ln_post weight\0" as &const byte, checked) { return false; }
    if !audio_check_real_vec(table, "encoder.ln_post.bias\0" as &const byte, config.hidden_size, "ln_post bias\0" as &const byte, checked) { return false; }
    if !audio_check_real_matrix(table, "audio_projector.linear1.weight\0" as &const byte, config.hidden_size, config.llm_hidden_size, "audio projector linear1 weight\0" as &const byte, checked) { return false; }
    if !audio_check_real_vec(table, "audio_projector.linear1.bias\0" as &const byte, config.llm_hidden_size, "audio projector linear1 bias\0" as &const byte, checked) { return false; }
    if !audio_check_real_matrix(table, "audio_projector.linear2.weight\0" as &const byte, config.llm_hidden_size, config.llm_hidden_size, "audio projector linear2 weight\0" as &const byte, checked) { return false; }
    if !audio_check_real_vec(table, "audio_projector.linear2.bias\0" as &const byte, config.llm_hidden_size, "audio projector linear2 bias\0" as &const byte, checked) { return false; }
    var layer: u32 = 0;
    while layer < config.layer_count {
        if !audio_check_real_layer_vec(table, layer, "attn_ln.weight\0" as &const byte, config.hidden_size, "attn_ln weight\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_vec(table, layer, "attn_ln.bias\0" as &const byte, config.hidden_size, "attn_ln bias\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_matrix(table, layer, "attn.query.weight\0" as &const byte, config.hidden_size, config.hidden_size, "attn query weight\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_vec(table, layer, "attn.query.bias\0" as &const byte, config.hidden_size, "attn query bias\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_matrix(table, layer, "attn.key.weight\0" as &const byte, config.hidden_size, config.hidden_size, "attn key weight\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_matrix(table, layer, "attn.value.weight\0" as &const byte, config.hidden_size, config.hidden_size, "attn value weight\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_vec(table, layer, "attn.value.bias\0" as &const byte, config.hidden_size, "attn value bias\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_matrix(table, layer, "attn.out.weight\0" as &const byte, config.hidden_size, config.hidden_size, "attn out weight\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_vec(table, layer, "attn.out.bias\0" as &const byte, config.hidden_size, "attn out bias\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_vec(table, layer, "mlp_ln.weight\0" as &const byte, config.hidden_size, "mlp_ln weight\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_vec(table, layer, "mlp_ln.bias\0" as &const byte, config.hidden_size, "mlp_ln bias\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_matrix(table, layer, "mlp.0.weight\0" as &const byte, config.hidden_size, config.intermediate_size, "mlp 0 weight\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_vec(table, layer, "mlp.0.bias\0" as &const byte, config.intermediate_size, "mlp 0 bias\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_matrix(table, layer, "mlp.2.weight\0" as &const byte, config.intermediate_size, config.hidden_size, "mlp 2 weight\0" as &const byte, checked) { return false; }
        if !audio_check_real_layer_vec(table, layer, "mlp.2.bias\0" as &const byte, config.hidden_size, "mlp 2 bias\0" as &const byte, checked) { return false; }
        layer = layer + 1;
    }
    return true;
}

export fn audio_real_bind_file(path: &const byte) bool {
    var config: AudioConfig = audio_config_init();
    if !audio_config_load_metadata(path, &config) { return false; }
    var table: TensorWeightTable = tensor_table_init();
    if !tensor_weight_table_load(path, &table) { return false; }
    if !audio_real_complete_config(&config, &table) { return false; }
    var checked: u32 = 0;
    if !audio_real_bind_check(&table, &config, &checked) { return false; }
    _ = printf("audio-real config: frames=%u mel_bins=%u filter_bins=%u filters=%llu hidden=%u layers=%u heads=%u head_dim=%u ffn=%u llm_hidden=%u\n", config.frame_count, config.mel_bin_count, config.filter_bin_count, config.filter_value_count, config.hidden_size, config.layer_count, config.head_count, config.head_dim, config.intermediate_size, config.llm_hidden_size);
    _ = printf("audio-real bind: conv1=encoder.conv1.weight conv2=encoder.conv2.weight pos=encoder.positional_embedding projector=audio_projector.linear1/2 checked_tensors=%u layers=%u\n", checked, config.layer_count);
    _ = printf("audio-real layer[0]: attn_ln=encoder.blocks.0.attn_ln.weight q=encoder.blocks.0.attn.query.weight k=encoder.blocks.0.attn.key.weight v=encoder.blocks.0.attn.value.weight\n");
    _ = printf("audio-real layer[0]: out=encoder.blocks.0.attn.out.weight mlp0=encoder.blocks.0.mlp.0.weight mlp2=encoder.blocks.0.mlp.2.weight\n");
    _ = printf("audio-real bind: PASS\n");
    return true;
}

export fn audio_real_bind_cli(path: &const byte) i32 {
    if !audio_real_bind_file(path) { return 1; }
    return 0;
}

fn audio_real_clock_us() u64 {
    return clock() as u64;
}

fn audio_real_conv_output_tokens(input_tokens: usize, kernel: usize, stride: usize) usize {
    if input_tokens == 0 || kernel == 0 || stride == 0 { return 0; }
    const pad: usize = kernel / 2;
    if input_tokens + (pad * 2) < kernel { return 0; }
    return ((input_tokens + (pad * 2) - kernel) / stride) + 1;
}

fn audio_real_pool_output_tokens(input_tokens: usize) usize {
    if input_tokens < AUDIO_REAL_POOL_KERNEL as usize { return 0; }
    return ((input_tokens - (AUDIO_REAL_POOL_KERNEL as usize)) / (AUDIO_REAL_POOL_STRIDE as usize)) + 1;
}

fn audio_real_alloc_f32(count: usize, label: &const byte) &f32 {
    const ptr: &f32 = calloc(count, 4) as &f32;
    if ptr == null { _ = printf("error: audio-real-encode allocation failed label=%s count=%zu\n", label, count); }
    return ptr;
}

fn audio_real_layer_norm_tensor(dst: &f32, src: &const f32, weight: &TensorView, bias: &TensorView, len: usize) void {
    var mean: f32 = 0.0;
    var i: usize = 0;
    while i < len { mean = mean + src[i]; i = i + 1; }
    mean = mean / (len as f32);
    var var_sum: f32 = 0.0;
    i = 0;
    while i < len {
        const delta: f32 = src[i] - mean;
        var_sum = var_sum + delta * delta;
        i = i + 1;
    }
    const scale: f32 = 1.0 / sqrtf(var_sum / (len as f32) + AUDIO_REAL_LAYER_NORM_EPS);
    i = 0;
    while i < len {
        dst[i] = (src[i] - mean) * scale * qwen3_tensor_get(weight, i) + qwen3_tensor_get(bias, i);
        i = i + 1;
    }
}

fn audio_real_matvec_bias(dst: &f32, matrix: &TensorView, bias: &TensorView, src: &const f32, in_dim: usize, out_dim: usize, use_gelu: bool, use_relu: bool) void {
    var out_index: usize = 0;
    while out_index < out_dim {
        var sum: f32 = 0.0;
        if bias != null { sum = qwen3_tensor_get(bias, out_index); }
        var in_index: usize = 0;
        while in_index < in_dim {
            sum = sum + src[in_index] * qwen3_tensor_get(matrix, in_index * out_dim + out_index);
            in_index = in_index + 1;
        }
        if use_gelu { sum = gelu(sum); }
        if use_relu && sum < 0.0 { sum = 0.0; }
        dst[out_index] = sum;
        out_index = out_index + 1;
    }
}

fn audio_real_position_value(view: &TensorView, hidden_size: usize, token_index: usize, hidden_index: usize) f32 {
    if view.n_dims != 2 { return 0.0 as f32; }
    if view.shape[0] == hidden_size as u64 {
        return qwen3_tensor_get(view, hidden_index * (view.shape[1] as usize) + token_index);
    }
    return qwen3_tensor_get(view, token_index * hidden_size + hidden_index);
}

fn audio_real_mel_to_frame_major(mel_values: &const f32, mel_frames: usize, mel_bins: usize, frame_major: &f32) void {
    var frame: usize = 0;
    while frame < mel_frames {
        var mel: usize = 0;
        while mel < mel_bins {
            frame_major[frame * mel_bins + mel] = mel_values[mel * mel_frames + frame];
            mel = mel + 1;
        }
        frame = frame + 1;
    }
}

fn audio_real_conv1d_same_from_mel(dst: &f32, mel_frames: usize, mel_bins: usize, mel_frame_major: &const f32, weight: &TensorView, bias: &TensorView, stride: usize, out_hidden: usize, out_tokens: &usize) bool {
    const kernel: usize = weight.shape[0] as usize;
    const pad: i32 = (kernel / 2) as i32;
    out_tokens[0] = audio_real_conv_output_tokens(mel_frames, kernel, stride);
    if out_tokens[0] == 0 { return false; }
    var out_token: usize = 0;
    while out_token < out_tokens[0] {
        var out_hidden_index: usize = 0;
        while out_hidden_index < out_hidden {
            var sum: f32 = qwen3_tensor_get(bias, out_hidden_index);
            var k: usize = 0;
            while k < kernel {
                const src_token_signed: i32 = (out_token * stride + k) as i32 - pad;
                if src_token_signed >= 0 && src_token_signed < mel_frames as i32 {
                    const src_token: usize = src_token_signed as usize;
                    var mel: usize = 0;
                    while mel < mel_bins {
                        const src_value: f32 = mel_frame_major[src_token * mel_bins + mel];
                        sum = sum + src_value * qwen3_tensor_get(weight, ((k * mel_bins + mel) * out_hidden) + out_hidden_index);
                        mel = mel + 1;
                    }
                }
                k = k + 1;
            }
            dst[out_token * out_hidden + out_hidden_index] = gelu(sum);
            out_hidden_index = out_hidden_index + 1;
        }
        out_token = out_token + 1;
    }
    return true;
}

fn audio_real_conv1d_same_hidden(dst: &f32, src_tokens: usize, src: &const f32, weight: &TensorView, bias: &TensorView, stride: usize, hidden: usize, out_tokens: &usize) bool {
    const kernel: usize = weight.shape[0] as usize;
    const pad: i32 = (kernel / 2) as i32;
    out_tokens[0] = audio_real_conv_output_tokens(src_tokens, kernel, stride);
    if out_tokens[0] == 0 { return false; }
    var out_token: usize = 0;
    while out_token < out_tokens[0] {
        var out_hidden_index: usize = 0;
        while out_hidden_index < hidden {
            var sum: f32 = qwen3_tensor_get(bias, out_hidden_index);
            var k: usize = 0;
            while k < kernel {
                const src_token_signed: i32 = (out_token * stride + k) as i32 - pad;
                if src_token_signed >= 0 && src_token_signed < src_tokens as i32 {
                    const src_token: usize = src_token_signed as usize;
                    var in_hidden_index: usize = 0;
                    while in_hidden_index < hidden {
                        sum = sum + src[src_token * hidden + in_hidden_index] * qwen3_tensor_get(weight, ((k * hidden + in_hidden_index) * hidden) + out_hidden_index);
                        in_hidden_index = in_hidden_index + 1;
                    }
                }
                k = k + 1;
            }
            dst[out_token * hidden + out_hidden_index] = gelu(sum);
            out_hidden_index = out_hidden_index + 1;
        }
        out_token = out_token + 1;
    }
    return true;
}

fn audio_real_attention_token(dst: &f32, q_values: &const f32, k_values: &const f32, v_values: &const f32, token_count: usize, head_count: usize, head_dim: usize, token_index: usize, scores: &f32, probs: &f32) void {
    var hidden_index: usize = 0;
    while hidden_index < head_count * head_dim { dst[hidden_index] = 0.0; hidden_index = hidden_index + 1; }
    const scale: f32 = 1.0 / sqrtf(head_dim as f32);
    var head_index: usize = 0;
    while head_index < head_count {
        var key_token: usize = 0;
        while key_token < token_count {
            var dot: f32 = 0.0;
            var dim_index: usize = 0;
            while dim_index < head_dim {
                const offset: usize = head_index * head_dim + dim_index;
                dot = dot + q_values[token_index * head_count * head_dim + offset] * k_values[key_token * head_count * head_dim + offset];
                dim_index = dim_index + 1;
            }
            scores[key_token] = dot * scale;
            key_token = key_token + 1;
        }
        softmax(probs, scores as &const f32, token_count);
        var out_dim: usize = 0;
        while out_dim < head_dim {
            var sum: f32 = 0.0;
            var value_token: usize = 0;
            while value_token < token_count {
                const offset2: usize = head_index * head_dim + out_dim;
                sum = sum + probs[value_token] * v_values[value_token * head_count * head_dim + offset2];
                value_token = value_token + 1;
            }
            dst[head_index * head_dim + out_dim] = sum;
            out_dim = out_dim + 1;
        }
        head_index = head_index + 1;
    }
}

fn audio_real_forward(table: &TensorWeightTable, config: &AudioConfig, mel_values: &const f32, mel_frames: usize, embeddings: &f32, span_count: &usize) bool {
    const hidden: usize = config.hidden_size as usize;
    const head_count: usize = config.head_count as usize;
    const head_dim: usize = config.head_dim as usize;
    const ffn: usize = config.intermediate_size as usize;
    const llm_hidden: usize = config.llm_hidden_size as usize;
    const conv_tokens: usize = audio_real_conv_output_tokens(mel_frames, 3, 2);
    const pooled_tokens: usize = audio_real_pool_output_tokens(conv_tokens);
    if conv_tokens == 0 || pooled_tokens == 0 { _ = printf("error: audio-real-encode invalid token plan mel_frames=%zu conv_tokens=%zu pooled_tokens=%zu\n", mel_frames, conv_tokens, pooled_tokens); return false; }
    if conv_tokens > config.frame_count as usize { _ = printf("error: audio-real-encode conv_tokens=%zu exceed position context=%u\n", conv_tokens, config.frame_count); return false; }

    const mel_frame_major_count: usize = mel_frames * (config.mel_bin_count as usize);
    var mel_frame_major: &f32 = audio_real_alloc_f32(mel_frame_major_count, "mel-frame-major\0" as &const byte);
    var conv1_states: &f32 = audio_real_alloc_f32(mel_frames * hidden, "conv1-states\0" as &const byte);
    var states: &f32 = audio_real_alloc_f32(conv_tokens * hidden, "states\0" as &const byte);
    var normed: &f32 = audio_real_alloc_f32(conv_tokens * hidden, "normed\0" as &const byte);
    var q_values: &f32 = audio_real_alloc_f32(conv_tokens * hidden, "q-values\0" as &const byte);
    var k_values: &f32 = audio_real_alloc_f32(conv_tokens * hidden, "k-values\0" as &const byte);
    var v_values: &f32 = audio_real_alloc_f32(conv_tokens * hidden, "v-values\0" as &const byte);
    var attn_ctx: &f32 = audio_real_alloc_f32(conv_tokens * hidden, "attn-ctx\0" as &const byte);
    var tmp_out: &f32 = audio_real_alloc_f32(conv_tokens * hidden, "tmp-out\0" as &const byte);
    var ffn_hidden: &f32 = audio_real_alloc_f32(conv_tokens * ffn, "ffn-hidden\0" as &const byte);
    var projector_1: &f32 = audio_real_alloc_f32(conv_tokens * llm_hidden, "projector-1\0" as &const byte);
    var projector_2: &f32 = audio_real_alloc_f32(conv_tokens * llm_hidden, "projector-2\0" as &const byte);
    var scores: &f32 = audio_real_alloc_f32(conv_tokens, "scores\0" as &const byte);
    var probs: &f32 = audio_real_alloc_f32(conv_tokens, "probs\0" as &const byte);
    if mel_frame_major == null || conv1_states == null || states == null || normed == null || q_values == null || k_values == null || v_values == null || attn_ctx == null || tmp_out == null || ffn_hidden == null || projector_1 == null || projector_2 == null || scores == null || probs == null {
        if mel_frame_major != null { free(mel_frame_major as &void); }
        if conv1_states != null { free(conv1_states as &void); }
        if states != null { free(states as &void); }
        if normed != null { free(normed as &void); }
        if q_values != null { free(q_values as &void); }
        if k_values != null { free(k_values as &void); }
        if v_values != null { free(v_values as &void); }
        if attn_ctx != null { free(attn_ctx as &void); }
        if tmp_out != null { free(tmp_out as &void); }
        if ffn_hidden != null { free(ffn_hidden as &void); }
        if projector_1 != null { free(projector_1 as &void); }
        if projector_2 != null { free(projector_2 as &void); }
        if scores != null { free(scores as &void); }
        if probs != null { free(probs as &void); }
        return false;
    }

    audio_real_mel_to_frame_major(mel_values, mel_frames, config.mel_bin_count as usize, mel_frame_major);

    const conv1_w: &TensorView = audio_require_tensor(table, "encoder.conv1.weight\0" as &const byte, "conv1 weight\0" as &const byte);
    const conv1_b: &TensorView = audio_require_tensor(table, "encoder.conv1.bias\0" as &const byte, "conv1 bias\0" as &const byte);
    const conv2_w: &TensorView = audio_require_tensor(table, "encoder.conv2.weight\0" as &const byte, "conv2 weight\0" as &const byte);
    const conv2_b: &TensorView = audio_require_tensor(table, "encoder.conv2.bias\0" as &const byte, "conv2 bias\0" as &const byte);
    const pos_view: &TensorView = audio_require_tensor(table, "encoder.positional_embedding\0" as &const byte, "position embedding\0" as &const byte);
    const ln_post_w: &TensorView = audio_require_tensor(table, "encoder.ln_post.weight\0" as &const byte, "ln post weight\0" as &const byte);
    const ln_post_b: &TensorView = audio_require_tensor(table, "encoder.ln_post.bias\0" as &const byte, "ln post bias\0" as &const byte);
    const proj1_w: &TensorView = audio_require_tensor(table, "audio_projector.linear1.weight\0" as &const byte, "projector 1 weight\0" as &const byte);
    const proj1_b: &TensorView = audio_require_tensor(table, "audio_projector.linear1.bias\0" as &const byte, "projector 1 bias\0" as &const byte);
    const proj2_w: &TensorView = audio_require_tensor(table, "audio_projector.linear2.weight\0" as &const byte, "projector 2 weight\0" as &const byte);
    const proj2_b: &TensorView = audio_require_tensor(table, "audio_projector.linear2.bias\0" as &const byte, "projector 2 bias\0" as &const byte);
    if conv1_w == null || conv1_b == null || conv2_w == null || conv2_b == null || pos_view == null || ln_post_w == null || ln_post_b == null || proj1_w == null || proj1_b == null || proj2_w == null || proj2_b == null {
        free(mel_frame_major as &void); free(conv1_states as &void); free(states as &void); free(normed as &void); free(q_values as &void); free(k_values as &void); free(v_values as &void); free(attn_ctx as &void); free(tmp_out as &void); free(ffn_hidden as &void); free(projector_1 as &void); free(projector_2 as &void); free(scores as &void); free(probs as &void);
        return false;
    }

    var conv1_tokens: usize = 0;
    var conv2_tokens: usize = 0;
    if !audio_real_conv1d_same_from_mel(conv1_states, mel_frames, config.mel_bin_count as usize, mel_frame_major as &const f32, conv1_w, conv1_b, 1, hidden, &conv1_tokens) {
        free(mel_frame_major as &void); free(conv1_states as &void); free(states as &void); free(normed as &void); free(q_values as &void); free(k_values as &void); free(v_values as &void); free(attn_ctx as &void); free(tmp_out as &void); free(ffn_hidden as &void); free(projector_1 as &void); free(projector_2 as &void); free(scores as &void); free(probs as &void);
        _ = printf("error: audio-real-encode conv1 forward failed\n");
        return false;
    }
    if !audio_real_conv1d_same_hidden(states, conv1_tokens, conv1_states as &const f32, conv2_w, conv2_b, 2, hidden, &conv2_tokens) {
        free(mel_frame_major as &void); free(conv1_states as &void); free(states as &void); free(normed as &void); free(q_values as &void); free(k_values as &void); free(v_values as &void); free(attn_ctx as &void); free(tmp_out as &void); free(ffn_hidden as &void); free(projector_1 as &void); free(projector_2 as &void); free(scores as &void); free(probs as &void);
        _ = printf("error: audio-real-encode conv2 forward failed\n");
        return false;
    }
    if conv2_tokens != conv_tokens {
        free(mel_frame_major as &void); free(conv1_states as &void); free(states as &void); free(normed as &void); free(q_values as &void); free(k_values as &void); free(v_values as &void); free(attn_ctx as &void); free(tmp_out as &void); free(ffn_hidden as &void); free(projector_1 as &void); free(projector_2 as &void); free(scores as &void); free(probs as &void);
        _ = printf("error: audio-real-encode conv token mismatch expected=%zu got=%zu\n", conv_tokens, conv2_tokens);
        return false;
    }

    var token_index: usize = 0;
    while token_index < conv_tokens {
        var hidden_index: usize = 0;
        while hidden_index < hidden {
            states[token_index * hidden + hidden_index] = states[token_index * hidden + hidden_index] + audio_real_position_value(pos_view, hidden, token_index, hidden_index);
            hidden_index = hidden_index + 1;
        }
        token_index = token_index + 1;
    }

    var layer_index: u32 = 0;
    while layer_index < config.layer_count {
        const attn_ln_w: &TensorView = audio_require_real_layer(table, layer_index, "attn_ln.weight\0" as &const byte, "attn ln weight\0" as &const byte);
        const attn_ln_b: &TensorView = audio_require_real_layer(table, layer_index, "attn_ln.bias\0" as &const byte, "attn ln bias\0" as &const byte);
        const q_w: &TensorView = audio_require_real_layer(table, layer_index, "attn.query.weight\0" as &const byte, "attn query weight\0" as &const byte);
        const q_b: &TensorView = audio_require_real_layer(table, layer_index, "attn.query.bias\0" as &const byte, "attn query bias\0" as &const byte);
        const k_w: &TensorView = audio_require_real_layer(table, layer_index, "attn.key.weight\0" as &const byte, "attn key weight\0" as &const byte);
        const v_w: &TensorView = audio_require_real_layer(table, layer_index, "attn.value.weight\0" as &const byte, "attn value weight\0" as &const byte);
        const v_b: &TensorView = audio_require_real_layer(table, layer_index, "attn.value.bias\0" as &const byte, "attn value bias\0" as &const byte);
        const out_w: &TensorView = audio_require_real_layer(table, layer_index, "attn.out.weight\0" as &const byte, "attn out weight\0" as &const byte);
        const out_b: &TensorView = audio_require_real_layer(table, layer_index, "attn.out.bias\0" as &const byte, "attn out bias\0" as &const byte);
        const mlp_ln_w: &TensorView = audio_require_real_layer(table, layer_index, "mlp_ln.weight\0" as &const byte, "mlp ln weight\0" as &const byte);
        const mlp_ln_b: &TensorView = audio_require_real_layer(table, layer_index, "mlp_ln.bias\0" as &const byte, "mlp ln bias\0" as &const byte);
        const mlp0_w: &TensorView = audio_require_real_layer(table, layer_index, "mlp.0.weight\0" as &const byte, "mlp 0 weight\0" as &const byte);
        const mlp0_b: &TensorView = audio_require_real_layer(table, layer_index, "mlp.0.bias\0" as &const byte, "mlp 0 bias\0" as &const byte);
        const mlp2_w: &TensorView = audio_require_real_layer(table, layer_index, "mlp.2.weight\0" as &const byte, "mlp 2 weight\0" as &const byte);
        const mlp2_b: &TensorView = audio_require_real_layer(table, layer_index, "mlp.2.bias\0" as &const byte, "mlp 2 bias\0" as &const byte);
        if attn_ln_w == null || attn_ln_b == null || q_w == null || q_b == null || k_w == null || v_w == null || v_b == null || out_w == null || out_b == null || mlp_ln_w == null || mlp_ln_b == null || mlp0_w == null || mlp0_b == null || mlp2_w == null || mlp2_b == null {
            free(mel_frame_major as &void); free(conv1_states as &void); free(states as &void); free(normed as &void); free(q_values as &void); free(k_values as &void); free(v_values as &void); free(attn_ctx as &void); free(tmp_out as &void); free(ffn_hidden as &void); free(projector_1 as &void); free(projector_2 as &void); free(scores as &void); free(probs as &void);
            return false;
        }

        token_index = 0;
        while token_index < conv_tokens {
            audio_real_layer_norm_tensor(&normed[token_index * hidden], &states[token_index * hidden] as &const f32, attn_ln_w, attn_ln_b, hidden);
            audio_real_matvec_bias(&q_values[token_index * hidden], q_w, q_b, &normed[token_index * hidden] as &const f32, hidden, hidden, false, false);
            audio_real_matvec_bias(&k_values[token_index * hidden], k_w, null, &normed[token_index * hidden] as &const f32, hidden, hidden, false, false);
            audio_real_matvec_bias(&v_values[token_index * hidden], v_w, v_b, &normed[token_index * hidden] as &const f32, hidden, hidden, false, false);
            token_index = token_index + 1;
        }

        token_index = 0;
        while token_index < conv_tokens {
            audio_real_attention_token(&attn_ctx[token_index * hidden], q_values as &const f32, k_values as &const f32, v_values as &const f32, conv_tokens, head_count, head_dim, token_index, scores, probs);
            audio_real_matvec_bias(&tmp_out[token_index * hidden], out_w, out_b, &attn_ctx[token_index * hidden] as &const f32, hidden, hidden, false, false);
            var hidden_index2: usize = 0;
            while hidden_index2 < hidden {
                states[token_index * hidden + hidden_index2] = states[token_index * hidden + hidden_index2] + tmp_out[token_index * hidden + hidden_index2];
                hidden_index2 = hidden_index2 + 1;
            }
            token_index = token_index + 1;
        }

        token_index = 0;
        while token_index < conv_tokens {
            audio_real_layer_norm_tensor(&normed[token_index * hidden], &states[token_index * hidden] as &const f32, mlp_ln_w, mlp_ln_b, hidden);
            audio_real_matvec_bias(&ffn_hidden[token_index * ffn], mlp0_w, mlp0_b, &normed[token_index * hidden] as &const f32, hidden, ffn, true, false);
            audio_real_matvec_bias(&tmp_out[token_index * hidden], mlp2_w, mlp2_b, &ffn_hidden[token_index * ffn] as &const f32, ffn, hidden, false, false);
            var hidden_index3: usize = 0;
            while hidden_index3 < hidden {
                states[token_index * hidden + hidden_index3] = states[token_index * hidden + hidden_index3] + tmp_out[token_index * hidden + hidden_index3];
                hidden_index3 = hidden_index3 + 1;
            }
            token_index = token_index + 1;
        }
        layer_index = layer_index + 1;
    }

    token_index = 0;
    while token_index < conv_tokens {
        audio_real_layer_norm_tensor(&normed[token_index * hidden], &states[token_index * hidden] as &const f32, ln_post_w, ln_post_b, hidden);
        audio_real_matvec_bias(&projector_1[token_index * llm_hidden], proj1_w, proj1_b, &normed[token_index * hidden] as &const f32, hidden, llm_hidden, false, true);
        audio_real_matvec_bias(&projector_2[token_index * llm_hidden], proj2_w, proj2_b, &projector_1[token_index * llm_hidden] as &const f32, llm_hidden, llm_hidden, false, false);
        token_index = token_index + 1;
    }

    var pooled_index: usize = 0;
    while pooled_index < pooled_tokens {
        var out_hidden_index: usize = 0;
        while out_hidden_index < llm_hidden {
            var sum: f32 = 0.0;
            var pool_index: usize = 0;
            while pool_index < AUDIO_REAL_POOL_KERNEL as usize {
                const src_token: usize = pooled_index * (AUDIO_REAL_POOL_STRIDE as usize) + pool_index;
                sum = sum + projector_2[src_token * llm_hidden + out_hidden_index];
                pool_index = pool_index + 1;
            }
            embeddings[pooled_index * llm_hidden + out_hidden_index] = sum / (AUDIO_REAL_POOL_KERNEL as f32);
            out_hidden_index = out_hidden_index + 1;
        }
        pooled_index = pooled_index + 1;
    }

    span_count[0] = pooled_tokens;
    free(mel_frame_major as &void);
    free(conv1_states as &void);
    free(states as &void);
    free(normed as &void);
    free(q_values as &void);
    free(k_values as &void);
    free(v_values as &void);
    free(attn_ctx as &void);
    free(tmp_out as &void);
    free(ffn_hidden as &void);
    free(projector_1 as &void);
    free(projector_2 as &void);
    free(scores as &void);
    free(probs as &void);
    return true;
}

fn audio_real_encode_with_session(session: &AudioRealEncoderSession, audio_path: &const byte, role: &const byte, span: &AudioRealEncodedSpan) bool {
    span[0] = audio_real_encoded_span_init();
    if !session.ready {
        _ = printf("error: audio-real-encode session is not ready\n");
        return false;
    }
    var pcm: AudioRealPcmHeap = audio_real_pcm_heap_init();
    if !audio_real_load_samples_file(audio_path, role, &pcm) { return false; }
    const aligned_samples: u64 = audio_real_aligned_sample_count(pcm.sample_count);
    const padded_samples: u64 = aligned_samples + (AUDIO_REAL_CENTER_PAD as u64) * (2 as u64);
    const mel_frames_u64: u64 = (padded_samples - (AUDIO_REAL_FRAME_SIZE as u64)) / (AUDIO_REAL_HOP_LENGTH as u64);
    const mel_count: u64 = mel_frames_u64 * (AUDIO_REAL_MEL_BINS as u64);
    if mel_frames_u64 == 0 || mel_count == 0 { _ = printf("error: audio-real-encode[%s] empty mel frames\n", role); audio_real_pcm_heap_free(&pcm); return false; }
    var mel_values: &f32 = audio_real_alloc_f32(mel_count as usize, "mel-values\0" as &const byte);
    if mel_values == null { audio_real_pcm_heap_free(&pcm); return false; }
    if !audio_real_mel_compute(&pcm, &session.filters, session.cos_table as &const f32, session.sin_table as &const f32, mel_values, mel_frames_u64, aligned_samples) { free(mel_values as &void); audio_real_pcm_heap_free(&pcm); return false; }

    const conv_tokens: usize = audio_real_conv_output_tokens(mel_frames_u64 as usize, 3, 2);
    const pooled_tokens: usize = audio_real_pool_output_tokens(conv_tokens);
    if pooled_tokens == 0 { _ = printf("error: audio-real-encode[%s] pooled_tokens=0 conv_tokens=%zu\n", role, conv_tokens); free(mel_values as &void); audio_real_pcm_heap_free(&pcm); return false; }
    span.values = audio_real_alloc_f32(pooled_tokens * (session.config.llm_hidden_size as usize), "embeddings\0" as &const byte);
    if span.values == null { free(mel_values as &void); audio_real_pcm_heap_free(&pcm); return false; }
    const encode_start_us: u64 = audio_real_clock_us();
    if !audio_real_forward(&session.table, &session.config, mel_values as &const f32, mel_frames_u64 as usize, span.values, &span.span_count) {
        audio_real_encoded_span_free(span); free(mel_values as &void); audio_real_pcm_heap_free(&pcm); return false;
    }
    span.encode_us = audio_real_clock_us() - encode_start_us;
    span.sample_count = pcm.sample_count;
    span.mel_frames = mel_frames_u64;
    span.conv_tokens = conv_tokens;
    span.hidden_size = session.config.llm_hidden_size as usize;
    span.checksum = audio_checksum(span.values as &const f32, span.span_count * span.hidden_size);
    free(mel_values as &void);
    audio_real_pcm_heap_free(&pcm);
    return true;
}

fn audio_real_encode_collect(audio_model_path: &const byte, audio_path: &const byte, role: &const byte, span: &AudioRealEncodedSpan) bool {
    var session: AudioRealEncoderSession = audio_real_encoder_session_init();
    if !audio_real_encoder_session_open(audio_model_path, &session) { return false; }
    const ok: bool = audio_real_encode_with_session(&session, audio_path, role, span);
    audio_real_encoder_session_free(&session);
    return ok;
}

export fn audio_real_encode_probe_file(audio_model_path: &const byte, audio_path: &const byte, role: &const byte) bool {
    var span: AudioRealEncodedSpan = audio_real_encoded_span_init();
    if !audio_real_encode_collect(audio_model_path, audio_path, role, &span) { return false; }
    _ = printf("audio-real-encode[%s]: audio=%s samples=%llu mel_frames=%llu conv_tokens=%zu pooled_tokens=%zu n_pos=%zu n_embd=%zu checksum=0x%x encode_ms=%.3f\n", role, audio_path, span.sample_count, span.mel_frames, span.conv_tokens, span.span_count, span.span_count, span.hidden_size, span.checksum, (span.encode_us as f64) / 1000.0);
    _ = printf("audio-real-encode[%s] values[0..5]: %.6f %.6f %.6f %.6f %.6f %.6f\n", role, span.values[0] as f64, span.values[1] as f64, span.values[2] as f64, span.values[3] as f64, span.values[4] as f64, span.values[5] as f64);
    audio_real_encoded_span_free(&span);
    return true;
}

export fn audio_real_encode_probe_cli(audio_model_path: &const byte, audio_path: &const byte) i32 {
    if !audio_real_encode_probe_file(audio_model_path, audio_path, "probe\0" as &const byte) { return 1; }
    _ = printf("audio-real-encode-probe: PASS\n");
    return 0;
}

fn audio2audio_real_append_user_span(config: &Qwen3Config, weights: &Qwen3Weights, tok: &Tokenizer, runtime: &Qwen3Runtime, audio_placeholder_id: u32, span: &AudioRealEncodedSpan, logits: &f32) bool {
    return qwen3_append_prompt_text(config, weights, tok, runtime, AUDIO2AUDIO_REAL_USER_AUDIO_PREFIX, logits) &&
           qwen3_append_prompt_embeddings(config, weights, runtime, audio_placeholder_id, span.values as &const f32, span.span_count, logits) &&
           qwen3_append_prompt_text(config, weights, tok, runtime, AUDIO2AUDIO_REAL_USER_AUDIO_SUFFIX, logits);
}

fn audio2audio_real_dump_embedding(label: &const byte, span: &AudioRealEncodedSpan) void {
    _ = printf("audio2audio-real embedding[%s] values[0..5]: %.6f %.6f %.6f %.6f %.6f %.6f\n", label, span.values[0] as f64, span.values[1] as f64, span.values[2] as f64, span.values[3] as f64, span.values[4] as f64, span.values[5] as f64);
}

export fn audio2audio_real_text_cli(llm_path: &const byte, audio_model_path: &const byte, ref_audio_path: &const byte, user_audio_path: &const byte, sampler_in: &Qwen3SamplerConfig, dump_embeddings: bool) i32 {
    const audio_load_start_us: u64 = audio_real_clock_us();
    var session: AudioRealEncoderSession = audio_real_encoder_session_init();
    if !audio_real_encoder_session_open(audio_model_path, &session) { return 1; }
    const audio_load_us: u64 = audio_real_clock_us() - audio_load_start_us;
    var ref_span: AudioRealEncodedSpan = audio_real_encoded_span_init();
    if !audio_real_encode_with_session(&session, ref_audio_path, "ref\0" as &const byte, &ref_span) { audio_real_encoder_session_free(&session); return 1; }
    var user_span: AudioRealEncodedSpan = audio_real_encoded_span_init();
    if !audio_real_encode_with_session(&session, user_audio_path, "user\0" as &const byte, &user_span) { audio_real_encoded_span_free(&ref_span); audio_real_encoder_session_free(&session); return 1; }
    if ref_span.hidden_size != user_span.hidden_size {
        _ = printf("error: audio2audio-real hidden mismatch ref=%zu user=%zu\n", ref_span.hidden_size, user_span.hidden_size);
        audio_real_encoded_span_free(&user_span);
        audio_real_encoded_span_free(&ref_span);
        audio_real_encoder_session_free(&session);
        return 1;
    }
    audio_real_encoder_session_free(&session);

    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    const load_start_us: u64 = audio_real_clock_us();
    if !qwen3_open_runtime(llm_path, &config, &table, &weights, &tok, &runtime) {
        audio_real_encoded_span_free(&user_span);
        audio_real_encoded_span_free(&ref_span);
        return 1;
    }
    const load_us: u64 = audio_real_clock_us() - load_start_us;
    if ref_span.hidden_size != config.hidden_size as usize {
        _ = printf("error: audio2audio-real projector output=%zu does not match qwen hidden=%u\n", ref_span.hidden_size, config.hidden_size);
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&user_span);
        audio_real_encoded_span_free(&ref_span);
        return 1;
    }

    var sampler: Qwen3SamplerConfig = sampler_in[0];
    if sampler.max_new_tokens == 0 { sampler.max_new_tokens = AUDIO2AUDIO_REAL_DEFAULT_MAX_NEW_TOKENS; }
    sampler.stop_token = tokenizer_chat_stop_token(&tok);
    qwen3_set_thread_count(sampler.threads);
    runtime.seed = sampler.seed;

    var audio_placeholder_id: u32 = 0;
    if !audio_real_single_token(&tok, "<audio>\0" as &const byte, &audio_placeholder_id) {
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&user_span);
        audio_real_encoded_span_free(&ref_span);
        return 1;
    }

    var logits: &f32 = calloc(config.vocab_size as usize, 4) as &f32;
    if logits == null {
        _ = printf("error: audio2audio-real logits allocation failed vocab=%u\n", config.vocab_size);
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&user_span);
        audio_real_encoded_span_free(&ref_span);
        return 1;
    }

    const prefill_start_us: u64 = audio_real_clock_us();
    if !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, AUDIO2AUDIO_REAL_SYSTEM_PREFIX, logits) ||
       !qwen3_append_prompt_embeddings(&config, &weights, &runtime, audio_placeholder_id, ref_span.values as &const f32, ref_span.span_count, logits) ||
       !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, AUDIO2AUDIO_REAL_SYSTEM_SUFFIX, logits) ||
       !audio2audio_real_append_user_span(&config, &weights, &tok, &runtime, audio_placeholder_id, &user_span, logits) ||
       !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, AUDIO2AUDIO_REAL_ASSISTANT_PROMPT, logits) {
        free(logits as &void);
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&user_span);
        audio_real_encoded_span_free(&ref_span);
        return 1;
    }
    const prefill_us: u64 = audio_real_clock_us() - prefill_start_us;
    const prompt_tokens: usize = runtime.total_tokens;

    _ = printf("audio2audio-real[text-only]: llm=%s ref_audio=%s user_audio=%s prompt_tokens=%zu stop_token=%u\n", llm_path, ref_audio_path, user_audio_path, prompt_tokens, sampler.stop_token);
    _ = printf("audio2audio-real[text-only]: ref_n_pos=%zu ref_checksum=0x%x ref_encode_ms=%.3f user_n_pos=%zu user_checksum=0x%x user_encode_ms=%.3f prefill_ms=%.3f audio_load_ms=%.3f llm_load_ms=%.3f\n", ref_span.span_count, ref_span.checksum, (ref_span.encode_us as f64) / 1000.0, user_span.span_count, user_span.checksum, (user_span.encode_us as f64) / 1000.0, (prefill_us as f64) / 1000.0, (audio_load_us as f64) / 1000.0, (load_us as f64) / 1000.0);
    if dump_embeddings {
        audio2audio_real_dump_embedding("ref\0" as &const byte, &ref_span);
        audio2audio_real_dump_embedding("user\0" as &const byte, &user_span);
    }

    var answer: [byte: AUDIO2AUDIO_REAL_ANSWER_CAP] = [];
    var answer_len: usize = 0;
    const decode_start_us: u64 = audio_real_clock_us();
    const rc: i32 = qwen3_generate_capture(&config, &weights, &runtime, &sampler, &tok, logits, "audio2audio-real answer\0" as &const byte, false, &answer[0], @len(answer), &answer_len);
    const decode_us: u64 = audio_real_clock_us() - decode_start_us;
    if rc == 0 {
        _ = printf("audio2audio-real[text-only]: answer_chars=%zu decode_ms=%.3f total_ms=%.3f\n", answer_len, (decode_us as f64) / 1000.0, ((audio_load_us + load_us + ref_span.encode_us + user_span.encode_us + prefill_us + decode_us) as f64) / 1000.0);
    }

    free(logits as &void);
    qwen3_close_runtime(&table, &tok, &runtime);
    audio_real_encoded_span_free(&user_span);
    audio_real_encoded_span_free(&ref_span);
    return rc;
}

export fn audio2audio_real_text_test_prefix_cli(llm_path: &const byte, audio_model_path: &const byte, ref_audio_path: &const byte, test_prefix: &const byte, test_count: u32, sampler_in: &Qwen3SamplerConfig, dump_embeddings: bool) i32 {
    if test_count < 2 { _ = printf("error: audio2audio-real text test-prefix requires count>=2\n"); return 1; }
    const audio_load_start_us: u64 = audio_real_clock_us();
    var session: AudioRealEncoderSession = audio_real_encoder_session_init();
    if !audio_real_encoder_session_open(audio_model_path, &session) { return 1; }
    const audio_load_us: u64 = audio_real_clock_us() - audio_load_start_us;
    var ref_span: AudioRealEncodedSpan = audio_real_encoded_span_init();
    if !audio_real_encode_with_session(&session, ref_audio_path, "ref\0" as &const byte, &ref_span) { audio_real_encoder_session_free(&session); return 1; }

    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    const load_start_us: u64 = audio_real_clock_us();
    if !qwen3_open_runtime(llm_path, &config, &table, &weights, &tok, &runtime) {
        audio_real_encoded_span_free(&ref_span);
        audio_real_encoder_session_free(&session);
        return 1;
    }
    const load_us: u64 = audio_real_clock_us() - load_start_us;
    if ref_span.hidden_size != config.hidden_size as usize {
        _ = printf("error: audio2audio-real projector output=%zu does not match qwen hidden=%u\n", ref_span.hidden_size, config.hidden_size);
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&ref_span);
        audio_real_encoder_session_free(&session);
        return 1;
    }

    var sampler: Qwen3SamplerConfig = sampler_in[0];
    if sampler.max_new_tokens == 0 { sampler.max_new_tokens = AUDIO2AUDIO_REAL_DEFAULT_MAX_NEW_TOKENS; }
    sampler.stop_token = tokenizer_chat_stop_token(&tok);
    qwen3_set_thread_count(sampler.threads);
    runtime.seed = sampler.seed;

    var audio_placeholder_id: u32 = 0;
    if !audio_real_single_token(&tok, "<audio>\0" as &const byte, &audio_placeholder_id) {
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&ref_span);
        audio_real_encoder_session_free(&session);
        return 1;
    }

    var logits: &f32 = calloc(config.vocab_size as usize, 4) as &f32;
    if logits == null {
        _ = printf("error: audio2audio-real logits allocation failed vocab=%u\n", config.vocab_size);
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&ref_span);
        audio_real_encoder_session_free(&session);
        return 1;
    }

    var prefill_us: u64 = 0;
    var append_start_us: u64 = audio_real_clock_us();
    if !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, AUDIO2AUDIO_REAL_SYSTEM_PREFIX, logits) ||
       !qwen3_append_prompt_embeddings(&config, &weights, &runtime, audio_placeholder_id, ref_span.values as &const f32, ref_span.span_count, logits) ||
       !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, AUDIO2AUDIO_REAL_SYSTEM_SUFFIX, logits) {
        free(logits as &void);
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&ref_span);
        audio_real_encoder_session_free(&session);
        return 1;
    }
    prefill_us = prefill_us + (audio_real_clock_us() - append_start_us);

    var total_user_n_pos: usize = 0;
    var total_user_encode_us: u64 = 0;
    var turn: u32 = 1;
    while turn < test_count {
        var user_path: [byte: 512] = [];
        const written: i32 = snprintf(&user_path[0] as *byte, @len(user_path), "%s_%04u.wav\0" as *const byte, test_prefix, turn);
        if written < 0 || (written as usize) >= @len(user_path) {
            _ = printf("error: audio2audio-real test user path too long prefix=%s turn=%u\n", test_prefix, turn);
            free(logits as &void);
            qwen3_close_runtime(&table, &tok, &runtime);
            audio_real_encoded_span_free(&ref_span);
            audio_real_encoder_session_free(&session);
            return 1;
        }
        var user_span: AudioRealEncodedSpan = audio_real_encoded_span_init();
        if !audio_real_encode_with_session(&session, &user_path[0] as &const byte, "user\0" as &const byte, &user_span) {
            free(logits as &void);
            qwen3_close_runtime(&table, &tok, &runtime);
            audio_real_encoded_span_free(&ref_span);
            audio_real_encoder_session_free(&session);
            return 1;
        }
        if user_span.hidden_size != config.hidden_size as usize {
            _ = printf("error: audio2audio-real user chunk hidden mismatch turn=%u chunk_hidden=%zu qwen_hidden=%u\n", turn, user_span.hidden_size, config.hidden_size);
            audio_real_encoded_span_free(&user_span);
            free(logits as &void);
            qwen3_close_runtime(&table, &tok, &runtime);
            audio_real_encoded_span_free(&ref_span);
            audio_real_encoder_session_free(&session);
            return 1;
        }
        total_user_n_pos = total_user_n_pos + user_span.span_count;
        total_user_encode_us = total_user_encode_us + user_span.encode_us;
        _ = printf("audio2audio-real[text-only]: user_chunk=%u path=%s n_pos=%zu checksum=0x%x encode_ms=%.3f\n", turn, &user_path[0], user_span.span_count, user_span.checksum, (user_span.encode_us as f64) / 1000.0);
        if dump_embeddings { audio2audio_real_dump_embedding(&user_path[0] as &const byte, &user_span); }
        append_start_us = audio_real_clock_us();
        if !audio2audio_real_append_user_span(&config, &weights, &tok, &runtime, audio_placeholder_id, &user_span, logits) {
            audio_real_encoded_span_free(&user_span);
            free(logits as &void);
            qwen3_close_runtime(&table, &tok, &runtime);
            audio_real_encoded_span_free(&ref_span);
            audio_real_encoder_session_free(&session);
            return 1;
        }
        prefill_us = prefill_us + (audio_real_clock_us() - append_start_us);
        audio_real_encoded_span_free(&user_span);
        turn = turn + 1;
    }
    audio_real_encoder_session_free(&session);

    append_start_us = audio_real_clock_us();
    if !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, AUDIO2AUDIO_REAL_ASSISTANT_PROMPT, logits) {
        free(logits as &void);
        qwen3_close_runtime(&table, &tok, &runtime);
        audio_real_encoded_span_free(&ref_span);
        return 1;
    }
    prefill_us = prefill_us + (audio_real_clock_us() - append_start_us);
    const prompt_tokens: usize = runtime.total_tokens;

    _ = printf("audio2audio-real[text-only]: llm=%s ref_audio=%s user_prefix=%s user_chunks=%u prompt_tokens=%zu stop_token=%u\n", llm_path, ref_audio_path, test_prefix, test_count - 1, prompt_tokens, sampler.stop_token);
    _ = printf("audio2audio-real[text-only]: ref_n_pos=%zu ref_checksum=0x%x ref_encode_ms=%.3f user_n_pos_total=%zu user_encode_ms=%.3f prefill_ms=%.3f audio_load_ms=%.3f llm_load_ms=%.3f\n", ref_span.span_count, ref_span.checksum, (ref_span.encode_us as f64) / 1000.0, total_user_n_pos, (total_user_encode_us as f64) / 1000.0, (prefill_us as f64) / 1000.0, (audio_load_us as f64) / 1000.0, (load_us as f64) / 1000.0);
    if dump_embeddings { audio2audio_real_dump_embedding("ref\0" as &const byte, &ref_span); }

    var answer: [byte: AUDIO2AUDIO_REAL_ANSWER_CAP] = [];
    var answer_len: usize = 0;
    const decode_start_us: u64 = audio_real_clock_us();
    const rc: i32 = qwen3_generate_capture(&config, &weights, &runtime, &sampler, &tok, logits, "audio2audio-real answer\0" as &const byte, false, &answer[0], @len(answer), &answer_len);
    const decode_us: u64 = audio_real_clock_us() - decode_start_us;
    if rc == 0 {
        _ = printf("audio2audio-real[text-only]: answer_chars=%zu decode_ms=%.3f total_ms=%.3f\n", answer_len, (decode_us as f64) / 1000.0, ((audio_load_us + load_us + ref_span.encode_us + total_user_encode_us + prefill_us + decode_us) as f64) / 1000.0);
    }

    free(logits as &void);
    qwen3_close_runtime(&table, &tok, &runtime);
    audio_real_encoded_span_free(&ref_span);
    return rc;
}

fn audio_count_layers_from_tensors(table: &TensorWeightTable) u32 {
    var layer_count: u32 = 0;
    while layer_count < AUDIO_MAX_LAYERS as u32 {
        if audio_lookup_layer(table, layer_count, "attn_q.weight\0" as &const byte) == null { return layer_count; }
        layer_count = layer_count + 1;
    }
    return layer_count;
}

fn audio_check_dtype(view: &TensorView, label: &const byte) bool {
    if view.dtype == TensorDType.F32 || view.dtype == TensorDType.F16 || view.dtype == TensorDType.BF16 { return true; }
    _ = printf("error: audio bind tensor=%s label=%s unsupported dtype=%s\n", &view.name[0], label, tensor_dtype_name(view.dtype));
    return false;
}

fn audio_print_shape(view: &TensorView) void {
    _ = printf("[");
    var dim_index: u32 = 0;
    while dim_index < view.n_dims {
        if dim_index > 0 { _ = printf("x"); }
        _ = printf("%llu", view.shape[dim_index as usize]);
        dim_index = dim_index + 1;
    }
    _ = printf("]");
}

fn audio_check_vec(view: &TensorView, len: u32, label: &const byte) bool {
    if !audio_check_dtype(view, label) { return false; }
    if view.n_dims == 1 && view.shape[0] == len as u64 { return true; }
    _ = printf("error: audio bind tensor=%s label=%s bad shape got=", &view.name[0], label);
    audio_print_shape(view);
    _ = printf(" expected=[%u]\n", len);
    return false;
}

fn audio_check_matrix(view: &TensorView, in_dim: u32, out_dim: u32, label: &const byte) bool {
    if !audio_check_dtype(view, label) { return false; }
    if view.n_dims == 2 && view.shape[0] == in_dim as u64 && view.shape[1] == out_dim as u64 { return true; }
    _ = printf("error: audio bind tensor=%s label=%s bad shape got=", &view.name[0], label);
    audio_print_shape(view);
    _ = printf(" expected=[%u,%u]\n", in_dim, out_dim);
    return false;
}

fn audio_check_position_embedding(view: &TensorView, hidden: u32, label: &const byte) bool {
    if !audio_check_dtype(view, label) { return false; }
    if view.n_dims == 2 && view.shape[0] > 0 && view.shape[0] <= AUDIO_MAX_FRAMES as u64 && view.shape[1] == hidden as u64 { return true; }
    _ = printf("error: audio bind tensor=%s label=%s bad shape got=", &view.name[0], label);
    audio_print_shape(view);
    _ = printf(" expected=[1..%zu,%u]\n", AUDIO_MAX_FRAMES, hidden);
    return false;
}

fn audio_sqrt_floor_u32(value: u32) u32 {
    var root: u32 = 0;
    while (root + 1) * (root + 1) <= value { root = root + 1; }
    return root;
}

fn audio_position_value(config: &AudioConfig, weights: &AudioWeights, frame_index: usize, hidden_index: usize) f32 {
    const source_count: usize = weights.position_embd.shape[0] as usize;
    const target_count: usize = config.frame_count as usize;
    var source_index: usize = frame_index;
    if source_count != target_count {
        const source_grid: u32 = audio_sqrt_floor_u32(source_count as u32);
        const target_grid: u32 = audio_sqrt_floor_u32(target_count as u32);
        if source_grid * source_grid == source_count as u32 && target_grid * target_grid == target_count as u32 && target_grid > 0 {
            const target_row: u32 = (frame_index as u32) / target_grid;
            const target_col: u32 = (frame_index as u32) % target_grid;
            const source_row: u32 = (target_row * source_grid) / target_grid;
            const source_col: u32 = (target_col * source_grid) / target_grid;
            source_index = (source_row * source_grid + source_col) as usize;
        } else {
            source_index = (frame_index * source_count) / target_count;
        }
    }
    return qwen3_tensor_get(weights.position_embd, source_index * (config.hidden_size as usize) + hidden_index);
}

export fn audio_complete_config(config: &AudioConfig, table: &TensorWeightTable, raw: &AudioRawMel) bool {
    if config.frame_count == 0 { config.frame_count = raw.frame_count; }
    if config.mel_bin_count == 0 { config.mel_bin_count = raw.mel_bin_count; }
    if config.head_count == 0 { config.head_count = 1; }
    if !config.has_audio_token_id { config.audio_token_id = 13; }
    if config.frame_count != raw.frame_count || config.mel_bin_count != raw.mel_bin_count {
        _ = printf("error: audio raw shape %ux%u does not match audio config %ux%u\n", raw.frame_count, raw.mel_bin_count, config.frame_count, config.mel_bin_count);
        return false;
    }
    const conv: &TensorView = tensor_lookup(table, "audio.conv1.weight\0" as &const byte);
    if conv == null { _ = printf("error: audio bind missing tensor audio.conv1.weight\n"); return false; }
    if conv.n_dims == 2 && config.hidden_size == 0 { config.hidden_size = conv.shape[1] as u32; }
    const projector: &TensorView = tensor_lookup(table, "audio.projector.weight\0" as &const byte);
    if projector == null { _ = printf("error: audio bind missing tensor audio.projector.weight\n"); return false; }
    if projector.n_dims == 2 && config.llm_hidden_size == 0 { config.llm_hidden_size = projector.shape[1] as u32; }
    if config.layer_count == 0 { config.layer_count = audio_count_layers_from_tensors(table); }
    const gate: &TensorView = audio_lookup_layer(table, 0, "ffn_gate.weight\0" as &const byte);
    if gate != null && gate.n_dims == 2 && config.intermediate_size == 0 { config.intermediate_size = gate.shape[1] as u32; }
    if config.hidden_size == 0 || config.layer_count == 0 || config.head_count == 0 || config.llm_hidden_size == 0 || config.intermediate_size == 0 {
        _ = printf("error: audio config incomplete frames=%u mel_bins=%u hidden=%u layers=%u heads=%u ffn=%u llm_hidden=%u\n", config.frame_count, config.mel_bin_count, config.hidden_size, config.layer_count, config.head_count, config.intermediate_size, config.llm_hidden_size);
        return false;
    }
    if config.hidden_size % config.head_count != 0 { _ = printf("error: audio hidden_size=%u not divisible by head_count=%u\n", config.hidden_size, config.head_count); return false; }
    config.head_dim = config.hidden_size / config.head_count;
    if config.frame_count > AUDIO_MAX_FRAMES as u32 || config.mel_bin_count > AUDIO_MAX_BINS as u32 || config.hidden_size > AUDIO_MAX_HIDDEN as u32 || config.intermediate_size > AUDIO_MAX_FFN as u32 || config.llm_hidden_size > AUDIO_MAX_LLM_HIDDEN as u32 || config.layer_count > AUDIO_MAX_LAYERS as u32 {
        _ = printf("error: audio config exceeds smoke caps frames=%u mel_bins=%u hidden=%u ffn=%u llm_hidden=%u layers=%u\n", config.frame_count, config.mel_bin_count, config.hidden_size, config.intermediate_size, config.llm_hidden_size, config.layer_count);
        return false;
    }
    return true;
}

export fn audio_bind_weights(table: &TensorWeightTable, config: &AudioConfig, weights: &AudioWeights) bool {
    weights[0] = audio_weights_init();
    weights.conv_weight = tensor_lookup(table, "audio.conv1.weight\0" as &const byte);
    if weights.conv_weight == null || !audio_check_matrix(weights.conv_weight, config.mel_bin_count, config.hidden_size, "conv front-end\0" as &const byte) { return false; }
    weights.conv_bias = tensor_lookup(table, "audio.conv1.bias\0" as &const byte);
    if weights.conv_bias != null && !audio_check_vec(weights.conv_bias, config.hidden_size, "conv bias\0" as &const byte) { return false; }
    weights.position_embd = tensor_lookup(table, "audio.position_embd.weight\0" as &const byte);
    if weights.position_embd == null || !audio_check_position_embedding(weights.position_embd, config.hidden_size, "position embedding\0" as &const byte) { return false; }
    weights.output_norm = tensor_lookup(table, "audio.output_norm.weight\0" as &const byte);
    if weights.output_norm == null || !audio_check_vec(weights.output_norm, config.hidden_size, "output norm\0" as &const byte) { return false; }
    weights.projector = tensor_lookup(table, "audio.projector.weight\0" as &const byte);
    if weights.projector == null || !audio_check_matrix(weights.projector, config.hidden_size, config.llm_hidden_size, "projector\0" as &const byte) { return false; }
    weights.layer_count = config.layer_count;
    var layer_index: u32 = 0;
    while layer_index < config.layer_count {
        var layer: &AudioLayerWeights = &weights.layers[layer_index as usize];
        layer.attn_norm = audio_lookup_layer(table, layer_index, "attn_norm.weight\0" as &const byte);
        if layer.attn_norm == null || !audio_check_vec(layer.attn_norm, config.hidden_size, "attention norm\0" as &const byte) { return false; }
        layer.q_proj = audio_lookup_layer(table, layer_index, "attn_q.weight\0" as &const byte);
        if layer.q_proj == null || !audio_check_matrix(layer.q_proj, config.hidden_size, config.hidden_size, "q projection\0" as &const byte) { return false; }
        layer.k_proj = audio_lookup_layer(table, layer_index, "attn_k.weight\0" as &const byte);
        if layer.k_proj == null || !audio_check_matrix(layer.k_proj, config.hidden_size, config.hidden_size, "k projection\0" as &const byte) { return false; }
        layer.v_proj = audio_lookup_layer(table, layer_index, "attn_v.weight\0" as &const byte);
        if layer.v_proj == null || !audio_check_matrix(layer.v_proj, config.hidden_size, config.hidden_size, "v projection\0" as &const byte) { return false; }
        layer.o_proj = audio_lookup_layer(table, layer_index, "attn_output.weight\0" as &const byte);
        if layer.o_proj == null || !audio_check_matrix(layer.o_proj, config.hidden_size, config.hidden_size, "o projection\0" as &const byte) { return false; }
        layer.ffn_norm = audio_lookup_layer(table, layer_index, "ffn_norm.weight\0" as &const byte);
        if layer.ffn_norm == null || !audio_check_vec(layer.ffn_norm, config.hidden_size, "ffn norm\0" as &const byte) { return false; }
        layer.gate_proj = audio_lookup_layer(table, layer_index, "ffn_gate.weight\0" as &const byte);
        if layer.gate_proj == null || !audio_check_matrix(layer.gate_proj, config.hidden_size, config.intermediate_size, "ffn gate\0" as &const byte) { return false; }
        layer.up_proj = audio_lookup_layer(table, layer_index, "ffn_up.weight\0" as &const byte);
        if layer.up_proj == null || !audio_check_matrix(layer.up_proj, config.hidden_size, config.intermediate_size, "ffn up\0" as &const byte) { return false; }
        layer.down_proj = audio_lookup_layer(table, layer_index, "ffn_down.weight\0" as &const byte);
        if layer.down_proj == null || !audio_check_matrix(layer.down_proj, config.intermediate_size, config.hidden_size, "ffn down\0" as &const byte) { return false; }
        layer_index = layer_index + 1;
    }
    return true;
}

fn audio_matvec_view(dst: &f32, matrix: &TensorView, src: &const f32, in_dim: usize, out_dim: usize) void {
    var out_index: usize = 0;
    while out_index < out_dim {
        var sum: f32 = 0.0;
        var in_index: usize = 0;
        while in_index < in_dim {
            sum = sum + src[in_index] * qwen3_tensor_get(matrix, in_index * out_dim + out_index);
            in_index = in_index + 1;
        }
        dst[out_index] = sum;
        out_index = out_index + 1;
    }
}

fn audio_rms_norm_view(dst: &f32, src: &const f32, weight: &TensorView, len: usize) void {
    var sum: f32 = 0.0;
    var value_index: usize = 0;
    while value_index < len { sum = sum + src[value_index] * src[value_index]; value_index = value_index + 1; }
    const inv: f32 = 1.0 / sqrtf(sum / (len as f32) + AUDIO_EPS);
    value_index = 0;
    while value_index < len {
        dst[value_index] = src[value_index] * inv * qwen3_tensor_get(weight, value_index);
        value_index = value_index + 1;
    }
}

fn audio_frontend(config: &AudioConfig, weights: &AudioWeights, raw: &AudioRawMel, states: &f32) void {
    const hidden: usize = config.hidden_size as usize;
    const mel_bins: usize = config.mel_bin_count as usize;
    var frame_index: usize = 0;
    while frame_index < config.frame_count as usize {
        audio_matvec_view(&states[frame_index * AUDIO_MAX_HIDDEN], weights.conv_weight, &raw.values[frame_index * mel_bins] as &const f32, mel_bins, hidden);
        var hidden_index: usize = 0;
        while hidden_index < hidden {
            if weights.conv_bias != null { states[frame_index * AUDIO_MAX_HIDDEN + hidden_index] = states[frame_index * AUDIO_MAX_HIDDEN + hidden_index] + qwen3_tensor_get(weights.conv_bias, hidden_index); }
            states[frame_index * AUDIO_MAX_HIDDEN + hidden_index] = states[frame_index * AUDIO_MAX_HIDDEN + hidden_index] + audio_position_value(config, weights, frame_index, hidden_index);
            hidden_index = hidden_index + 1;
        }
        frame_index = frame_index + 1;
    }
}

fn audio_attention(out: &f32, q_values: &const f32, k_values: &const f32, v_values: &const f32, token_count: usize, head_count: usize, head_dim: usize, token_index: usize) void {
    var hidden_index: usize = 0;
    while hidden_index < head_count * head_dim { out[hidden_index] = 0.0; hidden_index = hidden_index + 1; }
    var scores: [f32: 16] = [];
    var probs: [f32: 16] = [];
    const scale: f32 = 1.0 / sqrtf(head_dim as f32);
    var head_index: usize = 0;
    while head_index < head_count {
        var key_token: usize = 0;
        while key_token < token_count {
            var dot: f32 = 0.0;
            var dim_index: usize = 0;
            while dim_index < head_dim {
                dot = dot + q_values[token_index * AUDIO_MAX_HIDDEN + head_index * head_dim + dim_index] * k_values[key_token * AUDIO_MAX_HIDDEN + head_index * head_dim + dim_index];
                dim_index = dim_index + 1;
            }
            scores[key_token] = dot * scale;
            key_token = key_token + 1;
        }
        softmax(&probs[0], &scores[0], token_count);
        var out_dim: usize = 0;
        while out_dim < head_dim {
            var sum: f32 = 0.0;
            var value_token: usize = 0;
            while value_token < token_count {
                sum = sum + probs[value_token] * v_values[value_token * AUDIO_MAX_HIDDEN + head_index * head_dim + out_dim];
                value_token = value_token + 1;
            }
            out[head_index * head_dim + out_dim] = sum;
            out_dim = out_dim + 1;
        }
        head_index = head_index + 1;
    }
}

fn audio_transformer(config: &AudioConfig, weights: &AudioWeights, states: &f32) void {
    var normed: [f32: 1024] = [];
    var q_values: [f32: 1024] = [];
    var k_values: [f32: 1024] = [];
    var v_values: [f32: 1024] = [];
    var attn_ctx: [f32: 1024] = [];
    var attn_out: [f32: 1024] = [];
    var gate: [f32: 2048] = [];
    var up: [f32: 2048] = [];
    var fused: [f32: 2048] = [];
    var down: [f32: 1024] = [];
    const token_count: usize = config.frame_count as usize;
    const hidden: usize = config.hidden_size as usize;
    const ffn: usize = config.intermediate_size as usize;
    var layer_index: usize = 0;
    while layer_index < config.layer_count as usize {
        const layer: &AudioLayerWeights = &weights.layers[layer_index];
        var token_index: usize = 0;
        while token_index < token_count {
            audio_rms_norm_view(&normed[token_index * AUDIO_MAX_HIDDEN], &states[token_index * AUDIO_MAX_HIDDEN] as &const f32, layer.attn_norm, hidden);
            audio_matvec_view(&q_values[token_index * AUDIO_MAX_HIDDEN], layer.q_proj, &normed[token_index * AUDIO_MAX_HIDDEN] as &const f32, hidden, hidden);
            audio_matvec_view(&k_values[token_index * AUDIO_MAX_HIDDEN], layer.k_proj, &normed[token_index * AUDIO_MAX_HIDDEN] as &const f32, hidden, hidden);
            audio_matvec_view(&v_values[token_index * AUDIO_MAX_HIDDEN], layer.v_proj, &normed[token_index * AUDIO_MAX_HIDDEN] as &const f32, hidden, hidden);
            token_index = token_index + 1;
        }
        token_index = 0;
        while token_index < token_count {
            audio_attention(&attn_ctx[token_index * AUDIO_MAX_HIDDEN], &q_values[0], &k_values[0], &v_values[0], token_count, config.head_count as usize, config.head_dim as usize, token_index);
            audio_matvec_view(&attn_out[token_index * AUDIO_MAX_HIDDEN], layer.o_proj, &attn_ctx[token_index * AUDIO_MAX_HIDDEN] as &const f32, hidden, hidden);
            var hidden_index: usize = 0;
            while hidden_index < hidden { states[token_index * AUDIO_MAX_HIDDEN + hidden_index] = states[token_index * AUDIO_MAX_HIDDEN + hidden_index] + attn_out[token_index * AUDIO_MAX_HIDDEN + hidden_index]; hidden_index = hidden_index + 1; }
            token_index = token_index + 1;
        }
        token_index = 0;
        while token_index < token_count {
            audio_rms_norm_view(&normed[token_index * AUDIO_MAX_HIDDEN], &states[token_index * AUDIO_MAX_HIDDEN] as &const f32, layer.ffn_norm, hidden);
            audio_matvec_view(&gate[token_index * AUDIO_MAX_FFN], layer.gate_proj, &normed[token_index * AUDIO_MAX_HIDDEN] as &const f32, hidden, ffn);
            audio_matvec_view(&up[token_index * AUDIO_MAX_FFN], layer.up_proj, &normed[token_index * AUDIO_MAX_HIDDEN] as &const f32, hidden, ffn);
            var ffn_index: usize = 0;
            while ffn_index < ffn { fused[token_index * AUDIO_MAX_FFN + ffn_index] = silu(gate[token_index * AUDIO_MAX_FFN + ffn_index]) * up[token_index * AUDIO_MAX_FFN + ffn_index]; ffn_index = ffn_index + 1; }
            audio_matvec_view(&down[token_index * AUDIO_MAX_HIDDEN], layer.down_proj, &fused[token_index * AUDIO_MAX_FFN] as &const f32, ffn, hidden);
            var hidden_index2: usize = 0;
            while hidden_index2 < hidden { states[token_index * AUDIO_MAX_HIDDEN + hidden_index2] = states[token_index * AUDIO_MAX_HIDDEN + hidden_index2] + down[token_index * AUDIO_MAX_HIDDEN + hidden_index2]; hidden_index2 = hidden_index2 + 1; }
            token_index = token_index + 1;
        }
        layer_index = layer_index + 1;
    }
}

export fn audio_encode(config: &AudioConfig, weights: &AudioWeights, raw: &AudioRawMel, embeddings: &f32, span_count: &usize) bool {
    var states: [f32: 1024] = [];
    audio_frontend(config, weights, raw, &states[0]);
    audio_transformer(config, weights, &states[0]);
    const token_count: usize = config.frame_count as usize;
    const hidden: usize = config.hidden_size as usize;
    const llm_hidden: usize = config.llm_hidden_size as usize;
    var normed: [f32: 64] = [];
    var token_index: usize = 0;
    while token_index < token_count {
        audio_rms_norm_view(&normed[0], &states[token_index * AUDIO_MAX_HIDDEN] as &const f32, weights.output_norm, hidden);
        audio_matvec_view(&embeddings[token_index * AUDIO_MAX_LLM_HIDDEN], weights.projector, &normed[0], hidden, llm_hidden);
        token_index = token_index + 1;
    }
    *span_count = token_count;
    return true;
}

fn audio_f32_bits(value: f32) u32 {
    const ptr: &const u32 = &value as &const u32;
    return ptr[0];
}

fn audio_checksum(values: &const f32, count: usize) u32 {
    var hash: u32 = 2166136261;
    var value_index: usize = 0;
    while value_index < count {
        const bits: u32 = audio_f32_bits(values[value_index]);
        var byte_index: u32 = 0;
        while byte_index < 4 {
            hash = hash ^ ((bits >> ((byte_index * 8) as i32)) & (255 as u32));
            hash = hash * (16777619 as u32);
            byte_index = byte_index + 1;
        }
        value_index = value_index + 1;
    }
    return hash;
}

fn audio_count_placeholders(ids: &const u32, id_count: usize, audio_token_id: u32) usize {
    var placeholder_count: usize = 0;
    var token_index: usize = 0;
    while token_index < id_count {
        if ids[token_index] == audio_token_id { placeholder_count = placeholder_count + 1; }
        token_index = token_index + 1;
    }
    return placeholder_count;
}

fn audio_prefill_prompt(qwen_config: &Qwen3Config, qwen_weights: &Qwen3Weights, ids: &const u32, id_count: usize, audio_token_id: u32, embeddings: &const f32, span_count: usize, use_audio: bool, logits: &f32) bool {
    var k_cache: [f32: 16384] = [];
    var v_cache: [f32: 16384] = [];
    var token_index: usize = 0;
    var span_index: usize = 0;
    while token_index < id_count {
        const compute_logits: bool = (token_index + (1 as usize)) == id_count;
        if ids[token_index] == audio_token_id && use_audio {
            if span_index >= span_count { _ = printf("error: audio embedding span underflow span=%zu\n", span_count); return false; }
            if !qwen3_forward_embedding(qwen_config, qwen_weights, &embeddings[span_index * AUDIO_MAX_LLM_HIDDEN] as &const f32, token_index, &k_cache[0], &v_cache[0], logits, compute_logits) { return false; }
            span_index = span_index + 1;
        } else {
            if !qwen3_forward_token(qwen_config, qwen_weights, ids[token_index], token_index, &k_cache[0], &v_cache[0], logits, compute_logits) { return false; }
        }
        token_index = token_index + 1;
    }
    if use_audio && span_index != span_count { _ = printf("error: audio embedding span overflow used=%zu span=%zu\n", span_index, span_count); return false; }
    return true;
}

fn audio_logits_l1(a: &const f32, b: &const f32, count: usize) f32 {
    var sum: f32 = 0.0;
    var value_index: usize = 0;
    while value_index < count {
        if a[value_index] > b[value_index] { sum = sum + (a[value_index] - b[value_index]); } else { sum = sum + (b[value_index] - a[value_index]); }
        value_index = value_index + 1;
    }
    return sum;
}

fn audio_load_smoke_input(path: &const byte, raw: &AudioRawMel, source_kind: &u32) bool {
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    if !binary_read_u32_le(&reader, &magic, "audio2audio input magic\0" as &const byte) { binary_close(&reader); return false; }
    binary_close(&reader);
    if magic == AUDIO_RAW_MAGIC {
        source_kind[0] = 0;
        return audio_raw_load(path, raw);
    }
    if magic == AUDIO_PCM_MAGIC {
        var pcm: AudioRawPcm = audio_pcm_init();
        if !audio_pcm_load(path, &pcm) { return false; }
        var config: AudioPreprocessConfig = audio_preprocess_config_init();
        if !audio_pcm_to_mel(&config, &pcm, raw) { _ = printf("error: audio2audio pcm preprocessing failed\n"); return false; }
        source_kind[0] = 1;
        return true;
    }
    _ = printf("error: audio2audio unsupported input magic=0x%x expected UYAM or UYAP\n", magic);
    return false;
}

fn audio_source_label(source_kind: u32) &const byte {
    if source_kind == 1 { return "uyap-pcm\0" as &const byte; }
    return "uyam-mel\0" as &const byte;
}

fn audio_fit_raw_to_config(config: &AudioConfig, raw: &AudioRawMel) bool {
    if config.frame_count == 0 || raw.frame_count == config.frame_count { return true; }
    if config.mel_bin_count != 0 && raw.mel_bin_count != config.mel_bin_count {
        _ = printf("error: audio2audio mel bins=%u do not match audio config bins=%u\n", raw.mel_bin_count, config.mel_bin_count);
        return false;
    }
    const target_frames: u32 = config.frame_count;
    const mel_bins: u32 = raw.mel_bin_count;
    const target_elements: usize = (target_frames as usize) * (mel_bins as usize);
    if target_frames == 0 || mel_bins == 0 || target_elements > AUDIO_MAX_VALUES { return false; }
    var fitted: AudioRawMel = audio_raw_init();
    fitted.frame_count = target_frames;
    fitted.mel_bin_count = mel_bins;
    fitted.element_count = target_elements;
    var target_frame: usize = 0;
    while target_frame < target_frames as usize {
        const source_frame: usize = (target_frame * (raw.frame_count as usize)) / (target_frames as usize);
        var bin: usize = 0;
        while bin < mel_bins as usize {
            fitted.values[target_frame * (mel_bins as usize) + bin] = raw.values[source_frame * (mel_bins as usize) + bin];
            bin = bin + 1;
        }
        target_frame = target_frame + 1;
    }
    raw.frame_count = fitted.frame_count;
    raw.mel_bin_count = fitted.mel_bin_count;
    raw.element_count = fitted.element_count;
    var value_index: usize = 0;
    while value_index < fitted.element_count { raw.values[value_index] = fitted.values[value_index]; value_index = value_index + 1; }
    return true;
}

fn audio2audio_detach_tables(text_table: &TensorWeightTable, audio_table: &TensorWeightTable, speech_table: &TensorWeightTable, vocoder_table: &TensorWeightTable) void {
    tensor_weight_table_detach_mmap(text_table);
    tensor_weight_table_detach_mmap(audio_table);
    tensor_weight_table_detach_mmap(speech_table);
    tensor_weight_table_detach_mmap(vocoder_table);
}

fn audio2audio_smoke_usage() void {
    _ = printf("usage: minicpm-o-uya audio2audio-smoke <model.gguf> [--audio-model audio.gguf] [--speech-model speech.gguf] [--vocoder-model vocoder.gguf] <audio.pcm|audio.raw> [out.wav]\n");
}

export fn audio2audio_smoke_multi_cli(text_model_path: &const byte, audio_model_path: &const byte, speech_model_path: &const byte, vocoder_model_path: &const byte, audio_path: &const byte, wav_path: &const byte) i32 {
    var audio_config: AudioConfig = audio_config_init();
    if !audio_config_load_metadata(audio_model_path, &audio_config) { return 1; }
    if !audio_config.has_audio_token_id {
        var text_audio_config: AudioConfig = audio_config_init();
        if !audio_config_load_metadata(text_model_path, &text_audio_config) { return 1; }
        if text_audio_config.has_audio_token_id {
            audio_config.audio_token_id = text_audio_config.audio_token_id;
            audio_config.has_audio_token_id = true;
        }
    }
    var raw: AudioRawMel = audio_raw_init();
    var source_kind: u32 = 0;
    if !audio_load_smoke_input(audio_path, &raw, &source_kind) { return 1; }
    const input_frames: u32 = raw.frame_count;
    if !audio_fit_raw_to_config(&audio_config, &raw) { return 1; }
    var qwen_config: Qwen3Config = qwen3_config_init();
    if !qwen3_config_load_metadata(text_model_path, &qwen_config) { return 1; }
    var text_table: TensorWeightTable = tensor_table_init();
    var audio_table: TensorWeightTable = tensor_table_init();
    var speech_table: TensorWeightTable = tensor_table_init();
    var vocoder_table: TensorWeightTable = tensor_table_init();
    if !tensor_weight_table_load(text_model_path, &text_table) { return 1; }
    if !tensor_weight_table_load(audio_model_path, &audio_table) { return 1; }
    if !tensor_weight_table_load(speech_model_path, &speech_table) { return 1; }
    if !tensor_weight_table_load(vocoder_model_path, &vocoder_table) { return 1; }
    if !audio_complete_config(&audio_config, &audio_table, &raw) { return 1; }
    if !qwen3_complete_config_from_tensors(&qwen_config, &text_table) { return 1; }
    if qwen_config.hidden_size != audio_config.llm_hidden_size { _ = printf("error: audio2audio projector output=%u does not match qwen hidden=%u\n", audio_config.llm_hidden_size, qwen_config.hidden_size); return 1; }
    if !qwen3_check_forward_caps(&qwen_config) { return 1; }
    if !tensor_weight_table_attach_mmap(text_model_path, &text_table) { return 1; }
    if !tensor_weight_table_attach_mmap(audio_model_path, &audio_table) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    if !tensor_weight_table_attach_mmap(speech_model_path, &speech_table) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    if !tensor_weight_table_attach_mmap(vocoder_model_path, &vocoder_table) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    var audio_weights: AudioWeights = audio_weights_init();
    if !audio_bind_weights(&audio_table, &audio_config, &audio_weights) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    var qwen_weights: Qwen3Weights = qwen3_weights_init();
    if !qwen3_bind_weights(&text_table, &qwen_config, &qwen_weights) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(text_model_path, &tok) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }

    var embeddings: [f32: 1024] = [];
    var span_count: usize = 0;
    if !audio_encode(&audio_config, &audio_weights, &raw, &embeddings[0], &span_count) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    var prompt_ids: [u32: 64] = [];
    var prompt_count: usize = 0;
    if !tokenizer_encode_to_ids(&tok, "<audio> hello\0" as &const byte, &prompt_ids[0], AUDIO_MAX_PROMPT, &prompt_count) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    const placeholder_count: usize = audio_count_placeholders(&prompt_ids[0], prompt_count, audio_config.audio_token_id);
    if placeholder_count != span_count { _ = printf("error: audio2audio placeholder count=%zu does not match embedding span=%zu\n", placeholder_count, span_count); audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }

    var logits_audio: [f32: 256] = [];
    var logits_text: [f32: 256] = [];
    if !audio_prefill_prompt(&qwen_config, &qwen_weights, &prompt_ids[0], prompt_count, audio_config.audio_token_id, &embeddings[0], span_count, true, &logits_audio[0]) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    if !audio_prefill_prompt(&qwen_config, &qwen_weights, &prompt_ids[0], prompt_count, audio_config.audio_token_id, &embeddings[0], span_count, false, &logits_text[0]) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    const diff_l1: f32 = audio_logits_l1(&logits_audio[0], &logits_text[0], qwen_config.vocab_size as usize);
    if diff_l1 <= 0.000001 { _ = printf("error: audio2audio audio logits are not observably different diff_l1=%.9f\n", diff_l1 as f64); audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }

    var speech_ids: [u32: 64] = [];
    var speech_count: usize = 0;
    var copy_index: usize = 0;
    while copy_index < prompt_count {
        speech_ids[speech_count] = prompt_ids[copy_index];
        speech_count = speech_count + 1;
        copy_index = copy_index + 1;
    }
    var vocab_pick: u32 = 0;
    var best_logit: f32 = logits_audio[0];
    var vocab_index: usize = 1;
    while vocab_index < qwen_config.vocab_size as usize {
        if logits_audio[vocab_index] > best_logit { best_logit = logits_audio[vocab_index]; vocab_pick = vocab_index as u32; }
        vocab_index = vocab_index + 1;
    }
    if speech_count >= @len(speech_ids) { _ = printf("error: audio2audio speech prompt exceeds cap=%zu\n", @len(speech_ids)); audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    speech_ids[speech_count] = vocab_pick;
    speech_count = speech_count + 1;

    var speech_config: SpeechConfig = speech_config_init();
    var speech_weights: SpeechWeights = speech_weights_init();
    if !speech_bind_weights(&speech_table, &speech_config, &speech_weights) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    var seq: SpeechTokenSequence = SpeechTokenSequence{ count: 0, tokens: [], hidden: [] };
    if !speech_generate_tokens(&speech_config, &speech_weights, &speech_ids[0] as &const u32, speech_count, &seq) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    var vocoder_config: VocoderConfig = vocoder_config_init();
    var vocoder_weights: VocoderWeights = vocoder_weights_init();
    if !vocoder_bind_weights(&vocoder_table, &speech_config, &vocoder_config, &vocoder_weights) { audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    var waveform: SpeechWaveform = speech_waveform_init();
    if !vocoder_decode_tokens(&vocoder_config, &vocoder_weights, &seq, &waveform) { _ = printf("error: audio2audio vocoder decode failed\n"); audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    if !speech_waveform_analyze(&waveform) { _ = printf("error: audio2audio waveform validation failed\n"); audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }
    if !speech_wav_write(wav_path, &waveform) { _ = printf("error: audio2audio wav write failed\n"); audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table); return 1; }

    const raw_checksum: u32 = audio_checksum(&raw.values[0], raw.element_count);
    const embed_checksum: u32 = audio_checksum(&embeddings[0], span_count * (audio_config.llm_hidden_size as usize));
    const audio_logits_checksum: u32 = audio_checksum(&logits_audio[0], qwen_config.vocab_size as usize);
    const text_logits_checksum: u32 = audio_checksum(&logits_text[0], qwen_config.vocab_size as usize);
    const token_checksum: u32 = speech_checksum_u32(&seq.tokens[0] as &const u32, seq.count);
    const waveform_checksum: u32 = speech_checksum_waveform(&waveform);
    _ = printf("audio2audio models: text=%s audio=%s speech=%s vocoder=%s\n", text_model_path, audio_model_path, speech_model_path, vocoder_model_path);
    _ = printf("audio2audio input: source=%s input_frames=%u frames=%u mel_bins=%u elements=%zu checksum=0x%x\n", audio_source_label(source_kind), input_frames, raw.frame_count, raw.mel_bin_count, raw.element_count, raw_checksum);
    _ = printf("audio2audio audio: placeholders=%zu span=%zu embedding_checksum=0x%x logits_audio=0x%x logits_text=0x%x diff_l1=%.9f picked_token=%u\n", placeholder_count, span_count, embed_checksum, audio_logits_checksum, text_logits_checksum, diff_l1 as f64, vocab_pick);
    _ = printf("audio2audio speech: prompt_tokens=%zu generated=%zu checksum=0x%x\n", speech_count, seq.count, token_checksum);
    _ = printf("audio2audio waveform: samples=%zu sample_rate=%u rms=%.6f peak=%.6f checksum=0x%x\n", waveform.sample_count, waveform.sample_rate, waveform.rms as f64, waveform.peak as f64, waveform_checksum);
    _ = printf("audio2audio wav: path=%s bytes=%u\n", wav_path, 44 + ((waveform.sample_count as u32) * 2));
    _ = printf("audio2audio-smoke: PASS\n");
    audio2audio_detach_tables(&text_table, &audio_table, &speech_table, &vocoder_table);
    return 0;
}

export fn audio2audio_smoke_cli(model_path: &const byte, audio_path: &const byte, wav_path: &const byte) i32 {
    return audio2audio_smoke_multi_cli(model_path, model_path, model_path, model_path, audio_path, wav_path);
}

export fn audio2audio_smoke_args_cli(argc: i32, argv: & &byte) i32 {
    if argc < 4 { audio2audio_smoke_usage(); return 1; }
    const text_model_path: &const byte = argv[2] as &const byte;
    var audio_model_path: &const byte = text_model_path;
    var speech_model_path: &const byte = text_model_path;
    var vocoder_model_path: &const byte = text_model_path;
    var audio_path: &const byte = null;
    var wav_path: &const byte = speech_default_wav_path();
    var has_wav_path: bool = false;
    var arg_index: i32 = 3;
    while arg_index < argc {
        if strcmp(argv[arg_index] as *const byte, "--audio-model\0" as *const byte) == 0 {
            if arg_index + 1 >= argc { audio2audio_smoke_usage(); return 1; }
            audio_model_path = argv[arg_index + 1] as &const byte;
            arg_index = arg_index + 2;
            continue;
        }
        if strcmp(argv[arg_index] as *const byte, "--speech-model\0" as *const byte) == 0 {
            if arg_index + 1 >= argc { audio2audio_smoke_usage(); return 1; }
            speech_model_path = argv[arg_index + 1] as &const byte;
            arg_index = arg_index + 2;
            continue;
        }
        if strcmp(argv[arg_index] as *const byte, "--vocoder-model\0" as *const byte) == 0 {
            if arg_index + 1 >= argc { audio2audio_smoke_usage(); return 1; }
            vocoder_model_path = argv[arg_index + 1] as &const byte;
            arg_index = arg_index + 2;
            continue;
        }
        if audio_path == null {
            audio_path = argv[arg_index] as &const byte;
            arg_index = arg_index + 1;
            continue;
        }
        if !has_wav_path {
            wav_path = argv[arg_index] as &const byte;
            has_wav_path = true;
            arg_index = arg_index + 1;
            continue;
        }
        audio2audio_smoke_usage();
        return 1;
    }
    if audio_path == null { audio2audio_smoke_usage(); return 1; }
    return audio2audio_smoke_multi_cli(text_model_path, audio_model_path, speech_model_path, vocoder_model_path, audio_path, wav_path);
}

export fn audio_smoke_cli(model_path: &const byte, audio_path: &const byte) i32 {
    var audio_config: AudioConfig = audio_config_init();
    if !audio_config_load_metadata(model_path, &audio_config) { return 1; }
    var raw: AudioRawMel = audio_raw_init();
    if !audio_raw_load(audio_path, &raw) { return 1; }
    var qwen_config: Qwen3Config = qwen3_config_init();
    if !qwen3_config_load_metadata(model_path, &qwen_config) { return 1; }
    var table: TensorWeightTable = tensor_table_init();
    if !tensor_weight_table_load(model_path, &table) { return 1; }
    if !audio_complete_config(&audio_config, &table, &raw) { return 1; }
    if !qwen3_complete_config_from_tensors(&qwen_config, &table) { return 1; }
    if qwen_config.hidden_size != audio_config.llm_hidden_size { _ = printf("error: audio projector output=%u does not match qwen hidden=%u\n", audio_config.llm_hidden_size, qwen_config.hidden_size); return 1; }
    if !qwen3_check_forward_caps(&qwen_config) { return 1; }
    if !tensor_weight_table_attach_mmap(model_path, &table) { return 1; }
    var audio_weights: AudioWeights = audio_weights_init();
    if !audio_bind_weights(&table, &audio_config, &audio_weights) { tensor_weight_table_detach_mmap(&table); return 1; }
    var qwen_weights: Qwen3Weights = qwen3_weights_init();
    if !qwen3_bind_weights(&table, &qwen_config, &qwen_weights) { tensor_weight_table_detach_mmap(&table); return 1; }
    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(model_path, &tok) { tensor_weight_table_detach_mmap(&table); return 1; }
    var embeddings: [f32: 1024] = [];
    var span_count: usize = 0;
    if !audio_encode(&audio_config, &audio_weights, &raw, &embeddings[0], &span_count) { tensor_weight_table_detach_mmap(&table); return 1; }
    var prompt_ids: [u32: 64] = [];
    var prompt_count: usize = 0;
    if !tokenizer_encode_to_ids(&tok, "<audio> hello\0" as &const byte, &prompt_ids[0], AUDIO_MAX_PROMPT, &prompt_count) { tensor_weight_table_detach_mmap(&table); return 1; }
    const placeholder_count: usize = audio_count_placeholders(&prompt_ids[0], prompt_count, audio_config.audio_token_id);
    if placeholder_count != span_count {
        _ = printf("error: audio placeholder count=%zu does not match embedding span=%zu\n", placeholder_count, span_count);
        tensor_weight_table_detach_mmap(&table);
        return 1;
    }
    var logits_audio: [f32: 256] = [];
    var logits_text: [f32: 256] = [];
    if !audio_prefill_prompt(&qwen_config, &qwen_weights, &prompt_ids[0], prompt_count, audio_config.audio_token_id, &embeddings[0], span_count, true, &logits_audio[0]) { tensor_weight_table_detach_mmap(&table); return 1; }
    if !audio_prefill_prompt(&qwen_config, &qwen_weights, &prompt_ids[0], prompt_count, audio_config.audio_token_id, &embeddings[0], span_count, false, &logits_text[0]) { tensor_weight_table_detach_mmap(&table); return 1; }
    const diff_l1: f32 = audio_logits_l1(&logits_audio[0], &logits_text[0], qwen_config.vocab_size as usize);
    if diff_l1 <= 0.000001 { _ = printf("error: audio logits are not observably different diff_l1=%.9f\n", diff_l1 as f64); tensor_weight_table_detach_mmap(&table); return 1; }
    const raw_checksum: u32 = audio_checksum(&raw.values[0], raw.element_count);
    const embed_checksum: u32 = audio_checksum(&embeddings[0], span_count * (audio_config.llm_hidden_size as usize));
    const audio_logits_checksum: u32 = audio_checksum(&logits_audio[0], qwen_config.vocab_size as usize);
    const text_logits_checksum: u32 = audio_checksum(&logits_text[0], qwen_config.vocab_size as usize);
    _ = printf("audio raw: frames=%u mel_bins=%u dtype=f32 elements=%zu checksum=0x%x\n", raw.frame_count, raw.mel_bin_count, raw.element_count, raw_checksum);
    _ = printf("audio config: frames=%u mel_bins=%u hidden=%u layers=%u heads=%u ffn=%u llm_hidden=%u audio_token=%u\n", audio_config.frame_count, audio_config.mel_bin_count, audio_config.hidden_size, audio_config.layer_count, audio_config.head_count, audio_config.intermediate_size, audio_config.llm_hidden_size, audio_config.audio_token_id);
    _ = printf("audio bind: conv=%s pos=%s projector=%s layers=%u\n", &audio_weights.conv_weight.name[0], &audio_weights.position_embd.name[0], &audio_weights.projector.name[0], audio_weights.layer_count);
    _ = printf("audio-smoke prompt_tokens:");
    var prompt_index: usize = 0;
    while prompt_index < prompt_count { _ = printf(" %u", prompt_ids[prompt_index]); prompt_index = prompt_index + 1; }
    _ = printf(" placeholders=%zu span=%zu\n", placeholder_count, span_count);
    _ = printf("audio embedding checksum: 0x%x\n", embed_checksum);
    _ = printf("audio logits checksum: audio=0x%x text=0x%x diff_l1=%.9f\n", audio_logits_checksum, text_logits_checksum, diff_l1 as f64);
    _ = printf("audio logits[0..4]: %.6f %.6f %.6f %.6f %.6f\n", logits_audio[0] as f64, logits_audio[1] as f64, logits_audio[2] as f64, logits_audio[3] as f64, logits_audio[4] as f64);
    _ = printf("audio-smoke: PASS\n");
    tensor_weight_table_detach_mmap(&table);
    return 0;
}

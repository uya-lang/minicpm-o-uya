use libc.printf;
use libc.strcmp;
use minicpmo.audio.audio2audio_smoke_args_cli;
use minicpmo.audio.audio_input_probe_cli;
use minicpmo.audio.audio_real_bind_cli;
use minicpmo.audio.audio_real_encode_probe_cli;
use minicpmo.audio.audio_real_mel_probe_args_cli;
use minicpmo.audio.audio_preprocess_smoke_cli;
use minicpmo.audio.audio_real_preprocess_probe_cli;
use minicpmo.audio.audio_smoke_cli;
use minicpmo.bench.bench_cli;
use minicpmo.gguf.audit_gguf;
use minicpmo.gguf.audio2audio_real_args_cli;
use minicpmo.gguf.inspect_gguf;
use minicpmo.kernels.kernels_smoke_cli;
use minicpmo.kernels.quant_smoke_cli;
use minicpmo.omni.omni_chat_cli;
use minicpmo.omni.omni_smoke_cli;
use minicpmo.omni.stream_chat_cli;
use minicpmo.qwen3.qwen3_bind_cli;
use minicpmo.qwen3.qwen3_chat_cli;
use minicpmo.qwen3.qwen3_generate_args_cli;
use minicpmo.speech.speech_default_wav_path;
use minicpmo.speech.speech_smoke_cli;
use minicpmo.speech.speech_tts_bind_cli;
use minicpmo.tokenizer.tokenizer_decode_cli;
use minicpmo.tokenizer.tokenizer_encode_cli;
use minicpmo.tokenizer.tokenizer_format_chat_cli;
use minicpmo.tokenizer.tokenizer_piece_cli;
use minicpmo.tensor.tensor_table_cli;
use minicpmo.vision.vision_preprocess_smoke_cli;
use minicpmo.vision.vision_smoke_cli;

fn print_help() void {
    _ = printf("minicpm-o-uya - pure Uya MiniCPM-o runtime scaffold\n");
    _ = printf("\n");
    _ = printf("Usage:\n");
    _ = printf("  minicpm-o-uya --help\n");
    _ = printf("  minicpm-o-uya inspect <model.gguf>\n");
    _ = printf("  minicpm-o-uya audit <model.gguf>\n");
    _ = printf("  minicpm-o-uya piece <model.gguf> <token-id>\n");
    _ = printf("  minicpm-o-uya encode <model.gguf> <text>\n");
    _ = printf("  minicpm-o-uya decode <model.gguf> <token-id>...\n");
    _ = printf("  minicpm-o-uya format-chat <model.gguf> <user-text>\n");
    _ = printf("  minicpm-o-uya tensors <model.gguf> [--mmap]\n");
    _ = printf("  minicpm-o-uya qwen3-bind <model.gguf>\n");
    _ = printf("  minicpm-o-uya generate <model.gguf> <prompt> [--max-new-tokens N] [--temperature T] [--top-k K] [--top-p P] [--min-p P] [--repeat-penalty R] [--seed S] [--stop-token ID] [--threads N] [--verbose] [--dump-hidden]\n");
    _ = printf("  minicpm-o-uya vision-smoke <model.gguf> <image.raw|image.rgb|manifest>\n");
    _ = printf("  minicpm-o-uya vision-preprocess-smoke <model.gguf> <image.rgb|manifest>\n");
    _ = printf("  minicpm-o-uya audio-smoke <model.gguf> <audio.raw>\n");
    _ = printf("  minicpm-o-uya audio-bind <audio.gguf>\n");
    _ = printf("  minicpm-o-uya audio-preprocess-smoke <audio.pcm>\n");
    _ = printf("  minicpm-o-uya audio-input-probe <audio.wav|audio.uyap.pcm>\n");
    _ = printf("  minicpm-o-uya audio-real-preprocess-probe <audio.wav|audio.uyap.pcm>\n");
    _ = printf("  minicpm-o-uya audio-real-mel-probe <audio.gguf> <audio.wav|audio.uyap.pcm> [--dump-f32 out.uyml]\n");
    _ = printf("  minicpm-o-uya audio-real-encode-probe <audio.gguf> <audio.wav|audio.uyap.pcm>\n");
    _ = printf("  minicpm-o-uya audio2audio-smoke <model.gguf> [--audio-model audio.gguf] [--speech-model speech.gguf] [--vocoder-model vocoder.gguf] <audio.pcm|audio.raw> [out.wav]\n");
    _ = printf("  minicpm-o-uya audio2audio-real [--audit-only] --llm <llm.gguf> --audio <audio.gguf> --tts <tts.gguf> --projector <projector.gguf> --token2wav-dir <dir>\n");
    _ = printf("    [--ref-audio ref.wav] [--user-audio user.wav|--input-audio user.wav] [--input-prefix prefix] [--test-prefix prefix --count N] [--out out.wav]\n");
    _ = printf("  minicpm-o-uya speech-smoke <model.gguf> <prompt> [out.wav]\n");
    _ = printf("  minicpm-o-uya tts-bind <tts.gguf>\n");
    _ = printf("  minicpm-o-uya omni-smoke <model.gguf> <manifest.json>\n");
    _ = printf("  minicpm-o-uya omni-chat <model.gguf>\n");
    _ = printf("  minicpm-o-uya stream-chat <model.gguf> <manifest.json>\n");
    _ = printf("  minicpm-o-uya bench <model.gguf> <manifest.json>\n");
    _ = printf("  minicpm-o-uya bench <model.gguf> [--prompt TEXT] [--n-prompt N] [--n-gen N] [--repetitions N] [--threads N] [--no-warmup]\n");
    _ = printf("  minicpm-o-uya chat <model.gguf> [--max-new-tokens N] [--temperature T] [--top-k K] [--top-p P] [--min-p P] [--repeat-penalty R] [--seed S] [--stop-token ID] [--threads N] [--verbose] [--dump-hidden]\n");
    _ = printf("  minicpm-o-uya kernels-smoke\n");
    _ = printf("  minicpm-o-uya quant-smoke\n");
    _ = printf("\n");
    _ = printf("Status: GGUF inspect/audit, tokenizer, tensor/Qwen3 binding, text generation/chat/omni-chat, vision/audio/speech/omni smoke, stream-chat prototype, bench, tiny vocoder WAV, scalar kernels, and quant smoke are implemented.\n");
}

export extern fn main(argc: i32, argv: & &byte) i32 {
    if argc <= 1 || strcmp(argv[1] as *const byte, "--help\0" as *const byte) == 0 || strcmp(argv[1] as *const byte, "-h\0" as *const byte) == 0 {
        print_help();
        return 0;
    }
    if strcmp(argv[1] as *const byte, "kernels-smoke\0" as *const byte) == 0 {
        if argc != 2 {
            _ = printf("usage: minicpm-o-uya kernels-smoke\n");
            return 1;
        }
        return kernels_smoke_cli();
    }
    if strcmp(argv[1] as *const byte, "quant-smoke\0" as *const byte) == 0 {
        if argc != 2 {
            _ = printf("usage: minicpm-o-uya quant-smoke\n");
            return 1;
        }
        return quant_smoke_cli();
    }
    if strcmp(argv[1] as *const byte, "inspect\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya inspect <model.gguf>\n");
            return 1;
        }
        return inspect_gguf(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audit\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya audit <model.gguf>\n");
            return 1;
        }
        return audit_gguf(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "piece\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya piece <model.gguf> <token-id>\n");
            return 1;
        }
        return tokenizer_piece_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "encode\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya encode <model.gguf> <text>\n");
            return 1;
        }
        return tokenizer_encode_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "decode\0" as *const byte) == 0 {
        if argc < 4 {
            _ = printf("usage: minicpm-o-uya decode <model.gguf> <token-id>...\n");
            return 1;
        }
        return tokenizer_decode_cli(argv[2] as &const byte, argc, argv as & &byte, 3);
    }
    if strcmp(argv[1] as *const byte, "format-chat\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya format-chat <model.gguf> <user-text>\n");
            return 1;
        }
        return tokenizer_format_chat_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "qwen3-bind\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya qwen3-bind <model.gguf>\n");
            return 1;
        }
        return qwen3_bind_cli(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "generate\0" as *const byte) == 0 {
        return qwen3_generate_args_cli(argc, argv as & &byte);
    }
    if strcmp(argv[1] as *const byte, "chat\0" as *const byte) == 0 {
        if argc < 3 {
            _ = printf("usage: minicpm-o-uya chat <model.gguf> [--max-new-tokens N] [--temperature T] [--top-k K] [--top-p P] [--min-p P] [--repeat-penalty R] [--seed S] [--stop-token ID] [--threads N] [--verbose] [--dump-hidden]\n");
            return 1;
        }
        return qwen3_chat_cli(argc, argv as & &byte);
    }
    if strcmp(argv[1] as *const byte, "vision-smoke\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya vision-smoke <model.gguf> <image.raw|image.rgb|manifest>\n");
            return 1;
        }
        return vision_smoke_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "vision-preprocess-smoke\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya vision-preprocess-smoke <model.gguf> <image.rgb|manifest>\n");
            return 1;
        }
        return vision_preprocess_smoke_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audio-smoke\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya audio-smoke <model.gguf> <audio.raw>\n");
            return 1;
        }
        return audio_smoke_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audio-bind\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya audio-bind <audio.gguf>\n");
            return 1;
        }
        return audio_real_bind_cli(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audio-preprocess-smoke\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya audio-preprocess-smoke <audio.pcm>\n");
            return 1;
        }
        return audio_preprocess_smoke_cli(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audio-input-probe\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya audio-input-probe <audio.wav|audio.uyap.pcm>\n");
            return 1;
        }
        return audio_input_probe_cli(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audio-real-preprocess-probe\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya audio-real-preprocess-probe <audio.wav|audio.uyap.pcm>\n");
            return 1;
        }
        return audio_real_preprocess_probe_cli(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audio-real-mel-probe\0" as *const byte) == 0 {
        return audio_real_mel_probe_args_cli(argc, argv as & &byte);
    }
    if strcmp(argv[1] as *const byte, "audio-real-encode-probe\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya audio-real-encode-probe <audio.gguf> <audio.wav|audio.uyap.pcm>\n");
            return 1;
        }
        return audio_real_encode_probe_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audio2audio-smoke\0" as *const byte) == 0 {
        return audio2audio_smoke_args_cli(argc, argv as & &byte);
    }
    if strcmp(argv[1] as *const byte, "audio2audio-real\0" as *const byte) == 0 {
        return audio2audio_real_args_cli(argc, argv as & &byte);
    }
    if strcmp(argv[1] as *const byte, "speech-smoke\0" as *const byte) == 0 {
        if argc != 4 && argc != 5 {
            _ = printf("usage: minicpm-o-uya speech-smoke <model.gguf> <prompt> [out.wav]\n");
            return 1;
        }
        var wav_path: &const byte = speech_default_wav_path();
        if argc == 5 { wav_path = argv[4] as &const byte; }
        return speech_smoke_cli(argv[2] as &const byte, argv[3] as &const byte, wav_path);
    }
    if strcmp(argv[1] as *const byte, "tts-bind\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya tts-bind <tts.gguf>\n");
            return 1;
        }
        return speech_tts_bind_cli(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "omni-smoke\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya omni-smoke <model.gguf> <manifest.json>\n");
            return 1;
        }
        return omni_smoke_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "omni-chat\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya omni-chat <model.gguf>\n");
            return 1;
        }
        return omni_chat_cli(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "stream-chat\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya stream-chat <model.gguf> <manifest.json>\n");
            return 1;
        }
        return stream_chat_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "bench\0" as *const byte) == 0 {
        if argc < 3 {
            _ = printf("usage: minicpm-o-uya bench <model.gguf> <manifest.json>\n");
            _ = printf("   or: minicpm-o-uya bench <model.gguf> [--prompt TEXT] [--n-prompt N] [--n-gen N] [--repetitions N] [--threads N] [--no-warmup]\n");
            return 1;
        }
        return bench_cli(argc, argv as & &byte);
    }
    if strcmp(argv[1] as *const byte, "tensors\0" as *const byte) == 0 {
        if argc != 3 && argc != 4 {
            _ = printf("usage: minicpm-o-uya tensors <model.gguf> [--mmap]\n");
            return 1;
        }
        var attach: bool = false;
        if argc == 4 {
            if strcmp(argv[3] as *const byte, "--mmap\0" as *const byte) != 0 {
                _ = printf("usage: minicpm-o-uya tensors <model.gguf> [--mmap]\n");
                return 1;
            }
            attach = true;
        }
        return tensor_table_cli(argv[2] as &const byte, attach);
    }
    _ = printf("minicpm-o-uya: command not implemented yet: %s\n", argv[1]);
    return 1;
}

export fn gpu_context_attention(ctx: &GpuContext, q: &const f32, k: &const f32, v: &const f32, layer: usize, pos: usize, head_count: usize, kv_head_count: usize, head_dim: usize, context_capacity: usize, dst: &f32) bool {
    gpu_context_error_reset(ctx);
    if ctx.handle == null { return false; }
    if minicpmo_gpu_context_attention(ctx.handle, q, k, v, layer, pos, head_count, kv_head_count, head_dim, context_capacity, dst, &ctx.last_error[0], GPU_ERROR_CAP) == 0 {
        return false;

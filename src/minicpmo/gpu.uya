export fn cuda_smoke_cli() i32 {
    var ctx: GpuContext = gpu_context_init();
    if !gpu_context_open(0, &ctx) {
        _ = printf("%s\n", gpu_context_last_error(&ctx));
        return 1;
    }
    if !gpu_context_smoke(&ctx) {
        _ = printf("%s\n", gpu_context_last_error(&ctx));
        gpu_context_close(&ctx);
        return 1;
    }
    gpu_context_refresh_stats(&ctx);
    _ = printf("cuda-smoke: PASS device=0 backend_init_us=%llu host_to_device_bytes=%llu device_to_host_bytes=%llu weights_uploaded=%llu scratch_x_bytes=%llu scratch_y_bytes=%llu first_version_scope=qwen3-text-dense attention=cpu kv_cache=host\n", ctx.stats.backend_init_us, ctx.stats.host_to_device_bytes, ctx.stats.device_to_host_bytes, ctx.stats.uploaded_weight_count, ctx.stats.scratch_x_bytes, ctx.stats.scratch_y_bytes);
    gpu_context_close(&ctx);
    return 0;
}

export fn gpu_print_runtime_unsupported(prefix: &const byte, view: &TensorView) void {
    _ = printf("error: %s tensor=%s dtype=%s backend=cuda supported_dtypes=F32|F16|BF16|Q4_K|Q6_K no_cpu_fallback=true\n", prefix, &view.name[0] as &const byte, tensor_dtype_name(view.dtype));
}

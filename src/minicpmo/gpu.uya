export fn gpu_context_attention_slots(ctx: &GpuContext, dst_slot: u32, q_slot: u32, k_slot: u32, v_slot: u32, layer: usize, pos: usize, head_count: usize, kv_head_count: usize, head_dim: usize, context_capacity: usize) bool {

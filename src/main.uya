use libc.printf;
use libc.strcmp;
use minicpmo.gguf.audit_gguf;
use minicpmo.gguf.inspect_gguf;
use minicpmo.kernels.kernels_smoke_cli;
use minicpmo.kernels.quant_smoke_cli;
use minicpmo.qwen3.qwen3_bind_cli;
use minicpmo.tokenizer.tokenizer_decode_cli;
use minicpmo.tokenizer.tokenizer_encode_cli;
use minicpmo.tokenizer.tokenizer_format_chat_cli;
use minicpmo.tokenizer.tokenizer_piece_cli;
use minicpmo.tensor.tensor_table_cli;

fn print_help() void {
    _ = printf("minicpm-o-uya - pure Uya MiniCPM-o runtime scaffold\n");
    _ = printf("\n");
    _ = printf("Usage:\n");
    _ = printf("  minicpm-o-uya --help\n");
    _ = printf("  minicpm-o-uya inspect <model.gguf>\n");
    _ = printf("  minicpm-o-uya audit <model.gguf>\n");
    _ = printf("  minicpm-o-uya piece <model.gguf> <token-id>\n");
    _ = printf("  minicpm-o-uya encode <model.gguf> <text>\n");
    _ = printf("  minicpm-o-uya decode <model.gguf> <token-id>...\n");
    _ = printf("  minicpm-o-uya format-chat <model.gguf> <user-text>\n");
    _ = printf("  minicpm-o-uya tensors <model.gguf> [--mmap]\n");
    _ = printf("  minicpm-o-uya qwen3-bind <model.gguf>\n");
    _ = printf("  minicpm-o-uya kernels-smoke\n");
    _ = printf("  minicpm-o-uya quant-smoke\n");
    _ = printf("\n");
    _ = printf("Status: GGUF inspect/audit, tokenizer, tensor/Qwen3 binding, scalar kernels, and quant smoke are implemented; inference is not implemented yet.\n");
}

export extern fn main(argc: i32, argv: & &byte) i32 {
    if argc <= 1 || strcmp(argv[1] as *const byte, "--help\0" as *const byte) == 0 || strcmp(argv[1] as *const byte, "-h\0" as *const byte) == 0 {
        print_help();
        return 0;
    }
    if strcmp(argv[1] as *const byte, "kernels-smoke\0" as *const byte) == 0 {
        if argc != 2 {
            _ = printf("usage: minicpm-o-uya kernels-smoke\n");
            return 1;
        }
        return kernels_smoke_cli();
    }
    if strcmp(argv[1] as *const byte, "quant-smoke\0" as *const byte) == 0 {
        if argc != 2 {
            _ = printf("usage: minicpm-o-uya quant-smoke\n");
            return 1;
        }
        return quant_smoke_cli();
    }
    if strcmp(argv[1] as *const byte, "inspect\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya inspect <model.gguf>\n");
            return 1;
        }
        return inspect_gguf(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "audit\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya audit <model.gguf>\n");
            return 1;
        }
        return audit_gguf(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "piece\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya piece <model.gguf> <token-id>\n");
            return 1;
        }
        return tokenizer_piece_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "encode\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya encode <model.gguf> <text>\n");
            return 1;
        }
        return tokenizer_encode_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "decode\0" as *const byte) == 0 {
        if argc < 4 {
            _ = printf("usage: minicpm-o-uya decode <model.gguf> <token-id>...\n");
            return 1;
        }
        return tokenizer_decode_cli(argv[2] as &const byte, argc, argv as & &byte, 3);
    }
    if strcmp(argv[1] as *const byte, "format-chat\0" as *const byte) == 0 {
        if argc != 4 {
            _ = printf("usage: minicpm-o-uya format-chat <model.gguf> <user-text>\n");
            return 1;
        }
        return tokenizer_format_chat_cli(argv[2] as &const byte, argv[3] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "qwen3-bind\0" as *const byte) == 0 {
        if argc != 3 {
            _ = printf("usage: minicpm-o-uya qwen3-bind <model.gguf>\n");
            return 1;
        }
        return qwen3_bind_cli(argv[2] as &const byte);
    }
    if strcmp(argv[1] as *const byte, "tensors\0" as *const byte) == 0 {
        if argc != 3 && argc != 4 {
            _ = printf("usage: minicpm-o-uya tensors <model.gguf> [--mmap]\n");
            return 1;
        }
        var attach: bool = false;
        if argc == 4 {
            if strcmp(argv[3] as *const byte, "--mmap\0" as *const byte) != 0 {
                _ = printf("usage: minicpm-o-uya tensors <model.gguf> [--mmap]\n");
                return 1;
            }
            attach = true;
        }
        return tensor_table_cli(argv[2] as &const byte, attach);
    }
    _ = printf("minicpm-o-uya: command not implemented yet: %s\n", argv[1]);
    return 1;
}

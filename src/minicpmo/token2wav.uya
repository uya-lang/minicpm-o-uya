const T2W_FLOW_IN: usize = 320;
const T2W_FLOW_T_EMBED: usize = 256;
const T2W_FLOW_MAX_BLOCKS: usize = 64;
const T2W_PAD_TOKEN_DEFAULT: u32 = 4218;


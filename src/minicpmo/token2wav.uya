        if !t2w_check_matrix(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "attn.proj.weight\0" as &const byte, "flow_matching proj\0" as &const byte), 512, 512, "flow_matching proj\0" as &const byte) { ok = false; break; }
        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "attn.proj.bias\0" as &const byte, "flow_matching proj bias\0" as &const byte), 512, "flow_matching proj bias\0" as &const byte) { ok = false; break; }
        if !t2w_check_tensor3(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "conv.block.1.weight\0" as &const byte, "flow_matching conv1\0" as &const byte), 3, 512, 512, "flow_matching conv1\0" as &const byte) { ok = false; break; }
        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "conv.block.1.bias\0" as &const byte, "flow_matching conv1 bias\0" as &const byte), 512, "flow_matching conv1 bias\0" as &const byte) { ok = false; break; }
        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "conv.block.3.weight\0" as &const byte, "flow_matching conv3\0" as &const byte), 512, "flow_matching conv3\0" as &const byte) { ok = false; break; }
        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "conv.block.3.bias\0" as &const byte, "flow_matching conv3 bias\0" as &const byte), 512, "flow_matching conv3 bias\0" as &const byte) { ok = false; break; }

use minicpmo.tensor.tensor_weight_table_detach_mmap;
use minicpmo.tensor.tensor_weight_table_load;
use minicpmo.tokenizer.Tokenizer;
use minicpmo.tokenizer.tokenizer_chat_template_supported;
use minicpmo.tokenizer.tokenizer_encode_to_ids;
use minicpmo.tokenizer.tokenizer_format_chat_prompt;
use minicpmo.tokenizer.tokenizer_init;
use minicpmo.tokenizer.tokenizer_load;
use minicpmo.tokenizer.tokenizer_piece;

const QWEN3_GGUF_MAGIC: u32 = 0x46554747;
const QWEN3_GGUF_TYPE_UINT32: u32 = 4;
const QWEN3_GGUF_TYPE_INT32: u32 = 5;
const QWEN3_GGUF_TYPE_FLOAT32: u32 = 6;
const QWEN3_GGUF_TYPE_STRING: u32 = 8;
const QWEN3_GGUF_TYPE_ARRAY: u32 = 9;
const QWEN3_GGUF_TYPE_UINT64: u32 = 10;
const QWEN3_GGUF_TYPE_INT64: u32 = 11;
const QWEN3_GGUF_TYPE_FLOAT64: u32 = 12;
const QWEN3_MAX_LAYERS: usize = 64;
const QWEN3_FORWARD_MAX_LAYERS: usize = 4;
const QWEN3_FORWARD_MAX_CONTEXT: usize = 64;
const QWEN3_FORWARD_MAX_HIDDEN: usize = 64;
const QWEN3_FORWARD_MAX_FFN: usize = 256;
const QWEN3_FORWARD_MAX_QDIM: usize = 64;
const QWEN3_FORWARD_MAX_KVDIM: usize = 64;
const QWEN3_FORWARD_MAX_VOCAB: usize = 256;
const QWEN3_FORWARD_MAX_PROMPT: usize = 64;
const QWEN3_FORWARD_EPS: f32 = 0.000001;
const QWEN3_SAMPLER_DEFAULT_SEED: u32 = 1;
const QWEN3_CHAT_LINE_CAP: usize = 512;
const QWEN3_CHAT_TURN_CAP: usize = 1024;

export struct Qwen3SamplerConfig {
    max_new_tokens: u32,
    temperature_bits: u32,
    top_k: u32,
    top_p_bits: u32,
    min_p_bits: u32,
    repeat_penalty_bits: u32,
    seed: u32,
    stop_token: u32,
    stop_on_eos: bool,
}

struct Qwen3Runtime {
    k_cache: [f32: 16384],
    v_cache: [f32: 16384],
    prompt_ids: [u32: 64],
    prompt_count: usize,
    total_tokens: usize,
    seed: u32,
}

export struct Qwen3Config {
    vocab_size: u32,
    context_length: u32,
    hidden_size: u32,
    intermediate_size: u32,
    layer_count: u32,
    head_count: u32,
    kv_head_count: u32,
    head_dim: u32,
    norm_eps_bits: u32,
    rope_freq_base_bits: u32,
    has_norm_eps: bool,
    has_rope_freq_base: bool,
}

export struct Qwen3LayerWeights {
    attn_norm: &TensorView,
    q_proj: &TensorView,
    k_proj: &TensorView,
    v_proj: &TensorView,
    o_proj: &TensorView,
    q_norm: &TensorView,
    k_norm: &TensorView,
    ffn_norm: &TensorView,
    gate_proj: &TensorView,
    up_proj: &TensorView,
    down_proj: &TensorView,
}

export struct Qwen3Weights {
    token_embedding: &TensorView,
    output_norm: &TensorView,
    output: &TensorView,
    layers: [Qwen3LayerWeights: 64],
    layer_count: u32,
}

struct Qwen3StringRead {
    len: u64,
    copied: usize,
    truncated: bool,
}

fn qwen3_config_init() Qwen3Config {
    return Qwen3Config{ vocab_size: 0, context_length: 0, hidden_size: 0, intermediate_size: 0, layer_count: 0, head_count: 0, kv_head_count: 0, head_dim: 0, norm_eps_bits: 0, rope_freq_base_bits: 0, has_norm_eps: false, has_rope_freq_base: false };
}

fn qwen3_weights_init() Qwen3Weights {
    return Qwen3Weights{ token_embedding: null, output_norm: null, output: null, layers: [], layer_count: 0 };
}

fn qwen3_cstr_eq(a: &const byte, b: &const byte) bool {
    return strcmp(a as *const byte, b as *const byte) == 0;
}

fn qwen3_scalar_metadata_size(value_type: u32) u64 {
    if value_type == 0 || value_type == 1 || value_type == 7 { return 1; }
    if value_type == 2 || value_type == 3 { return 2; }
    if value_type == QWEN3_GGUF_TYPE_UINT32 || value_type == QWEN3_GGUF_TYPE_INT32 || value_type == QWEN3_GGUF_TYPE_FLOAT32 { return 4; }
    if value_type == QWEN3_GGUF_TYPE_UINT64 || value_type == QWEN3_GGUF_TYPE_INT64 || value_type == QWEN3_GGUF_TYPE_FLOAT64 { return 8; }
    return 0;
}

fn qwen3_read_string(reader: &BinaryReader, dest: &byte, dest_cap: usize, info: &Qwen3StringRead, context: &const byte) bool {
    info.len = 0;
    info.copied = 0;
    info.truncated = false;
    if !binary_read_u64_le(reader, &info.len, context) { return false; }
    if dest_cap == 0 { return binary_skip(reader, info.len, context); }
    var copy_len: usize = 0;
    if info.len > 0 {
        if info.len >= dest_cap as u64 {
            copy_len = dest_cap - 1;
            info.truncated = true;
        } else {
            copy_len = info.len as usize;
        }
        if copy_len > 0 {
            if !binary_read_exact(reader, dest, copy_len, context) { return false; }
        }
    }
    dest[copy_len] = 0;
    info.copied = copy_len;
    if info.len > copy_len as u64 {
        return binary_skip(reader, info.len - (copy_len as u64), context);
    }
    return true;
}

fn qwen3_skip_array(reader: &BinaryReader, element_type: u32, count: u64) bool {
    const elem_size: u64 = qwen3_scalar_metadata_size(element_type);
    if elem_size > 0 { return binary_skip(reader, elem_size * count, "metadata scalar array\0" as &const byte); }
    if element_type == QWEN3_GGUF_TYPE_STRING {
        var tmp: [byte: 1] = [];
        var info: Qwen3StringRead = Qwen3StringRead{ len: 0, copied: 0, truncated: false };
        var i: u64 = 0;
        while i < count {
            if !qwen3_read_string(reader, &tmp[0], 1, &info, "metadata string array element\0" as &const byte) { return false; }
            i = i + 1;
        }
        return true;
    }
    return false;
}

fn qwen3_apply_u32_metadata(config: &Qwen3Config, key: &const byte, value: u32) void {
    if qwen3_cstr_eq(key, "qwen3.context_length\0" as &const byte) { config.context_length = value; return; }
    if qwen3_cstr_eq(key, "qwen3.embedding_length\0" as &const byte) { config.hidden_size = value; return; }
    if qwen3_cstr_eq(key, "qwen3.feed_forward_length\0" as &const byte) { config.intermediate_size = value; return; }
    if qwen3_cstr_eq(key, "qwen3.block_count\0" as &const byte) { config.layer_count = value; return; }
    if qwen3_cstr_eq(key, "qwen3.attention.head_count\0" as &const byte) { config.head_count = value; return; }
    if qwen3_cstr_eq(key, "qwen3.attention.head_count_kv\0" as &const byte) { config.kv_head_count = value; return; }
    if qwen3_cstr_eq(key, "qwen3.rope.dimension_count\0" as &const byte) { config.head_dim = value; return; }
}

fn qwen3_skip_metadata_value(reader: &BinaryReader, config: &Qwen3Config, key: &const byte, value_type: u32) bool {
    if value_type == QWEN3_GGUF_TYPE_STRING {
        var tmp: [byte: 1] = [];
        var info: Qwen3StringRead = Qwen3StringRead{ len: 0, copied: 0, truncated: false };
        return qwen3_read_string(reader, &tmp[0], 1, &info, "metadata string value\0" as &const byte);
    }
    if value_type == QWEN3_GGUF_TYPE_ARRAY {
        var element_type: u32 = 0;
        var count: u64 = 0;
        if !binary_read_u32_le(reader, &element_type, "metadata array type\0" as &const byte) { return false; }
        if !binary_read_u64_le(reader, &count, "metadata array length\0" as &const byte) { return false; }
        if qwen3_cstr_eq(key, "tokenizer.ggml.tokens\0" as &const byte) && count <= 4294967295 { config.vocab_size = count as u32; }
        return qwen3_skip_array(reader, element_type, count);
    }
    if value_type == QWEN3_GGUF_TYPE_UINT32 || value_type == QWEN3_GGUF_TYPE_INT32 {
        var value: u32 = 0;
        if !binary_read_u32_le(reader, &value, "metadata int/uint32 value\0" as &const byte) { return false; }
        qwen3_apply_u32_metadata(config, key, value);
        return true;
    }
    if value_type == QWEN3_GGUF_TYPE_FLOAT32 {
        var bits: u32 = 0;
        if !binary_read_u32_le(reader, &bits, "metadata float32 value\0" as &const byte) { return false; }
        if qwen3_cstr_eq(key, "qwen3.attention.layer_norm_rms_epsilon\0" as &const byte) { config.norm_eps_bits = bits; config.has_norm_eps = true; }
        if qwen3_cstr_eq(key, "qwen3.rope.freq_base\0" as &const byte) { config.rope_freq_base_bits = bits; config.has_rope_freq_base = true; }
        return true;
    }
    const size: u64 = qwen3_scalar_metadata_size(value_type);
    if size > 0 { return binary_skip(reader, size, "metadata scalar value\0" as &const byte); }
    _ = printf("error: qwen3 config unsupported metadata type=%u key=%s\n", value_type, key);
    return false;
}

export fn qwen3_config_load_metadata(path: &const byte, config: &Qwen3Config) bool {
    config[0] = qwen3_config_init();
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    var version: u32 = 0;
    var tensor_count: u64 = 0;
    var metadata_count: u64 = 0;
    if !binary_read_u32_le(&reader, &magic, "GGUF magic\0" as &const byte) { binary_close(&reader); return false; }
    if magic != QWEN3_GGUF_MAGIC { _ = printf("error: qwen3 config bad GGUF magic\n"); binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &version, "GGUF version\0" as &const byte) { binary_close(&reader); return false; }
    if version != 2 && version != 3 { _ = printf("error: qwen3 config unsupported GGUF version=%u\n", version); binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &tensor_count, "GGUF tensor_count\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &metadata_count, "GGUF metadata_count\0" as &const byte) { binary_close(&reader); return false; }
    var i: u64 = 0;
    while i < metadata_count {
        var key: [byte: 128] = [];
        var info: Qwen3StringRead = Qwen3StringRead{ len: 0, copied: 0, truncated: false };
        if !qwen3_read_string(&reader, &key[0], @len(key), &info, "metadata key\0" as &const byte) { binary_close(&reader); return false; }
        if info.truncated { _ = printf("error: qwen3 config metadata key too long\n"); binary_close(&reader); return false; }
        var value_type: u32 = 0;
        if !binary_read_u32_le(&reader, &value_type, "metadata value type\0" as &const byte) { binary_close(&reader); return false; }
        if !qwen3_skip_metadata_value(&reader, config, &key[0] as &const byte, value_type) { binary_close(&reader); return false; }
        i = i + 1;
    }
    binary_close(&reader);
    return true;
}

fn qwen3_dtype_supported(dtype: TensorDType) bool {
    if dtype == TensorDType.F32 || dtype == TensorDType.F16 || dtype == TensorDType.BF16 { return true; }
    if dtype == TensorDType.Q8_0 || dtype == TensorDType.Q4_K || dtype == TensorDType.Q5_K || dtype == TensorDType.Q6_K || dtype == TensorDType.IQ4_NL { return true; }
    return false;
}

fn qwen3_print_shape(view: &TensorView) void {
    _ = printf("[");
    var i: u32 = 0;
    while i < view.n_dims {
        if i > 0 { _ = printf("x"); }
        _ = printf("%llu", view.shape[i as usize]);
        i = i + 1;
    }
    _ = printf("]");
}

fn qwen3_check_dtype(view: &TensorView, layer: u32) bool {
    if qwen3_dtype_supported(view.dtype) { return true; }
    _ = printf("error: qwen3 bind layer=%u tensor=%s unsupported dtype=%s\n", layer, &view.name[0], tensor_dtype_name(view.dtype));
    return false;
}

fn qwen3_check_vec(view: &TensorView, hidden: u32, layer: u32, role: &const byte) bool {
    if !qwen3_check_dtype(view, layer) { return false; }
    if view.n_dims == 1 && view.shape[0] == hidden as u64 { return true; }
    _ = printf("error: qwen3 bind layer=%u tensor=%s bad shape for %s expected=[%u] got=", layer, &view.name[0], role, hidden);
    qwen3_print_shape(view);
    _ = printf("\n");
    return false;
}

fn qwen3_check_matrix_first(view: &TensorView, first_dim: u32, layer: u32, role: &const byte) bool {
    if !qwen3_check_dtype(view, layer) { return false; }
    if view.n_dims == 2 && view.shape[0] == first_dim as u64 && view.shape[1] > 0 { return true; }
    _ = printf("error: qwen3 bind layer=%u tensor=%s bad shape for %s expected_first=%u got=", layer, &view.name[0], role, first_dim);
    qwen3_print_shape(view);
    _ = printf("\n");
    return false;
}

fn qwen3_check_matrix_exact(view: &TensorView, first_dim: u32, second_dim: u32, layer: u32, role: &const byte) bool {
    if !qwen3_check_dtype(view, layer) { return false; }
    if view.n_dims == 2 && view.shape[0] == first_dim as u64 && view.shape[1] == second_dim as u64 { return true; }
    _ = printf("error: qwen3 bind layer=%u tensor=%s bad shape for %s expected=[%u,%u] got=", layer, &view.name[0], role, first_dim, second_dim);
    qwen3_print_shape(view);
    _ = printf("\n");
    return false;
}

fn qwen3_lookup_required(table: &TensorWeightTable, name: &const byte, layer: u32) &TensorView {
    const view: &TensorView = tensor_lookup(table, name);
    if view == null { _ = printf("error: qwen3 bind layer=%u missing tensor %s\n", layer, name); }
    return view;
}

fn qwen3_lookup_layer_required(table: &TensorWeightTable, layer: u32, suffix: &const byte) &TensorView {
    var name: [byte: 96] = [];
    if !tensor_build_layer_name(layer, suffix, &name[0], @len(name)) { _ = printf("error: qwen3 bind layer=%u cannot build tensor name\n", layer); return null; }
    return qwen3_lookup_required(table, &name[0] as &const byte, layer);
}

fn qwen3_lookup_layer_optional(table: &TensorWeightTable, layer: u32, suffix: &const byte) &TensorView {
    var name: [byte: 96] = [];
    if !tensor_build_layer_name(layer, suffix, &name[0], @len(name)) { return null; }
    return tensor_lookup(table, &name[0] as &const byte);
}

fn qwen3_count_layers_from_tensors(table: &TensorWeightTable) u32 {
    var count: u32 = 0;
    while count < QWEN3_MAX_LAYERS as u32 {
        if qwen3_lookup_layer_optional(table, count, "attn_q.weight\0" as &const byte) == null { return count; }
        count = count + 1;
    }
    return count;
}

fn qwen3_complete_config_from_tensors(config: &Qwen3Config, table: &TensorWeightTable) bool {
    const emb: &TensorView = tensor_lookup_root_token_embedding(table);
    if emb == null { _ = printf("error: qwen3 bind layer=0 missing tensor token_embd.weight\n"); return false; }
    if emb.n_dims != 2 { _ = printf("error: qwen3 bind tensor=%s bad embedding shape got=", &emb.name[0]); qwen3_print_shape(emb); _ = printf("\n"); return false; }
    if config.hidden_size == 0 { config.hidden_size = emb.shape[0] as u32; }
    if config.vocab_size == 0 { config.vocab_size = emb.shape[1] as u32; }
    if config.layer_count == 0 { config.layer_count = qwen3_count_layers_from_tensors(table); }
    if config.head_count > 0 && config.hidden_size > 0 && config.head_dim == 0 {
        if config.hidden_size % config.head_count != 0 { _ = printf("error: qwen3 config hidden_size=%u not divisible by head_count=%u\n", config.hidden_size, config.head_count); return false; }
        config.head_dim = config.hidden_size / config.head_count;
    }
    if config.kv_head_count == 0 && config.head_count > 0 { config.kv_head_count = config.head_count; }
    if config.intermediate_size == 0 {
        const gate: &TensorView = qwen3_lookup_layer_optional(table, 0, "ffn_gate.weight\0" as &const byte);
        if gate != null && gate.n_dims == 2 { config.intermediate_size = gate.shape[1] as u32; }
    }
    if config.context_length == 0 { _ = printf("error: qwen3 config missing qwen3.context_length\n"); return false; }
    if config.hidden_size == 0 || config.vocab_size == 0 || config.layer_count == 0 || config.head_count == 0 || config.kv_head_count == 0 || config.head_dim == 0 || config.intermediate_size == 0 {
        _ = printf("error: qwen3 config incomplete vocab=%u hidden=%u layers=%u heads=%u kv_heads=%u head_dim=%u ffn=%u\n", config.vocab_size, config.hidden_size, config.layer_count, config.head_count, config.kv_head_count, config.head_dim, config.intermediate_size);
        return false;
    }
    if config.layer_count > QWEN3_MAX_LAYERS as u32 { _ = printf("error: qwen3 layer_count=%u exceeds max=%zu\n", config.layer_count, QWEN3_MAX_LAYERS); return false; }
    return true;
}

export fn qwen3_bind_weights(table: &TensorWeightTable, config: &Qwen3Config, weights: &Qwen3Weights) bool {
    weights[0] = qwen3_weights_init();
    weights.token_embedding = tensor_lookup_root_token_embedding(table);
    if weights.token_embedding == null { _ = printf("error: qwen3 bind layer=0 missing tensor token_embd.weight\n"); return false; }
    if !qwen3_check_matrix_exact(weights.token_embedding, config.hidden_size, config.vocab_size, 0, "token embedding\0" as &const byte) { return false; }
    weights.output_norm = tensor_lookup(table, "output_norm.weight\0" as &const byte);
    if weights.output_norm == null { weights.output_norm = tensor_lookup(table, "norm.weight\0" as &const byte); }
    if weights.output_norm == null { _ = printf("error: qwen3 bind layer=%u missing tensor output_norm.weight\n", config.layer_count); return false; }
    if !qwen3_check_vec(weights.output_norm, config.hidden_size, config.layer_count, "output norm\0" as &const byte) { return false; }
    weights.output = tensor_lookup_root_output(table);
    if weights.output == null { _ = printf("error: qwen3 bind layer=%u missing tensor output.weight\n", config.layer_count); return false; }
    if !qwen3_check_matrix_exact(weights.output, config.hidden_size, config.vocab_size, config.layer_count, "lm head/output\0" as &const byte) { return false; }
    weights.layer_count = config.layer_count;
    const q_dim: u32 = config.head_count * config.head_dim;
    const kv_dim: u32 = config.kv_head_count * config.head_dim;
    var layer: u32 = 0;
    while layer < config.layer_count {
        var lw: &Qwen3LayerWeights = &weights.layers[layer as usize];
        lw.attn_norm = qwen3_lookup_layer_required(table, layer, "attn_norm.weight\0" as &const byte);
        if lw.attn_norm == null || !qwen3_check_vec(lw.attn_norm, config.hidden_size, layer, "attention norm\0" as &const byte) { return false; }
        lw.q_proj = qwen3_lookup_layer_required(table, layer, "attn_q.weight\0" as &const byte);
        if lw.q_proj == null || !qwen3_check_matrix_exact(lw.q_proj, config.hidden_size, q_dim, layer, "q projection\0" as &const byte) { return false; }
        lw.k_proj = qwen3_lookup_layer_required(table, layer, "attn_k.weight\0" as &const byte);
        if lw.k_proj == null || !qwen3_check_matrix_exact(lw.k_proj, config.hidden_size, kv_dim, layer, "k projection\0" as &const byte) { return false; }
        lw.v_proj = qwen3_lookup_layer_required(table, layer, "attn_v.weight\0" as &const byte);
        if lw.v_proj == null || !qwen3_check_matrix_exact(lw.v_proj, config.hidden_size, kv_dim, layer, "v projection\0" as &const byte) { return false; }
        lw.o_proj = qwen3_lookup_layer_required(table, layer, "attn_output.weight\0" as &const byte);
        if lw.o_proj == null || !qwen3_check_matrix_exact(lw.o_proj, q_dim, config.hidden_size, layer, "o projection\0" as &const byte) { return false; }
        lw.q_norm = qwen3_lookup_layer_optional(table, layer, "attn_q_norm.weight\0" as &const byte);
        if lw.q_norm == null { lw.q_norm = qwen3_lookup_layer_optional(table, layer, "attn_q_a_norm.weight\0" as &const byte); }
        if lw.q_norm != null && !qwen3_check_vec(lw.q_norm, config.head_dim, layer, "q norm\0" as &const byte) { return false; }
        lw.k_norm = qwen3_lookup_layer_optional(table, layer, "attn_k_norm.weight\0" as &const byte);
        if lw.k_norm == null { lw.k_norm = qwen3_lookup_layer_optional(table, layer, "attn_k_a_norm.weight\0" as &const byte); }
        if lw.k_norm != null && !qwen3_check_vec(lw.k_norm, config.head_dim, layer, "k norm\0" as &const byte) { return false; }
        lw.ffn_norm = qwen3_lookup_layer_required(table, layer, "ffn_norm.weight\0" as &const byte);
        if lw.ffn_norm == null || !qwen3_check_vec(lw.ffn_norm, config.hidden_size, layer, "ffn norm\0" as &const byte) { return false; }
        lw.gate_proj = qwen3_lookup_layer_required(table, layer, "ffn_gate.weight\0" as &const byte);
        if lw.gate_proj == null || !qwen3_check_matrix_exact(lw.gate_proj, config.hidden_size, config.intermediate_size, layer, "ffn gate\0" as &const byte) { return false; }
        lw.up_proj = qwen3_lookup_layer_required(table, layer, "ffn_up.weight\0" as &const byte);
        if lw.up_proj == null || !qwen3_check_matrix_exact(lw.up_proj, config.hidden_size, config.intermediate_size, layer, "ffn up\0" as &const byte) { return false; }
        lw.down_proj = qwen3_lookup_layer_required(table, layer, "ffn_down.weight\0" as &const byte);
        if lw.down_proj == null || !qwen3_check_matrix_exact(lw.down_proj, config.intermediate_size, config.hidden_size, layer, "ffn down\0" as &const byte) { return false; }
        layer = layer + 1;
    }
    return true;
}

export fn qwen3_bind_cli(path: &const byte) i32 {
    var config: Qwen3Config = qwen3_config_init();
    if !qwen3_config_load_metadata(path, &config) { return 1; }
    var table: TensorWeightTable = tensor_table_init();
    if !tensor_weight_table_load(path, &table) { return 1; }
    if !qwen3_complete_config_from_tensors(&config, &table) { return 1; }
    var weights: Qwen3Weights = qwen3_weights_init();
    if !qwen3_bind_weights(&table, &config, &weights) { return 1; }
    var q_norm_label: &const byte = "no\0" as &const byte;
    if weights.layers[0].q_norm != null { q_norm_label = "yes\0" as &const byte; }
    var k_norm_label: &const byte = "no\0" as &const byte;
    if weights.layers[0].k_norm != null { k_norm_label = "yes\0" as &const byte; }
    _ = printf("qwen3 config: vocab=%u context=%u hidden=%u layers=%u heads=%u kv_heads=%u head_dim=%u ffn=%u norm_eps_bits=0x%x rope_freq_base_bits=0x%x\n", config.vocab_size, config.context_length, config.hidden_size, config.layer_count, config.head_count, config.kv_head_count, config.head_dim, config.intermediate_size, config.norm_eps_bits, config.rope_freq_base_bits);
    _ = printf("qwen3 bind: token_embd=%s output_norm=%s output=%s layers=%u q_norm=%s k_norm=%s\n", &weights.token_embedding.name[0], &weights.output_norm.name[0], &weights.output.name[0], weights.layer_count, q_norm_label, k_norm_label);
    _ = printf("qwen3 layer[0]: attn_norm=%s q=%s k=%s v=%s o=%s ffn_norm=%s gate=%s up=%s down=%s\n", &weights.layers[0].attn_norm.name[0], &weights.layers[0].q_proj.name[0], &weights.layers[0].k_proj.name[0], &weights.layers[0].v_proj.name[0], &weights.layers[0].o_proj.name[0], &weights.layers[0].ffn_norm.name[0], &weights.layers[0].gate_proj.name[0], &weights.layers[0].up_proj.name[0], &weights.layers[0].down_proj.name[0]);
    _ = printf("qwen3 bind: PASS\n");
    return 0;
}


fn qwen3_read_u16_at(data: &const byte, byte_offset: usize) u16 {
    return (data[byte_offset] as u16) | ((data[byte_offset + (1 as usize)] as u16) << 8);
}

fn qwen3_tensor_get(view: &TensorView, index: usize) f32 {
    if view.dtype == TensorDType.F16 {
        return f16_load_f32(qwen3_read_u16_at(view.data, index * (2 as usize)));
    }
    if view.dtype == TensorDType.BF16 {
        return bf16_load_f32(qwen3_read_u16_at(view.data, index * (2 as usize)));
    }
    if view.dtype == TensorDType.F32 {
        const ptr: &const f32 = &view.data[index * (4 as usize)] as &const f32;
        return ptr[0];
    }
    return 0.0 as f32;
}

fn qwen3_check_forward_caps(config: &Qwen3Config) bool {
    const q_dim: u32 = config.head_count * config.head_dim;
    const kv_dim: u32 = config.kv_head_count * config.head_dim;
    if config.layer_count == 0 || config.layer_count > QWEN3_FORWARD_MAX_LAYERS as u32 { _ = printf("error: qwen3 forward layer_count=%u exceeds cap=%zu\n", config.layer_count, QWEN3_FORWARD_MAX_LAYERS); return false; }
    if config.context_length == 0 || config.context_length > QWEN3_FORWARD_MAX_CONTEXT as u32 { _ = printf("error: qwen3 forward context_length=%u exceeds cap=%zu\n", config.context_length, QWEN3_FORWARD_MAX_CONTEXT); return false; }
    if config.hidden_size == 0 || config.hidden_size > QWEN3_FORWARD_MAX_HIDDEN as u32 { _ = printf("error: qwen3 forward hidden_size=%u exceeds cap=%zu\n", config.hidden_size, QWEN3_FORWARD_MAX_HIDDEN); return false; }
    if config.intermediate_size == 0 || config.intermediate_size > QWEN3_FORWARD_MAX_FFN as u32 { _ = printf("error: qwen3 forward intermediate_size=%u exceeds cap=%zu\n", config.intermediate_size, QWEN3_FORWARD_MAX_FFN); return false; }
    if q_dim == 0 || q_dim > QWEN3_FORWARD_MAX_QDIM as u32 { _ = printf("error: qwen3 forward q_dim=%u exceeds cap=%zu\n", q_dim, QWEN3_FORWARD_MAX_QDIM); return false; }
    if kv_dim == 0 || kv_dim > QWEN3_FORWARD_MAX_KVDIM as u32 { _ = printf("error: qwen3 forward kv_dim=%u exceeds cap=%zu\n", kv_dim, QWEN3_FORWARD_MAX_KVDIM); return false; }
    if config.vocab_size == 0 || config.vocab_size > QWEN3_FORWARD_MAX_VOCAB as u32 { _ = printf("error: qwen3 forward vocab_size=%u exceeds cap=%zu\n", config.vocab_size, QWEN3_FORWARD_MAX_VOCAB); return false; }
    return true;
}

fn qwen3_copy_embedding(dst: &f32, emb: &TensorView, token_id: u32, hidden: usize, vocab: usize) void {
    var i: usize = 0;
    while i < hidden {
        dst[i] = qwen3_tensor_get(emb, i * vocab + token_id as usize);
        i = i + 1;
    }
}

fn qwen3_rms_norm_view(dst: &f32, src: &const f32, weight: &TensorView, n: usize) void {
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n { sum = sum + src[i] * src[i]; i = i + 1; }
    const inv: f32 = 1.0 / sqrtf(sum / (n as f32) + QWEN3_FORWARD_EPS);
    i = 0;
    while i < n {
        dst[i] = src[i] * inv * qwen3_tensor_get(weight, i);
        i = i + 1;
    }
}

fn qwen3_matvec_view(dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_dim: usize) void {
    var j: usize = 0;
    while j < out_dim {
        var sum: f32 = 0.0;
        var i: usize = 0;
        while i < in_dim {
            sum = sum + x[i] * qwen3_tensor_get(matrix, i * out_dim + j);
            i = i + 1;
        }
        dst[j] = sum;
        j = j + 1;
    }
}

fn qwen3_apply_head_norm(vec: &f32, norm: &TensorView, head_count: usize, head_dim: usize) void {
    var h: usize = 0;
    while h < head_count {
        const base: usize = h * head_dim;
        var sum: f32 = 0.0;
        var d: usize = 0;
        while d < head_dim { sum = sum + vec[base + d] * vec[base + d]; d = d + 1; }
        const inv: f32 = 1.0 / sqrtf(sum / (head_dim as f32) + QWEN3_FORWARD_EPS);
        d = 0;
        while d < head_dim {
            vec[base + d] = vec[base + d] * inv * qwen3_tensor_get(norm, d);
            d = d + 1;
        }
        h = h + 1;
    }
}

fn qwen3_apply_rope(vec: &f32, head_count: usize, head_dim: usize, pos: usize) void {
    var h: usize = 0;
    while h < head_count {
        const base: usize = h * head_dim;
        var d: usize = 0;
        while d + (1 as usize) < head_dim {
            const theta: f32 = (pos as f32) * (((d / (2 as usize)) + (1 as usize)) as f32) * 0.01;
            rope_rotate_pair(&vec[base + d], &vec[base + d + (1 as usize)], theta);
            d = d + (2 as usize);
        }
        h = h + 1;
    }
}

fn qwen3_cache_index(layer: usize, pos: usize, dim: usize) usize {
    return (layer * QWEN3_FORWARD_MAX_CONTEXT + pos) * QWEN3_FORWARD_MAX_KVDIM + dim;
}

fn qwen3_write_kv_cache(k_cache: &f32, v_cache: &f32, layer: usize, pos: usize, k: &const f32, v: &const f32, kv_dim: usize) void {
    var d: usize = 0;
    while d < kv_dim {
        const idx: usize = qwen3_cache_index(layer, pos, d);
        k_cache[idx] = k[d];
        v_cache[idx] = v[d];
        d = d + 1;
    }
}

fn qwen3_attention(out: &f32, q: &const f32, k_cache: &const f32, v_cache: &const f32, layer: usize, pos: usize, head_count: usize, kv_head_count: usize, head_dim: usize) void {
    var i: usize = 0;
    const q_dim: usize = head_count * head_dim;
    while i < q_dim { out[i] = 0.0; i = i + 1; }
    var scores: [f32: 64] = [];
    var probs: [f32: 64] = [];
    const scale: f32 = 1.0 / sqrtf(head_dim as f32);
    var h: usize = 0;
    while h < head_count {
        const kvh: usize = (h * kv_head_count) / head_count;
        var t: usize = 0;
        while t <= pos {
            var dot: f32 = 0.0;
            var d: usize = 0;
            while d < head_dim {
                dot = dot + q[h * head_dim + d] * k_cache[qwen3_cache_index(layer, t, kvh * head_dim + d)];
                d = d + 1;
            }
            scores[t] = dot * scale;
            t = t + 1;
        }
        softmax(&probs[0], &scores[0], pos + (1 as usize));
        var d2: usize = 0;
        while d2 < head_dim {
            var sum: f32 = 0.0;
            t = 0;
            while t <= pos {
                sum = sum + probs[t] * v_cache[qwen3_cache_index(layer, t, kvh * head_dim + d2)];
                t = t + 1;
            }
            out[h * head_dim + d2] = sum;
            d2 = d2 + 1;
        }
        h = h + 1;
    }
}

fn qwen3_argmax(values: &const f32, n: usize) u32 {
    var best: usize = 0;
    var i: usize = 1;
    while i < n {
        if values[i] > values[best] { best = i; }
        i = i + 1;
    }
    return best as u32;
}

fn qwen3_forward_token(config: &Qwen3Config, weights: &Qwen3Weights, token_id: u32, pos: usize, k_cache: &f32, v_cache: &f32, logits: &f32) bool {
    const hidden_n: usize = config.hidden_size as usize;
    const vocab_n: usize = config.vocab_size as usize;
    const ffn_n: usize = config.intermediate_size as usize;
    const head_count: usize = config.head_count as usize;
    const kv_head_count: usize = config.kv_head_count as usize;
    const head_dim: usize = config.head_dim as usize;
    const q_dim: usize = head_count * head_dim;
    const kv_dim: usize = kv_head_count * head_dim;
    var hidden: [f32: 64] = [];
    var normed: [f32: 64] = [];
    var q: [f32: 64] = [];
    var k: [f32: 64] = [];
    var v: [f32: 64] = [];
    var attn_ctx: [f32: 64] = [];
    var attn_out: [f32: 64] = [];
    var gate: [f32: 256] = [];
    var up: [f32: 256] = [];
    var fused: [f32: 256] = [];
    var down: [f32: 64] = [];
    qwen3_copy_embedding(&hidden[0], weights.token_embedding, token_id, hidden_n, vocab_n);
    var layer: usize = 0;
    while layer < config.layer_count as usize {
        const lw: &Qwen3LayerWeights = &weights.layers[layer];
        qwen3_rms_norm_view(&normed[0], &hidden[0], lw.attn_norm, hidden_n);
        qwen3_matvec_view(&q[0], lw.q_proj, &normed[0], hidden_n, q_dim);
        qwen3_matvec_view(&k[0], lw.k_proj, &normed[0], hidden_n, kv_dim);
        qwen3_matvec_view(&v[0], lw.v_proj, &normed[0], hidden_n, kv_dim);
        if lw.q_norm != null { qwen3_apply_head_norm(&q[0], lw.q_norm, head_count, head_dim); }
        if lw.k_norm != null { qwen3_apply_head_norm(&k[0], lw.k_norm, kv_head_count, head_dim); }
        qwen3_apply_rope(&q[0], head_count, head_dim, pos);
        qwen3_apply_rope(&k[0], kv_head_count, head_dim, pos);
        qwen3_write_kv_cache(k_cache, v_cache, layer, pos, &k[0], &v[0], kv_dim);
        qwen3_attention(&attn_ctx[0], &q[0], k_cache, v_cache, layer, pos, head_count, kv_head_count, head_dim);
        qwen3_matvec_view(&attn_out[0], lw.o_proj, &attn_ctx[0], q_dim, hidden_n);
        var i: usize = 0;
        while i < hidden_n { hidden[i] = hidden[i] + attn_out[i]; i = i + 1; }
        qwen3_rms_norm_view(&normed[0], &hidden[0], lw.ffn_norm, hidden_n);
        qwen3_matvec_view(&gate[0], lw.gate_proj, &normed[0], hidden_n, ffn_n);
        qwen3_matvec_view(&up[0], lw.up_proj, &normed[0], hidden_n, ffn_n);
        i = 0;
        while i < ffn_n { fused[i] = silu(gate[i]) * up[i]; i = i + 1; }
        qwen3_matvec_view(&down[0], lw.down_proj, &fused[0], ffn_n, hidden_n);
        i = 0;
        while i < hidden_n { hidden[i] = hidden[i] + down[i]; i = i + 1; }
        layer = layer + 1;
    }
    qwen3_rms_norm_view(&normed[0], &hidden[0], weights.output_norm, hidden_n);
    qwen3_matvec_view(logits, weights.output, &normed[0], hidden_n, vocab_n);
    return true;
}


fn qwen3_sampler_init() Qwen3SamplerConfig {
    return Qwen3SamplerConfig{ max_new_tokens: 1, temperature_bits: 0x3f800000, top_k: 1, top_p_bits: 0x3f800000, min_p_bits: 0, repeat_penalty_bits: 0x3f800000, seed: QWEN3_SAMPLER_DEFAULT_SEED, stop_token: 2, stop_on_eos: true };
}

fn qwen3_sampler_f32(bits: u32) f32 {
    const ptr: &const f32 = &bits as &const f32;
    return ptr[0];
}

fn qwen3_parse_u32_value(text: &const byte, out: &u32) bool {
    var i: usize = 0;
    var value: u32 = 0;
    if text[0] == 0 { return false; }
    while text[i] != 0 {
        if text[i] < 48 || text[i] > 57 { return false; }
        value = value * 10 + ((text[i] - 48) as u32);
        i = i + 1;
    }
    *out = value;
    return true;
}

fn qwen3_parse_f32_value(text: &const byte, out_bits: &u32) bool {
    var end_ptr: &const byte = null;
    const value: f32 = strtod(text, &end_ptr) as f32;
    if end_ptr == null {
        return false;
    }
    if end_ptr == text || end_ptr[0] != 0 {
        return false;
    }
    const bits_ptr: &const u32 = &value as &const u32;
    *out_bits = bits_ptr[0];
    return true;
}

fn qwen3_xorshift32(state: &u32) u32 {
    var x: u32 = *state;
    x = x ^ (x << 13);
    x = x ^ (x >> 17);
    x = x ^ (x << 5);
    *state = x;
    return x;
}

fn qwen3_random_unit(seed: &u32) f32 {
    const value: u32 = qwen3_xorshift32(seed);
    return ((value as f32) / 4294967295.0) as f32;
}

fn qwen3_apply_repeat_penalty(logits: &f32, vocab: usize, seen: &const u32, seen_count: usize, penalty: f32) void {
    if penalty <= 1.0 { return; }
    var i: usize = 0;
    while i < seen_count {
        const token: usize = seen[i] as usize;
        if token < vocab {
            if logits[token] > 0.0 { logits[token] = logits[token] / penalty; }
            if logits[token] < 0.0 { logits[token] = logits[token] * penalty; }
        }
        i = i + 1;
    }
}

fn qwen3_sample(logits: &f32, vocab: usize, seen: &const u32, seen_count: usize, sampler: &Qwen3SamplerConfig, seed: &u32) u32 {
    const temp: f32 = qwen3_sampler_f32(sampler.temperature_bits);
    const top_p: f32 = qwen3_sampler_f32(sampler.top_p_bits);
    const min_p: f32 = qwen3_sampler_f32(sampler.min_p_bits);
    const repeat_penalty: f32 = qwen3_sampler_f32(sampler.repeat_penalty_bits);
    var local: [f32: 256] = [];
    var probs: [f32: 256] = [];
    var order: [u32: 256] = [];
    var i: usize = 0;
    while i < vocab {
        local[i] = logits[i];
        order[i] = i as u32;
        i = i + 1;
    }
    qwen3_apply_repeat_penalty(&local[0], vocab, seen, seen_count, repeat_penalty);
    if temp <= 0.000001 || sampler.top_k <= 1 { return qwen3_argmax(&local[0], vocab); }
    i = 0;
    while i < vocab {
        local[i] = local[i] / temp;
        i = i + 1;
    }
    softmax(&probs[0], &local[0], vocab);
    var a: usize = 0;
    while a < vocab {
        var b: usize = a + 1;
        while b < vocab {
            if probs[b] > probs[a] {
                const tp: f32 = probs[a]; probs[a] = probs[b]; probs[b] = tp;
                const ti: u32 = order[a]; order[a] = order[b]; order[b] = ti;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    var limit: usize = vocab;
    if sampler.top_k > 0 && sampler.top_k < limit as u32 { limit = sampler.top_k as usize; }
    var cumulative: f32 = 0.0;
    var kept: usize = 0;
    while kept < limit {
        if kept >= vocab || kept >= 256 { break; }
        cumulative = cumulative + probs[kept];
        kept = kept + 1;
        if cumulative >= top_p && top_p < 0.999999 { break; }
    }
    var max_prob: f32 = probs[0];
    if min_p > 0.0 {
        while kept > 1 {
            const tail: usize = kept - 1;
            if tail >= 256 || probs[tail] >= (max_prob * min_p) { break; }
            kept = kept - 1;
        }
    }
    var norm: f32 = 0.0;
    i = 0;
    while i < kept { norm = norm + probs[i]; i = i + 1; }
    const r: f32 = qwen3_random_unit(seed);
    var acc: f32 = 0.0;
    i = 0;
    while i < kept {
        acc = acc + probs[i] / norm;
        if r <= acc || i + 1 == kept { return order[i]; }
        i = i + 1;
    }
    return order[0];
}

fn qwen3_parse_sampler_args(argc: i32, argv: & &byte, start_index: i32, sampler: &Qwen3SamplerConfig) bool {
    var i: i32 = start_index;
    while i < argc {
        if strcmp(argv[i] as *const byte, "--max-new-tokens\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.max_new_tokens) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--temperature\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_f32_value(argv[i + 1] as &const byte, &sampler.temperature_bits) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--top-k\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.top_k) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--top-p\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_f32_value(argv[i + 1] as &const byte, &sampler.top_p_bits) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--min-p\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_f32_value(argv[i + 1] as &const byte, &sampler.min_p_bits) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--repeat-penalty\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_f32_value(argv[i + 1] as &const byte, &sampler.repeat_penalty_bits) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--seed\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.seed) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--stop-token\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.stop_token) { return false; }
            sampler.stop_on_eos = false;
            i = i + 2; continue;
        }
        return false;
    }
    return true;
}

fn qwen3_runtime_init() Qwen3Runtime {
    return Qwen3Runtime{ k_cache: [], v_cache: [], prompt_ids: [], prompt_count: 0, total_tokens: 0, seed: QWEN3_SAMPLER_DEFAULT_SEED };
}

fn qwen3_append_prompt_ids(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, ids: &const u32, id_count: usize, logits: &f32) bool {
    if id_count == 0 {
        _ = printf("error: empty prompt\n");
        return false;
    }
    if runtime.total_tokens + id_count > config.context_length as usize || runtime.total_tokens + id_count > QWEN3_FORWARD_MAX_CONTEXT {
        _ = printf("error: context overflow total_tokens=%zu add_tokens=%zu context=%u\n", runtime.total_tokens, id_count, config.context_length);
        return false;
    }
    var i: usize = 0;
    while i < id_count {
        const pos: usize = runtime.total_tokens;
        runtime.prompt_ids[pos] = ids[i];
        if !qwen3_forward_token(config, weights, ids[i], pos, &runtime.k_cache[0], &runtime.v_cache[0], logits) { return false; }
        runtime.total_tokens = runtime.total_tokens + 1;
        i = i + 1;
    }
    runtime.prompt_count = runtime.total_tokens;
    return true;
}

fn qwen3_append_prompt_text(config: &Qwen3Config, weights: &Qwen3Weights, tok: &Tokenizer, runtime: &Qwen3Runtime, prompt: &const byte, logits: &f32) bool {
    var ids: [u32: 64] = [];
    var id_count: usize = 0;
    if !tokenizer_encode_to_ids(tok, prompt, &ids[0], QWEN3_FORWARD_MAX_PROMPT, &id_count) {
        return false;
    }
    return qwen3_append_prompt_ids(config, weights, runtime, &ids[0], id_count, logits);
}

fn qwen3_generate_tokens(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, sampler: &Qwen3SamplerConfig, tok: &Tokenizer, logits: &f32) i32 {
    var generated: usize = 0;
    while generated < sampler.max_new_tokens as usize {
        if runtime.total_tokens >= config.context_length as usize || runtime.total_tokens >= QWEN3_FORWARD_MAX_CONTEXT { _ = printf("error: context overflow total_tokens=%zu context=%u\n", runtime.total_tokens, config.context_length); return 1; }
        const next_id: u32 = qwen3_sample(logits, config.vocab_size as usize, &runtime.prompt_ids[0], runtime.total_tokens, sampler, &runtime.seed);
        _ = printf("sampled token[%zu]: %u piece=%s\n", generated, next_id, tokenizer_piece(tok, next_id));
        if next_id == sampler.stop_token {
            _ = printf("stop: token=%u\n", next_id);
            return 0;
        }
        runtime.prompt_ids[runtime.total_tokens] = next_id;
        runtime.total_tokens = runtime.total_tokens + 1;
        if !qwen3_forward_token(config, weights, next_id, runtime.total_tokens - 1, &runtime.k_cache[0], &runtime.v_cache[0], logits) { return 1; }
        generated = generated + 1;
    }
    return 0;
}

fn qwen3_open_runtime(path: &const byte, config: &Qwen3Config, table: &TensorWeightTable, weights: &Qwen3Weights, tok: &Tokenizer, runtime: &Qwen3Runtime) bool {
    if !qwen3_config_load_metadata(path, config) { return false; }
    table[0] = tensor_table_init();
    if !tensor_weight_table_load(path, table) { return false; }
    if !qwen3_complete_config_from_tensors(config, table) { return false; }
    if !qwen3_check_forward_caps(config) { return false; }
    if !tensor_weight_table_attach_mmap(path, table) { return false; }
    weights[0] = qwen3_weights_init();
    if !qwen3_bind_weights(table, config, weights) { tensor_weight_table_detach_mmap(table); return false; }
    tok[0] = tokenizer_init();
    if !tokenizer_load(path, tok) { tensor_weight_table_detach_mmap(table); return false; }
    runtime[0] = qwen3_runtime_init();
    return true;
}

fn qwen3_prepare_runtime(path: &const byte, prompt: &const byte, config: &Qwen3Config, table: &TensorWeightTable, weights: &Qwen3Weights, tok: &Tokenizer, runtime: &Qwen3Runtime, logits: &f32) bool {
    if !qwen3_open_runtime(path, config, table, weights, tok, runtime) { return false; }
    if !qwen3_append_prompt_text(config, weights, tok, runtime, prompt, logits) {
        tensor_weight_table_detach_mmap(table);
        return false;
    }
    return true;
}

fn qwen3_trim_line(line: &byte) void {
    var len: usize = 0;
    while line[len] != 0 {
        len = len + 1;
    }
    while len > 0 && (line[len - 1] == 10 || line[len - 1] == 13) {
        line[len - 1] = 0;
        len = len - 1;
    }
}

export fn qwen3_generate_cli(path: &const byte, prompt: &const byte) i32 {
    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    var logits: [f32: 256] = [];
    if !qwen3_prepare_runtime(path, prompt, &config, &table, &weights, &tok, &runtime, &logits[0]) { return 1; }
    var sampler: Qwen3SamplerConfig = qwen3_sampler_init();
    _ = printf("generate prompt_tokens:");
    var i: usize = 0;
    while i < runtime.prompt_count { _ = printf(" %u", runtime.prompt_ids[i]); i = i + 1; }
    _ = printf("\n");
    const rc: i32 = qwen3_generate_tokens(&config, &weights, &runtime, &sampler, &tok, &logits[0]);
    if rc == 0 {
        _ = printf("logits[0..4]: %.6f %.6f %.6f %.6f %.6f\n", logits[0] as f64, logits[1] as f64, logits[2] as f64, logits[3] as f64, logits[4] as f64);
    }
    tensor_weight_table_detach_mmap(&table);
    return rc;
}

export fn qwen3_generate_args_cli(argc: i32, argv: & &byte) i32 {
    if argc < 4 { _ = printf("usage: minicpm-o-uya generate <model.gguf> <prompt> [--max-new-tokens N] [--temperature T] [--top-k K] [--top-p P] [--min-p P] [--repeat-penalty R] [--seed S] [--stop-token ID]\n"); return 1; }
    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    var logits: [f32: 256] = [];
    if !qwen3_prepare_runtime(argv[2] as &const byte, argv[3] as &const byte, &config, &table, &weights, &tok, &runtime, &logits[0]) { return 1; }
    var sampler: Qwen3SamplerConfig = qwen3_sampler_init();
    if !qwen3_parse_sampler_args(argc, argv, 4, &sampler) { _ = printf("error: invalid generate sampler args\n"); tensor_weight_table_detach_mmap(&table); return 1; }
    runtime.seed = sampler.seed;
    _ = printf("generate prompt_tokens:");
    var i: usize = 0;
    while i < runtime.prompt_count { _ = printf(" %u", runtime.prompt_ids[i]); i = i + 1; }
    _ = printf("\n");
    const rc: i32 = qwen3_generate_tokens(&config, &weights, &runtime, &sampler, &tok, &logits[0]);
    tensor_weight_table_detach_mmap(&table);
    return rc;
}

export fn qwen3_chat_cli(path: &const byte) i32 {
    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    if !qwen3_open_runtime(path, &config, &table, &weights, &tok, &runtime) { return 1; }
    if !tokenizer_chat_template_supported(&tok) {
        _ = printf("error: unsupported chat template: %s\n", &tok.chat_template[0]);
        tensor_weight_table_detach_mmap(&table);
        return 1;
    }
    var sampler: Qwen3SamplerConfig = qwen3_sampler_init();
    sampler.max_new_tokens = 1;
    var logits: [f32: 256] = [];
    var line: [byte: QWEN3_CHAT_LINE_CAP] = [];
    var turn_prompt: [byte: QWEN3_CHAT_TURN_CAP] = [];
    var close_previous_assistant: bool = false;
    _ = printf("chat> ");
    while fgets(&line[0], QWEN3_CHAT_LINE_CAP, stdin) != null {
        qwen3_trim_line(&line[0]);
        if line[0] == 0 {
            _ = printf("chat> ");
            continue;
        }
        if !tokenizer_format_chat_prompt(&tok, &line[0] as &const byte, close_previous_assistant, &turn_prompt[0], QWEN3_CHAT_TURN_CAP) {
            _ = printf("error: formatted chat prompt exceeds buffer cap=%zu\n", QWEN3_CHAT_TURN_CAP);
            tensor_weight_table_detach_mmap(&table);
            return 1;
        }
        if !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, &turn_prompt[0] as &const byte, &logits[0]) {
            tensor_weight_table_detach_mmap(&table);
            return 1;
        }
        if qwen3_generate_tokens(&config, &weights, &runtime, &sampler, &tok, &logits[0]) != 0 { tensor_weight_table_detach_mmap(&table); return 1; }
        close_previous_assistant = true;
        _ = printf("chat> ");
    }
    tensor_weight_table_detach_mmap(&table);
    return 0;
}

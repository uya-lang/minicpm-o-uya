        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "conv.block.6.bias\0" as &const byte, "flow_matching conv6 bias\0" as &const byte), 512, "flow_matching conv6 bias\0" as &const byte) { ok = false; break; }
        if !t2w_check_matrix(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "mlp.fc1.weight\0" as &const byte, "flow_matching fc1\0" as &const byte), 512, 2048, "flow_matching fc1\0" as &const byte) { ok = false; break; }
        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "mlp.fc1.bias\0" as &const byte, "flow_matching fc1 bias\0" as &const byte), 2048, "flow_matching fc1 bias\0" as &const byte) { ok = false; break; }
        if !t2w_check_matrix(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "mlp.fc2.weight\0" as &const byte, "flow_matching fc2\0" as &const byte), 2048, 512, "flow_matching fc2\0" as &const byte) { ok = false; break; }

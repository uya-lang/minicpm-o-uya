use libc.calloc;
use libc.free;
use libc.printf;
use libc.strcmp;
use minicpmo.binary.BinaryReader;
use minicpmo.binary.binary_close;
use minicpmo.binary.binary_open;
use minicpmo.binary.binary_read_exact;
use minicpmo.binary.binary_read_u32_le;
use minicpmo.binary.binary_read_u64_le;
use minicpmo.binary.binary_read_u8;
use minicpmo.binary.binary_reader_init;
use minicpmo.binary.binary_skip;

const TOK_GGUF_MAGIC: u32 = 0x46554747;
const TOK_GGUF_DEFAULT_ALIGNMENT: u64 = 32;
const TOK_GGUF_TYPE_UINT32: u32 = 4;
const TOK_GGUF_TYPE_INT32: u32 = 5;
const TOK_GGUF_TYPE_FLOAT32: u32 = 6;
const TOK_GGUF_TYPE_STRING: u32 = 8;
const TOK_GGUF_TYPE_ARRAY: u32 = 9;
const TOKENIZER_DEFAULT_TOKEN_CAP: usize = 4096;
const TOKENIZER_PIECE_CAP: usize = 512;
const TOKENIZER_DEFAULT_MERGE_CAP: usize = 4096;
const TOKENIZER_CHAT_TEMPLATE_DEFAULT_CAP: usize = 512;
const TOKENIZER_HARD_MAX_TOKENS: usize = 262144;
const TOKENIZER_HARD_MAX_MERGES: usize = 262144;
const TOKENIZER_HARD_MAX_CHAT_TEMPLATE: usize = 16384;
const TOKENIZER_UNKNOWN_ID: u32 = 4294967295;
const TOKENIZER_BPE_MAX_PARTS: usize = 1024;

struct TokGgufStringRead {
    len: u64,
    copied: usize,
    truncated: bool,
}

export struct Tokenizer {
    token_count: usize,
    token_capacity: usize,
    tokens: &byte,
    scores: &u32,
    types: &u32,
    merge_count: usize,
    merge_capacity: usize,
    merges: &byte,
    bos_id: u32,
    eos_id: u32,
    pad_id: u32,
    unk_id: u32,
    chat_template: &byte,
    chat_template_cap: usize,
    has_chat_template: bool,
    byte_bpe: bool,
}

export fn tokenizer_init() Tokenizer {
    return Tokenizer{
        token_count: 0,
        token_capacity: 0,
        tokens: null,
        scores: null,
        types: null,
        merge_count: 0,
        merge_capacity: 0,
        merges: null,
        bos_id: TOKENIZER_UNKNOWN_ID,
        eos_id: TOKENIZER_UNKNOWN_ID,
        pad_id: TOKENIZER_UNKNOWN_ID,
        unk_id: TOKENIZER_UNKNOWN_ID,
        chat_template: null,
        chat_template_cap: 0,
        has_chat_template: false,
        byte_bpe: false,
    };
}

export fn tokenizer_free(tok: &Tokenizer) void {
    if tok.tokens != null { free(tok.tokens as &void); }
    if tok.scores != null { free(tok.scores as &void); }
    if tok.types != null { free(tok.types as &void); }
    if tok.merges != null { free(tok.merges as &void); }
    if tok.chat_template != null { free(tok.chat_template as &void); }
    tok[0] = tokenizer_init();
}

fn tokenizer_alloc_tokens(tok: &Tokenizer, count: usize) bool {
    if count > TOKENIZER_HARD_MAX_TOKENS {
        _ = printf("error: tokenizer has too many tokens (%zu > %zu)\n", count, TOKENIZER_HARD_MAX_TOKENS);
        return false;
    }
    if tok.tokens != null { free(tok.tokens as &void); tok.tokens = null; }
    if tok.scores != null { free(tok.scores as &void); tok.scores = null; }
    if tok.types != null { free(tok.types as &void); tok.types = null; }
    tok.tokens = calloc(count, TOKENIZER_PIECE_CAP) as &byte;
    tok.scores = calloc(count, 4) as &u32;
    tok.types = calloc(count, 4) as &u32;
    if tok.tokens == null || tok.scores == null || tok.types == null {
        _ = printf("error: tokenizer allocation failed for tokens=%zu\n", count);
        return false;
    }
    tok.token_capacity = count;
    return true;
}

fn tokenizer_alloc_merges(tok: &Tokenizer, count: usize) bool {
    if count > TOKENIZER_HARD_MAX_MERGES {
        _ = printf("error: tokenizer has too many merges (%zu > %zu)\n", count, TOKENIZER_HARD_MAX_MERGES);
        return false;
    }
    if tok.merges != null { free(tok.merges as &void); tok.merges = null; }
    tok.merges = calloc(count, TOKENIZER_PIECE_CAP) as &byte;
    if tok.merges == null {
        _ = printf("error: tokenizer allocation failed for merges=%zu\n", count);
        return false;
    }
    tok.merge_capacity = count;
    return true;
}

fn tokenizer_alloc_chat_template(tok: &Tokenizer, cap: usize) bool {
    if cap > TOKENIZER_HARD_MAX_CHAT_TEMPLATE {
        _ = printf("error: tokenizer chat template too large (%zu > %zu)\n", cap, TOKENIZER_HARD_MAX_CHAT_TEMPLATE);
        return false;
    }
    if tok.chat_template != null { free(tok.chat_template as &void); tok.chat_template = null; }
    tok.chat_template = calloc(cap, 1) as &byte;
    if tok.chat_template == null {
        _ = printf("error: tokenizer allocation failed for chat template cap=%zu\n", cap);
        return false;
    }
    tok.chat_template_cap = cap;
    return true;
}

fn tok_cstr_len(s: &const byte) usize {
    var len: usize = 0;
    while s[len] != 0 {
        len = len + 1;
    }
    return len;
}

fn tok_cstr_eq(a: &const byte, b: &const byte) bool {
    return strcmp(a as *const byte, b as *const byte) == 0;
}

fn tok_cstr_starts_with(value: &const byte, prefix: &const byte) bool {
    var i: usize = 0;
    while prefix[i] != 0 {
        if value[i] != prefix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn tok_cstr_contains(value: &const byte, needle: &const byte) bool {
    var i: usize = 0;
    while value[i] != 0 {
        var j: usize = 0;
        var matched: bool = true;
        while needle[j] != 0 {
            if value[i + j] == 0 || value[i + j] != needle[j] { matched = false; break; }
            j = j + 1;
        }
        if matched { return true; }
        i = i + 1;
    }
    return false;
}

fn tok_copy_cstr(dest: &byte, dest_cap: usize, src: &const byte) void {
    if dest_cap == 0 {
        return;
    }
    var i: usize = 0;
    while i + 1 < dest_cap && src[i] != 0 {
        dest[i] = src[i];
        i = i + 1;
    }
    dest[i] = 0;
}

fn token_ptr(tok: &Tokenizer, id: usize) &const byte {
    if tok.tokens == null { return "\0" as &const byte; }
    return &tok.tokens[id * TOKENIZER_PIECE_CAP] as &const byte;
}

fn token_mut_ptr(tok: &Tokenizer, id: usize) &byte {
    return &tok.tokens[id * TOKENIZER_PIECE_CAP];
}

fn merge_ptr(tok: &Tokenizer, id: usize) &const byte {
    if tok.merges == null { return "\0" as &const byte; }
    return &tok.merges[id * TOKENIZER_PIECE_CAP] as &const byte;
}

fn merge_mut_ptr(tok: &Tokenizer, id: usize) &byte {
    return &tok.merges[id * TOKENIZER_PIECE_CAP];
}

fn tok_read_gguf_string(reader: &BinaryReader, dest: &byte, dest_cap: usize, out: &TokGgufStringRead, context: &const byte) bool {
    var len: u64 = 0;
    if !binary_read_u64_le(reader, &len, context) {
        return false;
    }
    out.len = len;
    out.copied = 0;
    out.truncated = false;
    if dest_cap > 0 {
        dest[0] = 0;
    }
    var copy_len: usize = 0;
    if dest_cap > 1 {
        const max_copy: u64 = (dest_cap - 1) as u64;
        if len > max_copy {
            copy_len = max_copy as usize;
            out.truncated = true;
        } else {
            copy_len = len as usize;
        }
    } else if len > 0 {
        out.truncated = true;
    }
    if copy_len > 0 {
        if !binary_read_exact(reader, dest, copy_len, context) {
            return false;
        }
        dest[copy_len] = 0;
        out.copied = copy_len;
    }
    const remaining: u64 = len - (copy_len as u64);
    if remaining > 0 {
        if !binary_skip(reader, remaining, context) {
            return false;
        }
    }
    return true;
}

fn tok_scalar_metadata_size(value_type: u32) u64 {
    if value_type == 0 { return 1; }
    if value_type == 1 { return 1; }
    if value_type == 7 { return 1; }
    if value_type == 2 { return 2; }
    if value_type == 3 { return 2; }
    if value_type == 4 { return 4; }
    if value_type == 5 { return 4; }
    if value_type == 6 { return 4; }
    if value_type == 10 { return 8; }
    if value_type == 11 { return 8; }
    if value_type == 12 { return 8; }
    return 0;
}

fn tok_skip_metadata_array(reader: &BinaryReader, element_type: u32, count: u64) bool {
    const elem_size: u64 = tok_scalar_metadata_size(element_type);
    if elem_size > 0 {
        if count > ((reader.size - reader.pos) / elem_size) {
            _ = printf("error: tokenizer metadata array truncated\n");
            return false;
        }
        return binary_skip(reader, count * elem_size, "metadata scalar array\0" as &const byte);
    }
    if element_type == TOK_GGUF_TYPE_STRING {
        var tmp: [byte: 1] = [];
        var info: TokGgufStringRead = TokGgufStringRead{ len: 0, copied: 0, truncated: false };
        var i: u64 = 0;
        while i < count {
            if !tok_read_gguf_string(reader, &tmp[0], 1, &info, "metadata string array element\0" as &const byte) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    _ = printf("error: unsupported tokenizer metadata array element type %u\n", element_type);
    return false;
}

fn read_token_array(reader: &BinaryReader, tok: &Tokenizer, count: u64) bool {
    if !tokenizer_alloc_tokens(tok, count as usize) { return false; }
    var info: TokGgufStringRead = TokGgufStringRead{ len: 0, copied: 0, truncated: false };
    var i: u64 = 0;
    while i < count {
        if !tok_read_gguf_string(reader, token_mut_ptr(tok, i as usize), TOKENIZER_PIECE_CAP, &info, "tokenizer token\0" as &const byte) {
            return false;
        }
        if info.truncated {
            _ = printf("error: tokenizer token %llu exceeds local piece cap\n", i);
            return false;
        }
        i = i + 1;
    }
    tok.token_count = count as usize;
    return true;
}

fn read_merge_array(reader: &BinaryReader, tok: &Tokenizer, count: u64) bool {
    if !tokenizer_alloc_merges(tok, count as usize) { return false; }
    var info: TokGgufStringRead = TokGgufStringRead{ len: 0, copied: 0, truncated: false };
    var i: u64 = 0;
    while i < count {
        if !tok_read_gguf_string(reader, merge_mut_ptr(tok, i as usize), TOKENIZER_PIECE_CAP, &info, "tokenizer merge\0" as &const byte) {
            return false;
        }
        if info.truncated {
            _ = printf("error: tokenizer merge %llu exceeds local piece cap\n", i);
            return false;
        }
        i = i + 1;
    }
    tok.merge_count = count as usize;
    return true;
}

fn read_u32_array(reader: &BinaryReader, dest: &u32, dest_cap: usize, count: u64, context: &const byte) bool {
    if count > dest_cap as u64 {
        _ = printf("error: %s has too many entries (%llu > %zu)\n", context, count, dest_cap);
        return false;
    }
    var i: u64 = 0;
    while i < count {
        if !binary_read_u32_le(reader, &dest[i as usize], context) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn handle_array_metadata(reader: &BinaryReader, tok: &Tokenizer, key: &const byte) bool {
    var element_type: u32 = 0;
    var count: u64 = 0;
    if !binary_read_u32_le(reader, &element_type, "metadata array element type\0" as &const byte) { return false; }
    if !binary_read_u64_le(reader, &count, "metadata array length\0" as &const byte) { return false; }

    if tok_cstr_eq(key, "tokenizer.ggml.tokens\0" as &const byte) {
        if element_type != TOK_GGUF_TYPE_STRING {
            _ = printf("error: tokenizer.ggml.tokens must be string array\n");
            return false;
        }
        return read_token_array(reader, tok, count);
    }
    if tok_cstr_eq(key, "tokenizer.ggml.merges\0" as &const byte) {
        if element_type != TOK_GGUF_TYPE_STRING {
            _ = printf("error: tokenizer.ggml.merges must be string array\n");
            return false;
        }
        return read_merge_array(reader, tok, count);
    }
    if tok_cstr_eq(key, "tokenizer.ggml.scores\0" as &const byte) {
        if element_type != TOK_GGUF_TYPE_FLOAT32 {
            _ = printf("error: tokenizer.ggml.scores must be float32 array\n");
            return false;
        }
        if tok.scores == null || count > tok.token_capacity as u64 { if !tokenizer_alloc_tokens(tok, count as usize) { return false; } }
        return read_u32_array(reader, tok.scores, tok.token_capacity, count, "tokenizer scores\0" as &const byte);
    }
    if tok_cstr_eq(key, "tokenizer.ggml.token_type\0" as &const byte) || tok_cstr_eq(key, "tokenizer.ggml.token_types\0" as &const byte) {
        if element_type != TOK_GGUF_TYPE_INT32 && element_type != TOK_GGUF_TYPE_UINT32 {
            _ = printf("error: tokenizer token types must be int32/uint32 array\n");
            return false;
        }
        if tok.types == null || count > tok.token_capacity as u64 { if !tokenizer_alloc_tokens(tok, count as usize) { return false; } }
        return read_u32_array(reader, tok.types, tok.token_capacity, count, "tokenizer token types\0" as &const byte);
    }
    return tok_skip_metadata_array(reader, element_type, count);
}

fn skip_metadata_value(reader: &BinaryReader, tok: &Tokenizer, key: &const byte, value_type: u32, alignment: &u64) bool {
    if value_type == TOK_GGUF_TYPE_STRING {
        if tok_cstr_eq(key, "tokenizer.chat_template\0" as &const byte) || tok_cstr_eq(key, "tokenizer.ggml.chat_template\0" as &const byte) {
            var len: u64 = 0;
            if !binary_read_u64_le(reader, &len, "metadata chat_template length\0" as &const byte) { return false; }
            if !tokenizer_alloc_chat_template(tok, (len as usize) + (1 as usize)) { return false; }
            if len > 0 && !binary_read_exact(reader, tok.chat_template, len as usize, "metadata chat_template value\0" as &const byte) { return false; }
            tok.chat_template[len as usize] = 0;
            tok.has_chat_template = true;
            return true;
        }
        var value: [byte: 512] = [];
        var info: TokGgufStringRead = TokGgufStringRead{ len: 0, copied: 0, truncated: false };
        if !tok_read_gguf_string(reader, &value[0], @len(value), &info, "metadata string value\0" as &const byte) {
            return false;
        }
        if tok_cstr_eq(key, "tokenizer.ggml.model\0" as &const byte) {
            tok.byte_bpe = tok_cstr_eq(&value[0] as &const byte, "gpt2\0" as &const byte);
        }
        return true;
    }
    if value_type == TOK_GGUF_TYPE_ARRAY {
        return handle_array_metadata(reader, tok, key);
    }
    if value_type == TOK_GGUF_TYPE_UINT32 {
        var value: u32 = 0;
        if !binary_read_u32_le(reader, &value, "metadata uint32 value\0" as &const byte) { return false; }
        if tok_cstr_eq(key, "general.alignment\0" as &const byte) {
            if value == 0 { return false; }
            *alignment = value as u64;
        } else if tok_cstr_eq(key, "tokenizer.ggml.bos_token_id\0" as &const byte) {
            tok.bos_id = value;
        } else if tok_cstr_eq(key, "tokenizer.ggml.eos_token_id\0" as &const byte) {
            tok.eos_id = value;
        } else if tok_cstr_eq(key, "tokenizer.ggml.padding_token_id\0" as &const byte) || tok_cstr_eq(key, "tokenizer.ggml.pad_token_id\0" as &const byte) {
            tok.pad_id = value;
        } else if tok_cstr_eq(key, "tokenizer.ggml.unknown_token_id\0" as &const byte) || tok_cstr_eq(key, "tokenizer.ggml.unk_token_id\0" as &const byte) {
            tok.unk_id = value;
        }
        return true;
    }
    if value_type == TOK_GGUF_TYPE_INT32 {
        var signed_bits: u32 = 0;
        if !binary_read_u32_le(reader, &signed_bits, "metadata int32 value\0" as &const byte) { return false; }
        const value: u32 = signed_bits;
        if tok_cstr_eq(key, "tokenizer.ggml.bos_token_id\0" as &const byte) {
            tok.bos_id = value;
        } else if tok_cstr_eq(key, "tokenizer.ggml.eos_token_id\0" as &const byte) {
            tok.eos_id = value;
        } else if tok_cstr_eq(key, "tokenizer.ggml.padding_token_id\0" as &const byte) || tok_cstr_eq(key, "tokenizer.ggml.pad_token_id\0" as &const byte) {
            tok.pad_id = value;
        } else if tok_cstr_eq(key, "tokenizer.ggml.unknown_token_id\0" as &const byte) || tok_cstr_eq(key, "tokenizer.ggml.unk_token_id\0" as &const byte) {
            tok.unk_id = value;
        }
        return true;
    }
    const size: u64 = tok_scalar_metadata_size(value_type);
    if size > 0 {
        return binary_skip(reader, size, "metadata scalar value\0" as &const byte);
    }
    _ = printf("error: unsupported metadata type while loading tokenizer: %u\n", value_type);
    return false;
}

export fn tokenizer_load(path: &const byte, tok: &Tokenizer) bool {
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) {
        return false;
    }
    var magic: u32 = 0;
    var version: u32 = 0;
    var tensor_count: u64 = 0;
    var metadata_count: u64 = 0;
    var alignment: u64 = TOK_GGUF_DEFAULT_ALIGNMENT;
    if !binary_read_u32_le(&reader, &magic, "GGUF magic\0" as &const byte) { binary_close(&reader); return false; }
    if magic != TOK_GGUF_MAGIC {
        _ = printf("error: bad GGUF magic 0x%x\n", magic);
        binary_close(&reader);
        return false;
    }
    if !binary_read_u32_le(&reader, &version, "GGUF version\0" as &const byte) { binary_close(&reader); return false; }
    if version != 2 && version != 3 {
        _ = printf("error: unsupported GGUF version %u\n", version);
        binary_close(&reader);
        return false;
    }
    if !binary_read_u64_le(&reader, &tensor_count, "GGUF tensor_count\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &metadata_count, "GGUF metadata_count\0" as &const byte) { binary_close(&reader); return false; }

    var i: u64 = 0;
    while i < metadata_count {
        var key: [byte: 257] = [];
        var key_info: TokGgufStringRead = TokGgufStringRead{ len: 0, copied: 0, truncated: false };
        if !tok_read_gguf_string(&reader, &key[0], @len(key), &key_info, "metadata key\0" as &const byte) { binary_close(&reader); return false; }
        var value_type: u32 = 0;
        if !binary_read_u32_le(&reader, &value_type, "metadata value type\0" as &const byte) { binary_close(&reader); return false; }
        if !skip_metadata_value(&reader, tok, &key[0] as &const byte, value_type, &alignment) { binary_close(&reader); return false; }
        i = i + 1;
    }
    binary_close(&reader);

    if tok.token_count == 0 {
        _ = printf("error: tokenizer.ggml.tokens not found\n");
        return false;
    }
    return true;
}

fn find_token(tok: &Tokenizer, piece: &const byte) u32 {
    var i: usize = 0;
    while i < tok.token_count {
        if tok_cstr_eq(token_ptr(tok, i), piece) {
            return i as u32;
        }
        i = i + 1;
    }
    return TOKENIZER_UNKNOWN_ID;
}

export fn tokenizer_has_piece(tok: &Tokenizer, piece: &const byte) bool {
    return find_token(tok, piece) != TOKENIZER_UNKNOWN_ID;
}

fn tokenizer_chat_no_think_supported(tok: &Tokenizer) bool {
    if !tokenizer_has_piece(tok, "<think>\0" as &const byte) { return false; }
    if !tokenizer_has_piece(tok, "</think>\0" as &const byte) { return false; }
    if tok.chat_template == null { return false; }
    if tok_cstr_contains(tok.chat_template as &const byte, "enable_thinking\0" as &const byte) { return true; }
    return tok_cstr_contains(tok.chat_template as &const byte, "<think>\0" as &const byte);
}

fn tokenizer_chat_tts_supported(tok: &Tokenizer) bool {
    return tokenizer_has_piece(tok, "<|tts_bos|>\0" as &const byte);
}

fn is_special_piece(piece: &const byte) bool {
    if piece[0] == 60 {
        return true;
    }
    if tok_cstr_starts_with(piece, "<|\0" as &const byte) {
        return true;
    }
    return false;
}

fn try_match_special(tok: &Tokenizer, text: &const byte, pos: usize, out_id: &u32, out_len: &usize) bool {
    var best_len: usize = 0;
    var best_id: u32 = TOKENIZER_UNKNOWN_ID;
    var i: usize = 0;
    while i < tok.token_count {
        const piece: &const byte = token_ptr(tok, i);
        if is_special_piece(piece) {
            var j: usize = 0;
            var matched: bool = true;
            while piece[j] != 0 {
                if text[pos + j] == 0 || text[pos + j] != piece[j] {
                    matched = false;
                    break;
                }
                j = j + 1;
            }
            if matched && j > best_len {
                best_len = j;
                best_id = i as u32;
            }
        }
        i = i + 1;
    }
    if best_id != TOKENIZER_UNKNOWN_ID {
        *out_id = best_id;
        *out_len = best_len;
        return true;
    }
    return false;
}

fn try_match_plain_token(tok: &Tokenizer, text: &const byte, pos: usize, out_id: &u32, out_len: &usize) bool {
    var best_len: usize = 0;
    var best_id: u32 = TOKENIZER_UNKNOWN_ID;
    var i: usize = 0;
    while i < tok.token_count {
        const piece: &const byte = token_ptr(tok, i);
        if !is_special_piece(piece) {
            var j: usize = 0;
            var matched: bool = true;
            while piece[j] != 0 {
                if text[pos + j] == 0 || text[pos + j] != piece[j] {
                    matched = false;
                    break;
                }
                j = j + 1;
            }
            if matched && j > best_len {
                best_len = j;
                best_id = i as u32;
            }
        }
        i = i + 1;
    }
    if best_id != TOKENIZER_UNKNOWN_ID {
        *out_id = best_id;
        *out_len = best_len;
        return true;
    }
    return false;
}


fn tok_byte_direct(value: u32) bool {
    if value >= 33 && value <= 126 { return true; }
    if value >= 161 && value <= 172 { return true; }
    if value >= 174 && value <= 255 { return true; }
    return false;
}

fn tok_utf8_encode(codepoint: u32, dest: &byte, dest_cap: usize) bool {
    if dest_cap < 4 { return false; }
    if codepoint < 128 {
        dest[0] = codepoint as byte;
        dest[1] = 0;
        return true;
    }
    if codepoint < 2048 {
        dest[0] = ((192 as u32) | (codepoint >> 6)) as byte;
        dest[1] = ((128 as u32) | (codepoint & (63 as u32))) as byte;
        dest[2] = 0;
        return true;
    }
    dest[0] = ((224 as u32) | (codepoint >> 12)) as byte;
    dest[1] = ((128 as u32) | ((codepoint >> 6) & (63 as u32))) as byte;
    dest[2] = ((128 as u32) | (codepoint & (63 as u32))) as byte;
    dest[3] = 0;
    return true;
}

fn tok_byte_fallback_piece(value: byte, dest: &byte, dest_cap: usize) bool {
    const b: u32 = value as u32;
    if tok_byte_direct(b) { return tok_utf8_encode(b, dest, dest_cap); }
    var extra: u32 = 0;
    var i: u32 = 0;
    while i < b {
        if !tok_byte_direct(i) { extra = extra + 1; }
        i = i + 1;
    }
    return tok_utf8_encode(256 + extra, dest, dest_cap);
}

fn parse_u32(s: &const byte, out: &u32) bool {
    var i: usize = 0;
    var value: u32 = 0;
    if s[0] == 0 {
        return false;
    }
    while s[i] != 0 {
        if s[i] < 48 || s[i] > 57 {
            return false;
        }
        value = value * 10 + ((s[i] - 48) as u32);
        i = i + 1;
    }
    *out = value;
    return true;
}

fn print_token_id(id: u32, first: bool) void {
    if !first {
        _ = printf(" ");
    }
    _ = printf("%u", id);
}

fn tok_part_ptr(parts: &byte, index: usize) &const byte {
    return &parts[index * TOKENIZER_PIECE_CAP] as &const byte;
}

fn tok_part_mut_ptr(parts: &byte, index: usize) &byte {
    return &parts[index * TOKENIZER_PIECE_CAP];
}

fn tok_merge_matches_pair(merge: &const byte, left: &const byte, right: &const byte) bool {
    var i: usize = 0;
    while left[i] != 0 {
        if merge[i] == 0 || merge[i] != left[i] {
            return false;
        }
        i = i + 1;
    }
    if merge[i] != 32 {
        return false;
    }
    i = i + 1;
    var j: usize = 0;
    while right[j] != 0 {
        if merge[i + j] == 0 || merge[i + j] != right[j] {
            return false;
        }
        j = j + 1;
    }
    return merge[i + j] == 0;
}

fn tok_concat_cstr(dest: &byte, dest_cap: usize, left: &const byte, right: &const byte) bool {
    if dest_cap == 0 {
        return false;
    }
    var pos: usize = 0;
    var i: usize = 0;
    while left[i] != 0 {
        if pos + 1 >= dest_cap {
            dest[dest_cap - 1] = 0;
            return false;
        }
        dest[pos] = left[i];
        pos = pos + 1;
        i = i + 1;
    }
    i = 0;
    while right[i] != 0 {
        if pos + 1 >= dest_cap {
            dest[dest_cap - 1] = 0;
            return false;
        }
        dest[pos] = right[i];
        pos = pos + 1;
        i = i + 1;
    }
    dest[pos] = 0;
    return true;
}

fn tok_shift_parts_left(parts: &byte, start: usize, count: usize) void {
    var i: usize = start;
    while i + 1 < count {
        tok_copy_cstr(tok_part_mut_ptr(parts, i), TOKENIZER_PIECE_CAP, tok_part_ptr(parts, i + 1));
        i = i + 1;
    }
    if count > 0 {
        tok_part_mut_ptr(parts, count - 1)[0] = 0;
    }
}

fn tokenizer_byte_bpe_append_ids(tok: &Tokenizer, text: &const byte, start: usize, end: usize, out_ids: &u32, out_cap: usize, out_count: &usize) bool {
    if start >= end {
        return true;
    }
    var parts: [byte: TOKENIZER_BPE_MAX_PARTS * TOKENIZER_PIECE_CAP] = [];
    var part_count: usize = 0;
    var pos: usize = start;
    while pos < end {
        if part_count >= TOKENIZER_BPE_MAX_PARTS {
            _ = printf("error: byte-BPE prompt span exceeds part cap=%zu\n", TOKENIZER_BPE_MAX_PARTS);
            return false;
        }
        if !tok_byte_fallback_piece(text[pos], tok_part_mut_ptr(&parts[0], part_count), TOKENIZER_PIECE_CAP) {
            return false;
        }
        part_count = part_count + 1;
        pos = pos + 1;
    }

    var merge_index: usize = 0;
    while merge_index < tok.merge_count {
        var part_index: usize = 0;
        while part_index + 1 < part_count {
            if tok_merge_matches_pair(merge_ptr(tok, merge_index), tok_part_ptr(&parts[0], part_index), tok_part_ptr(&parts[0], part_index + 1)) {
                var merged: [byte: TOKENIZER_PIECE_CAP] = [];
                if !tok_concat_cstr(&merged[0], @len(merged), tok_part_ptr(&parts[0], part_index), tok_part_ptr(&parts[0], part_index + 1)) {
                    _ = printf("error: byte-BPE merged piece exceeds cap=%zu\n", TOKENIZER_PIECE_CAP);
                    return false;
                }
                tok_copy_cstr(tok_part_mut_ptr(&parts[0], part_index), TOKENIZER_PIECE_CAP, &merged[0] as &const byte);
                tok_shift_parts_left(&parts[0], part_index + 1, part_count);
                part_count = part_count - 1;
                part_index = part_index + 1;
            } else {
                part_index = part_index + 1;
            }
        }
        merge_index = merge_index + 1;
    }

    var out_index: usize = 0;
    while out_index < part_count {
        if *out_count >= out_cap {
            _ = printf("error: encoded prompt exceeds token buffer cap=%zu\n", out_cap);
            return false;
        }
        var id: u32 = find_token(tok, tok_part_ptr(&parts[0], out_index));
        if id == TOKENIZER_UNKNOWN_ID {
            if tok.unk_id != TOKENIZER_UNKNOWN_ID {
                id = tok.unk_id;
            } else {
                _ = printf("error: no token for byte-BPE piece: %s\n", tok_part_ptr(&parts[0], out_index));
                return false;
            }
        }
        out_ids[*out_count] = id;
        *out_count = *out_count + 1;
        out_index = out_index + 1;
    }
    return true;
}

fn tokenizer_next_special_offset(tok: &Tokenizer, text: &const byte, start: usize) usize {
    var pos: usize = start;
    while text[pos] != 0 {
        var id: u32 = TOKENIZER_UNKNOWN_ID;
        var match_len: usize = 0;
        if try_match_special(tok, text, pos, &id, &match_len) {
            return pos;
        }
        pos = pos + 1;
    }
    return pos;
}

fn tokenizer_encode_byte_bpe_to_ids(tok: &Tokenizer, text: &const byte, out_ids: &u32, out_cap: usize, out_count: &usize) bool {
    *out_count = 0;
    var pos: usize = 0;
    while text[pos] != 0 {
        if *out_count >= out_cap {
            _ = printf("error: encoded prompt exceeds token buffer cap=%zu\n", out_cap);
            return false;
        }
        var id: u32 = TOKENIZER_UNKNOWN_ID;
        var match_len: usize = 0;
        if try_match_special(tok, text, pos, &id, &match_len) || try_match_plain_token(tok, text, pos, &id, &match_len) {
            out_ids[*out_count] = id;
            *out_count = *out_count + 1;
            pos = pos + match_len;
        } else {
            const span_end: usize = tokenizer_next_special_offset(tok, text, pos);
            if !tokenizer_byte_bpe_append_ids(tok, text, pos, span_end, out_ids, out_cap, out_count) {
                return false;
            }
            pos = span_end;
        }
    }
    return true;
}

export fn tokenizer_encode_to_ids(tok: &Tokenizer, text: &const byte, out_ids: &u32, out_cap: usize, out_count: &usize) bool {
    if tok.byte_bpe && tok.merge_count > 0 {
        return tokenizer_encode_byte_bpe_to_ids(tok, text, out_ids, out_cap, out_count);
    }
    *out_count = 0;
    var pos: usize = 0;
    while text[pos] != 0 {
        if *out_count >= out_cap {
            _ = printf("error: encoded prompt exceeds token buffer cap=%zu
", out_cap);
            return false;
        }
        var id: u32 = TOKENIZER_UNKNOWN_ID;
        var match_len: usize = 0;
        if try_match_special(tok, text, pos, &id, &match_len) || try_match_plain_token(tok, text, pos, &id, &match_len) {
            out_ids[*out_count] = id;
            *out_count = *out_count + 1;
            pos = pos + match_len;
        } else {
            var piece: [byte: 8] = [];
            if !tok_byte_fallback_piece(text[pos], &piece[0], @len(piece)) { return false; }
            id = find_token(tok, &piece[0] as &const byte);
            if id == TOKENIZER_UNKNOWN_ID {
                piece[0] = text[pos];
                piece[1] = 0;
                id = find_token(tok, &piece[0] as &const byte);
            }
            if id == TOKENIZER_UNKNOWN_ID {
                if tok.unk_id != TOKENIZER_UNKNOWN_ID {
                    id = tok.unk_id;
                } else {
                    _ = printf("error: no token for byte at offset %zu
", pos);
                    return false;
                }
            }
            out_ids[*out_count] = id;
            *out_count = *out_count + 1;
            pos = pos + 1;
        }
    }
    return true;
}

export fn tokenizer_piece(tok: &Tokenizer, id: u32) &const byte {
    if id >= tok.token_count as u32 { return "␀" as &const byte; }
    return token_ptr(tok, id as usize);
}

fn tok_utf8_decode_one(text: &const byte, pos: &usize, out: &u32) bool {
    const start: usize = *pos;
    const b0: u32 = text[start] as u32;
    if b0 < 128 {
        *out = b0;
        *pos = start + 1;
        return true;
    }
    if (b0 & (224 as u32)) == (192 as u32) && text[start + 1] != 0 {
        const b1: u32 = text[start + 1] as u32;
        *out = ((b0 & (31 as u32)) << 6) | (b1 & (63 as u32));
        *pos = start + 2;
        return true;
    }
    if (b0 & (240 as u32)) == (224 as u32) && text[start + 1] != 0 && text[start + 2] != 0 {
        const b1: u32 = text[start + 1] as u32;
        const b2: u32 = text[start + 2] as u32;
        *out = ((b0 & (15 as u32)) << 12) | ((b1 & (63 as u32)) << 6) | (b2 & (63 as u32));
        *pos = start + 3;
        return true;
    }
    if (b0 & (248 as u32)) == (240 as u32) && text[start + 1] != 0 && text[start + 2] != 0 && text[start + 3] != 0 {
        const b1: u32 = text[start + 1] as u32;
        const b2: u32 = text[start + 2] as u32;
        const b3: u32 = text[start + 3] as u32;
        *out = ((b0 & (7 as u32)) << 18) | ((b1 & (63 as u32)) << 12) | ((b2 & (63 as u32)) << 6) | (b3 & (63 as u32));
        *pos = start + 4;
        return true;
    }
    *out = b0;
    *pos = start + 1;
    return false;
}

fn tok_byte_from_codepoint(codepoint: u32, out: &byte) bool {
    if tok_byte_direct(codepoint) {
        *out = codepoint as byte;
        return true;
    }
    if codepoint < 256 {
        return false;
    }
    const target: u32 = codepoint - 256;
    var seen: u32 = 0;
    var value: u32 = 0;
    while value < 256 {
        if !tok_byte_direct(value) {
            if seen == target {
                *out = value as byte;
                return true;
            }
            seen = seen + 1;
        }
        value = value + 1;
    }
    return false;
}

fn tok_print_raw_bytes(text: &const byte, start: usize, end: usize) void {
    var i: usize = start;
    while i < end {
        _ = printf("%c", text[i] as i32);
        i = i + 1;
    }
}

fn tok_append_byte(dest: &byte, dest_cap: usize, pos: &usize, value: byte) bool {
    if *pos + 1 >= dest_cap {
        if dest_cap > 0 {
            dest[dest_cap - 1] = 0;
        }
        return false;
    }
    dest[*pos] = value;
    *pos = *pos + 1;
    dest[*pos] = 0;
    return true;
}

fn tok_append_raw_bytes(dest: &byte, dest_cap: usize, pos: &usize, text: &const byte, start: usize, end: usize) bool {
    var i: usize = start;
    while i < end {
        if !tok_append_byte(dest, dest_cap, pos, text[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

export fn tokenizer_append_piece_text(tok: &Tokenizer, id: u32, dest: &byte, dest_cap: usize, out_pos: &usize) bool {
    if id >= tok.token_count as u32 {
        return true;
    }
    const piece: &const byte = token_ptr(tok, id as usize);
    var pos: usize = 0;
    if !tok.byte_bpe {
        while piece[pos] != 0 {
            if !tok_append_byte(dest, dest_cap, out_pos, piece[pos]) {
                return false;
            }
            pos = pos + 1;
        }
        return true;
    }
    while piece[pos] != 0 {
        const start: usize = pos;
        var codepoint: u32 = 0;
        _ = tok_utf8_decode_one(piece, &pos, &codepoint);
        var decoded: byte = 0;
        if tok_byte_from_codepoint(codepoint, &decoded) {
            if !tok_append_byte(dest, dest_cap, out_pos, decoded) {
                return false;
            }
        } else if !tok_append_raw_bytes(dest, dest_cap, out_pos, piece, start, pos) {
            return false;
        }
    }
    return true;
}

export fn tokenizer_print_piece_text(tok: &Tokenizer, id: u32) void {
    var text: [byte: TOKENIZER_PIECE_CAP] = [];
    var pos: usize = 0;
    if tokenizer_append_piece_text(tok, id, &text[0], @len(text), &pos) {
        _ = printf("%s", &text[0]);
    }
}

export fn tokenizer_piece_cli(path: &const byte, id_text: &const byte) i32 {
    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(path, &tok) { return 1; }
    var id: u32 = 0;
    if !parse_u32(id_text, &id) {
        _ = printf("error: invalid token id: %s\n", id_text);
        return 1;
    }
    if id >= tok.token_count as u32 {
        _ = printf("error: token id out of range: %u (vocab=%zu)\n", id, tok.token_count);
        return 1;
    }
    _ = printf("%s\n", token_ptr(&tok, id as usize));
    return 0;
}

export fn tokenizer_decode_cli(path: &const byte, argc: i32, argv: & &byte, start_index: i32) i32 {
    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(path, &tok) { return 1; }
    var i: i32 = start_index;
    while i < argc {
        var id: u32 = 0;
        if !parse_u32(argv[i] as &const byte, &id) {
            _ = printf("error: invalid token id: %s\n", argv[i]);
            return 1;
        }
        if id >= tok.token_count as u32 {
            _ = printf("error: token id out of range: %u (vocab=%zu)\n", id, tok.token_count);
            return 1;
        }
        tokenizer_print_piece_text(&tok, id);
        i = i + 1;
    }
    _ = printf("\n");
    return 0;
}

export fn tokenizer_encode_cli(path: &const byte, text: &const byte) i32 {
    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(path, &tok) { return 1; }
    var ids: [u32: TOKENIZER_BPE_MAX_PARTS] = [];
    var id_count: usize = 0;
    if !tokenizer_encode_to_ids(&tok, text, &ids[0], @len(ids), &id_count) {
        return 1;
    }
    var first: bool = true;
    var i: usize = 0;
    while i < id_count {
        print_token_id(ids[i], first);
        first = false;
        i = i + 1;
    }
    _ = printf("\n");
    return 0;
}

fn print_chat_default(user_text: &const byte) void {
    _ = printf("<|im_start|>user\n%s<|im_end|>\n<|im_start|>assistant\n", user_text);
}

export fn tokenizer_chat_template_supported(tok: &Tokenizer) bool {
    if !tok.has_chat_template {
        return true;
    }
    if tok_cstr_eq(tok.chat_template as &const byte, "minicpmo.chatml\0" as &const byte) {
        return true;
    }
    if tok.chat_template == null { return true; }
    if tok_cstr_starts_with(tok.chat_template as &const byte, "<|im_start|>\0" as &const byte) { return true; }
    return tok_cstr_contains(tok.chat_template as &const byte, "<|im_start|>\0" as &const byte);
}

export fn tokenizer_chat_stop_token(tok: &Tokenizer) u32 {
    if tokenizer_chat_template_supported(tok) {
        const im_end_id: u32 = find_token(tok, "<|im_end|>\0" as &const byte);
        if im_end_id != TOKENIZER_UNKNOWN_ID {
            return im_end_id;
        }
    }
    return tok.eos_id;
}

fn tok_append_cstr(dest: &byte, dest_cap: usize, pos: &usize, src: &const byte) bool {
    var i: usize = 0;
    while src[i] != 0 {
        if *pos + 1 >= dest_cap {
            if dest_cap > 0 {
                dest[dest_cap - 1] = 0;
            }
            return false;
        }
        dest[*pos] = src[i];
        *pos = *pos + 1;
        i = i + 1;
    }
    if dest_cap > 0 {
        dest[*pos] = 0;
    }
    return true;
}

export fn tokenizer_format_chat_prompt(tok: &Tokenizer, user_text: &const byte, close_previous_assistant: bool, dest: &byte, dest_cap: usize) bool {
    return tokenizer_format_generation_prompt(tok, null as &const byte, user_text, close_previous_assistant, false, false, dest, dest_cap);
}

fn tokenizer_append_assistant_prompt(tok: &Tokenizer, enable_thinking: bool, use_tts_template: bool, dest: &byte, dest_cap: usize, pos: &usize) bool {
    if !tok_append_cstr(dest, dest_cap, pos, "<|im_start|>assistant\n\0" as &const byte) {
        return false;
    }
    if !enable_thinking && tokenizer_chat_no_think_supported(tok) {
        if !tok_append_cstr(dest, dest_cap, pos, "<think>\n\n</think>\n\n\0" as &const byte) {
            return false;
        }
    }
    if use_tts_template && tokenizer_chat_tts_supported(tok) {
        return tok_append_cstr(dest, dest_cap, pos, "<|tts_bos|>\0" as &const byte);
    }
    return true;
}

export fn tokenizer_format_generation_prompt(tok: &Tokenizer, system_text: &const byte, user_text: &const byte, close_previous_assistant: bool, enable_thinking: bool, use_tts_template: bool, dest: &byte, dest_cap: usize) bool {
    if !tokenizer_chat_template_supported(tok) || dest_cap == 0 {
        return false;
    }
    dest[0] = 0;
    var pos: usize = 0;
    if close_previous_assistant && !tok_append_cstr(dest, dest_cap, &pos, "<|im_end|>\n\0" as &const byte) {
        return false;
    }
    if system_text != null && system_text[0] != 0 {
        if !tok_append_cstr(dest, dest_cap, &pos, "<|im_start|>system\n\0" as &const byte) {
            return false;
        }
        if !tok_append_cstr(dest, dest_cap, &pos, system_text) {
            return false;
        }
        if !tok_append_cstr(dest, dest_cap, &pos, "<|im_end|>\n\0" as &const byte) {
            return false;
        }
    }
    if user_text != null {
        if !tok_append_cstr(dest, dest_cap, &pos, "<|im_start|>user\n\0" as &const byte) {
            return false;
        }
        if !tok_append_cstr(dest, dest_cap, &pos, user_text) {
            return false;
        }
        if !tok_append_cstr(dest, dest_cap, &pos, "<|im_end|>\n\0" as &const byte) {
            return false;
        }
    }
    if use_tts_template && !tokenizer_chat_tts_supported(tok) {
        return false;
    }
    return tokenizer_append_assistant_prompt(tok, enable_thinking, use_tts_template, dest, dest_cap, &pos);
}

export fn tokenizer_format_assistant_prompt(tok: &Tokenizer, close_previous_assistant: bool, enable_thinking: bool, use_tts_template: bool, dest: &byte, dest_cap: usize) bool {
    return tokenizer_format_generation_prompt(tok, null as &const byte, null as &const byte, close_previous_assistant, enable_thinking, use_tts_template, dest, dest_cap);
}

export fn tokenizer_format_chat_args_cli(argc: i32, argv: & &byte) i32 {
    if argc < 4 {
        _ = printf("usage: minicpm-o-uya format-chat <model.gguf> <user-text> [--system TEXT] [--enable-thinking] [--tts-template]\n");
        return 1;
    }
    const path: &const byte = argv[2] as &const byte;
    const user_text: &const byte = argv[3] as &const byte;
    var system_text: &const byte = null;
    var enable_thinking: bool = false;
    var use_tts_template: bool = false;
    var i: i32 = 4;
    while i < argc {
        if strcmp(argv[i] as *const byte, "--system\0" as *const byte) == 0 {
            if i + 1 >= argc {
                _ = printf("error: format-chat requires text after --system\n");
                return 1;
            }
            system_text = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--enable-thinking\0" as *const byte) == 0 {
            enable_thinking = true;
            i = i + 1;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--tts-template\0" as *const byte) == 0 {
            use_tts_template = true;
            i = i + 1;
            continue;
        }
        _ = printf("error: invalid format-chat arg: %s\n", argv[i]);
        return 1;
    }

    var tok: Tokenizer = tokenizer_init();
    if !tokenizer_load(path, &tok) { return 1; }
    if tokenizer_chat_template_supported(&tok) {
        if use_tts_template && !tokenizer_chat_tts_supported(&tok) {
            _ = printf("error: tokenizer/template does not support <|tts_bos|> assistant prompt\n");
            return 1;
        }
        var prompt: [byte: 2048] = [];
        if !tokenizer_format_generation_prompt(&tok, system_text, user_text, false, enable_thinking, use_tts_template, &prompt[0], @len(prompt)) {
            _ = printf("error: formatted chat prompt exceeds buffer cap=%zu\n", @len(prompt));
            return 1;
        }
        _ = printf("%s", &prompt[0]);
        return 0;
    }
    _ = printf("%s\n", tok.chat_template);
    return 0;
}

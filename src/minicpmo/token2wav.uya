        if !t2w_check_matrix(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "attn.to_v.weight\0" as &const byte, "flow_matching v\0" as &const byte), 512, 512, "flow_matching v\0" as &const byte) { ok = false; break; }

const AUDIO_GGUF_MAGIC: u32 = 0x46554747;
const AUDIO_RAW_MAGIC: u32 = 0x4d415955;
const AUDIO_RAW_VERSION: u32 = 1;
const AUDIO_RAW_DTYPE_F32: u32 = 0;
const AUDIO_PCM_MAGIC: u32 = 0x50415955;
const AUDIO_PCM_DTYPE_S16: u32 = 0;
const AUDIO_PCM_DTYPE_F32: u32 = 1;
const AUDIO_GGUF_TYPE_UINT32: u32 = 4;
const AUDIO_GGUF_TYPE_INT32: u32 = 5;
const AUDIO_GGUF_TYPE_FLOAT32: u32 = 6;
const AUDIO_GGUF_TYPE_STRING: u32 = 8;
const AUDIO_GGUF_TYPE_ARRAY: u32 = 9;
const AUDIO_GGUF_TYPE_UINT64: u32 = 10;
const AUDIO_GGUF_TYPE_INT64: u32 = 11;
const AUDIO_GGUF_TYPE_FLOAT64: u32 = 12;
const AUDIO_MAX_LAYERS: usize = 4;
const AUDIO_MAX_FRAMES: usize = 16;
const AUDIO_MAX_BINS: usize = 64;
const AUDIO_MAX_VALUES: usize = 1024;
const AUDIO_MAX_HIDDEN: usize = 64;
const AUDIO_MAX_FFN: usize = 128;
const AUDIO_MAX_LLM_HIDDEN: usize = 64;
const AUDIO_MAX_PROMPT: usize = 64;
const AUDIO_EPS: f32 = 0.000001;
const AUDIO_PI: f32 = 3.14159265358979323846;
const AUDIO_MAX_PCM_SAMPLES: usize = 4096;
const AUDIO_MAX_STFT_BINS: usize = 65;
const AUDIO_WAV_RIFF: u32 = 0x46464952;
const AUDIO_WAV_WAVE: u32 = 0x45564157;
const AUDIO_WAV_FMT: u32 = 0x20746d66;
const AUDIO_WAV_DATA: u32 = 0x61746164;
const AUDIO_WAV_FORMAT_PCM: u16 = 1;
const AUDIO_WAV_FORMAT_FLOAT: u16 = 3;
const AUDIO_REAL_SAMPLE_RATE: u32 = 16000;
const AUDIO_REAL_CHANNELS: u16 = 1;
const AUDIO_REAL_FRAME_SIZE: u32 = 400;
const AUDIO_REAL_WIN_LENGTH: u32 = 400;
const AUDIO_REAL_HOP_LENGTH: u32 = 160;
const AUDIO_REAL_MEL_BINS: u32 = 80;
const AUDIO_REAL_FILTER_BINS: u32 = 201;
const AUDIO_REAL_CENTER_PAD: u32 = 200;
const AUDIO_REAL_ALIGN_SAMPLES: u32 = 1600;
const AUDIO_REAL_ENCODER_CONTEXT: u32 = 1500;
const AUDIO_REAL_POOL_KERNEL: u32 = 5;
const AUDIO_REAL_POOL_STRIDE: u32 = 5;
const AUDIO_REAL_MEL_DUMP_MAGIC: u32 = 0x4c4d5955;
const AUDIO_REAL_MEL_DUMP_VERSION: u32 = 1;
const AUDIO_REAL_LAYER_NORM_EPS: f32 = 0.00001;
const AUDIO_INFO_CONTAINER_WAV: u32 = 1;
const AUDIO_INFO_CONTAINER_UYAP: u32 = 2;
const AUDIO_INFO_DTYPE_S16: u32 = 1;
const AUDIO_INFO_DTYPE_F32: u32 = 2;
const AUDIO2AUDIO_REAL_DEFAULT_MAX_NEW_TOKENS: u32 = 128;
const AUDIO2AUDIO_REAL_ANSWER_CAP: usize = 32768;
const AUDIO2AUDIO_REAL_SYSTEM_PREFIX: &const byte = "<|im_start|>system\nClone the voice in the provided audio prompt.\n<|audio_start|>\0" as &const byte;
const AUDIO2AUDIO_REAL_SYSTEM_SUFFIX: &const byte = "<|audio_end|>Please assist users while maintaining this voice style. Please answer the user's questions seriously and in a high quality. Please chat with the user in a highly human-like and oral style. You are a helpful assistant developed by ModelBest: MiniCPM-Omni.<|im_end|>\n<|im_start|>user\n\0" as &const byte;
const AUDIO2AUDIO_REAL_USER_AUDIO_PREFIX: &const byte = "<|audio_start|>\0" as &const byte;
const AUDIO2AUDIO_REAL_USER_AUDIO_SUFFIX: &const byte = "<|audio_end|>\0" as &const byte;
const AUDIO2AUDIO_REAL_ASSISTANT_PROMPT: &const byte = "<|im_end|>\n<|im_start|>assistant\n\0" as &const byte;


export struct AudioConfig {
    frame_count: u32,
    mel_bin_count: u32,
    hidden_size: u32,
    layer_count: u32,
    head_count: u32,
    head_dim: u32,
    intermediate_size: u32,
    llm_hidden_size: u32,
    filter_bin_count: u32,
    filter_value_count: u64,
    audio_token_id: u32,
    has_audio_token_id: bool,
    has_filters: bool,
}

export struct AudioLayerWeights {
    attn_norm: &TensorView,
    q_proj: &TensorView,
    k_proj: &TensorView,
    v_proj: &TensorView,
    o_proj: &TensorView,
    ffn_norm: &TensorView,
    gate_proj: &TensorView,
    up_proj: &TensorView,
    down_proj: &TensorView,
}

export struct AudioWeights {
    conv_weight: &TensorView,
    conv_bias: &TensorView,
    position_embd: &TensorView,
    output_norm: &TensorView,
    projector: &TensorView,
    layers: [AudioLayerWeights: 4],
    layer_count: u32,
}


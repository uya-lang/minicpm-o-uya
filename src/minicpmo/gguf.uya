fn ascii_lower(c: byte) byte {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

fn cstr_len(s: &const byte) usize {
    var len: usize = 0;
    while s[len] != 0 {
        len = len + 1;
    }
    return len;
}

fn cstr_contains_ci(haystack: &const byte, needle: &const byte) bool {
    const needle_len: usize = cstr_len(needle);
    if needle_len == 0 {
        return true;
    }
    const haystack_len: usize = cstr_len(haystack);
    if needle_len > haystack_len {
        return false;
    }
    var i: usize = 0;
    while i <= haystack_len - needle_len {
        var j: usize = 0;
        var matched: bool = true;
        while j < needle_len {
            if ascii_lower(haystack[i + j]) != ascii_lower(needle[j]) {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn cstr_starts_with_ci(value: &const byte, prefix: &const byte) bool {
    const prefix_len: usize = cstr_len(prefix);
    const value_len: usize = cstr_len(value);
    if prefix_len > value_len {
        return false;
    }
    var i: usize = 0;
    while i < prefix_len {
        if ascii_lower(value[i]) != ascii_lower(prefix[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn copy_cstr(dest: &byte, dest_cap: usize, src: &const byte) void {
    if dest_cap == 0 {
        return;
    }
    var i: usize = 0;
    while i + 1 < dest_cap && src[i] != 0 {
        dest[i] = src[i];
        i = i + 1;
    }
    dest[i] = 0;
}

fn audit_mark_type(stats: &AuditStats, value_type: u32) void {
    if value_type < 13 {
        stats.metadata_type_counts[value_type as usize] = stats.metadata_type_counts[value_type as usize] + 1;
    } else {
        stats.metadata_unknown_type_count = stats.metadata_unknown_type_count + 1;
    }
}

fn audit_mark_array_element_type(stats: &AuditStats, value_type: u32) void {
    if value_type < 13 {
        stats.array_element_type_counts[value_type as usize] = stats.array_element_type_counts[value_type as usize] + 1;
    } else {
        stats.array_unknown_element_type_count = stats.array_unknown_element_type_count + 1;
    }
}

fn audit_mark_metadata_signal(stats: &AuditStats, key: &const byte, value: &const byte, has_value: bool) void {
    if cstr_contains_ci(key, "tokenizer\0" as &const byte) {
        stats.has_tokenizer_metadata = true;
    }
    if cstr_contains_ci(key, "tokenizer.ggml.tokens\0" as &const byte) || cstr_contains_ci(key, "tokenizer.model\0" as &const byte) || cstr_contains_ci(key, "tokenizer.ggml.merges\0" as &const byte) {
        stats.has_tokenizer_tokens = true;
    }
    if cstr_contains_ci(key, "chat_template\0" as &const byte) {
        stats.has_chat_template = true;
        stats.has_special_token_metadata = true;
    }
    if cstr_contains_ci(key, "special\0" as &const byte) || cstr_contains_ci(key, "added\0" as &const byte) || cstr_contains_ci(key, "bos\0" as &const byte) || cstr_contains_ci(key, "eos\0" as &const byte) || cstr_contains_ci(key, "pad\0" as &const byte) || cstr_contains_ci(key, "unk\0" as &const byte) {
        stats.has_special_token_metadata = true;
    }
    if cstr_contains_ci(key, "image_token\0" as &const byte) || cstr_contains_ci(key, "audio_token\0" as &const byte) || cstr_contains_ci(key, "video_token\0" as &const byte) || cstr_contains_ci(key, "media\0" as &const byte) || cstr_contains_ci(key, "placeholder\0" as &const byte) {
        stats.has_media_placeholder_metadata = true;
        stats.has_special_token_metadata = true;
    }

    if cstr_contains_ci(key, "qwen3\0" as &const byte) {
        stats.has_qwen3_metadata = true;
        stats.has_qwen_metadata = true;
        stats.has_text_metadata = true;
    }
    if cstr_contains_ci(key, "qwen\0" as &const byte) || cstr_contains_ci(key, "llm\0" as &const byte) || cstr_contains_ci(key, "text\0" as &const byte) || cstr_contains_ci(key, "attention\0" as &const byte) || cstr_contains_ci(key, "rope\0" as &const byte) {
        stats.has_qwen_metadata = true;
        stats.has_text_metadata = true;
    }
    if cstr_contains_ci(key, "vision\0" as &const byte) || cstr_contains_ci(key, "visual\0" as &const byte) || cstr_contains_ci(key, "siglip\0" as &const byte) || cstr_contains_ci(key, "clip\0" as &const byte) || cstr_contains_ci(key, "image\0" as &const byte) {
        stats.has_vision_metadata = true;
    }
    if cstr_contains_ci(key, "audio\0" as &const byte) || cstr_contains_ci(key, "whisper\0" as &const byte) || cstr_contains_ci(key, "mel\0" as &const byte) {
        stats.has_audio_metadata = true;
    }
    if cstr_contains_ci(key, "speech\0" as &const byte) || cstr_contains_ci(key, "vocoder\0" as &const byte) || cstr_contains_ci(key, "cosy\0" as &const byte) || cstr_contains_ci(key, "codec\0" as &const byte) || cstr_contains_ci(key, "tts\0" as &const byte) {
        stats.has_speech_metadata = true;
    }

    if has_value {
        if cstr_contains_ci(value, "qwen3\0" as &const byte) {
            stats.has_qwen3_metadata = true;
            stats.has_qwen_metadata = true;
            stats.has_text_metadata = true;
        }
        if cstr_contains_ci(value, "qwen\0" as &const byte) {
            stats.has_qwen_metadata = true;
            stats.has_text_metadata = true;
        }
        if cstr_contains_ci(value, "siglip\0" as &const byte) || cstr_contains_ci(value, "clip\0" as &const byte) || cstr_contains_ci(value, "vision\0" as &const byte) {
            stats.has_vision_metadata = true;
        }
        if cstr_contains_ci(value, "whisper\0" as &const byte) || cstr_contains_ci(value, "audio\0" as &const byte) {
            stats.has_audio_metadata = true;
        }
        if cstr_contains_ci(value, "cosy\0" as &const byte) || cstr_contains_ci(value, "vocoder\0" as &const byte) || cstr_contains_ci(value, "speech\0" as &const byte) || cstr_contains_ci(value, "codec\0" as &const byte) {
            stats.has_speech_metadata = true;
        }
        if cstr_contains_ci(value, "<image\0" as &const byte) || cstr_contains_ci(value, "<audio\0" as &const byte) || cstr_contains_ci(value, "<video\0" as &const byte) || cstr_contains_ci(value, "im_start\0" as &const byte) || cstr_contains_ci(value, "media\0" as &const byte) {
            stats.has_media_placeholder_metadata = true;
            stats.has_special_token_metadata = true;
        }
    }
}

fn audit_skip_string_array(reader: &BinaryReader, stats: &AuditStats, key: &const byte, count: u64) bool {
    var tmp: [byte: 129] = [];
    var info: GgufStringRead = GgufStringRead{ len: 0, copied: 0, truncated: false };
    const should_sample: bool = cstr_contains_ci(key, "token\0" as &const byte) || cstr_contains_ci(key, "special\0" as &const byte) || cstr_contains_ci(key, "added\0" as &const byte) || cstr_contains_ci(key, "chat\0" as &const byte);
    var i: u64 = 0;
    while i < count {
        if should_sample {
            if !read_gguf_string(reader, &tmp[0], @len(tmp), &info, "metadata string array element\0" as &const byte) {
                return false;
            }
            audit_mark_metadata_signal(stats, key, &tmp[0] as &const byte, true);
        } else {
            if !read_gguf_string(reader, &tmp[0], 1, &info, "metadata string array element\0" as &const byte) {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

fn audit_skip_array_value(reader: &BinaryReader, stats: &AuditStats, key: &const byte) bool {
    var element_type: u32 = 0;
    var count: u64 = 0;
    if !binary_read_u32_le(reader, &element_type, "metadata array element type\0" as &const byte) { return false; }
    if !binary_read_u64_le(reader, &count, "metadata array length\0" as &const byte) { return false; }
    audit_mark_array_element_type(stats, element_type);

    if cstr_contains_ci(key, "tokenizer.ggml.tokens\0" as &const byte) {
        stats.has_tokenizer_tokens = true;
        stats.has_tokenizer_metadata = true;
    }

    const elem_size: u64 = scalar_metadata_size(element_type);
    if elem_size > 0 {
        if count > ((reader.size - reader.pos) / elem_size) {
            _ = printf("error: metadata array is truncated (type=%s, count=%llu)\n", gguf_value_type_name(element_type), count);
            return false;
        }
        return binary_skip(reader, count * elem_size, "metadata scalar array\0" as &const byte);
    }
    if element_type == GGUF_TYPE_STRING {
        return audit_skip_string_array(reader, stats, key, count);
    }
    if element_type == GGUF_TYPE_ARRAY {
        _ = printf("error: nested metadata arrays are not supported by GGUF audit\n");
        return false;
    }
    _ = printf("error: unknown metadata array element type %u\n", element_type);
    return false;
}

fn audit_skip_metadata_value(reader: &BinaryReader, stats: &AuditStats, key: &const byte, value_type: u32, alignment: &u64) bool {
    if value_type == GGUF_TYPE_STRING {
        var value: [byte: 257] = [];
        var info: GgufStringRead = GgufStringRead{ len: 0, copied: 0, truncated: false };
        if !read_gguf_string(reader, &value[0], @len(value), &info, "metadata string value\0" as &const byte) {
            return false;
        }
        audit_mark_metadata_signal(stats, key, &value[0] as &const byte, true);
        return true;
    }
    if value_type == GGUF_TYPE_ARRAY {
        return audit_skip_array_value(reader, stats, key);
    }
    if value_type == GGUF_TYPE_UINT32 {
        var value: u32 = 0;
        if !binary_read_u32_le(reader, &value, "metadata uint32 value\0" as &const byte) { return false; }
        if strcmp(key as *const byte, "general.alignment\0" as *const byte) == 0 {
            if value == 0 {
                _ = printf("error: general.alignment must be non-zero\n");
                return false;
            }
            *alignment = value as u64;
        }
        return true;
    }
    const elem_size: u64 = scalar_metadata_size(value_type);
    if elem_size > 0 {
        return binary_skip(reader, elem_size, "metadata scalar value\0" as &const byte);
    }
    _ = printf("error: unknown metadata value type %u\n", value_type);
    return false;
}

fn audit_metadata_entry(reader: &BinaryReader, stats: &AuditStats, alignment: &u64) bool {
    var key: [byte: 257] = [];
    var key_info: GgufStringRead = GgufStringRead{ len: 0, copied: 0, truncated: false };
    if !read_gguf_string(reader, &key[0], @len(key), &key_info, "metadata key\0" as &const byte) {
        return false;
    }
    var value_type: u32 = 0;
    if !binary_read_u32_le(reader, &value_type, "metadata value type\0" as &const byte) {
        return false;
    }
    audit_mark_type(stats, value_type);
    audit_mark_metadata_signal(stats, &key[0] as &const byte, "\0" as &const byte, false);
    return audit_skip_metadata_value(reader, stats, &key[0] as &const byte, value_type, alignment);
}

fn audit_is_root_tensor(name: &const byte) bool {
    if cstr_starts_with_ci(name, "token_embd\0" as &const byte) { return true; }
    if cstr_starts_with_ci(name, "tok_embeddings\0" as &const byte) { return true; }
    if cstr_starts_with_ci(name, "output\0" as &const byte) { return true; }
    if cstr_starts_with_ci(name, "lm_head\0" as &const byte) { return true; }
    if cstr_starts_with_ci(name, "rope_freqs\0" as &const byte) { return true; }
    return false;
}

fn audit_shape_exact(dims: &u64, n_dims: u32, e0: u64, e1: u64, e2: u64, e3: u64, expected_dims: u32) bool {
    if n_dims != expected_dims { return false; }
    if expected_dims > 0 && dims[0] != e0 { return false; }
    if expected_dims > 1 && dims[1] != e1 { return false; }
    if expected_dims > 2 && dims[2] != e2 { return false; }
    if expected_dims > 3 && dims[3] != e3 { return false; }
    return true;
}

fn audit_record_shape_mismatch(stats: &AuditStats, name: &const byte, dims: &u64, n_dims: u32, e0: u64, e1: u64, e2: u64, e3: u64, expected_dims: u32) void {
    stats.shape_mismatch_count = stats.shape_mismatch_count + 1;
    if stats.shape_mismatch_count != 1 { return; }
    copy_cstr(&stats.first_shape_mismatch_tensor[0], @len(stats.first_shape_mismatch_tensor), name);
    audit_copy_shape(&stats.first_shape_mismatch_actual[0], dims, n_dims);
    stats.first_shape_mismatch_actual_dims = n_dims;
    stats.first_shape_mismatch_expected_dims = expected_dims;
    if expected_dims > 0 { stats.first_shape_mismatch_expected[0] = e0; }
    if expected_dims > 1 { stats.first_shape_mismatch_expected[1] = e1; }
    if expected_dims > 2 { stats.first_shape_mismatch_expected[2] = e2; }
    if expected_dims > 3 { stats.first_shape_mismatch_expected[3] = e3; }
}

fn audit_expect_shape(stats: &AuditStats, name: &const byte, dims: &u64, n_dims: u32, expected_name: &const byte, e0: u64, e1: u64, e2: u64, e3: u64, expected_dims: u32) void {
    if strcmp(name as *const byte, expected_name as *const byte) != 0 { return; }
    if !audit_shape_exact(dims, n_dims, e0, e1, e2, e3, expected_dims) {
        audit_record_shape_mismatch(stats, name, dims, n_dims, e0, e1, e2, e3, expected_dims);
    }
}

fn audit_check_known_alias_shape(stats: &AuditStats, name: &const byte, dims: &u64, n_dims: u32) void {
    audit_expect_shape(stats, name, dims, n_dims, "encoder.conv1.bias\0" as &const byte, 1, 1024, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "encoder.conv1.weight\0" as &const byte, 3, 80, 1024, 0, 3);
    audit_expect_shape(stats, name, dims, n_dims, "encoder.conv2.weight\0" as &const byte, 3, 1024, 1024, 0, 3);
    audit_expect_shape(stats, name, dims, n_dims, "encoder.positional_embedding\0" as &const byte, 1024, 1500, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "audio_projector.linear1.weight\0" as &const byte, 1024, 4096, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "audio_projector.linear2.weight\0" as &const byte, 4096, 4096, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "emb_code.0.weight\0" as &const byte, 768, 6562, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "emb_text.weight\0" as &const byte, 768, 152064, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "head_code.0.weight\0" as &const byte, 6562, 768, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "linear1.weight\0" as &const byte, 4096, 768, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "linear2.weight\0" as &const byte, 768, 768, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "after_norm.bias\0" as &const byte, 512, 0, 0, 0, 1);
    audit_expect_shape(stats, name, dims, n_dims, "input_embedding.weight\0" as &const byte, 512, 6561, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "estimator.in_proj.weight\0" as &const byte, 320, 512, 0, 0, 2);
    audit_expect_shape(stats, name, dims, n_dims, "conv_post.bias\0" as &const byte, 18, 0, 0, 0, 1);
    audit_expect_shape(stats, name, dims, n_dims, "prompt_cache.spk_cb\0" as &const byte, 192, 0, 0, 0, 1);
}

fn audit_mark_tensor_prefixes(stats: &AuditStats, name: &const byte) void {
    if cstr_starts_with_ci(name, "blk.\0" as &const byte) { stats.prefix_blk_count = stats.prefix_blk_count + 1; }
    if cstr_starts_with_ci(name, "encoder.\0" as &const byte) { stats.prefix_audio_encoder_count = stats.prefix_audio_encoder_count + 1; }
    if cstr_starts_with_ci(name, "audio_projector.\0" as &const byte) { stats.prefix_audio_projector_count = stats.prefix_audio_projector_count + 1; }
    if cstr_starts_with_ci(name, "emb_code\0" as &const byte) { stats.prefix_tts_emb_code_count = stats.prefix_tts_emb_code_count + 1; }
    if cstr_starts_with_ci(name, "emb_text\0" as &const byte) { stats.prefix_tts_emb_text_count = stats.prefix_tts_emb_text_count + 1; }
    if cstr_starts_with_ci(name, "projector_semantic\0" as &const byte) { stats.prefix_tts_projector_semantic_count = stats.prefix_tts_projector_semantic_count + 1; }
    if cstr_starts_with_ci(name, "projector_spk\0" as &const byte) { stats.prefix_tts_projector_spk_count = stats.prefix_tts_projector_spk_count + 1; }
    if cstr_starts_with_ci(name, "head_code\0" as &const byte) { stats.prefix_tts_head_code_count = stats.prefix_tts_head_code_count + 1; }
    if cstr_starts_with_ci(name, "emb_code\0" as &const byte) || cstr_starts_with_ci(name, "emb_text\0" as &const byte) || cstr_starts_with_ci(name, "projector_semantic\0" as &const byte) || cstr_starts_with_ci(name, "projector_spk\0" as &const byte) || cstr_starts_with_ci(name, "head_code\0" as &const byte) { stats.prefix_tts_count = stats.prefix_tts_count + 1; }
    if cstr_starts_with_ci(name, "linear1.\0" as &const byte) || cstr_starts_with_ci(name, "linear2.\0" as &const byte) { stats.prefix_projector_count = stats.prefix_projector_count + 1; }
    if cstr_starts_with_ci(name, "after_norm.\0" as &const byte) || cstr_starts_with_ci(name, "embed.\0" as &const byte) || cstr_starts_with_ci(name, "up_embed.\0" as &const byte) || cstr_starts_with_ci(name, "encoders.\0" as &const byte) || cstr_starts_with_ci(name, "up_encoders.\0" as &const byte) || cstr_starts_with_ci(name, "pre_lookahead_layer.\0" as &const byte) || cstr_starts_with_ci(name, "up_layer.\0" as &const byte) { stats.prefix_token2wav_encoder_count = stats.prefix_token2wav_encoder_count + 1; }
    if cstr_starts_with_ci(name, "estimator.\0" as &const byte) || cstr_starts_with_ci(name, "input_embedding.\0" as &const byte) || cstr_starts_with_ci(name, "encoder_proj.\0" as &const byte) || cstr_starts_with_ci(name, "spk_embed_affine_layer.\0" as &const byte) { stats.prefix_flow_count = stats.prefix_flow_count + 1; }
    if cstr_starts_with_ci(name, "conv_pre.\0" as &const byte) || cstr_starts_with_ci(name, "conv_post.\0" as &const byte) || cstr_starts_with_ci(name, "ups.\0" as &const byte) || cstr_starts_with_ci(name, "resblocks.\0" as &const byte) || cstr_starts_with_ci(name, "source_resblocks.\0" as &const byte) || cstr_starts_with_ci(name, "source_downs.\0" as &const byte) || cstr_starts_with_ci(name, "m_source.\0" as &const byte) || cstr_starts_with_ci(name, "f0_predictor.\0" as &const byte) { stats.prefix_hifigan_count = stats.prefix_hifigan_count + 1; }
    if cstr_starts_with_ci(name, "prompt_cache.\0" as &const byte) { stats.prefix_prompt_cache_count = stats.prefix_prompt_cache_count + 1; }
}

fn audit_copy_shape(dest: &u64, dims: &u64, n_dims: u32) void {
    var i: u32 = 0;
    while i < n_dims {
        dest[i as usize] = dims[i as usize];
        i = i + 1;
    }
}

fn audit_mark_first_unknown_shape(stats: &AuditStats, name: &const byte, dims: &u64, n_dims: u32, ggml_type: u32) void {
    copy_cstr(&stats.first_unknown_tensor[0], @len(stats.first_unknown_tensor), name);
    audit_copy_shape(&stats.first_unknown_shape[0], dims, n_dims);
    stats.first_unknown_n_dims = n_dims;
    stats.first_unknown_ggml_type = ggml_type;
}

fn audit_mark_tensor_branch(stats: &AuditStats, name: &const byte, dims: &u64, n_dims: u32, ggml_type: u32) void {
    audit_mark_tensor_prefixes(stats, name);

    if cstr_contains_ci(name, "token_embd\0" as &const byte) || cstr_contains_ci(name, "tok_embeddings\0" as &const byte) || cstr_contains_ci(name, "embed_tokens\0" as &const byte) {
        stats.has_token_embd_tensor = true;
    }
    if cstr_contains_ci(name, "output\0" as &const byte) || cstr_contains_ci(name, "lm_head\0" as &const byte) {
        stats.has_output_tensor = true;
    }

    if audit_is_root_tensor(name) {
        stats.root_tensor_count = stats.root_tensor_count + 1;
        if stats.root_tensor_count == 1 {
            copy_cstr(&stats.first_root_tensor[0], @len(stats.first_root_tensor), name);
            audit_copy_shape(&stats.first_root_shape[0], dims, n_dims);
            stats.first_root_n_dims = n_dims;
            stats.first_root_ggml_type = ggml_type;
        }
        return;
    }
    if cstr_starts_with_ci(name, "blk.\0" as &const byte) || cstr_contains_ci(name, "model.layers\0" as &const byte) || cstr_contains_ci(name, "language_model\0" as &const byte) || cstr_contains_ci(name, "llm\0" as &const byte) || cstr_contains_ci(name, "qwen\0" as &const byte) || cstr_contains_ci(name, "text\0" as &const byte) {
        stats.text_tensor_count = stats.text_tensor_count + 1;
        if stats.text_tensor_count == 1 {
            copy_cstr(&stats.first_text_tensor[0], @len(stats.first_text_tensor), name);
            audit_copy_shape(&stats.first_text_shape[0], dims, n_dims);
            stats.first_text_n_dims = n_dims;
            stats.first_text_ggml_type = ggml_type;
        }
        stats.has_text_tensor = true;
        return;
    }
    if cstr_contains_ci(name, "audio\0" as &const byte) || cstr_contains_ci(name, "whisper\0" as &const byte) || cstr_contains_ci(name, "mel\0" as &const byte) || cstr_starts_with_ci(name, "encoder.\0" as &const byte) || cstr_starts_with_ci(name, "audio_projector.\0" as &const byte) {
        stats.audio_tensor_count = stats.audio_tensor_count + 1;
        if stats.audio_tensor_count == 1 {
            copy_cstr(&stats.first_audio_tensor[0], @len(stats.first_audio_tensor), name);
            audit_copy_shape(&stats.first_audio_shape[0], dims, n_dims);
            stats.first_audio_n_dims = n_dims;
            stats.first_audio_ggml_type = ggml_type;
        }
        stats.has_audio_tensor = true;
        return;
    }
    if cstr_contains_ci(name, "vision\0" as &const byte) || cstr_contains_ci(name, "visual\0" as &const byte) || cstr_contains_ci(name, "siglip\0" as &const byte) || cstr_contains_ci(name, "clip\0" as &const byte) || cstr_contains_ci(name, "image\0" as &const byte) || cstr_contains_ci(name, "resampler\0" as &const byte) || cstr_contains_ci(name, "projector\0" as &const byte) {
        stats.vision_tensor_count = stats.vision_tensor_count + 1;
        stats.has_vision_tensor = true;
        return;
    }
    if cstr_contains_ci(name, "speech\0" as &const byte) || cstr_contains_ci(name, "vocoder\0" as &const byte) || cstr_contains_ci(name, "cosy\0" as &const byte) || cstr_contains_ci(name, "codec\0" as &const byte) || cstr_contains_ci(name, "tts\0" as &const byte) || cstr_starts_with_ci(name, "emb_code\0" as &const byte) || cstr_starts_with_ci(name, "emb_text\0" as &const byte) || cstr_starts_with_ci(name, "projector_semantic\0" as &const byte) || cstr_starts_with_ci(name, "projector_spk\0" as &const byte) || cstr_starts_with_ci(name, "head_code\0" as &const byte) || cstr_starts_with_ci(name, "linear1.\0" as &const byte) || cstr_starts_with_ci(name, "linear2.\0" as &const byte) || cstr_starts_with_ci(name, "after_norm.\0" as &const byte) || cstr_starts_with_ci(name, "embed.\0" as &const byte) || cstr_starts_with_ci(name, "up_embed.\0" as &const byte) || cstr_starts_with_ci(name, "encoders.\0" as &const byte) || cstr_starts_with_ci(name, "up_encoders.\0" as &const byte) || cstr_starts_with_ci(name, "pre_lookahead_layer.\0" as &const byte) || cstr_starts_with_ci(name, "up_layer.\0" as &const byte) || cstr_starts_with_ci(name, "estimator.\0" as &const byte) || cstr_starts_with_ci(name, "input_embedding.\0" as &const byte) || cstr_starts_with_ci(name, "encoder_proj.\0" as &const byte) || cstr_starts_with_ci(name, "spk_embed_affine_layer.\0" as &const byte) || cstr_starts_with_ci(name, "conv_pre.\0" as &const byte) || cstr_starts_with_ci(name, "conv_post.\0" as &const byte) || cstr_starts_with_ci(name, "ups.\0" as &const byte) || cstr_starts_with_ci(name, "resblocks.\0" as &const byte) || cstr_starts_with_ci(name, "source_resblocks.\0" as &const byte) || cstr_starts_with_ci(name, "source_downs.\0" as &const byte) || cstr_starts_with_ci(name, "m_source.\0" as &const byte) || cstr_starts_with_ci(name, "f0_predictor.\0" as &const byte) || cstr_starts_with_ci(name, "prompt_cache.\0" as &const byte) {
        stats.speech_tensor_count = stats.speech_tensor_count + 1;
        if stats.speech_tensor_count == 1 {
            copy_cstr(&stats.first_speech_tensor[0], @len(stats.first_speech_tensor), name);
            audit_copy_shape(&stats.first_speech_shape[0], dims, n_dims);
            stats.first_speech_n_dims = n_dims;
            stats.first_speech_ggml_type = ggml_type;
        }
        stats.has_speech_tensor = true;
        return;
    }
    if stats.unknown_tensor_count == 0 { audit_mark_first_unknown_shape(stats, name, dims, n_dims, ggml_type); }
    stats.unknown_tensor_count = stats.unknown_tensor_count + 1;
}

fn audit_tensor_info(reader: &BinaryReader, stats: &AuditStats, data_start: u64) bool {
    var name: [byte: 257] = [];
    var name_info: GgufStringRead = GgufStringRead{ len: 0, copied: 0, truncated: false };
    if !read_gguf_string(reader, &name[0], @len(name), &name_info, "tensor name\0" as &const byte) {
        return false;
    }
    var n_dims: u32 = 0;
    if !binary_read_u32_le(reader, &n_dims, "tensor n_dims\0" as &const byte) {
        return false;
    }
    if n_dims == 0 || n_dims > GGUF_MAX_DIMS {
        _ = printf("error: tensor has unsupported n_dims=%u\n", n_dims);
        return false;
    }
    var dims: [u64: 8] = [];
    var i: u32 = 0;
    while i < n_dims {
        if !binary_read_u64_le(reader, &dims[i as usize], "tensor dimension\0" as &const byte) {
            return false;
        }
        i = i + 1;
    }
    var ggml_type: u32 = 0;
    var relative_offset: u64 = 0;
    if !binary_read_u32_le(reader, &ggml_type, "tensor ggml_type\0" as &const byte) { return false; }
    if !binary_read_u64_le(reader, &relative_offset, "tensor relative offset\0" as &const byte) { return false; }

    if ggml_type < 64 {
        stats.dtype_counts[ggml_type as usize] = stats.dtype_counts[ggml_type as usize] + 1;
    } else {
        stats.dtype_overflow_count = stats.dtype_overflow_count + 1;
    }
    const type_info: GgmlTypeInfo = ggml_type_info(ggml_type);
    if !type_info.known {
        if stats.unknown_dtype_count == 0 {
            stats.first_unknown_dtype = ggml_type;
        }
        stats.unknown_dtype_count = stats.unknown_dtype_count + 1;
    }
    audit_mark_tensor_branch(stats, &name[0] as &const byte, &dims[0], n_dims, ggml_type);
    audit_check_known_alias_shape(stats, &name[0] as &const byte, &dims[0], n_dims);

    var byte_count: u64 = 0;
    var absolute_offset: u64 = 0;
    var end_offset: u64 = 0;
    if tensor_byte_size(ggml_type, &dims[0], n_dims, &byte_count) && checked_add_u64(data_start, relative_offset, &absolute_offset) && checked_add_u64(absolute_offset, byte_count, &end_offset) {
        if end_offset > reader.size {
            stats.tensor_data_warning_count = stats.tensor_data_warning_count + 1;
        }
    } else {
        stats.tensor_data_warning_count = stats.tensor_data_warning_count + 1;
    }
    return true;
}

fn print_present(name: &const byte, present: bool) void {
    if present {
        _ = printf("  %s: present\n", name);
    } else {
        _ = printf("  %s: missing\n", name);
    }
}

fn audit_print_metadata_distribution(stats: &AuditStats) void {
    _ = printf("metadata value types:\n");
    var i: u32 = 0;
    var printed_meta: bool = false;
    while i < 13 {
        const count: u64 = stats.metadata_type_counts[i as usize];
        if count > 0 {
            _ = printf("  %s(%u): %llu\n", gguf_value_type_name(i), i, count);
            printed_meta = true;
        }
        i = i + 1;
    }
    if stats.metadata_unknown_type_count > 0 {
        _ = printf("  unknown: %llu\n", stats.metadata_unknown_type_count);
        printed_meta = true;
    }
    if !printed_meta {
        _ = printf("  none\n");
    }
    _ = printf("metadata array element types:\n");
    i = 0;
    var printed: bool = false;
    while i < 13 {
        const count: u64 = stats.array_element_type_counts[i as usize];
        if count > 0 {
            _ = printf("  %s(%u): %llu\n", gguf_value_type_name(i), i, count);
            printed = true;
        }
        i = i + 1;
    }
    if stats.array_unknown_element_type_count > 0 {
        _ = printf("  unknown: %llu\n", stats.array_unknown_element_type_count);
        printed = true;
    }
    if !printed {
        _ = printf("  none\n");
    }
}

fn audit_print_dtype_distribution(stats: &AuditStats) void {
    _ = printf("tensor dtype distribution:\n");
    var i: u32 = 0;
    var printed: bool = false;
    while i < 64 {
        const count: u64 = stats.dtype_counts[i as usize];
        if count > 0 {
            const info: GgmlTypeInfo = ggml_type_info(i);
            _ = printf("  %s(%u): %llu\n", info.name, i, count);
            printed = true;
        }
        i = i + 1;
    }
    if stats.dtype_overflow_count > 0 {
        _ = printf("  out_of_range: %llu\n", stats.dtype_overflow_count);
        printed = true;
    }
    if !printed {
        _ = printf("  none\n");
    }
}

fn audit_print_prefix_summary(stats: &AuditStats) void {
    _ = printf("tensor prefix summary:\n");
    _ = printf("  qwen_blk: %llu\n", stats.prefix_blk_count);
    _ = printf("  audio_encoder.encoder: %llu\n", stats.prefix_audio_encoder_count);
    _ = printf("  audio_projector: %llu\n", stats.prefix_audio_projector_count);
    _ = printf("  tts_core: %llu\n", stats.prefix_tts_count);
    _ = printf("    emb_code: %llu emb_text: %llu projector_semantic: %llu projector_spk: %llu head_code: %llu\n", stats.prefix_tts_emb_code_count, stats.prefix_tts_emb_text_count, stats.prefix_tts_projector_semantic_count, stats.prefix_tts_projector_spk_count, stats.prefix_tts_head_code_count);
    _ = printf("  tts_projector.linear: %llu\n", stats.prefix_projector_count);
    _ = printf("  token2wav_encoder.after_norm: %llu\n", stats.prefix_token2wav_encoder_count);
    _ = printf("  token2wav_flow: %llu\n", stats.prefix_flow_count);
    _ = printf("  hifigan2: %llu\n", stats.prefix_hifigan_count);
    _ = printf("  prompt_cache: %llu\n", stats.prefix_prompt_cache_count);
    _ = printf("tensor shape samples:\n");
    if stats.root_tensor_count > 0 { _ = printf("  root first=%s shape=", &stats.first_root_tensor[0]); print_shape(&stats.first_root_shape[0], stats.first_root_n_dims); _ = printf(" ggml_type=%u\n", stats.first_root_ggml_type); }
    if stats.text_tensor_count > 0 { _ = printf("  text first=%s shape=", &stats.first_text_tensor[0]); print_shape(&stats.first_text_shape[0], stats.first_text_n_dims); _ = printf(" ggml_type=%u\n", stats.first_text_ggml_type); }
    if stats.audio_tensor_count > 0 { _ = printf("  audio first=%s shape=", &stats.first_audio_tensor[0]); print_shape(&stats.first_audio_shape[0], stats.first_audio_n_dims); _ = printf(" ggml_type=%u\n", stats.first_audio_ggml_type); }
    if stats.speech_tensor_count > 0 { _ = printf("  speech/token2wav first=%s shape=", &stats.first_speech_tensor[0]); print_shape(&stats.first_speech_shape[0], stats.first_speech_n_dims); _ = printf(" ggml_type=%u\n", stats.first_speech_ggml_type); }
    if stats.unknown_tensor_count > 0 {
        _ = printf("  unknown first=%s shape=", &stats.first_unknown_tensor[0]);
        print_shape(&stats.first_unknown_shape[0], stats.first_unknown_n_dims);
        _ = printf(" ggml_type=%u\n", stats.first_unknown_ggml_type);
    }
}

fn audit_print_diagnostics(stats: &AuditStats) void {
    _ = printf("schema signals:\n");
    print_present("tokenizer metadata\0" as &const byte, stats.has_tokenizer_metadata);
    print_present("tokenizer tokens/model\0" as &const byte, stats.has_tokenizer_tokens);
    print_present("special/media tokens\0" as &const byte, stats.has_special_token_metadata || stats.has_media_placeholder_metadata);
    print_present("chat template\0" as &const byte, stats.has_chat_template);
    print_present("Qwen3 text metadata\0" as &const byte, stats.has_qwen3_metadata);
    print_present("Qwen-family text metadata\0" as &const byte, stats.has_qwen_metadata || stats.has_text_metadata);
    print_present("vision tower metadata/tensors\0" as &const byte, stats.has_vision_metadata || stats.has_vision_tensor);
    print_present("audio encoder metadata/tensors\0" as &const byte, stats.has_audio_metadata || stats.has_audio_tensor);
    print_present("speech/vocoder metadata/tensors\0" as &const byte, stats.has_speech_metadata || stats.has_speech_tensor);

    _ = printf("diagnostics:\n");
    _ = printf("  generation_supported=false (audit only; inference is not implemented)\n");
    if !stats.has_tokenizer_tokens {
        _ = printf("  unsupported: missing tokenizer tokens/model metadata\n");
    }
    if !stats.has_token_embd_tensor {
        _ = printf("  unsupported: missing root token embedding tensor\n");
    }
    if !stats.has_output_tensor {
        _ = printf("  unsupported: missing root output/lm_head tensor\n");
    }
    if !stats.has_qwen3_metadata {
        if stats.has_qwen_metadata || stats.has_text_tensor {
            _ = printf("  warning: text backbone detected, but Qwen3 metadata is not confirmed\n");
        } else {
            _ = printf("  unsupported: missing Qwen3 text backbone metadata\n");
        }
    }
    if !(stats.has_vision_metadata || stats.has_vision_tensor) {
        _ = printf("  warning: vision tower not detected\n");
    }
    if !(stats.has_audio_metadata || stats.has_audio_tensor) {
        _ = printf("  warning: audio encoder not detected\n");
    }
    if !(stats.has_speech_metadata || stats.has_speech_tensor) {
        _ = printf("  warning: speech/vocoder path not detected\n");
    }
    if stats.unknown_dtype_count > 0 || stats.dtype_overflow_count > 0 {
        _ = printf("  unsupported: unknown tensor dtype count=%llu first=%u\n", stats.unknown_dtype_count + stats.dtype_overflow_count, stats.first_unknown_dtype);
    }
    if stats.unknown_tensor_count > 0 {
        _ = printf("  unsupported: unclassified tensor branch count=%llu first=%s\n", stats.unknown_tensor_count, &stats.first_unknown_tensor[0]);
    }
    if stats.tensor_data_warning_count > 0 {
        _ = printf("  warning: tensor byte-size/offset issues count=%llu\n", stats.tensor_data_warning_count);
    }
}

export fn audit_gguf(path: &const byte) i32 {
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) {
        return 1;
    }

    var magic: u32 = 0;
    var version: u32 = 0;
    var tensor_count: u64 = 0;
    var metadata_count: u64 = 0;
    var alignment: u64 = GGUF_DEFAULT_ALIGNMENT;
    var stats: AuditStats = audit_stats_init();

    if !binary_read_u32_le(&reader, &magic, "GGUF magic\0" as &const byte) { binary_close(&reader); return 1; }
    if magic != GGUF_MAGIC {
        _ = printf("error: bad GGUF magic 0x%x, expected 0x%x\n", magic, GGUF_MAGIC);
        binary_close(&reader);
        return 1;
    }
    if !binary_read_u32_le(&reader, &version, "GGUF version\0" as &const byte) { binary_close(&reader); return 1; }
    if version != 2 && version != 3 {
        _ = printf("error: unsupported GGUF version %u (supported: 2, 3)\n", version);
        binary_close(&reader);
        return 1;
    }
    if !binary_read_u64_le(&reader, &tensor_count, "GGUF tensor_count\0" as &const byte) { binary_close(&reader); return 1; }
    if !binary_read_u64_le(&reader, &metadata_count, "GGUF metadata_count\0" as &const byte) { binary_close(&reader); return 1; }

    _ = printf("MiniCPM-o GGUF audit: %s\n", path);
    _ = printf("header: version=%u tensor_count=%llu metadata_count=%llu file_size=%llu\n", version, tensor_count, metadata_count, reader.size);

    var i: u64 = 0;
    while i < metadata_count {
        if !audit_metadata_entry(&reader, &stats, &alignment) {
            binary_close(&reader);
            return 1;
        }
        i = i + 1;
    }

    const tensor_dir_start: u64 = reader.pos;
    i = 0;
    while i < tensor_count {
        if !read_tensor_info(&reader, i, 0, false) {
            binary_close(&reader);
            return 1;
        }
        i = i + 1;
    }
    const tensor_dir_end: u64 = reader.pos;

    var data_start: u64 = 0;
    if !align_up(tensor_dir_end, alignment, &data_start) {
        _ = printf("error: cannot compute aligned data section offset (dir_end=%llu, alignment=%llu)\n", tensor_dir_end, alignment);
        binary_close(&reader);
        return 1;
    }

    if !binary_seek(&reader, tensor_dir_start, "rewind tensor directory\0" as &const byte) {
        binary_close(&reader);
        return 1;
    }
    i = 0;
    while i < tensor_count {
        if !audit_tensor_info(&reader, &stats, data_start) {
            binary_close(&reader);
            return 1;
        }
        i = i + 1;
    }

    _ = printf("layout: alignment=%llu tensor_dir_start=%llu tensor_dir_end=%llu data_start=%llu\n", alignment, tensor_dir_start, tensor_dir_end, data_start);
    audit_print_metadata_distribution(&stats);
    audit_print_dtype_distribution(&stats);
    audit_print_prefix_summary(&stats);
    _ = printf("tensor branch counts:\n");
    _ = printf("  root: %llu\n", stats.root_tensor_count);
    _ = printf("  text: %llu\n", stats.text_tensor_count);
    _ = printf("  vision: %llu\n", stats.vision_tensor_count);
    _ = printf("  audio: %llu\n", stats.audio_tensor_count);
    _ = printf("  speech: %llu\n", stats.speech_tensor_count);
    _ = printf("  unknown: %llu\n", stats.unknown_tensor_count);
    audit_print_diagnostics(&stats);

    binary_close(&reader);
    return 0;
}

fn audit_bundle_one(label: &const byte, path: &const byte) bool {
    _ = printf("\n== bundle file: %s ==\n", label);
    const rc: i32 = audit_gguf(path);
    if rc != 0 {
        _ = printf("bundle audit failed: %s path=%s\n", label, path);
        return false;
    }
    return true;
}

fn audit_join_path(dir: &const byte, leaf: &const byte, out: &byte, cap: usize) bool {
    const written: i32 = snprintf(out as *byte, cap, "%s/%s\0" as *const byte, dir, leaf);
    if written < 0 || (written as usize) >= cap {
        _ = printf("error: token2wav path too long for %s/%s\n", dir, leaf);
        return false;
    }
    return true;
}

fn audit_parse_u32_value(text: &const byte, out: &u32) bool {
    var i: usize = 0;
    var value: u32 = 0;
    if text[0] == 0 { return false; }
    while text[i] != 0 {
        if text[i] < 48 || text[i] > 57 { return false; }
        value = value * 10 + ((text[i] - 48) as u32);
        i = i + 1;
    }
    *out = value;
    return true;
}

fn audit_bundle_usage() void {
    _ = printf("usage: minicpm-o-uya audio2audio-real [--audit-only] [--encode-probe] --llm <llm.gguf> --audio <audio.gguf> --tts <tts.gguf> --projector <projector.gguf> --token2wav-dir <dir>\n");
    _ = printf("       [--ref-audio ref.wav] [--user-audio user.wav|--input-audio user.wav] [--input-prefix prefix] [--test-prefix prefix --count N] [--out out.wav]\n");
}

export fn audio2audio_real_args_cli(argc: i32, argv: & &byte) i32 {
    var llm_path: &const byte = null;
    var audio_path: &const byte = null;
    var tts_path: &const byte = null;
    var projector_path: &const byte = null;
    var token2wav_dir: &const byte = null;
    var ref_audio_path: &const byte = null;
    var user_audio_path: &const byte = null;
    var input_prefix: &const byte = null;
    var test_prefix: &const byte = null;
    var test_count: u32 = 0;
    var has_test_count: bool = false;
    var out_path: &const byte = null;
    var prefix_ref_path: [byte: 512] = [];
    var prefix_user_path: [byte: 512] = [];
    var audit_only: bool = false;
    var encode_probe: bool = false;
    var i: i32 = 2;
    while i < argc {
        if strcmp(argv[i] as *const byte, "--audit-only\0" as *const byte) == 0 {
            audit_only = true;
            i = i + 1;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--encode-probe\0" as *const byte) == 0 {
            encode_probe = true;
            i = i + 1;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--llm\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            llm_path = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--audio\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            audio_path = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--tts\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            tts_path = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--projector\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            projector_path = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--token2wav-dir\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            token2wav_dir = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--ref-audio\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            ref_audio_path = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--user-audio\0" as *const byte) == 0 || strcmp(argv[i] as *const byte, "--input-audio\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            user_audio_path = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--input-prefix\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            input_prefix = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--test-prefix\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            test_prefix = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--count\0" as *const byte) == 0 {
            if i + 1 >= argc || !audit_parse_u32_value(argv[i + 1] as &const byte, &test_count) { audit_bundle_usage(); return 1; }
            has_test_count = true;
            i = i + 2;
            continue;
        }
        if strcmp(argv[i] as *const byte, "--out\0" as *const byte) == 0 {
            if i + 1 >= argc { audit_bundle_usage(); return 1; }
            out_path = argv[i + 1] as &const byte;
            i = i + 2;
            continue;
        }
        audit_bundle_usage();
        return 1;
    }
    if llm_path == null || audio_path == null || tts_path == null || projector_path == null || token2wav_dir == null {
        audit_bundle_usage();
        return 1;
    }
    if test_prefix != null {
        if input_prefix != null || ref_audio_path != null || user_audio_path != null {
            _ = printf("error: audio2audio-real --test-prefix cannot be combined with --input-prefix/--ref-audio/--user-audio\n");
            return 1;
        }
        if !has_test_count || test_count < 2 {
            _ = printf("error: audio2audio-real --test-prefix requires --count N with N>=2; 0000 is reference and 0001.. are user turns\n");
            return 1;
        }
        const written_ref_test: i32 = snprintf(&prefix_ref_path[0] as *byte, @len(prefix_ref_path), "%s_%04u.wav\0" as *const byte, test_prefix, 0);
        if written_ref_test < 0 || (written_ref_test as usize) >= @len(prefix_ref_path) { _ = printf("error: test-prefix ref path too long: %s\n", test_prefix); return 1; }
        ref_audio_path = &prefix_ref_path[0] as &const byte;
    }
    if input_prefix != null {
        if ref_audio_path == null {
            const written_ref: i32 = snprintf(&prefix_ref_path[0] as *byte, @len(prefix_ref_path), "%s_0000.wav\0" as *const byte, input_prefix);
            if written_ref < 0 || (written_ref as usize) >= @len(prefix_ref_path) { _ = printf("error: input-prefix ref path too long: %s\n", input_prefix); return 1; }
            ref_audio_path = &prefix_ref_path[0] as &const byte;
        }
        if user_audio_path == null {
            const written_user: i32 = snprintf(&prefix_user_path[0] as *byte, @len(prefix_user_path), "%s_0001.wav\0" as *const byte, input_prefix);
            if written_user < 0 || (written_user as usize) >= @len(prefix_user_path) { _ = printf("error: input-prefix user path too long: %s\n", input_prefix); return 1; }
            user_audio_path = &prefix_user_path[0] as &const byte;
        }
    }
    if test_prefix == null && ((ref_audio_path == null && user_audio_path != null) || (ref_audio_path != null && user_audio_path == null)) {
        _ = printf("error: audio2audio-real requires both ref and user audio; use --ref-audio with --user-audio, --input-prefix, or --test-prefix with --count\n");
        return 1;
    }

    _ = printf("audio2audio-real: bundle validation\n");
    var ok: bool = true;
    if !audit_bundle_one("llm\0" as &const byte, llm_path) { ok = false; }
    if !audit_bundle_one("audio\0" as &const byte, audio_path) { ok = false; }
    else { if !audio_real_bind_file(audio_path) { ok = false; } }
    if !audit_bundle_one("tts\0" as &const byte, tts_path) { ok = false; }
    else { if !speech_tts_bind_file(tts_path) { ok = false; } }
    if !audit_bundle_one("projector\0" as &const byte, projector_path) { ok = false; }

    var path: [byte: 512] = [];
    if audit_join_path(token2wav_dir, "encoder.gguf\0" as &const byte, &path[0], @len(path)) {
        if !audit_bundle_one("token2wav.encoder\0" as &const byte, &path[0] as &const byte) { ok = false; }
    } else { ok = false; }
    if audit_join_path(token2wav_dir, "flow_matching.gguf\0" as &const byte, &path[0], @len(path)) {
        if !audit_bundle_one("token2wav.flow_matching\0" as &const byte, &path[0] as &const byte) { ok = false; }
    } else { ok = false; }
    if audit_join_path(token2wav_dir, "flow_extra.gguf\0" as &const byte, &path[0], @len(path)) {
        if !audit_bundle_one("token2wav.flow_extra\0" as &const byte, &path[0] as &const byte) { ok = false; }
    } else { ok = false; }
    if audit_join_path(token2wav_dir, "hifigan2.gguf\0" as &const byte, &path[0], @len(path)) {
        if !audit_bundle_one("token2wav.hifigan2\0" as &const byte, &path[0] as &const byte) { ok = false; }
    } else { ok = false; }
    if audit_join_path(token2wav_dir, "prompt_cache.gguf\0" as &const byte, &path[0], @len(path)) {
        if !audit_bundle_one("token2wav.prompt_cache\0" as &const byte, &path[0] as &const byte) { ok = false; }
    } else { ok = false; }

    if !ok { return 1; }
    if test_prefix != null {
        _ = printf("audio2audio-real test protocol: prefix=%s count=%u ref_audio=%s user_turns=%u\n", test_prefix, test_count, ref_audio_path, test_count - 1);
        if out_path != null { _ = printf("audio2audio-real output target: %s\n", out_path); }
        if !audio_input_probe_file(ref_audio_path, "ref\0" as &const byte) { return 1; }
        if !audio_real_preprocess_probe_file(ref_audio_path, "ref\0" as &const byte) { return 1; }
        if encode_probe { if !audio_real_encode_probe_file(audio_path, ref_audio_path, "ref\0" as &const byte) { return 1; } }
        var turn: u32 = 1;
        while turn < test_count {
            const written_turn: i32 = snprintf(&prefix_user_path[0] as *byte, @len(prefix_user_path), "%s_%04u.wav\0" as *const byte, test_prefix, turn);
            if written_turn < 0 || (written_turn as usize) >= @len(prefix_user_path) { _ = printf("error: test-prefix user path too long: %s turn=%u\n", test_prefix, turn); return 1; }
            _ = printf("audio2audio-real test turn: user_index=%u user_audio=%s\n", turn, &prefix_user_path[0]);
            if !audio_input_probe_file(&prefix_user_path[0] as &const byte, "user\0" as &const byte) { return 1; }
            if !audio_real_preprocess_probe_file(&prefix_user_path[0] as &const byte, "user\0" as &const byte) { return 1; }
            if encode_probe { if !audio_real_encode_probe_file(audio_path, &prefix_user_path[0] as &const byte, "user\0" as &const byte) { return 1; } }
            turn = turn + 1;
        }
        _ = printf("audio2audio-real input-audit PASS ref_user=%u\n", test_count);
    } else { if ref_audio_path != null && user_audio_path != null {
        _ = printf("audio2audio-real input protocol: ref_audio=%s user_audio=%s\n", ref_audio_path, user_audio_path);
        if out_path != null { _ = printf("audio2audio-real output target: %s\n", out_path); }
        if !audio_input_probe_file(ref_audio_path, "ref\0" as &const byte) { return 1; }
        if !audio_real_preprocess_probe_file(ref_audio_path, "ref\0" as &const byte) { return 1; }
        if encode_probe { if !audio_real_encode_probe_file(audio_path, ref_audio_path, "ref\0" as &const byte) { return 1; } }
        if !audio_input_probe_file(user_audio_path, "user\0" as &const byte) { return 1; }
        if !audio_real_preprocess_probe_file(user_audio_path, "user\0" as &const byte) { return 1; }
        if encode_probe { if !audio_real_encode_probe_file(audio_path, user_audio_path, "user\0" as &const byte) { return 1; } }
        _ = printf("audio2audio-real input-audit PASS ref_user=2\n");
    } }
    if audit_only {
        _ = printf("audio2audio-real: audit-only PASS files=9\n");
        _ = printf("audio2audio-real: inference_supported=false next=audio-encoder-forward-and-tts-bind\n");
        return 0;
    }
    _ = printf("error: audio2audio-real inference is not implemented yet; use --audit-only to validate bundle and input protocol\n");
    _ = printf("audio2audio-real: inference_supported=false next=bind-audio-encoder-forward\n");
    return 1;
}

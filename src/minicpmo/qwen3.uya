export fn qwen3_config_init() Qwen3Config {
    return Qwen3Config{ vocab_size: 0, context_length: 0, hidden_size: 0, intermediate_size: 0, layer_count: 0, head_count: 0, kv_head_count: 0, head_dim: 0, norm_eps_bits: 0, rope_freq_base_bits: 0, rope_scaling_factor_bits: 0, rope_scaling_orig_ctx: 0, rope_scaling_type: [], has_norm_eps: false, has_rope_freq_base: false, has_rope_scaling_factor: false, has_rope_scaling_orig_ctx: false, has_rope_scaling_type: false, rope_scaling_finetuned: false, has_rope_scaling_finetuned: false };
}

fn qwen3_config_copy(dst: &Qwen3Config, src: &Qwen3Config) void {
    dst.vocab_size = src.vocab_size;
    dst.context_length = src.context_length;
    dst.hidden_size = src.hidden_size;
    dst.intermediate_size = src.intermediate_size;
    dst.layer_count = src.layer_count;
    dst.head_count = src.head_count;
    dst.kv_head_count = src.kv_head_count;
    dst.head_dim = src.head_dim;
    dst.norm_eps_bits = src.norm_eps_bits;
    dst.rope_freq_base_bits = src.rope_freq_base_bits;
    dst.rope_scaling_factor_bits = src.rope_scaling_factor_bits;
    dst.rope_scaling_orig_ctx = src.rope_scaling_orig_ctx;
    qwen3_copy_cstr(&dst.rope_scaling_type[0], @len(dst.rope_scaling_type), &src.rope_scaling_type[0] as &const byte);
    dst.has_norm_eps = src.has_norm_eps;
    dst.has_rope_freq_base = src.has_rope_freq_base;
    dst.has_rope_scaling_factor = src.has_rope_scaling_factor;
    dst.has_rope_scaling_orig_ctx = src.has_rope_scaling_orig_ctx;
    dst.has_rope_scaling_type = src.has_rope_scaling_type;
    dst.rope_scaling_finetuned = src.rope_scaling_finetuned;
    dst.has_rope_scaling_finetuned = src.has_rope_scaling_finetuned;
}

export fn qwen3_weights_init() Qwen3Weights {
    return Qwen3Weights{ token_embedding: null, output_norm: null, output: null, layers: [], layer_count: 0 };
}

fn qwen3_backend_default() BackendKind {
    return BackendKind.Cpu;
}

export fn qwen3_device_init() Qwen3Device {
    return Qwen3Device{ backend: BackendKind.Cpu, index: 0 };
}

fn qwen3_backend_name(kind: BackendKind) &const byte {
    if kind == BackendKind.Cuda { return "cuda\0" as &const byte; }
    return "cpu\0" as &const byte;
}

fn qwen3_parse_backend_value(text: &const byte, out: &BackendKind) bool {
    if strcmp(text as *const byte, "cpu\0" as *const byte) == 0 {
        *out = BackendKind.Cpu;
        return true;
    }
    if strcmp(text as *const byte, "cuda\0" as *const byte) == 0 {
        *out = BackendKind.Cuda;
        return true;
    }
    return false;
}

fn qwen3_backend_supported(kind: BackendKind) bool {
    _ = kind;
    return true;
}

fn qwen3_cstr_eq(a: &const byte, b: &const byte) bool {
    return strcmp(a as *const byte, b as *const byte) == 0;
}

fn qwen3_copy_cstr(dest: &byte, dest_cap: usize, src: &const byte) void {
    if dest_cap == 0 { return; }
    var i: usize = 0;
    while i + 1 < dest_cap && src[i] != 0 {
        dest[i] = src[i];
        i = i + 1;
    }
    dest[i] = 0;
}

fn qwen3_text_render_state_init() Qwen3TextRenderState {
    return Qwen3TextRenderState{ pending_escape: false, pending_escaped_backslash: false, in_code_fence: false, backtick_run: 0 };
}

fn qwen3_text_render_note_char(state: &Qwen3TextRenderState, ch: byte) void {
    if ch == 96 {
        state.backtick_run = state.backtick_run + 1;
        if state.backtick_run == 3 {
            state.in_code_fence = !state.in_code_fence;
            state.backtick_run = 0;
        }
    } else {
        state.backtick_run = 0;
    }
}

fn qwen3_text_render_put_char(state: &Qwen3TextRenderState, ch: byte) void {
    _ = printf("%c", ch as i32);
    qwen3_text_render_note_char(state, ch);
}

fn qwen3_text_render_piece(state: &Qwen3TextRenderState, text: &const byte) void {
    var i: usize = 0;
    while text[i] != 0 {
        const ch: byte = text[i];
        if state.pending_escaped_backslash {
            state.pending_escaped_backslash = false;
            if !state.in_code_fence && ch == 110 {
                qwen3_text_render_put_char(state, 10 as byte);
                i = i + 1;
                continue;
            }
            if !state.in_code_fence && ch == 116 {
                qwen3_text_render_put_char(state, 9 as byte);
                i = i + 1;
                continue;
            }
            qwen3_text_render_put_char(state, 92 as byte);
        }
        if state.pending_escape {
            state.pending_escape = false;
            if ch == 92 {
                if state.in_code_fence {
                    qwen3_text_render_put_char(state, 92 as byte);
                } else {
                    state.pending_escaped_backslash = true;
                }
                i = i + 1;
                continue;
            }
            if ch == 34 {
                qwen3_text_render_put_char(state, 34 as byte);
                i = i + 1;
                continue;
            }
            if !state.in_code_fence && ch == 110 {
                qwen3_text_render_put_char(state, 10 as byte);
                i = i + 1;
                continue;
            }
            if !state.in_code_fence && ch == 116 {
                qwen3_text_render_put_char(state, 9 as byte);
                i = i + 1;
                continue;
            }
            qwen3_text_render_put_char(state, 92 as byte);
            qwen3_text_render_put_char(state, ch);
            i = i + 1;
            continue;
        }
        if ch == 92 {
            state.pending_escape = true;
            i = i + 1;
            continue;
        }
        qwen3_text_render_put_char(state, ch);
        i = i + 1;
    }
}

fn qwen3_text_render_flush(state: &Qwen3TextRenderState) void {
    if state.pending_escaped_backslash {
        qwen3_text_render_put_char(state, 92 as byte);
        state.pending_escaped_backslash = false;
    }
    if state.pending_escape {
        qwen3_text_render_put_char(state, 92 as byte);
        state.pending_escape = false;
    }
}

fn qwen3_scalar_metadata_size(value_type: u32) u64 {
    if value_type == 0 || value_type == 1 || value_type == 7 { return 1; }
    if value_type == 2 || value_type == 3 { return 2; }
    if value_type == QWEN3_GGUF_TYPE_UINT32 || value_type == QWEN3_GGUF_TYPE_INT32 || value_type == QWEN3_GGUF_TYPE_FLOAT32 { return 4; }
    if value_type == QWEN3_GGUF_TYPE_UINT64 || value_type == QWEN3_GGUF_TYPE_INT64 || value_type == QWEN3_GGUF_TYPE_FLOAT64 { return 8; }
    return 0;
}

fn qwen3_read_string(reader: &BinaryReader, dest: &byte, dest_cap: usize, info: &Qwen3StringRead, context: &const byte) bool {
    info.len = 0;
    info.copied = 0;
    info.truncated = false;
    if !binary_read_u64_le(reader, &info.len, context) { return false; }
    if dest_cap == 0 { return binary_skip(reader, info.len, context); }
    var copy_len: usize = 0;
    if info.len > 0 {
        if info.len >= dest_cap as u64 {
            copy_len = dest_cap - 1;
            info.truncated = true;
        } else {
            copy_len = info.len as usize;
        }
        if copy_len > 0 {
            if !binary_read_exact(reader, dest, copy_len, context) { return false; }
        }
    }
    dest[copy_len] = 0;
    info.copied = copy_len;
    if info.len > copy_len as u64 {
        return binary_skip(reader, info.len - (copy_len as u64), context);
    }
    return true;
}

fn qwen3_skip_array(reader: &BinaryReader, element_type: u32, count: u64) bool {
    const elem_size: u64 = qwen3_scalar_metadata_size(element_type);
    if elem_size > 0 { return binary_skip(reader, elem_size * count, "metadata scalar array\0" as &const byte); }
    if element_type == QWEN3_GGUF_TYPE_STRING {
        var tmp: [byte: 1] = [];
        var info: Qwen3StringRead = Qwen3StringRead{ len: 0, copied: 0, truncated: false };
        var i: u64 = 0;
        while i < count {
            if !qwen3_read_string(reader, &tmp[0], 1, &info, "metadata string array element\0" as &const byte) { return false; }
            i = i + 1;
        }
        return true;
    }
    return false;
}

fn qwen3_apply_u32_metadata(config: &Qwen3Config, key: &const byte, value: u32) void {
    if qwen3_cstr_eq(key, "qwen3.context_length\0" as &const byte) { config.context_length = value; return; }
    if qwen3_cstr_eq(key, "qwen3.embedding_length\0" as &const byte) { config.hidden_size = value; return; }
    if qwen3_cstr_eq(key, "qwen3.feed_forward_length\0" as &const byte) { config.intermediate_size = value; return; }
    if qwen3_cstr_eq(key, "qwen3.block_count\0" as &const byte) { config.layer_count = value; return; }
    if qwen3_cstr_eq(key, "qwen3.attention.head_count\0" as &const byte) { config.head_count = value; return; }
    if qwen3_cstr_eq(key, "qwen3.attention.head_count_kv\0" as &const byte) { config.kv_head_count = value; return; }
    if qwen3_cstr_eq(key, "qwen3.rope.dimension_count\0" as &const byte) { config.head_dim = value; return; }
    if qwen3_cstr_eq(key, "qwen3.attention.key_length\0" as &const byte) { config.head_dim = value; return; }
    if qwen3_cstr_eq(key, "qwen3.rope.scaling.original_context_length\0" as &const byte) { config.rope_scaling_orig_ctx = value; config.has_rope_scaling_orig_ctx = true; return; }
}

fn qwen3_skip_metadata_value(reader: &BinaryReader, config: &Qwen3Config, key: &const byte, value_type: u32) bool {
    if value_type == QWEN3_GGUF_TYPE_STRING {
        if qwen3_cstr_eq(key, "qwen3.rope.scaling.type\0" as &const byte) {
            var info_type: Qwen3StringRead = Qwen3StringRead{ len: 0, copied: 0, truncated: false };
            if !qwen3_read_string(reader, &config.rope_scaling_type[0], @len(config.rope_scaling_type), &info_type, "metadata string value\0" as &const byte) { return false; }
            if info_type.truncated { _ = printf("error: qwen3 rope scaling type too long\n"); return false; }
            config.has_rope_scaling_type = true;
            return true;
        }
        var tmp: [byte: 1] = [];
        var info: Qwen3StringRead = Qwen3StringRead{ len: 0, copied: 0, truncated: false };
        return qwen3_read_string(reader, &tmp[0], 1, &info, "metadata string value\0" as &const byte);
    }
    if value_type == QWEN3_GGUF_TYPE_ARRAY {
        var element_type: u32 = 0;
        var count: u64 = 0;
        if !binary_read_u32_le(reader, &element_type, "metadata array type\0" as &const byte) { return false; }
        if !binary_read_u64_le(reader, &count, "metadata array length\0" as &const byte) { return false; }
        if qwen3_cstr_eq(key, "tokenizer.ggml.tokens\0" as &const byte) && count <= 4294967295 { config.vocab_size = count as u32; }
        return qwen3_skip_array(reader, element_type, count);
    }
    if value_type == QWEN3_GGUF_TYPE_UINT32 || value_type == QWEN3_GGUF_TYPE_INT32 {
        var value: u32 = 0;
        if !binary_read_u32_le(reader, &value, "metadata int/uint32 value\0" as &const byte) { return false; }
        qwen3_apply_u32_metadata(config, key, value);
        return true;
    }
    if value_type == QWEN3_GGUF_TYPE_FLOAT32 {
        var bits: u32 = 0;
        if !binary_read_u32_le(reader, &bits, "metadata float32 value\0" as &const byte) { return false; }
        if qwen3_cstr_eq(key, "qwen3.attention.layer_norm_rms_epsilon\0" as &const byte) { config.norm_eps_bits = bits; config.has_norm_eps = true; }
        if qwen3_cstr_eq(key, "qwen3.rope.freq_base\0" as &const byte) { config.rope_freq_base_bits = bits; config.has_rope_freq_base = true; }
        if qwen3_cstr_eq(key, "qwen3.rope.scaling.factor\0" as &const byte) || qwen3_cstr_eq(key, "qwen3.rope.scale_linear\0" as &const byte) { config.rope_scaling_factor_bits = bits; config.has_rope_scaling_factor = true; }
        return true;
    }
    if value_type == 7 {
        var value_bool: u8 = 0;
        if !binary_read_u8(reader, &value_bool, "metadata bool value\0" as &const byte) { return false; }
        if qwen3_cstr_eq(key, "qwen3.rope.scaling.finetuned\0" as &const byte) { config.rope_scaling_finetuned = value_bool != 0; config.has_rope_scaling_finetuned = true; }
        return true;
    }
    const size: u64 = qwen3_scalar_metadata_size(value_type);
    if size > 0 { return binary_skip(reader, size, "metadata scalar value\0" as &const byte); }
    _ = printf("error: qwen3 config unsupported metadata type=%u key=%s\n", value_type, key);
    return false;
}

export fn qwen3_config_load_metadata(path: &const byte, config: &Qwen3Config) bool {
    config[0] = qwen3_config_init();
    var reader: BinaryReader = binary_reader_init();
    if !binary_open(path, &reader) { return false; }
    var magic: u32 = 0;
    var version: u32 = 0;
    var tensor_count: u64 = 0;
    var metadata_count: u64 = 0;
    if !binary_read_u32_le(&reader, &magic, "GGUF magic\0" as &const byte) { binary_close(&reader); return false; }
    if magic != QWEN3_GGUF_MAGIC { _ = printf("error: qwen3 config bad GGUF magic\n"); binary_close(&reader); return false; }
    if !binary_read_u32_le(&reader, &version, "GGUF version\0" as &const byte) { binary_close(&reader); return false; }
    if version != 2 && version != 3 { _ = printf("error: qwen3 config unsupported GGUF version=%u\n", version); binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &tensor_count, "GGUF tensor_count\0" as &const byte) { binary_close(&reader); return false; }
    if !binary_read_u64_le(&reader, &metadata_count, "GGUF metadata_count\0" as &const byte) { binary_close(&reader); return false; }
    var i: u64 = 0;
    while i < metadata_count {
        var key: [byte: 128] = [];
        var info: Qwen3StringRead = Qwen3StringRead{ len: 0, copied: 0, truncated: false };
        if !qwen3_read_string(&reader, &key[0], @len(key), &info, "metadata key\0" as &const byte) { binary_close(&reader); return false; }
        if info.truncated { _ = printf("error: qwen3 config metadata key too long\n"); binary_close(&reader); return false; }
        var value_type: u32 = 0;
        if !binary_read_u32_le(&reader, &value_type, "metadata value type\0" as &const byte) { binary_close(&reader); return false; }
        if !qwen3_skip_metadata_value(&reader, config, &key[0] as &const byte, value_type) { binary_close(&reader); return false; }
        i = i + 1;
    }
    binary_close(&reader);
    return true;
}

fn qwen3_dtype_supported(dtype: TensorDType) bool {
    if dtype == TensorDType.F32 || dtype == TensorDType.F16 || dtype == TensorDType.BF16 { return true; }
    if dtype == TensorDType.Q8_0 || dtype == TensorDType.Q4_K || dtype == TensorDType.Q5_K || dtype == TensorDType.Q6_K || dtype == TensorDType.IQ4_NL { return true; }
    return false;
}

fn qwen3_dtype_runtime_matvec_supported(dtype: TensorDType) bool {
    if dtype == TensorDType.F32 || dtype == TensorDType.F16 || dtype == TensorDType.BF16 { return true; }
    if dtype == TensorDType.Q8_0 || dtype == TensorDType.Q4_K || dtype == TensorDType.Q5_K || dtype == TensorDType.Q6_K { return true; }
    return false;
}

fn qwen3_check_runtime_tensor_dtype(view: &TensorView, role: &const byte, layer: u32) bool {
    if qwen3_dtype_runtime_matvec_supported(view.dtype) { return true; }
    _ = printf("error: qwen3 runtime layer=%u tensor=%s role=%s dtype=%s parsed=true matvec=false candidate=implement real GGML K-quant dot before text generation\n", layer, &view.name[0], role, tensor_dtype_name(view.dtype));
    return false;
}

fn qwen3_validate_runtime_matvec_dtypes(weights: &Qwen3Weights) bool {
    if !qwen3_check_runtime_tensor_dtype(weights.token_embedding, "token_embedding\0" as &const byte, 0) { return false; }
    if !qwen3_check_runtime_tensor_dtype(weights.output, "lm_head\0" as &const byte, weights.layer_count) { return false; }
    var layer: u32 = 0;
    while layer < weights.layer_count {
        const lw: &Qwen3LayerWeights = &weights.layers[layer as usize];
        if !qwen3_check_runtime_tensor_dtype(lw.q_proj, "attn_q\0" as &const byte, layer) { return false; }
        if !qwen3_check_runtime_tensor_dtype(lw.k_proj, "attn_k\0" as &const byte, layer) { return false; }
        if !qwen3_check_runtime_tensor_dtype(lw.v_proj, "attn_v\0" as &const byte, layer) { return false; }
        if !qwen3_check_runtime_tensor_dtype(lw.o_proj, "attn_o\0" as &const byte, layer) { return false; }
        if !qwen3_check_runtime_tensor_dtype(lw.gate_proj, "ffn_gate\0" as &const byte, layer) { return false; }
        if !qwen3_check_runtime_tensor_dtype(lw.up_proj, "ffn_up\0" as &const byte, layer) { return false; }
        if !qwen3_check_runtime_tensor_dtype(lw.down_proj, "ffn_down\0" as &const byte, layer) { return false; }
        layer = layer + 1;
    }
    return true;
}

fn qwen3_check_cuda_runtime_matvec_tensor(view: &TensorView, role: &const byte, layer: u32) bool {
    if gpu_dtype_matvec_supported(view.dtype) { return true; }
    _ = printf("error: qwen3 runtime layer=%u tensor=%s role=%s dtype=%s backend=cuda supported_dtypes=F32|F16|BF16|Q4_K|Q6_K attention=cuda kv_cache=device no_cpu_fallback=true\n", layer, &view.name[0], role, tensor_dtype_name(view.dtype));
    return false;
}

fn qwen3_check_cuda_runtime_vec_tensor(view: &TensorView, role: &const byte, layer: u32) bool {
    if view.dtype == TensorDType.F32 || view.dtype == TensorDType.F16 || view.dtype == TensorDType.BF16 { return true; }
    _ = printf("error: qwen3 runtime layer=%u tensor=%s role=%s dtype=%s backend=cuda supported_vector_dtypes=F32|F16|BF16 attention=cuda kv_cache=device no_cpu_fallback=true\n", layer, &view.name[0], role, tensor_dtype_name(view.dtype));
    return false;
}

fn qwen3_validate_cuda_runtime_dtypes(weights: &Qwen3Weights) bool {
    if !qwen3_dtype_supported(weights.token_embedding.dtype) {
        _ = printf("error: qwen3 runtime tensor=%s role=token_embedding dtype=%s backend=cuda cpu_side_embedding_copy_unsupported=true\n", &weights.token_embedding.name[0], tensor_dtype_name(weights.token_embedding.dtype));
        return false;
    }
    if !qwen3_check_cuda_runtime_vec_tensor(weights.output_norm, "output_norm\0" as &const byte, weights.layer_count) { return false; }
    if !qwen3_check_cuda_runtime_matvec_tensor(weights.output, "lm_head\0" as &const byte, weights.layer_count) { return false; }
    var layer: u32 = 0;
    while layer < weights.layer_count {
        const lw: &Qwen3LayerWeights = &weights.layers[layer as usize];
        if !qwen3_check_cuda_runtime_vec_tensor(lw.attn_norm, "attn_norm\0" as &const byte, layer) { return false; }
        if !qwen3_check_cuda_runtime_matvec_tensor(lw.q_proj, "attn_q\0" as &const byte, layer) { return false; }
        if !qwen3_check_cuda_runtime_matvec_tensor(lw.k_proj, "attn_k\0" as &const byte, layer) { return false; }
        if !qwen3_check_cuda_runtime_matvec_tensor(lw.v_proj, "attn_v\0" as &const byte, layer) { return false; }
        if !qwen3_check_cuda_runtime_matvec_tensor(lw.o_proj, "attn_o\0" as &const byte, layer) { return false; }
        if lw.q_norm != null && !qwen3_check_cuda_runtime_vec_tensor(lw.q_norm, "q_norm\0" as &const byte, layer) { return false; }
        if lw.k_norm != null && !qwen3_check_cuda_runtime_vec_tensor(lw.k_norm, "k_norm\0" as &const byte, layer) { return false; }
        if !qwen3_check_cuda_runtime_vec_tensor(lw.ffn_norm, "ffn_norm\0" as &const byte, layer) { return false; }
        if !qwen3_check_cuda_runtime_matvec_tensor(lw.gate_proj, "ffn_gate\0" as &const byte, layer) { return false; }
        if !qwen3_check_cuda_runtime_matvec_tensor(lw.up_proj, "ffn_up\0" as &const byte, layer) { return false; }
        if !qwen3_check_cuda_runtime_matvec_tensor(lw.down_proj, "ffn_down\0" as &const byte, layer) { return false; }
        layer = layer + 1;
    }
    return true;
}

fn qwen3_print_shape(view: &TensorView) void {
    _ = printf("[");
    var i: u32 = 0;
    while i < view.n_dims {
        if i > 0 { _ = printf("x"); }
        _ = printf("%llu", view.shape[i as usize]);
        i = i + 1;
    }
    _ = printf("]");
}

fn qwen3_check_dtype(view: &TensorView, layer: u32) bool {
    if qwen3_dtype_supported(view.dtype) { return true; }
    _ = printf("error: qwen3 bind layer=%u tensor=%s unsupported dtype=%s\n", layer, &view.name[0], tensor_dtype_name(view.dtype));
    return false;
}

fn qwen3_check_vec(view: &TensorView, hidden: u32, layer: u32, role: &const byte) bool {
    if !qwen3_check_dtype(view, layer) { return false; }
    if view.n_dims == 1 && view.shape[0] == hidden as u64 { return true; }
    _ = printf("error: qwen3 bind layer=%u tensor=%s bad shape for %s expected=[%u] got=", layer, &view.name[0], role, hidden);
    qwen3_print_shape(view);
    _ = printf("\n");
    return false;
}

fn qwen3_check_matrix_first(view: &TensorView, first_dim: u32, layer: u32, role: &const byte) bool {
    if !qwen3_check_dtype(view, layer) { return false; }
    if view.n_dims == 2 && view.shape[0] == first_dim as u64 && view.shape[1] > 0 { return true; }
    _ = printf("error: qwen3 bind layer=%u tensor=%s bad shape for %s expected_first=%u got=", layer, &view.name[0], role, first_dim);
    qwen3_print_shape(view);
    _ = printf("\n");
    return false;
}

fn qwen3_check_matrix_exact(view: &TensorView, first_dim: u32, second_dim: u32, layer: u32, role: &const byte) bool {
    if !qwen3_check_dtype(view, layer) { return false; }
    if view.n_dims == 2 && view.shape[0] == first_dim as u64 && view.shape[1] == second_dim as u64 { return true; }
    _ = printf("error: qwen3 bind layer=%u tensor=%s bad shape for %s expected=[%u,%u] got=", layer, &view.name[0], role, first_dim, second_dim);
    qwen3_print_shape(view);
    _ = printf("\n");
    return false;
}

fn qwen3_lookup_required(table: &TensorWeightTable, name: &const byte, layer: u32) &TensorView {
    const view: &TensorView = tensor_lookup(table, name);
    if view == null { _ = printf("error: qwen3 bind layer=%u missing tensor %s\n", layer, name); }
    return view;
}

fn qwen3_lookup_layer_required(table: &TensorWeightTable, layer: u32, suffix: &const byte) &TensorView {
    var name: [byte: 96] = [];
    if !tensor_build_layer_name(layer, suffix, &name[0], @len(name)) { _ = printf("error: qwen3 bind layer=%u cannot build tensor name\n", layer); return null; }
    return qwen3_lookup_required(table, &name[0] as &const byte, layer);
}

fn qwen3_lookup_layer_optional(table: &TensorWeightTable, layer: u32, suffix: &const byte) &TensorView {
    var name: [byte: 96] = [];
    if !tensor_build_layer_name(layer, suffix, &name[0], @len(name)) { return null; }
    return tensor_lookup(table, &name[0] as &const byte);
}

fn qwen3_count_layers_from_tensors(table: &TensorWeightTable) u32 {
    var count: u32 = 0;
    while count < QWEN3_MAX_LAYERS as u32 {
        if qwen3_lookup_layer_optional(table, count, "attn_q.weight\0" as &const byte) == null { return count; }
        count = count + 1;
    }
    return count;
}

export fn qwen3_complete_config_from_tensors(config: &Qwen3Config, table: &TensorWeightTable) bool {
    const emb: &TensorView = tensor_lookup_root_token_embedding(table);
    if emb == null { _ = printf("error: qwen3 bind layer=0 missing tensor token_embd.weight\n"); return false; }
    if emb.n_dims != 2 { _ = printf("error: qwen3 bind tensor=%s bad embedding shape got=", &emb.name[0]); qwen3_print_shape(emb); _ = printf("\n"); return false; }
    if config.hidden_size == 0 { config.hidden_size = emb.shape[0] as u32; }
    if config.vocab_size == 0 { config.vocab_size = emb.shape[1] as u32; }
    if config.layer_count == 0 { config.layer_count = qwen3_count_layers_from_tensors(table); }
    if config.head_count > 0 && config.hidden_size > 0 && config.head_dim == 0 {
        if config.hidden_size % config.head_count != 0 { _ = printf("error: qwen3 config hidden_size=%u not divisible by head_count=%u\n", config.hidden_size, config.head_count); return false; }
        config.head_dim = config.hidden_size / config.head_count;
    }
    if config.kv_head_count == 0 && config.head_count > 0 { config.kv_head_count = config.head_count; }
    if config.intermediate_size == 0 {
        const gate: &TensorView = qwen3_lookup_layer_optional(table, 0, "ffn_gate.weight\0" as &const byte);
        if gate != null && gate.n_dims == 2 { config.intermediate_size = gate.shape[1] as u32; }
    }
    if config.context_length == 0 { _ = printf("error: qwen3 config missing qwen3.context_length\n"); return false; }
    if config.hidden_size == 0 || config.vocab_size == 0 || config.layer_count == 0 || config.head_count == 0 || config.kv_head_count == 0 || config.head_dim == 0 || config.intermediate_size == 0 {
        _ = printf("error: qwen3 config incomplete vocab=%u hidden=%u layers=%u heads=%u kv_heads=%u head_dim=%u ffn=%u\n", config.vocab_size, config.hidden_size, config.layer_count, config.head_count, config.kv_head_count, config.head_dim, config.intermediate_size);
        return false;
    }
    if config.layer_count > QWEN3_MAX_LAYERS as u32 { _ = printf("error: qwen3 layer_count=%u exceeds max=%zu\n", config.layer_count, QWEN3_MAX_LAYERS); return false; }
    return true;
}

export fn qwen3_bind_weights(table: &TensorWeightTable, config: &Qwen3Config, weights: &Qwen3Weights) bool {
    weights[0] = qwen3_weights_init();
    weights.token_embedding = tensor_lookup_root_token_embedding(table);
    if weights.token_embedding == null { _ = printf("error: qwen3 bind layer=0 missing tensor token_embd.weight\n"); return false; }
    if !qwen3_check_matrix_exact(weights.token_embedding, config.hidden_size, config.vocab_size, 0, "token embedding\0" as &const byte) { return false; }
    weights.output_norm = tensor_lookup(table, "output_norm.weight\0" as &const byte);
    if weights.output_norm == null { weights.output_norm = tensor_lookup(table, "norm.weight\0" as &const byte); }
    if weights.output_norm == null { _ = printf("error: qwen3 bind layer=%u missing tensor output_norm.weight\n", config.layer_count); return false; }
    if !qwen3_check_vec(weights.output_norm, config.hidden_size, config.layer_count, "output norm\0" as &const byte) { return false; }
    weights.output = tensor_lookup_root_output(table);
    if weights.output == null { _ = printf("error: qwen3 bind layer=%u missing tensor output.weight\n", config.layer_count); return false; }
    if !qwen3_check_matrix_exact(weights.output, config.hidden_size, config.vocab_size, config.layer_count, "lm head/output\0" as &const byte) { return false; }
    weights.layer_count = config.layer_count;
    const q_dim: u32 = config.head_count * config.head_dim;
    const kv_dim: u32 = config.kv_head_count * config.head_dim;
    var layer: u32 = 0;
    while layer < config.layer_count {
        var lw: &Qwen3LayerWeights = &weights.layers[layer as usize];
        lw.attn_norm = qwen3_lookup_layer_required(table, layer, "attn_norm.weight\0" as &const byte);
        if lw.attn_norm == null || !qwen3_check_vec(lw.attn_norm, config.hidden_size, layer, "attention norm\0" as &const byte) { return false; }
        lw.q_proj = qwen3_lookup_layer_required(table, layer, "attn_q.weight\0" as &const byte);
        if lw.q_proj == null || !qwen3_check_matrix_exact(lw.q_proj, config.hidden_size, q_dim, layer, "q projection\0" as &const byte) { return false; }
        lw.k_proj = qwen3_lookup_layer_required(table, layer, "attn_k.weight\0" as &const byte);
        if lw.k_proj == null || !qwen3_check_matrix_exact(lw.k_proj, config.hidden_size, kv_dim, layer, "k projection\0" as &const byte) { return false; }
        lw.v_proj = qwen3_lookup_layer_required(table, layer, "attn_v.weight\0" as &const byte);
        if lw.v_proj == null || !qwen3_check_matrix_exact(lw.v_proj, config.hidden_size, kv_dim, layer, "v projection\0" as &const byte) { return false; }
        lw.o_proj = qwen3_lookup_layer_required(table, layer, "attn_output.weight\0" as &const byte);
        if lw.o_proj == null || !qwen3_check_matrix_exact(lw.o_proj, q_dim, config.hidden_size, layer, "o projection\0" as &const byte) { return false; }
        lw.q_norm = qwen3_lookup_layer_optional(table, layer, "attn_q_norm.weight\0" as &const byte);
        if lw.q_norm == null { lw.q_norm = qwen3_lookup_layer_optional(table, layer, "attn_q_a_norm.weight\0" as &const byte); }
        if lw.q_norm != null && !qwen3_check_vec(lw.q_norm, config.head_dim, layer, "q norm\0" as &const byte) { return false; }
        lw.k_norm = qwen3_lookup_layer_optional(table, layer, "attn_k_norm.weight\0" as &const byte);
        if lw.k_norm == null { lw.k_norm = qwen3_lookup_layer_optional(table, layer, "attn_k_a_norm.weight\0" as &const byte); }
        if lw.k_norm != null && !qwen3_check_vec(lw.k_norm, config.head_dim, layer, "k norm\0" as &const byte) { return false; }
        lw.ffn_norm = qwen3_lookup_layer_required(table, layer, "ffn_norm.weight\0" as &const byte);
        if lw.ffn_norm == null || !qwen3_check_vec(lw.ffn_norm, config.hidden_size, layer, "ffn norm\0" as &const byte) { return false; }
        lw.gate_proj = qwen3_lookup_layer_required(table, layer, "ffn_gate.weight\0" as &const byte);
        if lw.gate_proj == null || !qwen3_check_matrix_exact(lw.gate_proj, config.hidden_size, config.intermediate_size, layer, "ffn gate\0" as &const byte) { return false; }
        lw.up_proj = qwen3_lookup_layer_required(table, layer, "ffn_up.weight\0" as &const byte);
        if lw.up_proj == null || !qwen3_check_matrix_exact(lw.up_proj, config.hidden_size, config.intermediate_size, layer, "ffn up\0" as &const byte) { return false; }
        lw.down_proj = qwen3_lookup_layer_required(table, layer, "ffn_down.weight\0" as &const byte);
        if lw.down_proj == null || !qwen3_check_matrix_exact(lw.down_proj, config.intermediate_size, config.hidden_size, layer, "ffn down\0" as &const byte) { return false; }
        layer = layer + 1;
    }
    return true;
}

export fn qwen3_bind_cli(path: &const byte) i32 {
    var config: Qwen3Config = qwen3_config_init();
    if !qwen3_config_load_metadata(path, &config) { return 1; }
    var table: TensorWeightTable = tensor_table_init();
    if !tensor_weight_table_load(path, &table) { return 1; }
    if !qwen3_complete_config_from_tensors(&config, &table) { return 1; }
    if !qwen3_check_forward_caps(&config) { return 1; }
    var weights: Qwen3Weights = qwen3_weights_init();
    if !qwen3_bind_weights(&table, &config, &weights) { return 1; }
    var q_norm_label: &const byte = "no\0" as &const byte;
    if weights.layers[0].q_norm != null { q_norm_label = "yes\0" as &const byte; }
    var k_norm_label: &const byte = "no\0" as &const byte;
    if weights.layers[0].k_norm != null { k_norm_label = "yes\0" as &const byte; }
    _ = printf("qwen3 config: vocab=%u context=%u hidden=%u layers=%u heads=%u kv_heads=%u head_dim=%u ffn=%u norm_eps_bits=0x%x rope_freq_base_bits=0x%x rope_scaling=%s rope_scale=%f rope_orig_ctx=%u runtime_context=%zu\n", config.vocab_size, config.context_length, config.hidden_size, config.layer_count, config.head_count, config.kv_head_count, config.head_dim, config.intermediate_size, config.norm_eps_bits, config.rope_freq_base_bits, qwen3_config_rope_scaling_type(&config), qwen3_config_rope_scaling_factor(&config), config.rope_scaling_orig_ctx, qwen3_runtime_context_capacity(&config));
    _ = printf("qwen3 bind: token_embd=%s output_norm=%s output=%s layers=%u q_norm=%s k_norm=%s\n", &weights.token_embedding.name[0], &weights.output_norm.name[0], &weights.output.name[0], weights.layer_count, q_norm_label, k_norm_label);
    _ = printf("qwen3 layer[0]: attn_norm=%s q=%s k=%s v=%s o=%s ffn_norm=%s gate=%s up=%s down=%s\n", &weights.layers[0].attn_norm.name[0], &weights.layers[0].q_proj.name[0], &weights.layers[0].k_proj.name[0], &weights.layers[0].v_proj.name[0], &weights.layers[0].o_proj.name[0], &weights.layers[0].ffn_norm.name[0], &weights.layers[0].gate_proj.name[0], &weights.layers[0].up_proj.name[0], &weights.layers[0].down_proj.name[0]);
    _ = printf("qwen3 bind: PASS\n");
    return 0;
}


fn qwen3_read_u16_at(data: &const byte, byte_offset: usize) u16 {
    return (data[byte_offset] as u16) | ((data[byte_offset + (1 as usize)] as u16) << 8);
}

export fn qwen3_tensor_get(view: &TensorView, index: usize) f32 {
    if view.dtype == TensorDType.F16 {
        return f16_load_f32(qwen3_read_u16_at(view.data, index * (2 as usize)));
    }
    if view.dtype == TensorDType.BF16 {
        return bf16_load_f32(qwen3_read_u16_at(view.data, index * (2 as usize)));
    }
    if view.dtype == TensorDType.F32 {
        const ptr: &const f32 = &view.data[index * (4 as usize)] as &const f32;
        return ptr[0];
    }
    if view.dtype == TensorDType.Q8_0 {
        const block: usize = index / (32 as usize);
        const inner: usize = index % (32 as usize);
        const base: usize = block * (34 as usize);
        const scale_bits: u16 = qwen3_read_u16_at(view.data, base);
        const qs: &const i8 = &view.data[base + (2 as usize)] as &const i8;
        return f16_load_f32(scale_bits) * (qs[inner] as f32);
    }
    return 0.0 as f32;
}


fn qwen3_q4_k_scale_min(j: i32, scales: &const byte, scale: &u8, minv: &u8) void {
    if j < 4 {
        scale[0] = scales[j as usize] & (63 as byte);
        minv[0] = scales[(j + 4) as usize] & (63 as byte);
    } else {
        scale[0] = (scales[(j + 4) as usize] & (15 as byte)) | ((scales[(j - 4) as usize] >> 6) << 4);
        minv[0] = (scales[(j + 4) as usize] >> 4) | ((scales[j as usize] >> 6) << 4);
    }
}

fn qwen3_q4_k_dot_row(matrix: &TensorView, row: usize, x: &const f32, in_dim: usize) f32 {
    const qk: usize = 256;
    const block_bytes: usize = 144;
    const blocks_per_row: usize = in_dim / qk;
    const row_base: usize = row * blocks_per_row * block_bytes;
    var sum: f32 = 0.0;
    var block: usize = 0;
    while block < blocks_per_row {
        const base: usize = row_base + block * block_bytes;
        const d: f32 = f16_load_f32(qwen3_read_u16_at(matrix.data, base));
        const dmin: f32 = f16_load_f32(qwen3_read_u16_at(matrix.data, base + (2 as usize)));
        const scales: &const byte = &matrix.data[base + (4 as usize)];
        const qs: &const byte = &matrix.data[base + (16 as usize)];
        const xb: &const f32 = &x[block * qk];
        var is: i32 = 0;
        var group: usize = 0;
        while group < 4 {
            var sc: u8 = 0;
            var mn: u8 = 0;
            qwen3_q4_k_scale_min(is, scales, &sc, &mn);
            const d1: f32 = d * (sc as f32);
            const m1: f32 = dmin * (mn as f32);
            qwen3_q4_k_scale_min(is + 1, scales, &sc, &mn);
            const d2: f32 = d * (sc as f32);
            const m2: f32 = dmin * (mn as f32);
            const qbase: usize = group * (32 as usize);
            var l: usize = 0;
            while l < (32 as usize) {
                sum = sum + xb[group * (64 as usize) + l] * (d1 * ((qs[qbase + l] & (15 as byte)) as f32) - m1);
                l = l + 1;
            }
            l = 0;
            while l < (32 as usize) {
                sum = sum + xb[group * (64 as usize) + (32 as usize) + l] * (d2 * ((qs[qbase + l] >> 4) as f32) - m2);
                l = l + 1;
            }
            is = is + 2;
            group = group + 1;
        }
        block = block + 1;
    }
    return sum;
}

fn qwen3_q5_k_dot_row(matrix: &TensorView, row: usize, x: &const f32, in_dim: usize) f32 {
    const qk: usize = 256;
    const block_bytes: usize = 176;
    const blocks_per_row: usize = in_dim / qk;
    const row_base: usize = row * blocks_per_row * block_bytes;
    var sum: f32 = 0.0;
    var block: usize = 0;
    while block < blocks_per_row {
        const base: usize = row_base + block * block_bytes;
        const d: f32 = f16_load_f32(qwen3_read_u16_at(matrix.data, base));
        const dmin: f32 = f16_load_f32(qwen3_read_u16_at(matrix.data, base + (2 as usize)));
        const scales: &const byte = &matrix.data[base + (4 as usize)];
        const qh: &const byte = &matrix.data[base + (16 as usize)];
        const qs: &const byte = &matrix.data[base + (48 as usize)];
        const xb: &const f32 = &x[block * qk];
        var is: i32 = 0;
        var group: usize = 0;
        var u1: byte = 1 as byte;
        var u2: byte = 2 as byte;
        while group < 4 {
            var sc: u8 = 0;
            var mn: u8 = 0;
            qwen3_q4_k_scale_min(is, scales, &sc, &mn);
            const d1: f32 = d * (sc as f32);
            const m1: f32 = dmin * (mn as f32);
            qwen3_q4_k_scale_min(is + 1, scales, &sc, &mn);
            const d2: f32 = d * (sc as f32);
            const m2: f32 = dmin * (mn as f32);
            const qbase: usize = group * (32 as usize);
            var l: usize = 0;
            while l < (32 as usize) {
                var high: f32 = 0.0;
                if (qh[l] & u1) != (0 as byte) { high = 16.0; }
                sum = sum + xb[group * (64 as usize) + l] * (d1 * (((qs[qbase + l] & (15 as byte)) as f32) + high) - m1);
                l = l + 1;
            }
            l = 0;
            while l < (32 as usize) {
                var high: f32 = 0.0;
                if (qh[l] & u2) != (0 as byte) { high = 16.0; }
                sum = sum + xb[group * (64 as usize) + (32 as usize) + l] * (d2 * (((qs[qbase + l] >> 4) as f32) + high) - m2);
                l = l + 1;
            }
            is = is + 2;
            u1 = ((u1 as u32) << 2) as byte;
            u2 = ((u2 as u32) << 2) as byte;
            group = group + 1;
        }
        block = block + 1;
    }
    return sum;
}

fn qwen3_q6_k_dot_row(matrix: &TensorView, row: usize, x: &const f32, in_dim: usize) f32 {
    const qk: usize = 256;
    const block_bytes: usize = 210;
    const blocks_per_row: usize = in_dim / qk;
    const row_base: usize = row * blocks_per_row * block_bytes;
    var sum: f32 = 0.0;
    var block: usize = 0;
    while block < blocks_per_row {
        const base: usize = row_base + block * block_bytes;
        const ql: &const byte = &matrix.data[base];
        const qh: &const byte = &matrix.data[base + (128 as usize)];
        const sc: &const i8 = &matrix.data[base + (192 as usize)] as &const i8;
        const d: f32 = f16_load_f32(qwen3_read_u16_at(matrix.data, base + (208 as usize)));
        const xb: &const f32 = &x[block * qk];
        var n: usize = 0;
        while n < (256 as usize) {
            var l: usize = 0;
            while l < (32 as usize) {
                const isv: usize = l / (16 as usize);
                const q1: i32 = (((ql[n / (2 as usize) + l] & (15 as byte)) as i32) | ((((qh[n / (4 as usize) + l] >> 0) & (3 as byte)) as i32) << 4)) - 32;
                const q2: i32 = (((ql[n / (2 as usize) + l + (32 as usize)] & (15 as byte)) as i32) | ((((qh[n / (4 as usize) + l] >> 2) & (3 as byte)) as i32) << 4)) - 32;
                const q3: i32 = (((ql[n / (2 as usize) + l] >> 4) as i32) | ((((qh[n / (4 as usize) + l] >> 4) & (3 as byte)) as i32) << 4)) - 32;
                const q4: i32 = (((ql[n / (2 as usize) + l + (32 as usize)] >> 4) as i32) | ((((qh[n / (4 as usize) + l] >> 6) & (3 as byte)) as i32) << 4)) - 32;
                sum = sum + xb[n + l] * d * (sc[n / (16 as usize) + isv + 0] as f32) * (q1 as f32);
                sum = sum + xb[n + (32 as usize) + l] * d * (sc[n / (16 as usize) + isv + 2] as f32) * (q2 as f32);
                sum = sum + xb[n + (64 as usize) + l] * d * (sc[n / (16 as usize) + isv + 4] as f32) * (q3 as f32);
                sum = sum + xb[n + (96 as usize) + l] * d * (sc[n / (16 as usize) + isv + 6] as f32) * (q4 as f32);
                l = l + 1;
            }
            n = n + (128 as usize);
        }
        block = block + 1;
    }
    return sum;
}

fn qwen3_k_matvec_range(dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_start: usize, out_end: usize) bool {
    if in_dim % (256 as usize) != 0 { return false; }
    if minicpmo_cpu_matvec_range(dst, matrix.data, matrix.dtype as i32, x, in_dim, out_start, out_end) != 0 { return true; }
    var j: usize = out_start;
    while j < out_end {
        if matrix.dtype == TensorDType.Q4_K { dst[j] = qwen3_q4_k_dot_row(matrix, j, x, in_dim); }
        else if matrix.dtype == TensorDType.Q5_K { dst[j] = qwen3_q5_k_dot_row(matrix, j, x, in_dim); }
        else if matrix.dtype == TensorDType.Q6_K { dst[j] = qwen3_q6_k_dot_row(matrix, j, x, in_dim); }
        else { return false; }
        j = j + 1;
    }
    return true;
}

fn qwen3_q5_k_copy_row(dst: &f32, emb: &TensorView, row: usize, hidden: usize) bool {
    if hidden % (256 as usize) != 0 { return false; }
    const qk: usize = 256;
    const block_bytes: usize = 176;
    const blocks_per_row: usize = hidden / qk;
    const row_base: usize = row * blocks_per_row * block_bytes;
    var block: usize = 0;
    while block < blocks_per_row {
        const base: usize = row_base + block * block_bytes;
        const d: f32 = f16_load_f32(qwen3_read_u16_at(emb.data, base));
        const dmin: f32 = f16_load_f32(qwen3_read_u16_at(emb.data, base + (2 as usize)));
        const scales: &const byte = &emb.data[base + (4 as usize)];
        const qh: &const byte = &emb.data[base + (16 as usize)];
        const qs: &const byte = &emb.data[base + (48 as usize)];
        const out_base: usize = block * qk;
        var is: i32 = 0;
        var group: usize = 0;
        var u1: byte = 1 as byte;
        var u2: byte = 2 as byte;
        while group < 4 {
            var sc: u8 = 0;
            var mn: u8 = 0;
            qwen3_q4_k_scale_min(is, scales, &sc, &mn);
            const d1: f32 = d * (sc as f32);
            const m1: f32 = dmin * (mn as f32);
            qwen3_q4_k_scale_min(is + 1, scales, &sc, &mn);
            const d2: f32 = d * (sc as f32);
            const m2: f32 = dmin * (mn as f32);
            const qbase: usize = group * (32 as usize);
            var l: usize = 0;
            while l < (32 as usize) {
                var high: f32 = 0.0;
                if (qh[l] & u1) != (0 as byte) { high = 16.0; }
                dst[out_base + group * (64 as usize) + l] = d1 * (((qs[qbase + l] & (15 as byte)) as f32) + high) - m1;
                l = l + 1;
            }
            l = 0;
            while l < (32 as usize) {
                var high: f32 = 0.0;
                if (qh[l] & u2) != (0 as byte) { high = 16.0; }
                dst[out_base + group * (64 as usize) + (32 as usize) + l] = d2 * (((qs[qbase + l] >> 4) as f32) + high) - m2;
                l = l + 1;
            }
            is = is + 2;
            u1 = ((u1 as u32) << 2) as byte;
            u2 = ((u2 as u32) << 2) as byte;
            group = group + 1;
        }
        block = block + 1;
    }
    return true;
}

fn qwen3_q6_k_copy_row(dst: &f32, emb: &TensorView, row: usize, hidden: usize) bool {
    if hidden % (256 as usize) != 0 { return false; }
    const qk: usize = 256;
    const block_bytes: usize = 210;
    const blocks_per_row: usize = hidden / qk;
    const row_base: usize = row * blocks_per_row * block_bytes;
    var block: usize = 0;
    while block < blocks_per_row {
        const base: usize = row_base + block * block_bytes;
        const ql: &const byte = &emb.data[base];
        const qh: &const byte = &emb.data[base + (128 as usize)];
        const sc: &const i8 = &emb.data[base + (192 as usize)] as &const i8;
        const d: f32 = f16_load_f32(qwen3_read_u16_at(emb.data, base + (208 as usize)));
        const out_base: usize = block * qk;
        var n: usize = 0;
        while n < (256 as usize) {
            var l: usize = 0;
            while l < (32 as usize) {
                const isv: usize = l / (16 as usize);
                const q1: i32 = (((ql[n / (2 as usize) + l] & (15 as byte)) as i32) | ((((qh[n / (4 as usize) + l] >> 0) & (3 as byte)) as i32) << 4)) - 32;
                const q2: i32 = (((ql[n / (2 as usize) + l + (32 as usize)] & (15 as byte)) as i32) | ((((qh[n / (4 as usize) + l] >> 2) & (3 as byte)) as i32) << 4)) - 32;
                const q3: i32 = (((ql[n / (2 as usize) + l] >> 4) as i32) | ((((qh[n / (4 as usize) + l] >> 4) & (3 as byte)) as i32) << 4)) - 32;
                const q4: i32 = (((ql[n / (2 as usize) + l + (32 as usize)] >> 4) as i32) | ((((qh[n / (4 as usize) + l] >> 6) & (3 as byte)) as i32) << 4)) - 32;
                dst[out_base + n + l] = d * (sc[n / (16 as usize) + isv + 0] as f32) * (q1 as f32);
                dst[out_base + n + (32 as usize) + l] = d * (sc[n / (16 as usize) + isv + 2] as f32) * (q2 as f32);
                dst[out_base + n + (64 as usize) + l] = d * (sc[n / (16 as usize) + isv + 4] as f32) * (q3 as f32);
                dst[out_base + n + (96 as usize) + l] = d * (sc[n / (16 as usize) + isv + 6] as f32) * (q4 as f32);
                l = l + 1;
            }
            n = n + (128 as usize);
        }
        block = block + 1;
    }
    return true;
}

fn qwen3_q4_k_copy_row(dst: &f32, emb: &TensorView, row: usize, hidden: usize) bool {
    if hidden % (256 as usize) != 0 { return false; }
    var i: usize = 0;
    while i < hidden { dst[i] = 0.0; i = i + 1; }
    const qk: usize = 256;
    const block_bytes: usize = 144;
    const blocks_per_row: usize = hidden / qk;
    const row_base: usize = row * blocks_per_row * block_bytes;
    var block: usize = 0;
    while block < blocks_per_row {
        const base: usize = row_base + block * block_bytes;
        const d: f32 = f16_load_f32(qwen3_read_u16_at(emb.data, base));
        const dmin: f32 = f16_load_f32(qwen3_read_u16_at(emb.data, base + (2 as usize)));
        const scales: &const byte = &emb.data[base + (4 as usize)];
        const qs: &const byte = &emb.data[base + (16 as usize)];
        const out_base: usize = block * qk;
        var is: i32 = 0;
        var group: usize = 0;
        while group < 4 {
            var sc: u8 = 0;
            var mn: u8 = 0;
            qwen3_q4_k_scale_min(is, scales, &sc, &mn);
            const d1: f32 = d * (sc as f32);
            const m1: f32 = dmin * (mn as f32);
            qwen3_q4_k_scale_min(is + 1, scales, &sc, &mn);
            const d2: f32 = d * (sc as f32);
            const m2: f32 = dmin * (mn as f32);
            const qbase: usize = group * (32 as usize);
            var l: usize = 0;
            while l < (32 as usize) {
                dst[out_base + group * (64 as usize) + l] = d1 * ((qs[qbase + l] & (15 as byte)) as f32) - m1;
                l = l + 1;
            }
            l = 0;
            while l < (32 as usize) {
                dst[out_base + group * (64 as usize) + (32 as usize) + l] = d2 * ((qs[qbase + l] >> 4) as f32) - m2;
                l = l + 1;
            }
            is = is + 2;
            group = group + 1;
        }
        block = block + 1;
    }
    return true;
}
export fn qwen3_check_forward_caps(config: &Qwen3Config) bool {
    const q_dim: u32 = config.head_count * config.head_dim;
    const kv_dim: u32 = config.kv_head_count * config.head_dim;
    if !qwen3_config_rope_scaling_supported(config) { return false; }
    if config.layer_count == 0 || config.layer_count > QWEN3_FORWARD_MAX_LAYERS as u32 { _ = printf("error: qwen3 forward layer_count=%u exceeds cap=%zu\n", config.layer_count, QWEN3_FORWARD_MAX_LAYERS); return false; }
    if config.context_length == 0 { _ = printf("error: qwen3 forward context_length=0\n"); return false; }
    if config.hidden_size == 0 || config.hidden_size > QWEN3_FORWARD_MAX_HIDDEN as u32 { _ = printf("error: qwen3 forward hidden_size=%u exceeds cap=%zu\n", config.hidden_size, QWEN3_FORWARD_MAX_HIDDEN); return false; }
    if config.intermediate_size == 0 || config.intermediate_size > QWEN3_FORWARD_MAX_FFN as u32 { _ = printf("error: qwen3 forward intermediate_size=%u exceeds cap=%zu\n", config.intermediate_size, QWEN3_FORWARD_MAX_FFN); return false; }
    if q_dim == 0 || q_dim > QWEN3_FORWARD_MAX_QDIM as u32 { _ = printf("error: qwen3 forward q_dim=%u exceeds cap=%zu\n", q_dim, QWEN3_FORWARD_MAX_QDIM); return false; }
    if kv_dim == 0 || kv_dim > QWEN3_FORWARD_MAX_KVDIM as u32 { _ = printf("error: qwen3 forward kv_dim=%u exceeds cap=%zu\n", kv_dim, QWEN3_FORWARD_MAX_KVDIM); return false; }
    if config.vocab_size == 0 || config.vocab_size > QWEN3_FORWARD_MAX_VOCAB as u32 { _ = printf("error: qwen3 forward vocab_size=%u exceeds cap=%zu\n", config.vocab_size, QWEN3_FORWARD_MAX_VOCAB); return false; }
    return true;
}

fn qwen3_copy_embedding(dst: &f32, emb: &TensorView, token_id: u32, hidden: usize, vocab: usize) void {
    _ = vocab;
    if emb.dtype == TensorDType.Q4_K && qwen3_q4_k_copy_row(dst, emb, token_id as usize, hidden) { return; }
    if emb.dtype == TensorDType.Q5_K && qwen3_q5_k_copy_row(dst, emb, token_id as usize, hidden) { return; }
    if emb.dtype == TensorDType.Q6_K && qwen3_q6_k_copy_row(dst, emb, token_id as usize, hidden) { return; }
    var i: usize = 0;
    while i < hidden {
        dst[i] = qwen3_tensor_get(emb, (token_id as usize) * hidden + i);
        i = i + 1;
    }
}

fn qwen3_rms_norm_view(dst: &f32, src: &const f32, weight: &TensorView, n: usize) void {
    var sum: f32 = 0.0;
    var i: usize = 0;
    while i < n { sum = sum + src[i] * src[i]; i = i + 1; }
    const inv: f32 = 1.0 / sqrtf(sum / (n as f32) + QWEN3_FORWARD_EPS);
    i = 0;
    while i < n {
        dst[i] = src[i] * inv * qwen3_tensor_get(weight, i);
        i = i + 1;
    }
}

fn qwen3_zero_f32(dst: &f32, n: usize) void {
    var i: usize = 0;
    while i < n { dst[i] = 0.0; i = i + 1; }
}

export fn qwen3_set_thread_count(threads: u32) void {
    var count: usize = threads as usize;
    if count < 1 { count = 1; }
    if count > QWEN3_MAX_THREADS { count = QWEN3_MAX_THREADS; }
    qwen3_thread_count = count;
}

fn qwen3_q8_0_matvec_range(dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_start: usize, out_end: usize) void {
    if minicpmo_cpu_matvec_range(dst, matrix.data, TensorDType.Q8_0 as i32, x, in_dim, out_start, out_end) != 0 { return; }
    const blocks_per_row: usize = in_dim / (32 as usize);
    const row_bytes: usize = blocks_per_row * (34 as usize);
    var j: usize = out_start;
    while j < out_end {
        const row_base: usize = j * row_bytes;
        var sum: f32 = 0.0;
        var block: usize = 0;
        while block < blocks_per_row {
            const block_base: usize = row_base + block * (34 as usize);
            const scale_bits: u16 = qwen3_read_u16_at(matrix.data, block_base);
            const scale: f32 = f16_load_f32(scale_bits);
            const qs: &const i8 = &matrix.data[block_base + (2 as usize)] as &const i8;
            const xb: &const f32 = &x[block * (32 as usize)];
            var k: usize = 0;
            while k < (32 as usize) {
                sum = sum + xb[k] * scale * (qs[k] as f32);
                k = k + 1;
            }
            block = block + 1;
        }
        dst[j] = sum;
        j = j + 1;
    }
}

fn qwen3_q8_0_matvec_view(dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_dim: usize) bool {
    if in_dim % (32 as usize) != 0 { return false; }
    qwen3_q8_0_matvec_range(dst, matrix, x, in_dim, 0, out_dim);
    return true;
}

fn qwen3_dense_matvec_range(dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_start: usize, out_end: usize) void {
    var j: usize = out_start;
    while j < out_end {
        var sum: f32 = 0.0;
        var i: usize = 0;
        while i < in_dim {
            sum = sum + x[i] * qwen3_tensor_get(matrix, j * in_dim + i);
            i = i + 1;
        }
        dst[j] = sum;
        j = j + 1;
    }
}

fn qwen3_matvec_pool_pause() void {
    _ = pthread_yield();
}

fn qwen3_matvec_pool_do_part(pool: &Qwen3MatvecPool, participant: u64) void {
    const participants: u64 = pool.participants;
    if participants == 0 || participant >= participants {
        return;
    }
    const out_dim_u64: u64 = pool.out_dim as u64;
    const start: usize = ((out_dim_u64 * participant) / participants) as usize;
    const end: usize = ((out_dim_u64 * (participant + 1)) / participants) as usize;
    if pool.dtype == TensorDType.Q8_0 {
        qwen3_q8_0_matvec_range(pool.dst, pool.matrix, pool.x, pool.in_dim, start, end);
    } else if pool.dtype == TensorDType.Q4_K || pool.dtype == TensorDType.Q5_K || pool.dtype == TensorDType.Q6_K {
        if pool.x_q8_1_active != null && (pool.dtype == TensorDType.Q4_K || pool.dtype == TensorDType.Q6_K) {
            if minicpmo_cpu_matvec_q8_1_range(pool.dst, pool.matrix.data, pool.dtype as i32, pool.x_q8_1_active, pool.in_dim, start, end) != 0 { return; }
        }
        _ = qwen3_k_matvec_range(pool.dst, pool.matrix, pool.x, pool.in_dim, start, end);
    } else {
        qwen3_dense_matvec_range(pool.dst, pool.matrix, pool.x, pool.in_dim, start, end);
    }
}

fn qwen3_matvec_pool_worker_main(arg: &void) &void {
    const worker: &Qwen3MatvecWorkerArg = arg as &Qwen3MatvecWorkerArg;
    const pool: &Qwen3MatvecPool = worker.pool as &Qwen3MatvecPool;
    var seen: u64 = 0;
    while true {
        if pool.stop != 0 || pool.task_kind == QWEN3_MATVEC_TASK_STOP {
            return null;
        }
        const seq_now: u64 = pool.task_seq;
        if seq_now == seen {
            qwen3_matvec_pool_pause();
            continue;
        }
        const participant: u64 = worker.worker_id + 1;
        const active: bool = participant < pool.participants && pool.task_kind == QWEN3_MATVEC_TASK_RUN;
        if active {
            qwen3_matvec_pool_do_part(pool, participant);
        }
        if pool.task_seq == seq_now && active {
            _ = __sync_fetch_and_add((&pool.done) as &u64, 1);
        }
        seen = seq_now;
    }
    return null;
}

fn qwen3_matvec_pool_deinit(pool: &Qwen3MatvecPool) void {
    if pool == null {
        return;
    }
    if pool.initialized {
        pool.stop = 1;
        pool.task_kind = QWEN3_MATVEC_TASK_STOP;
        _ = __sync_fetch_and_add((&pool.task_seq) as &u64, 1);
        var i: u64 = 0;
        while i < pool.n_workers {
            _ = pthread_join(&pool.threads[i as usize], null as & &void);
            i = i + 1;
        }
    }
    if pool.worker_args != null {
        free(pool.worker_args as &void);
    }
    if pool.x_q8_1_cache != null {
        free(pool.x_q8_1_cache);
    }
}

fn qwen3_matvec_pool_init(thread_count: usize) &Qwen3MatvecPool {
    if thread_count < 2 {
        return null;
    }
    var count: usize = thread_count;
    if count > QWEN3_MAX_THREADS { count = QWEN3_MAX_THREADS; }
    const pool: &Qwen3MatvecPool = calloc(1, @size_of(Qwen3MatvecPool) as usize) as &Qwen3MatvecPool;
    if pool == null {
        return null;
    }
    pool.n_workers = (count - 1) as u64;
    pool.participants = count as u64;
    pool.task_kind = QWEN3_MATVEC_TASK_NONE;
    pool.worker_args = calloc(pool.n_workers as usize, @size_of(Qwen3MatvecWorkerArg) as usize) as &Qwen3MatvecWorkerArg;
    if pool.worker_args == null {
        free(pool as &void);
        return null;
    }
    var attr: pthread_attr_t = pthread_attr_t{};
    _ = pthread_attr_init(&attr);
    _ = pthread_attr_setstacksize(&attr, QWEN3_THREAD_STACK);
    var created: u64 = 0;
    var i: u64 = 0;
    while i < pool.n_workers {
        pool.worker_args[i as usize] = Qwen3MatvecWorkerArg{ pool: pool as &void, worker_id: i };
        if pthread_create(&pool.threads[i as usize], &attr as &const pthread_attr_t, &qwen3_matvec_pool_worker_main as &void, &pool.worker_args[i as usize] as &void) != 0 {
            pool.stop = 1;
            _ = __sync_fetch_and_add((&pool.task_seq) as &u64, 1);
            var j: u64 = 0;
            while j < created {
                _ = pthread_join(&pool.threads[j as usize], null as & &void);
                j = j + 1;
            }
            _ = pthread_attr_destroy(&attr);
            free(pool.worker_args as &void);
            free(pool as &void);
            return null;
        }
        created = created + 1;
        i = i + 1;
    }
    _ = pthread_attr_destroy(&attr);
    pool.initialized = true;
    return pool;
}

fn qwen3_matvec_pool_get(thread_count: usize) &Qwen3MatvecPool {
    if thread_count < 2 {
        return null;
    }
    if qwen3_matvec_pool_ptr != null && qwen3_matvec_pool_threads == thread_count {
        return qwen3_matvec_pool_ptr as &Qwen3MatvecPool;
    }
    if qwen3_matvec_pool_ptr != null {
        const old_pool: &Qwen3MatvecPool = qwen3_matvec_pool_ptr as &Qwen3MatvecPool;
        qwen3_matvec_pool_deinit(old_pool);
        free(old_pool as &void);
        qwen3_matvec_pool_ptr = null;
        qwen3_matvec_pool_threads = 0;
    }
    const pool: &Qwen3MatvecPool = qwen3_matvec_pool_init(thread_count);
    if pool == null {
        return null;
    }
    qwen3_matvec_pool_ptr = pool as &void;
    qwen3_matvec_pool_threads = thread_count;
    return pool;
}

fn qwen3_cpu_q8_1_enabled() bool {
    if qwen3_cpu_q8_1_checked {
        return qwen3_cpu_q8_1_flag;
    }
    const value: &const byte = getenv("MINICPMO_CPU_Q8_1\0" as &const byte) as &const byte;
    if value == null || value[0] == 0 {
        qwen3_cpu_q8_1_checked = true;
        qwen3_cpu_q8_1_flag = false;
        return false;
    }
    if value[0] == 48 as byte && value[1] == 0 {
        qwen3_cpu_q8_1_checked = true;
        qwen3_cpu_q8_1_flag = false;
        return false;
    }
    qwen3_cpu_q8_1_checked = true;
    qwen3_cpu_q8_1_flag = true;
    return qwen3_cpu_q8_1_flag;
}

fn qwen3_cuda_attention_enabled() bool {
    const value: &const byte = getenv("MINICPMO_GPU_ATTENTION\0" as &const byte) as &const byte;
    if value == null || value[0] == 0 {
        return true;
    }
    if value[0] == 48 as byte && value[1] == 0 {
        return false;
    }
    return true;
}

fn qwen3_cuda_device_forward_enabled() bool {
    const value: &const byte = getenv("MINICPMO_GPU_DEVICE_FORWARD\0" as &const byte) as &const byte;
    if value == null || value[0] == 0 {
        return true;
    }
    if value[0] == 48 as byte && value[1] == 0 {
        return false;
    }
    return true;
}

fn qwen3_matvec_pool_prepare_q8_1(pool: &Qwen3MatvecPool, x: &const f32, in_dim: usize, dtype: TensorDType) &void {
    if pool == null || x == null {
        return null;
    }
    if !qwen3_cpu_q8_1_enabled() {
        return null;
    }
    if dtype != TensorDType.Q4_K && dtype != TensorDType.Q6_K {
        return null;
    }
    const bytes: usize = minicpmo_cpu_q8_1_cache_bytes(in_dim);
    if bytes == 0 {
        return null;
    }
    if pool.x_q8_1_capacity < bytes {
        const new_cache: &void = calloc(1, bytes);
        if new_cache == null {
            return null;
        }
        if pool.x_q8_1_cache != null {
            free(pool.x_q8_1_cache);
        }
        pool.x_q8_1_cache = new_cache;
        pool.x_q8_1_capacity = bytes;
    }
    if minicpmo_cpu_quantize_q8_1(pool.x_q8_1_cache, x, in_dim) == 0 {
        return null;
    }
    return pool.x_q8_1_cache;
}

fn qwen3_matvec_pool_run(pool: &Qwen3MatvecPool, dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_dim: usize, dtype: TensorDType, participants: u64) bool {
    if pool == null || participants < 2 {
        return false;
    }
    pool.x_q8_1_active = qwen3_matvec_pool_prepare_q8_1(pool, x, in_dim, dtype);
    pool.dst = dst;
    pool.matrix = matrix;
    pool.x = x;
    pool.in_dim = in_dim;
    pool.out_dim = out_dim;
    pool.dtype = dtype;
    pool.participants = participants;
    pool.done = 0;
    pool.task_kind = QWEN3_MATVEC_TASK_RUN;
    __sync_synchronize();
    _ = __sync_fetch_and_add((&pool.task_seq) as &u64, 1);

    qwen3_matvec_pool_do_part(pool, 0);

    const done_target: u64 = participants - 1;
    while true {
        if pool.done >= done_target {
            pool.task_kind = QWEN3_MATVEC_TASK_NONE;
            return true;
        }
        qwen3_matvec_pool_pause();
    }
    return true;
}

fn qwen3_matvec_parallel(dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_dim: usize, dtype: TensorDType) bool {
    var count: usize = qwen3_thread_count;
    if count < 2 || out_dim < (64 as usize) { return false; }
    if count > QWEN3_MAX_THREADS { count = QWEN3_MAX_THREADS; }
    if count > out_dim { count = out_dim; }
    const pool: &Qwen3MatvecPool = qwen3_matvec_pool_get(count);
    if pool == null { return false; }
    return qwen3_matvec_pool_run(pool, dst, matrix, x, in_dim, out_dim, dtype, count as u64);
}

fn qwen3_matvec_view(dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_dim: usize) void {
    if matrix.dtype == TensorDType.Q8_0 {
        if in_dim % (32 as usize) == 0 && qwen3_matvec_parallel(dst, matrix, x, in_dim, out_dim, TensorDType.Q8_0) { return; }
        if qwen3_q8_0_matvec_view(dst, matrix, x, in_dim, out_dim) { return; }
    }
    if matrix.dtype == TensorDType.Q4_K || matrix.dtype == TensorDType.Q5_K || matrix.dtype == TensorDType.Q6_K {
        if in_dim % (256 as usize) == 0 && qwen3_matvec_parallel(dst, matrix, x, in_dim, out_dim, matrix.dtype) { return; }
        if qwen3_k_matvec_range(dst, matrix, x, in_dim, 0, out_dim) { return; }
    }
    if qwen3_matvec_parallel(dst, matrix, x, in_dim, out_dim, matrix.dtype) { return; }
    qwen3_dense_matvec_range(dst, matrix, x, in_dim, 0, out_dim);
}

fn qwen3_runtime_matvec_view(runtime: &Qwen3Runtime, dst: &f32, matrix: &TensorView, x: &const f32, in_dim: usize, out_dim: usize) bool {
    if runtime.device.backend == BackendKind.Cuda {
        if !gpu_dtype_matvec_supported(matrix.dtype) {
            gpu_print_runtime_unsupported("qwen3 cuda matvec unsupported\0" as &const byte, matrix);
            return false;
        }
        if !gpu_context_matvec(&runtime.gpu, matrix, x, in_dim, out_dim, dst) {
            _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
            return false;
        }
        return true;
    }
    qwen3_matvec_view(dst, matrix, x, in_dim, out_dim);
    return true;
}

fn qwen3_runtime_attention_view(runtime: &Qwen3Runtime, dst: &f32, q: &const f32, k: &const f32, v: &const f32, layer: usize, pos: usize, head_count: usize, kv_head_count: usize, head_dim: usize) bool {
    if runtime.device.backend == BackendKind.Cuda && qwen3_cuda_attention_enabled() {
        if !gpu_context_attention(&runtime.gpu, q, k, v, layer, pos, head_count, kv_head_count, head_dim, runtime.context_capacity, dst) {
            _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
            return false;
        }
        return true;
    }
    qwen3_write_kv_cache(runtime.k_cache, runtime.v_cache, layer, pos, k, v, kv_head_count * head_dim, runtime.context_capacity);
    qwen3_attention(dst, q, runtime.k_cache, runtime.v_cache, layer, pos, head_count, kv_head_count, head_dim, runtime.context_capacity);
    return true;
}

fn qwen3_apply_head_norm(vec: &f32, norm: &TensorView, head_count: usize, head_dim: usize) void {
    var h: usize = 0;
    while h < head_count {
        const base: usize = h * head_dim;
        var sum: f32 = 0.0;
        var d: usize = 0;
        while d < head_dim { sum = sum + vec[base + d] * vec[base + d]; d = d + 1; }
        const inv: f32 = 1.0 / sqrtf(sum / (head_dim as f32) + QWEN3_FORWARD_EPS);
        d = 0;
        while d < head_dim {
            vec[base + d] = vec[base + d] * inv * qwen3_tensor_get(norm, d);
            d = d + 1;
        }
        h = h + 1;
    }
}

fn qwen3_config_rope_freq_base(config: &Qwen3Config) f32 {
    if config.has_rope_freq_base {
        const ptr: &const f32 = &config.rope_freq_base_bits as &const f32;
        return ptr[0];
    }
    return QWEN3_DEFAULT_ROPE_FREQ_BASE;
}

fn qwen3_config_rope_scaling_type(config: &Qwen3Config) &const byte {
    if config.has_rope_scaling_type && config.rope_scaling_type[0] != 0 {
        return &config.rope_scaling_type[0] as &const byte;
    }
    if config.has_rope_scaling_factor {
        return "linear\0" as &const byte;
    }
    return "none\0" as &const byte;
}

fn qwen3_config_rope_scaling_factor(config: &Qwen3Config) f32 {
    if config.has_rope_scaling_factor {
        const ptr: &const f32 = &config.rope_scaling_factor_bits as &const f32;
        return ptr[0];
    }
    return 1.0 as f32;
}

fn qwen3_config_rope_freq_scale(config: &Qwen3Config) f32 {
    const factor: f32 = qwen3_config_rope_scaling_factor(config);
    if factor > 0.0 {
        return (1.0 as f32) / factor;
    }
    return 1.0 as f32;
}

fn qwen3_config_rope_scaling_supported(config: &Qwen3Config) bool {
    const scaling_type: &const byte = qwen3_config_rope_scaling_type(config);
    if qwen3_cstr_eq(scaling_type, "none\0" as &const byte) || qwen3_cstr_eq(scaling_type, "linear\0" as &const byte) {
        return true;
    }
    var finetuned: &const byte = "no\0" as &const byte;
    if config.rope_scaling_finetuned { finetuned = "yes\0" as &const byte; }
    _ = printf("error: qwen3 unsupported rope scaling type=%s factor=%f orig_ctx=%u finetuned=%s\n", scaling_type, qwen3_config_rope_scaling_factor(config), config.rope_scaling_orig_ctx, finetuned);
    return false;
}

fn qwen3_apply_rope(vec: &f32, head_count: usize, head_dim: usize, pos: usize, freq_base: f32, freq_scale: f32, rope_cos: &const f32, rope_sin: &const f32) void {
    const half_dim: usize = head_dim / (2 as usize);
    var h: usize = 0;
    while h < head_count {
        const base: usize = h * head_dim;
        var d: usize = 0;
        while d < half_dim {
            var c: f32 = 0.0;
            var s: f32 = 0.0;
            if rope_cos != null && rope_sin != null {
                const rope_index: usize = pos * half_dim + d;
                c = rope_cos[rope_index];
                s = rope_sin[rope_index];
            } else {
                const theta: f32 = ((pos as f32) * freq_scale) / powf(freq_base, (((2 as usize) * d) as f32) / (head_dim as f32));
                c = cosf(theta);
                s = sinf(theta);
            }
            const x0: f32 = vec[base + d];
            const x1: f32 = vec[base + half_dim + d];
            vec[base + d] = x0 * c - x1 * s;
            vec[base + half_dim + d] = x1 * c + x0 * s;
            d = d + 1;
        }
        h = h + 1;
    }
}

fn qwen3_precompute_rope(config: &Qwen3Config, runtime: &Qwen3Runtime) bool {
    const half_dim: usize = (config.head_dim as usize) / (2 as usize);
    const rope_count: usize = runtime.context_capacity * half_dim;
    if half_dim == 0 { return false; }
    runtime.rope_cos = calloc(rope_count, 4) as &f32;
    runtime.rope_sin = calloc(rope_count, 4) as &f32;
    if runtime.rope_cos == null || runtime.rope_sin == null {
        _ = printf("error: qwen3 rope cache allocation failed count=%zu\n", rope_count);
        free(runtime.rope_cos as &void); free(runtime.rope_sin as &void);
        runtime.rope_cos = null;
        runtime.rope_sin = null;
        return false;
    }
    runtime.rope_half_dim = half_dim;
    const freq_base: f32 = qwen3_config_rope_freq_base(config);
    const freq_scale: f32 = qwen3_config_rope_freq_scale(config);
    var pos: usize = 0;
    while pos < runtime.context_capacity {
        var d: usize = 0;
        while d < half_dim {
            const theta: f32 = ((pos as f32) * freq_scale) / powf(freq_base, (((2 as usize) * d) as f32) / (config.head_dim as f32));
            const idx: usize = pos * half_dim + d;
            runtime.rope_cos[idx] = cosf(theta);
            runtime.rope_sin[idx] = sinf(theta);
            d = d + 1;
        }
        pos = pos + 1;
    }
    return true;
}

fn qwen3_cache_index(layer: usize, pos: usize, dim: usize, kv_dim: usize, context_capacity: usize) usize {
    return (layer * context_capacity + pos) * kv_dim + dim;
}

fn qwen3_write_kv_cache(k_cache: &f32, v_cache: &f32, layer: usize, pos: usize, k: &const f32, v: &const f32, kv_dim: usize, context_capacity: usize) void {
    var d: usize = 0;
    while d < kv_dim {
        const idx: usize = qwen3_cache_index(layer, pos, d, kv_dim, context_capacity);
        k_cache[idx] = k[d];
        v_cache[idx] = v[d];
        d = d + 1;
    }
}

fn qwen3_attention(out: &f32, q: &const f32, k_cache: &const f32, v_cache: &const f32, layer: usize, pos: usize, head_count: usize, kv_head_count: usize, head_dim: usize, context_capacity: usize) void {
    var i: usize = 0;
    const q_dim: usize = head_count * head_dim;
    while i < q_dim { out[i] = 0.0; i = i + 1; }
    var scores: [f32: QWEN3_FORWARD_MAX_CONTEXT] = [];
    var probs: [f32: QWEN3_FORWARD_MAX_CONTEXT] = [];
    const scale: f32 = 1.0 / sqrtf(head_dim as f32);
    var h: usize = 0;
    while h < head_count {
        const kvh: usize = (h * kv_head_count) / head_count;
        var t: usize = 0;
        while t <= pos {
            var dot: f32 = 0.0;
            var d: usize = 0;
            while d < head_dim {
                dot = dot + q[h * head_dim + d] * k_cache[qwen3_cache_index(layer, t, kvh * head_dim + d, kv_head_count * head_dim, context_capacity)];
                d = d + 1;
            }
            scores[t] = dot * scale;
            t = t + 1;
        }
        softmax(&probs[0], &scores[0], pos + (1 as usize));
        var d2: usize = 0;
        while d2 < head_dim {
            var sum: f32 = 0.0;
            t = 0;
            while t <= pos {
                sum = sum + probs[t] * v_cache[qwen3_cache_index(layer, t, kvh * head_dim + d2, kv_head_count * head_dim, context_capacity)];
                t = t + 1;
            }
            out[h * head_dim + d2] = sum;
            d2 = d2 + 1;
        }
        h = h + 1;
    }
}

fn qwen3_argmax(values: &const f32, n: usize) u32 {
    var best: usize = 0;
    var i: usize = 1;
    while i < n {
        if values[i] > values[best] { best = i; }
        i = i + 1;
    }
    return best as u32;
}

fn qwen3_seen_token(seen: &const u32, seen_count: usize, token: u32) bool {
    var i: usize = 0;
    while i < seen_count {
        if seen[i] == token { return true; }
        i = i + 1;
    }
    return false;
}

fn qwen3_argmax_penalized(values: &const f32, n: usize, seen: &const u32, seen_count: usize, penalty: f32) u32 {
    var best: usize = 0;
    var best_value: f32 = values[0];
    if penalty > 1.0 && qwen3_seen_token(seen, seen_count, 0) {
        if best_value > 0.0 { best_value = best_value / penalty; }
        if best_value < 0.0 { best_value = best_value * penalty; }
    }
    var i: usize = 1;
    while i < n {
        var value: f32 = values[i];
        if penalty > 1.0 && qwen3_seen_token(seen, seen_count, i as u32) {
            if value > 0.0 { value = value / penalty; }
            if value < 0.0 { value = value * penalty; }
        }
        if value > best_value { best = i; best_value = value; }
        i = i + 1;
    }
    return best as u32;
}

fn qwen3_print_hidden_summary(label: &const byte, token_index: usize, token_id: u32, hidden: &const f32, n: usize) void {
    if hidden == null || n == 0 { return; }
    var sum: f32 = 0.0;
    var abs_sum: f32 = 0.0;
    var max_abs: f32 = 0.0;
    var i: usize = 0;
    while i < n {
        const v: f32 = hidden[i];
        var av: f32 = v;
        if av < 0.0 { av = -av; }
        sum = sum + v;
        abs_sum = abs_sum + av;
        if av > max_abs { max_abs = av; }
        i = i + 1;
    }
    _ = printf("%s: token_index=%zu token=%u n=%zu sum=%.6f abs_sum=%.6f max_abs=%.6f first=%.6f last=%.6f\n", label, token_index, token_id, n, sum as f64, abs_sum as f64, max_abs as f64, hidden[0] as f64, hidden[n - (1 as usize)] as f64);
}

fn qwen3_forward_embedding_with_rope(config: &Qwen3Config, weights: &Qwen3Weights, embedding: &const f32, pos: usize, k_cache: &f32, v_cache: &f32, logits: &f32, compute_logits: bool, rope_cos: &const f32, rope_sin: &const f32, context_capacity: usize, hidden_out: &f32, hidden_out_len: usize) bool {
    if pos >= context_capacity || pos >= QWEN3_FORWARD_MAX_CONTEXT {
        _ = printf("error: qwen3 forward pos=%zu exceeds runtime_context=%zu max_context=%zu\n", pos, context_capacity, QWEN3_FORWARD_MAX_CONTEXT);
        return false;
    }
    const hidden_n: usize = config.hidden_size as usize;
    const vocab_n: usize = config.vocab_size as usize;
    const ffn_n: usize = config.intermediate_size as usize;
    const head_count: usize = config.head_count as usize;
    const kv_head_count: usize = config.kv_head_count as usize;
    const head_dim: usize = config.head_dim as usize;
    const q_dim: usize = head_count * head_dim;
    const kv_dim: usize = kv_head_count * head_dim;
    const rope_freq_base: f32 = qwen3_config_rope_freq_base(config);
    const rope_freq_scale: f32 = qwen3_config_rope_freq_scale(config);
    var hidden: &f32 = calloc(hidden_n, 4) as &f32;
    var normed: &f32 = calloc(hidden_n, 4) as &f32;
    var q: &f32 = calloc(q_dim, 4) as &f32;
    var k: &f32 = calloc(kv_dim, 4) as &f32;
    var v: &f32 = calloc(kv_dim, 4) as &f32;
    var attn_ctx: &f32 = calloc(q_dim, 4) as &f32;
    var attn_out: &f32 = calloc(hidden_n, 4) as &f32;
    var gate: &f32 = calloc(ffn_n, 4) as &f32;
    var up: &f32 = calloc(ffn_n, 4) as &f32;
    var fused: &f32 = calloc(ffn_n, 4) as &f32;
    var down: &f32 = calloc(hidden_n, 4) as &f32;
    if hidden == null || normed == null || q == null || k == null || v == null || attn_ctx == null || attn_out == null || gate == null || up == null || fused == null || down == null {
        _ = printf("error: qwen3 forward workspace allocation failed\n");
        free(hidden as &void); free(normed as &void); free(q as &void); free(k as &void); free(v as &void); free(attn_ctx as &void); free(attn_out as &void); free(gate as &void); free(up as &void); free(fused as &void); free(down as &void);
        return false;
    }
    var copy_i: usize = 0;
    while copy_i < hidden_n { hidden[copy_i] = embedding[copy_i]; copy_i = copy_i + 1; }
    var layer: usize = 0;
    while layer < config.layer_count as usize {
        const lw: &Qwen3LayerWeights = &weights.layers[layer];
        qwen3_rms_norm_view(normed, hidden, lw.attn_norm, hidden_n);
        qwen3_matvec_view(q, lw.q_proj, normed, hidden_n, q_dim);
        qwen3_matvec_view(k, lw.k_proj, normed, hidden_n, kv_dim);
        qwen3_matvec_view(v, lw.v_proj, normed, hidden_n, kv_dim);
        if lw.q_norm != null { qwen3_apply_head_norm(q, lw.q_norm, head_count, head_dim); }
        if lw.k_norm != null { qwen3_apply_head_norm(k, lw.k_norm, kv_head_count, head_dim); }
        qwen3_apply_rope(q, head_count, head_dim, pos, rope_freq_base, rope_freq_scale, rope_cos, rope_sin);
        qwen3_apply_rope(k, kv_head_count, head_dim, pos, rope_freq_base, rope_freq_scale, rope_cos, rope_sin);
        qwen3_write_kv_cache(k_cache, v_cache, layer, pos, k, v, kv_dim, context_capacity);
        qwen3_attention(attn_ctx, q, k_cache, v_cache, layer, pos, head_count, kv_head_count, head_dim, context_capacity);
        qwen3_matvec_view(attn_out, lw.o_proj, attn_ctx, q_dim, hidden_n);
        var i: usize = 0;
        while i < hidden_n { hidden[i] = hidden[i] + attn_out[i]; i = i + 1; }
        qwen3_rms_norm_view(normed, hidden, lw.ffn_norm, hidden_n);
        qwen3_matvec_view(gate, lw.gate_proj, normed, hidden_n, ffn_n);
        qwen3_matvec_view(up, lw.up_proj, normed, hidden_n, ffn_n);
        i = 0;
        while i < ffn_n { fused[i] = silu(gate[i]) * up[i]; i = i + 1; }
        qwen3_matvec_view(down, lw.down_proj, fused, ffn_n, hidden_n);
        i = 0;
        while i < hidden_n { hidden[i] = hidden[i] + down[i]; i = i + 1; }
        layer = layer + 1;
    }
    if hidden_out != null {
        if hidden_out_len < hidden_n {
            _ = printf("error: qwen3 hidden capture buffer too small len=%zu hidden=%zu\n", hidden_out_len, hidden_n);
            free(hidden as &void); free(normed as &void); free(q as &void); free(k as &void); free(v as &void); free(attn_ctx as &void); free(attn_out as &void); free(gate as &void); free(up as &void); free(fused as &void); free(down as &void);
            return false;
        }
        var hidden_i: usize = 0;
        while hidden_i < hidden_n { hidden_out[hidden_i] = hidden[hidden_i]; hidden_i = hidden_i + 1; }
    }
    if compute_logits {
        qwen3_rms_norm_view(normed, hidden, weights.output_norm, hidden_n);
        qwen3_matvec_view(logits, weights.output, normed, hidden_n, vocab_n);
    }
    free(hidden as &void); free(normed as &void); free(q as &void); free(k as &void); free(v as &void); free(attn_ctx as &void); free(attn_out as &void); free(gate as &void); free(up as &void); free(fused as &void); free(down as &void);
    return true;
}

export fn qwen3_forward_embedding(config: &Qwen3Config, weights: &Qwen3Weights, embedding: &const f32, pos: usize, k_cache: &f32, v_cache: &f32, logits: &f32, compute_logits: bool) bool {
    return qwen3_forward_embedding_with_rope(config, weights, embedding, pos, k_cache, v_cache, logits, compute_logits, null as &const f32, null as &const f32, QWEN3_FORWARD_COMPAT_CONTEXT, null as &f32, 0);
}

fn qwen3_forward_token_with_rope(config: &Qwen3Config, weights: &Qwen3Weights, token_id: u32, pos: usize, k_cache: &f32, v_cache: &f32, logits: &f32, compute_logits: bool, rope_cos: &const f32, rope_sin: &const f32, context_capacity: usize, hidden_out: &f32, hidden_out_len: usize) bool {
    var embedding: &f32 = calloc(config.hidden_size as usize, 4) as &f32;
    if embedding == null { _ = printf("error: qwen3 embedding allocation failed\n"); return false; }
    qwen3_copy_embedding(embedding, weights.token_embedding, token_id, config.hidden_size as usize, config.vocab_size as usize);
    const ok: bool = qwen3_forward_embedding_with_rope(config, weights, embedding, pos, k_cache, v_cache, logits, compute_logits, rope_cos, rope_sin, context_capacity, hidden_out, hidden_out_len);
    free(embedding as &void);
    return ok;
}

export fn qwen3_forward_token(config: &Qwen3Config, weights: &Qwen3Weights, token_id: u32, pos: usize, k_cache: &f32, v_cache: &f32, logits: &f32, compute_logits: bool) bool {
    return qwen3_forward_token_with_rope(config, weights, token_id, pos, k_cache, v_cache, logits, compute_logits, null as &const f32, null as &const f32, QWEN3_FORWARD_COMPAT_CONTEXT, null as &f32, 0);
}

fn qwen3_forward_embedding_runtime_cuda(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, embedding: &const f32, pos: usize, logits: &f32, compute_logits: bool, hidden_out: &f32, hidden_out_len: usize) bool {
    const hidden_n: usize = config.hidden_size as usize;
    const vocab_n: usize = config.vocab_size as usize;
    const ffn_n: usize = config.intermediate_size as usize;
    const head_count: usize = config.head_count as usize;
    const kv_head_count: usize = config.kv_head_count as usize;
    const head_dim: usize = config.head_dim as usize;
    const q_dim: usize = head_count * head_dim;
    const kv_dim: usize = kv_head_count * head_dim;
    const rope_freq_base: f32 = qwen3_config_rope_freq_base(config);
    const rope_freq_scale: f32 = qwen3_config_rope_freq_scale(config);
    if !gpu_context_slot_upload_f32(&runtime.gpu, QWEN3_GPU_SLOT_HIDDEN, embedding, hidden_n) {
        _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
        return false;
    }
    var layer: usize = 0;
    while layer < config.layer_count as usize {
        const lw: &Qwen3LayerWeights = &weights.layers[layer];
        if !gpu_context_slot_rms_norm(&runtime.gpu, QWEN3_GPU_SLOT_NORMED, QWEN3_GPU_SLOT_HIDDEN, lw.attn_norm, hidden_n, QWEN3_FORWARD_EPS) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_matvec3(&runtime.gpu, QWEN3_GPU_SLOT_Q, lw.q_proj, q_dim, QWEN3_GPU_SLOT_K, lw.k_proj, kv_dim, QWEN3_GPU_SLOT_V, lw.v_proj, kv_dim, QWEN3_GPU_SLOT_NORMED, hidden_n) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if lw.q_norm != null && !gpu_context_slot_head_norm(&runtime.gpu, QWEN3_GPU_SLOT_Q, lw.q_norm, head_count, head_dim) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if lw.k_norm != null && !gpu_context_slot_head_norm(&runtime.gpu, QWEN3_GPU_SLOT_K, lw.k_norm, kv_head_count, head_dim) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_rope(&runtime.gpu, QWEN3_GPU_SLOT_Q, head_count, head_dim, pos, rope_freq_base, rope_freq_scale, runtime.rope_cos, runtime.rope_sin, runtime.context_capacity) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_rope(&runtime.gpu, QWEN3_GPU_SLOT_K, kv_head_count, head_dim, pos, rope_freq_base, rope_freq_scale, runtime.rope_cos, runtime.rope_sin, runtime.context_capacity) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_attention_slots(&runtime.gpu, QWEN3_GPU_SLOT_ATTN_CTX, QWEN3_GPU_SLOT_Q, QWEN3_GPU_SLOT_K, QWEN3_GPU_SLOT_V, layer, pos, head_count, kv_head_count, head_dim, runtime.context_capacity) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_matvec(&runtime.gpu, QWEN3_GPU_SLOT_ATTN_OUT, lw.o_proj, QWEN3_GPU_SLOT_ATTN_CTX, q_dim, hidden_n) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_add_inplace(&runtime.gpu, QWEN3_GPU_SLOT_HIDDEN, QWEN3_GPU_SLOT_ATTN_OUT, hidden_n) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_rms_norm(&runtime.gpu, QWEN3_GPU_SLOT_NORMED, QWEN3_GPU_SLOT_HIDDEN, lw.ffn_norm, hidden_n, QWEN3_FORWARD_EPS) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_matvec2(&runtime.gpu, QWEN3_GPU_SLOT_GATE, lw.gate_proj, ffn_n, QWEN3_GPU_SLOT_UP, lw.up_proj, ffn_n, QWEN3_GPU_SLOT_NORMED, hidden_n) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_silu_mul(&runtime.gpu, QWEN3_GPU_SLOT_FUSED, QWEN3_GPU_SLOT_GATE, QWEN3_GPU_SLOT_UP, ffn_n) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_matvec(&runtime.gpu, QWEN3_GPU_SLOT_DOWN, lw.down_proj, QWEN3_GPU_SLOT_FUSED, ffn_n, hidden_n) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_add_inplace(&runtime.gpu, QWEN3_GPU_SLOT_HIDDEN, QWEN3_GPU_SLOT_DOWN, hidden_n) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        layer = layer + 1;
    }
    if hidden_out != null {
        if hidden_out_len < hidden_n {
            _ = printf("error: qwen3 hidden capture buffer too small len=%zu hidden=%zu\n", hidden_out_len, hidden_n);
            return false;
        }
        if !gpu_context_slot_download_f32(&runtime.gpu, QWEN3_GPU_SLOT_HIDDEN, hidden_out, hidden_n) {
            _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
            return false;
        }
    }
    if compute_logits {
        if !gpu_context_slot_rms_norm(&runtime.gpu, QWEN3_GPU_SLOT_NORMED, QWEN3_GPU_SLOT_HIDDEN, weights.output_norm, hidden_n, QWEN3_FORWARD_EPS) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_matvec(&runtime.gpu, QWEN3_GPU_SLOT_LOGITS, weights.output, QWEN3_GPU_SLOT_NORMED, hidden_n, vocab_n) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_slot_download_f32(&runtime.gpu, QWEN3_GPU_SLOT_LOGITS, logits, vocab_n) {
            _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
            return false;
        }
    }
    return true;
}

fn qwen3_forward_embedding_runtime(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, embedding: &const f32, pos: usize, logits: &f32, compute_logits: bool, hidden_out: &f32, hidden_out_len: usize) bool {
    if pos >= runtime.context_capacity || pos >= QWEN3_FORWARD_MAX_CONTEXT {
        _ = printf("error: qwen3 forward pos=%zu exceeds runtime_context=%zu max_context=%zu\n", pos, runtime.context_capacity, QWEN3_FORWARD_MAX_CONTEXT);
        return false;
    }
    if runtime.device.backend == BackendKind.Cuda && qwen3_cuda_device_forward_enabled() {
        return qwen3_forward_embedding_runtime_cuda(config, weights, runtime, embedding, pos, logits, compute_logits, hidden_out, hidden_out_len);
    }
    const hidden_n: usize = config.hidden_size as usize;
    const vocab_n: usize = config.vocab_size as usize;
    const ffn_n: usize = config.intermediate_size as usize;
    const head_count: usize = config.head_count as usize;
    const kv_head_count: usize = config.kv_head_count as usize;
    const head_dim: usize = config.head_dim as usize;
    const q_dim: usize = head_count * head_dim;
    const kv_dim: usize = kv_head_count * head_dim;
    const rope_freq_base: f32 = qwen3_config_rope_freq_base(config);
    const rope_freq_scale: f32 = qwen3_config_rope_freq_scale(config);
    var hidden: [f32: QWEN3_FORWARD_MAX_HIDDEN] = [];
    var normed: [f32: QWEN3_FORWARD_MAX_HIDDEN] = [];
    var q: [f32: QWEN3_FORWARD_MAX_QDIM] = [];
    var k: [f32: QWEN3_FORWARD_MAX_KVDIM] = [];
    var v: [f32: QWEN3_FORWARD_MAX_KVDIM] = [];
    var attn_ctx: [f32: QWEN3_FORWARD_MAX_QDIM] = [];
    var attn_out: [f32: QWEN3_FORWARD_MAX_HIDDEN] = [];
    var gate: [f32: QWEN3_FORWARD_MAX_FFN] = [];
    var up: [f32: QWEN3_FORWARD_MAX_FFN] = [];
    var fused: [f32: QWEN3_FORWARD_MAX_FFN] = [];
    var down: [f32: QWEN3_FORWARD_MAX_HIDDEN] = [];
    var copy_i: usize = 0;
    while copy_i < hidden_n { hidden[copy_i] = embedding[copy_i]; copy_i = copy_i + 1; }
    var layer: usize = 0;
    while layer < config.layer_count as usize {
        const lw: &Qwen3LayerWeights = &weights.layers[layer];
        qwen3_rms_norm_view(&normed[0], &hidden[0], lw.attn_norm, hidden_n);
        if !qwen3_runtime_matvec_view(runtime, &q[0], lw.q_proj, &normed[0], hidden_n, q_dim) { return false; }
        if !qwen3_runtime_matvec_view(runtime, &k[0], lw.k_proj, &normed[0], hidden_n, kv_dim) { return false; }
        if !qwen3_runtime_matvec_view(runtime, &v[0], lw.v_proj, &normed[0], hidden_n, kv_dim) { return false; }
        if lw.q_norm != null { qwen3_apply_head_norm(&q[0], lw.q_norm, head_count, head_dim); }
        if lw.k_norm != null { qwen3_apply_head_norm(&k[0], lw.k_norm, kv_head_count, head_dim); }
        qwen3_apply_rope(&q[0], head_count, head_dim, pos, rope_freq_base, rope_freq_scale, runtime.rope_cos, runtime.rope_sin);
        qwen3_apply_rope(&k[0], kv_head_count, head_dim, pos, rope_freq_base, rope_freq_scale, runtime.rope_cos, runtime.rope_sin);
        if !qwen3_runtime_attention_view(runtime, &attn_ctx[0], &q[0], &k[0], &v[0], layer, pos, head_count, kv_head_count, head_dim) { return false; }
        if !qwen3_runtime_matvec_view(runtime, &attn_out[0], lw.o_proj, &attn_ctx[0], q_dim, hidden_n) { return false; }
        var i: usize = 0;
        while i < hidden_n { hidden[i] = hidden[i] + attn_out[i]; i = i + 1; }
        qwen3_rms_norm_view(&normed[0], &hidden[0], lw.ffn_norm, hidden_n);
        if !qwen3_runtime_matvec_view(runtime, &gate[0], lw.gate_proj, &normed[0], hidden_n, ffn_n) { return false; }
        if !qwen3_runtime_matvec_view(runtime, &up[0], lw.up_proj, &normed[0], hidden_n, ffn_n) { return false; }
        i = 0;
        while i < ffn_n { fused[i] = silu(gate[i]) * up[i]; i = i + 1; }
        if !qwen3_runtime_matvec_view(runtime, &down[0], lw.down_proj, &fused[0], ffn_n, hidden_n) { return false; }
        i = 0;
        while i < hidden_n { hidden[i] = hidden[i] + down[i]; i = i + 1; }
        layer = layer + 1;
    }
    if hidden_out != null {
        if hidden_out_len < hidden_n {
            _ = printf("error: qwen3 hidden capture buffer too small len=%zu hidden=%zu\n", hidden_out_len, hidden_n);
            return false;
        }
        var hidden_i: usize = 0;
        while hidden_i < hidden_n { hidden_out[hidden_i] = hidden[hidden_i]; hidden_i = hidden_i + 1; }
    }
    if compute_logits {
        qwen3_rms_norm_view(&normed[0], &hidden[0], weights.output_norm, hidden_n);
        if !qwen3_runtime_matvec_view(runtime, logits, weights.output, &normed[0], hidden_n, vocab_n) { return false; }
    }
    return true;
}

fn qwen3_forward_token_runtime(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, token_id: u32, pos: usize, logits: &f32, compute_logits: bool, hidden_out: &f32, hidden_out_len: usize) bool {
    var embedding: [f32: QWEN3_FORWARD_MAX_HIDDEN] = [];
    qwen3_copy_embedding(&embedding[0], weights.token_embedding, token_id, config.hidden_size as usize, config.vocab_size as usize);
    return qwen3_forward_embedding_runtime(config, weights, runtime, &embedding[0] as &const f32, pos, logits, compute_logits, hidden_out, hidden_out_len);
}


export fn qwen3_sampler_init() Qwen3SamplerConfig {
    return Qwen3SamplerConfig{ max_new_tokens: 0, temperature_bits: 0x3f800000, top_k: 1, top_p_bits: 0x3f800000, min_p_bits: 0, repeat_penalty_bits: 0x3f800000, seed: QWEN3_SAMPLER_DEFAULT_SEED, stop_token: 2, stop_on_eos: true, verbose: false, dump_hidden: false, threads: 1, backend: qwen3_backend_default() };
}

fn qwen3_bench_config_init() Qwen3BenchConfig {
    return Qwen3BenchConfig{
        prompt_tokens: QWEN3_BENCH_DEFAULT_PROMPT_TOKENS,
        gen_tokens: QWEN3_BENCH_DEFAULT_GEN_TOKENS,
        repetitions: QWEN3_BENCH_DEFAULT_REPETITIONS,
        threads: 1,
        warmup: true,
        prompt_seed: "hello\0" as &const byte,
        backend: qwen3_backend_default(),
    };
}

fn qwen3_sampler_f32(bits: u32) f32 {
    const ptr: &const f32 = &bits as &const f32;
    return ptr[0];
}

fn qwen3_parse_u32_value(text: &const byte, out: &u32) bool {
    var i: usize = 0;
    var value: u32 = 0;
    if text[0] == 0 { return false; }
    while text[i] != 0 {
        if text[i] < 48 || text[i] > 57 { return false; }
        value = value * 10 + ((text[i] - 48) as u32);
        i = i + 1;
    }
    *out = value;
    return true;
}

fn qwen3_parse_f32_value(text: &const byte, out_bits: &u32) bool {
    var end_ptr: &const byte = null;
    const value: f32 = strtod(text, &end_ptr) as f32;
    if end_ptr == null {
        return false;
    }
    if end_ptr == text || end_ptr[0] != 0 {
        return false;
    }
    const bits_ptr: &const u32 = &value as &const u32;
    *out_bits = bits_ptr[0];
    return true;
}

fn qwen3_xorshift32(state: &u32) u32 {
    var x: u32 = *state;
    x = x ^ (x << 13);
    x = x ^ (x >> 17);
    x = x ^ (x << 5);
    *state = x;
    return x;
}

fn qwen3_random_unit(seed: &u32) f32 {
    const value: u32 = qwen3_xorshift32(seed);
    return ((value as f32) / 4294967295.0) as f32;
}

fn qwen3_apply_repeat_penalty(logits: &f32, vocab: usize, seen: &const u32, seen_count: usize, penalty: f32) void {
    if penalty <= 1.0 { return; }
    var i: usize = 0;
    while i < seen_count {
        const token: usize = seen[i] as usize;
        if token < vocab {
            if logits[token] > 0.0 { logits[token] = logits[token] / penalty; }
            if logits[token] < 0.0 { logits[token] = logits[token] * penalty; }
        }
        i = i + 1;
    }
}

fn qwen3_sample(logits: &f32, vocab: usize, seen: &const u32, seen_count: usize, sampler: &Qwen3SamplerConfig, seed: &u32) u32 {
    const temp: f32 = qwen3_sampler_f32(sampler.temperature_bits);
    const top_p: f32 = qwen3_sampler_f32(sampler.top_p_bits);
    const min_p: f32 = qwen3_sampler_f32(sampler.min_p_bits);
    const repeat_penalty: f32 = qwen3_sampler_f32(sampler.repeat_penalty_bits);
    if temp <= 0.000001 || sampler.top_k <= 1 || vocab > 256 { return qwen3_argmax_penalized(logits as &const f32, vocab, seen, seen_count, repeat_penalty); }
    var local: [f32: 256] = [];
    var probs: [f32: 256] = [];
    var order: [u32: 256] = [];
    var i: usize = 0;
    while i < vocab {
        local[i] = logits[i];
        order[i] = i as u32;
        i = i + 1;
    }
    qwen3_apply_repeat_penalty(&local[0], vocab, seen, seen_count, repeat_penalty);
    if temp <= 0.000001 || sampler.top_k <= 1 { return qwen3_argmax(&local[0], vocab); }
    i = 0;
    while i < vocab {
        local[i] = local[i] / temp;
        i = i + 1;
    }
    softmax(&probs[0], &local[0], vocab);
    var a: usize = 0;
    while a < vocab {
        var b: usize = a + 1;
        while b < vocab {
            if probs[b] > probs[a] {
                const tp: f32 = probs[a]; probs[a] = probs[b]; probs[b] = tp;
                const ti: u32 = order[a]; order[a] = order[b]; order[b] = ti;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    var limit: usize = vocab;
    if sampler.top_k > 0 && sampler.top_k < limit as u32 { limit = sampler.top_k as usize; }
    var cumulative: f32 = 0.0;
    var kept: usize = 0;
    while kept < limit {
        if kept >= vocab || kept >= 256 { break; }
        cumulative = cumulative + probs[kept];
        kept = kept + 1;
        if cumulative >= top_p && top_p < 0.999999 { break; }
    }
    var max_prob: f32 = probs[0];
    if min_p > 0.0 {
        while kept > 1 {
            const tail: usize = kept - 1;
            if tail >= 256 || probs[tail] >= (max_prob * min_p) { break; }
            kept = kept - 1;
        }
    }
    var norm: f32 = 0.0;
    i = 0;
    while i < kept { norm = norm + probs[i]; i = i + 1; }
    const r: f32 = qwen3_random_unit(seed);
    var acc: f32 = 0.0;
    i = 0;
    while i < kept {
        acc = acc + probs[i] / norm;
        if r <= acc || i + 1 == kept { return order[i]; }
        i = i + 1;
    }
    return order[0];
}

fn qwen3_parse_sampler_args(argc: i32, argv: & &byte, start_index: i32, sampler: &Qwen3SamplerConfig) bool {
    var i: i32 = start_index;
    while i < argc {
        if strcmp(argv[i] as *const byte, "--max-new-tokens\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.max_new_tokens) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--temperature\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_f32_value(argv[i + 1] as &const byte, &sampler.temperature_bits) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--top-k\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.top_k) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--top-p\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_f32_value(argv[i + 1] as &const byte, &sampler.top_p_bits) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--min-p\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_f32_value(argv[i + 1] as &const byte, &sampler.min_p_bits) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--repeat-penalty\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_f32_value(argv[i + 1] as &const byte, &sampler.repeat_penalty_bits) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--seed\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.seed) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--stop-token\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.stop_token) { return false; }
            sampler.stop_on_eos = false;
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--verbose\0" as *const byte) == 0 {
            sampler.verbose = true;
            i = i + 1; continue;
        }
        if strcmp(argv[i] as *const byte, "--dump-hidden\0" as *const byte) == 0 {
            sampler.dump_hidden = true;
            i = i + 1; continue;
        }
        if strcmp(argv[i] as *const byte, "--threads\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &sampler.threads) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--backend\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_backend_value(argv[i + 1] as &const byte, &sampler.backend) { return false; }
            i = i + 2; continue;
        }
        return false;
    }
    return true;
}

fn qwen3_parse_bench_args(argc: i32, argv: & &byte, start_index: i32, bench: &Qwen3BenchConfig) bool {
    var i: i32 = start_index;
    while i < argc {
        if strcmp(argv[i] as *const byte, "-p\0" as *const byte) == 0 || strcmp(argv[i] as *const byte, "--n-prompt\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &bench.prompt_tokens) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "-n\0" as *const byte) == 0 || strcmp(argv[i] as *const byte, "--n-gen\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &bench.gen_tokens) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "-r\0" as *const byte) == 0 || strcmp(argv[i] as *const byte, "--repetitions\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &bench.repetitions) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "-t\0" as *const byte) == 0 || strcmp(argv[i] as *const byte, "--threads\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_u32_value(argv[i + 1] as &const byte, &bench.threads) { return false; }
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--prompt\0" as *const byte) == 0 {
            if i + 1 >= argc { return false; }
            bench.prompt_seed = argv[i + 1] as &const byte;
            i = i + 2; continue;
        }
        if strcmp(argv[i] as *const byte, "--no-warmup\0" as *const byte) == 0 {
            bench.warmup = false;
            i = i + 1; continue;
        }
        if strcmp(argv[i] as *const byte, "--backend\0" as *const byte) == 0 {
            if i + 1 >= argc || !qwen3_parse_backend_value(argv[i + 1] as &const byte, &bench.backend) { return false; }
            i = i + 2; continue;
        }
        return false;
    }
    return true;
}

export fn qwen3_runtime_init() Qwen3Runtime {
    return Qwen3Runtime{ k_cache: null, v_cache: null, rope_cos: null, rope_sin: null, prompt_ids: null, last_hidden: null, context_capacity: 0, rope_half_dim: 0, last_hidden_len: 0, last_hidden_valid: false, prompt_count: 0, total_tokens: 0, seed: QWEN3_SAMPLER_DEFAULT_SEED, device: qwen3_device_init(), gpu: gpu_context_init() };
}

fn qwen3_runtime_context_capacity(config: &Qwen3Config) usize {
    var cap: usize = config.context_length as usize;
    if cap > QWEN3_FORWARD_MAX_CONTEXT { cap = QWEN3_FORWARD_MAX_CONTEXT; }
    return cap;
}

fn qwen3_runtime_gpu_upload_matvec_tensor(runtime: &Qwen3Runtime, view: &TensorView) bool {
    if !gpu_context_upload_tensor(&runtime.gpu, view) {
        _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
        return false;
    }
    return true;
}

fn qwen3_runtime_gpu_upload_weights(weights: &Qwen3Weights, runtime: &Qwen3Runtime) bool {
    if runtime.device.backend != BackendKind.Cuda { return true; }
    if !gpu_context_upload_tensor(&runtime.gpu, weights.output_norm) {
        _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
        return false;
    }
    if !qwen3_runtime_gpu_upload_matvec_tensor(runtime, weights.output) { return false; }
    var layer: u32 = 0;
    while layer < weights.layer_count {
        const lw: &Qwen3LayerWeights = &weights.layers[layer as usize];
        if !gpu_context_upload_tensor(&runtime.gpu, lw.attn_norm) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !qwen3_runtime_gpu_upload_matvec_tensor(runtime, lw.q_proj) { return false; }
        if !qwen3_runtime_gpu_upload_matvec_tensor(runtime, lw.k_proj) { return false; }
        if !qwen3_runtime_gpu_upload_matvec_tensor(runtime, lw.v_proj) { return false; }
        if !qwen3_runtime_gpu_upload_matvec_tensor(runtime, lw.o_proj) { return false; }
        if lw.q_norm != null && !gpu_context_upload_tensor(&runtime.gpu, lw.q_norm) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if lw.k_norm != null && !gpu_context_upload_tensor(&runtime.gpu, lw.k_norm) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !gpu_context_upload_tensor(&runtime.gpu, lw.ffn_norm) { _ = printf("%s\n", gpu_context_last_error(&runtime.gpu)); return false; }
        if !qwen3_runtime_gpu_upload_matvec_tensor(runtime, lw.gate_proj) { return false; }
        if !qwen3_runtime_gpu_upload_matvec_tensor(runtime, lw.up_proj) { return false; }
        if !qwen3_runtime_gpu_upload_matvec_tensor(runtime, lw.down_proj) { return false; }
        layer = layer + 1;
    }
    gpu_context_refresh_stats(&runtime.gpu);
    return true;
}

fn qwen3_runtime_backend_open(weights: &Qwen3Weights, runtime: &Qwen3Runtime) bool {
    if runtime.device.backend != BackendKind.Cuda { return true; }
    if runtime.device.index != 0 {
        _ = printf("error: backend=cuda first version only supports device.index=0 requested=%u\n", runtime.device.index);
        return false;
    }
    if !qwen3_validate_cuda_runtime_dtypes(weights) { return false; }
    if !gpu_context_open(runtime.device.index, &runtime.gpu) {
        _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
        return false;
    }
    if !gpu_context_smoke(&runtime.gpu) {
        _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
        gpu_context_close(&runtime.gpu);
        return false;
    }
    return true;
}

fn qwen3_runtime_alloc(config: &Qwen3Config, runtime: &Qwen3Runtime) bool {
    const kv_dim: usize = (config.kv_head_count * config.head_dim) as usize;
    const context_capacity: usize = qwen3_runtime_context_capacity(config);
    const cache_count: usize = (config.layer_count as usize) * context_capacity * kv_dim;
    const use_device_kv: bool = runtime.device.backend == BackendKind.Cuda && (qwen3_cuda_attention_enabled() || qwen3_cuda_device_forward_enabled());
    if use_device_kv {
        runtime.k_cache = null;
        runtime.v_cache = null;
    } else {
        runtime.k_cache = calloc(cache_count, 4) as &f32;
        runtime.v_cache = calloc(cache_count, 4) as &f32;
    }
    runtime.prompt_ids = calloc(context_capacity, 4) as &u32;
    runtime.last_hidden = calloc(config.hidden_size as usize, 4) as &f32;
    if (!use_device_kv && (runtime.k_cache == null || runtime.v_cache == null)) || runtime.prompt_ids == null || runtime.last_hidden == null {
        _ = printf("error: qwen3 runtime allocation failed cache_floats=%zu runtime_context=%zu kv_dim=%zu hidden=%u\n", cache_count, context_capacity, kv_dim, config.hidden_size);
        free(runtime.k_cache as &void); free(runtime.v_cache as &void); free(runtime.prompt_ids as &void); free(runtime.last_hidden as &void);
        runtime.k_cache = null;
        runtime.v_cache = null;
        runtime.prompt_ids = null;
        runtime.last_hidden = null;
        return false;
    }
    runtime.context_capacity = context_capacity;
    runtime.last_hidden_len = config.hidden_size as usize;
    runtime.last_hidden_valid = false;
    if !qwen3_precompute_rope(config, runtime) {
        free(runtime.k_cache as &void); free(runtime.v_cache as &void); free(runtime.prompt_ids as &void); free(runtime.last_hidden as &void);
        runtime.k_cache = null;
        runtime.v_cache = null;
        runtime.prompt_ids = null;
        runtime.last_hidden = null;
        return false;
    }
    if use_device_kv && !gpu_context_prepare_attention(&runtime.gpu, config.layer_count as usize, context_capacity, kv_dim) {
        _ = printf("%s\n", gpu_context_last_error(&runtime.gpu));
        free(runtime.prompt_ids as &void); free(runtime.last_hidden as &void);
        free(runtime.rope_cos as &void); free(runtime.rope_sin as &void);
        runtime.prompt_ids = null;
        runtime.last_hidden = null;
        runtime.rope_cos = null;
        runtime.rope_sin = null;
        return false;
    }
    runtime.prompt_count = 0;
    runtime.total_tokens = 0;
    runtime.seed = QWEN3_SAMPLER_DEFAULT_SEED;
    return true;
}

fn qwen3_runtime_free(runtime: &Qwen3Runtime) void {
    if runtime.k_cache != null { free(runtime.k_cache as &void); }
    if runtime.v_cache != null { free(runtime.v_cache as &void); }
    if runtime.rope_cos != null { free(runtime.rope_cos as &void); }
    if runtime.rope_sin != null { free(runtime.rope_sin as &void); }
    if runtime.prompt_ids != null { free(runtime.prompt_ids as &void); }
    if runtime.last_hidden != null { free(runtime.last_hidden as &void); }
    gpu_context_close(&runtime.gpu);
    runtime[0] = qwen3_runtime_init();
}

export fn qwen3_close_runtime(table: &TensorWeightTable, tok: &Tokenizer, runtime: &Qwen3Runtime) void {
    qwen3_runtime_free(runtime);
    tokenizer_free(tok);
    tensor_weight_table_detach_mmap(table);
}

fn qwen3_bench_clock_micros() u64 {
    return (clock() as u64) * (1000000 as u64) / (CLOCKS_PER_SEC as u64);
}

fn qwen3_bench_elapsed_micros(start: u64, end: u64) u64 {
    if end < start { return 0; }
    return end - start;
}

fn qwen3_bench_rate_x1000(units: u64, micros: u64) u64 {
    if micros == 0 { return 0; }
    return (units * (1000000000 as u64)) / micros;
}

fn qwen3_bench_print_rate(label: &const byte, units: u64, micros: u64, unit_name: &const byte, repetitions: u32) void {
    const scaled: u64 = qwen3_bench_rate_x1000(units, micros);
    const whole_ms: u64 = micros / (1000 as u64);
    const frac_ms: u64 = micros % (1000 as u64);
    _ = printf("bench %s: %llu.%03llu %s/s units=%llu ms=%llu.%03llu repetitions=%u\n", label, scaled / (1000 as u64), scaled % (1000 as u64), unit_name, units, whole_ms, frac_ms, repetitions);
}

fn qwen3_bench_print_duration(label: &const byte, micros: u64, repetitions: u32) void {
    var avg: u64 = 0;
    if repetitions != 0 {
        avg = micros / (repetitions as u64);
    }
    _ = printf("bench %s: ms=%llu.%03llu avg_ms=%llu.%03llu repetitions=%u\n", label, micros / (1000 as u64), micros % (1000 as u64), avg / (1000 as u64), avg % (1000 as u64), repetitions);
}

fn qwen3_bench_print_micros(label: &const byte, micros: u64, repetitions: u32) void {
    var avg: u64 = 0;
    if repetitions != 0 {
        avg = micros / (repetitions as u64);
    }
    _ = printf("bench %s: us=%llu avg_us=%llu repetitions=%u\n", label, micros, avg, repetitions);
}

fn qwen3_bench_make_prompt_ids(seed_ids: &const u32, seed_count: usize, prompt_ids: &u32, prompt_count: usize) bool {
    if seed_count == 0 || prompt_count == 0 { return false; }
    var i: usize = 0;
    while i < prompt_count {
        prompt_ids[i] = seed_ids[i % seed_count];
        i = i + 1;
    }
    return true;
}

fn qwen3_bench_decode_tokens(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, logits: &f32, seed_ids: &const u32, seed_count: usize, gen_count: usize, first_token_us: &u64) bool {
    first_token_us[0] = 0;
    if gen_count == 0 { return true; }
    if seed_count == 0 { return false; }
    if runtime.total_tokens + gen_count > config.context_length as usize || runtime.total_tokens + gen_count > runtime.context_capacity {
        _ = printf("error: bench decode exceeds context total_tokens=%zu add_tokens=%zu runtime_context=%zu model_context=%u\n", runtime.total_tokens, gen_count, runtime.context_capacity, config.context_length);
        return false;
    }
    var i: usize = 0;
    while i < gen_count {
        const next_id: u32 = seed_ids[i % seed_count];
        runtime.prompt_ids[runtime.total_tokens] = next_id;
        runtime.total_tokens = runtime.total_tokens + 1;
        var token_start_us: u64 = 0;
        if i == 0 { token_start_us = qwen3_bench_clock_micros(); }
        if !qwen3_forward_token_runtime(config, weights, runtime, next_id, runtime.total_tokens - 1, logits, true, null as &f32, 0) { return false; }
        if i == 0 { first_token_us[0] = qwen3_bench_elapsed_micros(token_start_us, qwen3_bench_clock_micros()); }
        i = i + 1;
    }
    return true;
}

fn qwen3_alloc_logits() &f32 {
    var logits: &f32 = calloc(QWEN3_FORWARD_MAX_VOCAB, 4) as &f32;
    if logits == null {
        _ = printf("error: qwen3 logits allocation failed vocab_cap=%zu\n", QWEN3_FORWARD_MAX_VOCAB);
    }
    return logits;
}

fn qwen3_bench_warmup(model_path: &const byte, bench: &Qwen3BenchConfig) bool {
    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    runtime.device.backend = bench.backend;
    var logits: &f32 = qwen3_alloc_logits();
    if logits == null { return false; }
    var seed_ids: [u32: QWEN3_BENCH_SEED_CAP] = [];
    var seed_count: usize = 0;
    if !qwen3_open_runtime(model_path, &config, &table, &weights, &tok, &runtime) { return false; }
    if !tokenizer_encode_to_ids(&tok, bench.prompt_seed, &seed_ids[0], @len(seed_ids), &seed_count) || seed_count == 0 {
        _ = printf("error: bench warmup failed to encode prompt seed: %s\n", bench.prompt_seed);
        qwen3_close_runtime(&table, &tok, &runtime);
        return false;
    }
    var prompt_ids: &u32 = calloc(bench.prompt_tokens as usize, 4) as &u32;
    if prompt_ids == null {
        _ = printf("error: bench warmup prompt allocation failed tokens=%u\n", bench.prompt_tokens);
        qwen3_close_runtime(&table, &tok, &runtime);
        return false;
    }
    const total_tokens: usize = (bench.prompt_tokens + bench.gen_tokens) as usize;
    if total_tokens > runtime.context_capacity || total_tokens > config.context_length as usize {
        _ = printf("error: bench warmup exceeds context prompt=%u gen=%u runtime_context=%zu model_context=%u\n", bench.prompt_tokens, bench.gen_tokens, runtime.context_capacity, config.context_length);
        free(prompt_ids as &void);
        qwen3_close_runtime(&table, &tok, &runtime);
        return false;
    }
    if !qwen3_bench_make_prompt_ids(&seed_ids[0], seed_count, prompt_ids, bench.prompt_tokens as usize) {
        free(prompt_ids as &void);
        qwen3_close_runtime(&table, &tok, &runtime);
        return false;
    }
    var ignored_first_token_us: u64 = 0;
    const ok: bool = qwen3_append_prompt_ids(&config, &weights, &runtime, prompt_ids as &const u32, bench.prompt_tokens as usize, logits) && qwen3_bench_decode_tokens(&config, &weights, &runtime, logits, &seed_ids[0], seed_count, bench.gen_tokens as usize, &ignored_first_token_us);
    free(prompt_ids as &void);
    qwen3_close_runtime(&table, &tok, &runtime);
    free(logits as &void);
    return ok;
}

export fn qwen3_append_prompt_ids(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, ids: &const u32, id_count: usize, logits: &f32) bool {
    if id_count == 0 {
        _ = printf("error: empty prompt\n");
        return false;
    }
    if runtime.total_tokens + id_count > config.context_length as usize || runtime.total_tokens + id_count > runtime.context_capacity {
        _ = printf("error: context overflow total_tokens=%zu add_tokens=%zu runtime_context=%zu model_context=%u\n", runtime.total_tokens, id_count, runtime.context_capacity, config.context_length);
        return false;
    }
    var i: usize = 0;
    while i < id_count {
        const pos: usize = runtime.total_tokens;
        runtime.prompt_ids[pos] = ids[i];
        const compute_logits: bool = (i + (1 as usize)) == id_count;
        if !qwen3_forward_token_runtime(config, weights, runtime, ids[i], pos, logits, compute_logits, runtime.last_hidden, runtime.last_hidden_len) { return false; }
        runtime.last_hidden_valid = true;
        runtime.total_tokens = runtime.total_tokens + 1;
        i = i + 1;
    }
    runtime.prompt_count = runtime.total_tokens;
    return true;
}

export fn qwen3_append_prompt_text(config: &Qwen3Config, weights: &Qwen3Weights, tok: &Tokenizer, runtime: &Qwen3Runtime, prompt: &const byte, logits: &f32) bool {
    var ids: [u32: QWEN3_FORWARD_MAX_PROMPT] = [];
    var id_count: usize = 0;
    if !tokenizer_encode_to_ids(tok, prompt, &ids[0], QWEN3_FORWARD_MAX_PROMPT, &id_count) {
        return false;
    }
    return qwen3_append_prompt_ids(config, weights, runtime, &ids[0], id_count, logits);
}

fn qwen3_capture_append(dest: &byte, dest_cap: usize, pos: &usize, text: &const byte) bool {
    var i: usize = 0;
    while text[i] != 0 {
        if *pos + 1 >= dest_cap {
            if dest_cap > 0 { dest[dest_cap - 1] = 0; }
            return false;
        }
        dest[*pos] = text[i];
        *pos = *pos + 1;
        i = i + 1;
    }
    if dest_cap > 0 {
        dest[*pos] = 0;
    }
    return true;
}

export fn qwen3_append_prompt_embeddings(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, placeholder_id: u32, embeddings: &const f32, span_count: usize, logits: &f32) bool {
    if span_count == 0 {
        return true;
    }
    if runtime.total_tokens + span_count > config.context_length as usize || runtime.total_tokens + span_count > runtime.context_capacity {
        _ = printf("error: context overflow total_tokens=%zu add_embeddings=%zu runtime_context=%zu model_context=%u\n", runtime.total_tokens, span_count, runtime.context_capacity, config.context_length);
        return false;
    }
    const hidden_n: usize = config.hidden_size as usize;
    var i: usize = 0;
    while i < span_count {
        const pos: usize = runtime.total_tokens;
        runtime.prompt_ids[pos] = placeholder_id;
        const compute_logits: bool = (i + (1 as usize)) == span_count;
        if !qwen3_forward_embedding_runtime(config, weights, runtime, &embeddings[i * hidden_n] as &const f32, pos, logits, compute_logits, runtime.last_hidden, runtime.last_hidden_len) {
            return false;
        }
        runtime.last_hidden_valid = true;
        runtime.total_tokens = runtime.total_tokens + 1;
        i = i + 1;
    }
    runtime.prompt_count = runtime.total_tokens;
    return true;
}

export fn qwen3_generate_capture_timed(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, sampler: &Qwen3SamplerConfig, tok: &Tokenizer, logits: &f32, text_label: &const byte, preserve_final_cache: bool, capture: &byte, capture_cap: usize, capture_len: &usize, first_token_us: &u64) i32 {
    capture_len[0] = 0;
    first_token_us[0] = 0;
    var print_label: bool = false;
    if text_label != null && text_label[0] != 0 { print_label = true; }
    if capture_cap > 0 {
        capture[0] = 0;
    }
    if sampler.dump_hidden && runtime.last_hidden_valid && runtime.total_tokens > 0 {
        qwen3_print_hidden_summary("prompt hidden\0" as &const byte, runtime.total_tokens - (1 as usize), runtime.prompt_ids[runtime.total_tokens - (1 as usize)], runtime.last_hidden as &const f32, runtime.last_hidden_len);
    }
    var generated: usize = 0;
    var render_state: Qwen3TextRenderState = qwen3_text_render_state_init();
    if sampler.verbose {
        _ = printf("threads: %zu\n", qwen3_thread_count);
    }
    if print_label {
        _ = printf("%s: ", text_label);
        _ = fflush(stdout);
    }
    const generate_start_us: u64 = qwen3_bench_clock_micros();
    while sampler.max_new_tokens == 0 || generated < sampler.max_new_tokens as usize {
        if runtime.total_tokens >= config.context_length as usize || runtime.total_tokens >= runtime.context_capacity {
            if !print_label { qwen3_text_render_flush(&render_state); }
            _ = printf("\n");
            if print_label || sampler.verbose {
                _ = printf("stop: context_limit=%zu model_context=%u total_tokens=%zu\n", runtime.context_capacity, config.context_length, runtime.total_tokens);
            }
            return 0;
        }
        const next_id: u32 = qwen3_sample(logits, config.vocab_size as usize, runtime.prompt_ids, runtime.total_tokens, sampler, &runtime.seed);
        if sampler.verbose {
            _ = printf("sampled token[%zu]: %u piece=%s\n", generated, next_id, tokenizer_piece(tok, next_id));
        }
        if next_id == sampler.stop_token {
            if !print_label { qwen3_text_render_flush(&render_state); }
            _ = printf("\n");
            if print_label || sampler.verbose {
                _ = printf("stop: token=%u\n", next_id);
            }
            return 0;
        }
        var piece_text: [byte: QWEN3_GENERATED_TEXT_CAP] = [];
        var piece_text_pos: usize = 0;
        if !tokenizer_append_piece_text(tok, next_id, &piece_text[0], QWEN3_GENERATED_TEXT_CAP, &piece_text_pos) {
            _ = printf("error: generated text exceeds buffer cap=%zu\n", QWEN3_GENERATED_TEXT_CAP);
            return 1;
        }
        if capture_cap > 0 && !qwen3_capture_append(capture, capture_cap, capture_len, &piece_text[0] as &const byte) {
            _ = printf("error: generated capture exceeds buffer cap=%zu\n", capture_cap);
            return 1;
        }
        if generated == 0 { first_token_us[0] = qwen3_bench_elapsed_micros(generate_start_us, qwen3_bench_clock_micros()); }
        if print_label {
            _ = printf("%s", &piece_text[0]);
        } else {
            qwen3_text_render_piece(&render_state, &piece_text[0] as &const byte);
        }
        _ = fflush(stdout);
        runtime.prompt_ids[runtime.total_tokens] = next_id;
        runtime.total_tokens = runtime.total_tokens + 1;
        const will_stop_after_token: bool = sampler.max_new_tokens != 0 && (generated + (1 as usize)) >= sampler.max_new_tokens as usize;
        const should_forward_generated: bool = preserve_final_cache || sampler.dump_hidden || !will_stop_after_token;
        if should_forward_generated {
            const compute_next_logits: bool = !will_stop_after_token;
            if !qwen3_forward_token_runtime(config, weights, runtime, next_id, runtime.total_tokens - 1, logits, compute_next_logits, runtime.last_hidden, runtime.last_hidden_len) { return 1; }
            runtime.last_hidden_valid = true;
            if sampler.dump_hidden {
                _ = printf("\n");
                qwen3_print_hidden_summary("generated hidden\0" as &const byte, generated, next_id, runtime.last_hidden as &const f32, runtime.last_hidden_len);
            }
        }
        generated = generated + 1;
    }
    if !print_label { qwen3_text_render_flush(&render_state); }
    _ = printf("\n");
    if sampler.max_new_tokens != 0 && (print_label || sampler.verbose) {
        _ = printf("stop: max_new_tokens=%u\n", sampler.max_new_tokens);
    }
    return 0;
}

export fn qwen3_generate_capture(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, sampler: &Qwen3SamplerConfig, tok: &Tokenizer, logits: &f32, text_label: &const byte, preserve_final_cache: bool, capture: &byte, capture_cap: usize, capture_len: &usize) i32 {
    var ignored_first_token_us: u64 = 0;
    return qwen3_generate_capture_timed(config, weights, runtime, sampler, tok, logits, text_label, preserve_final_cache, capture, capture_cap, capture_len, &ignored_first_token_us);
}

export fn qwen3_generate_capture_hidden(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, sampler: &Qwen3SamplerConfig, tok: &Tokenizer, logits: &f32, text_label: &const byte, capture: &byte, capture_cap: usize, capture_len: &usize, out_ids: &u32, out_id_cap: usize, out_hidden: &f32, out_hidden_cap_tokens: usize, out_generated: &usize) i32 {
    capture_len[0] = 0;
    out_generated[0] = 0;
    if capture_cap > 0 {
        capture[0] = 0;
    }
    if sampler.dump_hidden && runtime.last_hidden_valid && runtime.total_tokens > 0 {
        qwen3_print_hidden_summary("prompt hidden\0" as &const byte, runtime.total_tokens - (1 as usize), runtime.prompt_ids[runtime.total_tokens - (1 as usize)], runtime.last_hidden as &const f32, runtime.last_hidden_len);
    }
    var generated: usize = 0;
    const hidden_n: usize = config.hidden_size as usize;
    if sampler.verbose {
        _ = printf("threads: %zu\n", qwen3_thread_count);
    }
    _ = printf("%s: ", text_label);
    _ = fflush(stdout);
    while sampler.max_new_tokens == 0 || generated < sampler.max_new_tokens as usize {
        if runtime.total_tokens >= config.context_length as usize || runtime.total_tokens >= runtime.context_capacity {
            _ = printf("\n");
            _ = printf("stop: context_limit=%zu model_context=%u total_tokens=%zu\n", runtime.context_capacity, config.context_length, runtime.total_tokens);
            out_generated[0] = generated;
            return 0;
        }
        if generated >= out_id_cap || generated >= out_hidden_cap_tokens {
            _ = printf("\n");
            _ = printf("error: generated hidden capture exceeds cap ids=%zu hidden_tokens=%zu generated=%zu\n", out_id_cap, out_hidden_cap_tokens, generated);
            return 1;
        }
        const next_id: u32 = qwen3_sample(logits, config.vocab_size as usize, runtime.prompt_ids, runtime.total_tokens, sampler, &runtime.seed);
        if sampler.verbose {
            _ = printf("sampled token[%zu]: %u piece=%s\n", generated, next_id, tokenizer_piece(tok, next_id));
        }
        if next_id == sampler.stop_token {
            _ = printf("\n");
            _ = printf("stop: token=%u\n", next_id);
            out_generated[0] = generated;
            return 0;
        }
        var piece_text: [byte: QWEN3_GENERATED_TEXT_CAP] = [];
        var piece_text_pos: usize = 0;
        if !tokenizer_append_piece_text(tok, next_id, &piece_text[0], QWEN3_GENERATED_TEXT_CAP, &piece_text_pos) {
            _ = printf("error: generated text exceeds buffer cap=%zu\n", QWEN3_GENERATED_TEXT_CAP);
            return 1;
        }
        if capture_cap > 0 && !qwen3_capture_append(capture, capture_cap, capture_len, &piece_text[0] as &const byte) {
            _ = printf("error: generated capture exceeds buffer cap=%zu\n", capture_cap);
            return 1;
        }
        _ = printf("%s", &piece_text[0]);
        _ = fflush(stdout);
        runtime.prompt_ids[runtime.total_tokens] = next_id;
        runtime.total_tokens = runtime.total_tokens + 1;
        const will_stop_after_token: bool = sampler.max_new_tokens != 0 && (generated + (1 as usize)) >= sampler.max_new_tokens as usize;
        const compute_next_logits: bool = !will_stop_after_token;
        if !qwen3_forward_token_runtime(config, weights, runtime, next_id, runtime.total_tokens - 1, logits, compute_next_logits, runtime.last_hidden, runtime.last_hidden_len) { return 1; }
        runtime.last_hidden_valid = true;
        out_ids[generated] = next_id;
        var hidden_i: usize = 0;
        while hidden_i < hidden_n {
            out_hidden[generated * hidden_n + hidden_i] = runtime.last_hidden[hidden_i];
            hidden_i = hidden_i + 1;
        }
        if sampler.dump_hidden {
            _ = printf("\n");
            qwen3_print_hidden_summary("generated hidden\0" as &const byte, generated, next_id, runtime.last_hidden as &const f32, runtime.last_hidden_len);
        }
        generated = generated + 1;
    }
    _ = printf("\n");
    if sampler.max_new_tokens != 0 {
        _ = printf("stop: max_new_tokens=%u\n", sampler.max_new_tokens);
    }
    out_generated[0] = generated;
    return 0;
}

fn qwen3_generate_tokens(config: &Qwen3Config, weights: &Qwen3Weights, runtime: &Qwen3Runtime, sampler: &Qwen3SamplerConfig, tok: &Tokenizer, logits: &f32, text_label: &const byte, preserve_final_cache: bool) i32 {
    var ignored_capture: [byte: 1] = [];
    var ignored_len: usize = 0;
    return qwen3_generate_capture(config, weights, runtime, sampler, tok, logits, text_label, preserve_final_cache, &ignored_capture[0], 0, &ignored_len);
}

export fn qwen3_open_runtime(path: &const byte, config: &Qwen3Config, table: &TensorWeightTable, weights: &Qwen3Weights, tok: &Tokenizer, runtime: &Qwen3Runtime) bool {
    const requested_device: Qwen3Device = runtime.device;
    if !qwen3_backend_supported(runtime.device.backend) { return false; }
    if !qwen3_config_load_metadata(path, config) { return false; }
    table[0] = tensor_table_init();
    if !tensor_weight_table_load(path, table) { return false; }
    if !qwen3_complete_config_from_tensors(config, table) { return false; }
    if !qwen3_check_forward_caps(config) { return false; }
    if !tensor_weight_table_attach_mmap(path, table) { return false; }
    weights[0] = qwen3_weights_init();
    if !qwen3_bind_weights(table, config, weights) { tensor_weight_table_detach_mmap(table); return false; }
    if requested_device.backend == BackendKind.Cpu && !qwen3_validate_runtime_matvec_dtypes(weights) { tensor_weight_table_detach_mmap(table); return false; }
    tok[0] = tokenizer_init();
    if !tokenizer_load(path, tok) { tensor_weight_table_detach_mmap(table); return false; }
    runtime[0] = qwen3_runtime_init();
    runtime.device = requested_device;
    if !qwen3_runtime_backend_open(weights, runtime) {
        tokenizer_free(tok);
        tensor_weight_table_detach_mmap(table);
        runtime[0] = qwen3_runtime_init();
        return false;
    }
    if !qwen3_runtime_alloc(config, runtime) {
        qwen3_runtime_free(runtime);
        tokenizer_free(tok);
        tensor_weight_table_detach_mmap(table);
        return false;
    }
    if !qwen3_runtime_gpu_upload_weights(weights, runtime) {
        qwen3_runtime_free(runtime);
        tokenizer_free(tok);
        tensor_weight_table_detach_mmap(table);
        return false;
    }
    return true;
}

fn qwen3_prepare_runtime(path: &const byte, prompt: &const byte, config: &Qwen3Config, table: &TensorWeightTable, weights: &Qwen3Weights, tok: &Tokenizer, runtime: &Qwen3Runtime, logits: &f32) bool {
    if !qwen3_open_runtime(path, config, table, weights, tok, runtime) { return false; }
    if !qwen3_append_prompt_text(config, weights, tok, runtime, prompt, logits) {
        qwen3_close_runtime(table, tok, runtime);
        return false;
    }
    return true;
}

export fn qwen3_bench_args_cli(argc: i32, argv: & &byte) i32 {
    if argc < 3 {
        _ = printf("usage: minicpm-o-uya bench <model.gguf> [--prompt TEXT] [--n-prompt N] [--n-gen N] [--repetitions N] [--threads N] [--no-warmup] [--backend cpu|cuda]\n");
        return 1;
    }
    var bench: Qwen3BenchConfig = qwen3_bench_config_init();
    if !qwen3_parse_bench_args(argc, argv, 3, &bench) {
        _ = printf("usage: minicpm-o-uya bench <model.gguf> [--prompt TEXT] [--n-prompt N] [--n-gen N] [--repetitions N] [--threads N] [--no-warmup] [--backend cpu|cuda]\n");
        return 1;
    }
    if bench.prompt_tokens == 0 {
        _ = printf("error: bench requires --n-prompt >= 1\n");
        return 1;
    }
    if bench.repetitions == 0 {
        _ = printf("error: bench requires --repetitions >= 1\n");
        return 1;
    }
    qwen3_set_thread_count(bench.threads);
    if !qwen3_backend_supported(bench.backend) { return 1; }
    if bench.warmup && !qwen3_bench_warmup(argv[2] as &const byte, &bench) {
        return 1;
    }

    var load_micros: u64 = 0;
    var prompt_micros: u64 = 0;
    var decode_micros: u64 = 0;
    var first_token_micros: u64 = 0;
    var backend_init_micros: u64 = 0;
    var host_to_device_bytes: u64 = 0;
    var device_to_host_bytes: u64 = 0;
    var weight_upload_bytes: u64 = 0;
    var scratch_x_bytes_peak: u64 = 0;
    var scratch_y_bytes_peak: u64 = 0;
    var uploaded_weight_count: u64 = 0;
    var native_quant_matvec_count: u64 = 0;
    var staged_quant_matvec_count: u64 = 0;
    var q8_1_x_bytes: u64 = 0;
    var attention_kernel_calls: u64 = 0;
    var kv_device_bytes: u64 = 0;
    var kv_host_to_device_bytes: u64 = 0;
    var prompt_units: u64 = 0;
    var decode_units: u64 = 0;
    var summary_config: Qwen3Config = qwen3_config_init();
    var summary_file_size: u64 = 0;
    var seed_ids: [u32: QWEN3_BENCH_SEED_CAP] = [];
    var seed_count: usize = 0;

    var rep: u32 = 0;
    while rep < bench.repetitions {
        var config: Qwen3Config = qwen3_config_init();
        var table: TensorWeightTable = tensor_table_init();
        var weights: Qwen3Weights = qwen3_weights_init();
        var tok: Tokenizer = tokenizer_init();
        var runtime: Qwen3Runtime = qwen3_runtime_init();
        runtime.device.backend = bench.backend;
        const start: u64 = qwen3_bench_clock_micros();
        if !qwen3_open_runtime(argv[2] as &const byte, &config, &table, &weights, &tok, &runtime) { return 1; }
        load_micros = load_micros + qwen3_bench_elapsed_micros(start, qwen3_bench_clock_micros());
        if rep == 0 {
            qwen3_config_copy(&summary_config, &config);
            summary_file_size = table.file_size;
            if !tokenizer_encode_to_ids(&tok, bench.prompt_seed, &seed_ids[0], @len(seed_ids), &seed_count) || seed_count == 0 {
                _ = printf("error: bench failed to encode prompt seed: %s\n", bench.prompt_seed);
                qwen3_close_runtime(&table, &tok, &runtime);
                return 1;
            }
            const total_tokens: usize = (bench.prompt_tokens + bench.gen_tokens) as usize;
            if total_tokens > runtime.context_capacity || total_tokens > config.context_length as usize {
                _ = printf("error: bench prompt+decode exceeds context prompt=%u gen=%u runtime_context=%zu model_context=%u\n", bench.prompt_tokens, bench.gen_tokens, runtime.context_capacity, config.context_length);
                qwen3_close_runtime(&table, &tok, &runtime);
                return 1;
            }
        }
        qwen3_close_runtime(&table, &tok, &runtime);
        rep = rep + 1;
    }

    var prompt_ids: &u32 = calloc(bench.prompt_tokens as usize, 4) as &u32;
    if prompt_ids == null {
        _ = printf("error: bench prompt allocation failed tokens=%u\n", bench.prompt_tokens);
        return 1;
    }
    if !qwen3_bench_make_prompt_ids(&seed_ids[0], seed_count, prompt_ids, bench.prompt_tokens as usize) {
        free(prompt_ids as &void);
        _ = printf("error: bench failed to build prompt ids\n");
        return 1;
    }

    rep = 0;
    while rep < bench.repetitions {
        var config: Qwen3Config = qwen3_config_init();
        var table: TensorWeightTable = tensor_table_init();
        var weights: Qwen3Weights = qwen3_weights_init();
        var tok: Tokenizer = tokenizer_init();
        var runtime: Qwen3Runtime = qwen3_runtime_init();
        runtime.device.backend = bench.backend;
        var logits: &f32 = qwen3_alloc_logits();
        if logits == null {
            free(prompt_ids as &void);
            return 1;
        }
        if !qwen3_open_runtime(argv[2] as &const byte, &config, &table, &weights, &tok, &runtime) {
            free(logits as &void);
            free(prompt_ids as &void);
            return 1;
        }
        if bench.backend == BackendKind.Cuda {
            gpu_context_refresh_stats(&runtime.gpu);
            backend_init_micros = backend_init_micros + runtime.gpu.stats.backend_init_us;
            weight_upload_bytes = weight_upload_bytes + runtime.gpu.stats.weight_upload_bytes;
            if runtime.gpu.stats.uploaded_weight_count > uploaded_weight_count { uploaded_weight_count = runtime.gpu.stats.uploaded_weight_count; }
        }
        const prompt_start: u64 = qwen3_bench_clock_micros();
        if !qwen3_append_prompt_ids(&config, &weights, &runtime, prompt_ids as &const u32, bench.prompt_tokens as usize, logits) {
            free(prompt_ids as &void);
            qwen3_close_runtime(&table, &tok, &runtime);
            free(logits as &void);
            return 1;
        }
        prompt_micros = prompt_micros + qwen3_bench_elapsed_micros(prompt_start, qwen3_bench_clock_micros());
        prompt_units = prompt_units + (bench.prompt_tokens as u64);

        const decode_start: u64 = qwen3_bench_clock_micros();
        var rep_first_token_us: u64 = 0;
        if !qwen3_bench_decode_tokens(&config, &weights, &runtime, logits, &seed_ids[0], seed_count, bench.gen_tokens as usize, &rep_first_token_us) {
            free(prompt_ids as &void);
            qwen3_close_runtime(&table, &tok, &runtime);
            free(logits as &void);
            return 1;
        }
        decode_micros = decode_micros + qwen3_bench_elapsed_micros(decode_start, qwen3_bench_clock_micros());
        first_token_micros = first_token_micros + rep_first_token_us;
        decode_units = decode_units + (bench.gen_tokens as u64);
        if bench.backend == BackendKind.Cuda {
            gpu_context_refresh_stats(&runtime.gpu);
            host_to_device_bytes = host_to_device_bytes + runtime.gpu.stats.host_to_device_bytes;
            device_to_host_bytes = device_to_host_bytes + runtime.gpu.stats.device_to_host_bytes;
            weight_upload_bytes = weight_upload_bytes + runtime.gpu.stats.weight_upload_bytes;
            if runtime.gpu.stats.uploaded_weight_count > uploaded_weight_count { uploaded_weight_count = runtime.gpu.stats.uploaded_weight_count; }
            native_quant_matvec_count = native_quant_matvec_count + runtime.gpu.stats.native_quant_matvec_count;
            staged_quant_matvec_count = staged_quant_matvec_count + runtime.gpu.stats.staged_quant_matvec_count;
            q8_1_x_bytes = q8_1_x_bytes + runtime.gpu.stats.q8_1_x_bytes;
            attention_kernel_calls = attention_kernel_calls + runtime.gpu.stats.attention_kernel_calls;
            if runtime.gpu.stats.kv_device_bytes > kv_device_bytes { kv_device_bytes = runtime.gpu.stats.kv_device_bytes; }
            kv_host_to_device_bytes = kv_host_to_device_bytes + runtime.gpu.stats.kv_host_to_device_bytes;
            if runtime.gpu.stats.scratch_x_bytes > scratch_x_bytes_peak { scratch_x_bytes_peak = runtime.gpu.stats.scratch_x_bytes; }
            if runtime.gpu.stats.scratch_y_bytes > scratch_y_bytes_peak { scratch_y_bytes_peak = runtime.gpu.stats.scratch_y_bytes; }
        }
        qwen3_close_runtime(&table, &tok, &runtime);
        free(logits as &void);
        rep = rep + 1;
    }
    free(prompt_ids as &void);

    const runtime_context: usize = qwen3_runtime_context_capacity(&summary_config);
    const kv_layout: LlmKvCacheLayout = llm_kv_cache_layout(summary_config.layer_count, runtime_context as u32, summary_config.kv_head_count, summary_config.head_dim, TensorDType.F32);
    const rope_half_dim: u64 = (summary_config.head_dim as u64) / 2;
    const rope_bytes: u64 = (runtime_context as u64) * rope_half_dim * 8;
    const prompt_bytes: u64 = (runtime_context as u64) * 4;
    const logits_bytes: u64 = (summary_config.vocab_size as u64) * 4;
    const runtime_bytes: u64 = kv_layout.total_bytes + rope_bytes + prompt_bytes + logits_bytes;
    const peak_bytes: u64 = runtime_bytes + summary_file_size;
    var warmup_value: u32 = 0;
    const native_quant_used: bool = native_quant_matvec_count > 0;
    const device_attention_used: bool = attention_kernel_calls > 0;
    var attention_backend_name: &const byte = "cpu\0" as &const byte;
    var kv_cache_name: &const byte = "host\0" as &const byte;
    if bench.warmup { warmup_value = 1; }
    if device_attention_used {
        attention_backend_name = "cuda\0" as &const byte;
        kv_cache_name = "device\0" as &const byte;
    }

    _ = printf("bench config: mode=text-real backend=%s prompt_tokens=%u gen_tokens=%u repetitions=%u warmup=%u threads=%zu\n", qwen3_backend_name(bench.backend), bench.prompt_tokens, bench.gen_tokens, bench.repetitions, warmup_value, qwen3_thread_count);
    _ = printf("bench model: path=%s seed_prompt=%s seed_tokens=%zu vocab=%u context=%u hidden=%u layers=%u kv_heads=%u head_dim=%u\n", argv[2] as &const byte, bench.prompt_seed, seed_count, summary_config.vocab_size, summary_config.context_length, summary_config.hidden_size, summary_config.layer_count, summary_config.kv_head_count, summary_config.head_dim);
    qwen3_bench_print_duration("load\0" as &const byte, load_micros, bench.repetitions);
    qwen3_bench_print_rate("text_prompt\0" as &const byte, prompt_units, prompt_micros, "tokens\0" as &const byte, bench.repetitions);
    qwen3_bench_print_rate("text_decode\0" as &const byte, decode_units, decode_micros, "tokens\0" as &const byte, bench.repetitions);
    qwen3_bench_print_micros("first_token\0" as &const byte, first_token_micros, bench.repetitions);
    _ = printf("bench memory: peak_estimate_bytes=%llu weights_mmap=%llu runtime=%llu kv=%llu rope=%llu prompt_ids=%llu logits=%llu\n", peak_bytes, summary_file_size, runtime_bytes, kv_layout.total_bytes, rope_bytes, prompt_bytes, logits_bytes);
    if bench.backend == BackendKind.Cuda {
        if native_quant_used {
            _ = printf("bench backend: hot_matvec=cuda_mixed_dense_q8_1_vecdot attention=%s kv_cache=%s prefill=tokenwise device_index=0 quant_path=native_q8_1_vecdot device_cache=persistent_prefix_lru_resident weights_uploaded=%llu\n", attention_backend_name, kv_cache_name, uploaded_weight_count);
            _ = printf("bench transfer: backend_init_ms=%llu.%03llu host_to_device_bytes=%llu device_to_host_bytes=%llu weights_device_bytes=%llu scratch_x_bytes=%llu scratch_y_bytes=%llu q8_1_x_bytes=%llu native_quant_calls=%llu staged_quant_calls=%llu kv_device_bytes=%llu kv_host_to_device_bytes=%llu attention_calls=%llu\n", backend_init_micros / (1000 as u64), backend_init_micros % (1000 as u64), host_to_device_bytes, device_to_host_bytes, weight_upload_bytes, scratch_x_bytes_peak, scratch_y_bytes_peak, q8_1_x_bytes, native_quant_matvec_count, staged_quant_matvec_count, kv_device_bytes, kv_host_to_device_bytes, attention_kernel_calls);
            _ = printf("bench optimize: hot_matvec=cuda_mixed_dense_q8_1_vecdot quant=native_q8_1_vecdot attention=%s kv_cache=%s device_cache=persistent_prefix_lru_resident rope=device_slots activations=device_slots sampler=fixed-seed\n", attention_backend_name, kv_cache_name);
        } else {
            _ = printf("bench backend: hot_matvec=cuda_cublas_dense attention=%s kv_cache=%s prefill=tokenwise device_index=0 quant_path=host_f16_staging device_cache=persistent_prefix_lru_resident weights_uploaded=%llu\n", attention_backend_name, kv_cache_name, uploaded_weight_count);
            _ = printf("bench transfer: backend_init_ms=%llu.%03llu host_to_device_bytes=%llu device_to_host_bytes=%llu weights_device_bytes=%llu scratch_x_bytes=%llu scratch_y_bytes=%llu q8_1_x_bytes=%llu native_quant_calls=%llu staged_quant_calls=%llu kv_device_bytes=%llu kv_host_to_device_bytes=%llu attention_calls=%llu\n", backend_init_micros / (1000 as u64), backend_init_micros % (1000 as u64), host_to_device_bytes, device_to_host_bytes, weight_upload_bytes, scratch_x_bytes_peak, scratch_y_bytes_peak, q8_1_x_bytes, native_quant_matvec_count, staged_quant_matvec_count, kv_device_bytes, kv_host_to_device_bytes, attention_kernel_calls);
            _ = printf("bench optimize: hot_matvec=cuda_cublas_dense quant=host_f16_staging attention=%s kv_cache=%s device_cache=persistent_prefix_lru_resident rope=device_slots activations=device_slots sampler=fixed-seed\n", attention_backend_name, kv_cache_name);
        }
    } else {
        _ = printf("bench backend: hot_matvec=k_quant_uya_parallel attention=cpu kv_cache=host prefill=tokenwise device_index=cpu\n");
        _ = printf("bench transfer: backend_init_ms=0.000 host_to_device_bytes=0 device_to_host_bytes=0 weights_device_bytes=0 scratch_x_bytes=0 scratch_y_bytes=0\n");
        _ = printf("bench optimize: hot_matvec=k_quant_uya_parallel attention=cpu kv_cache=host rope=precomputed sampler=fixed-seed\n");
    }
    _ = printf("bench reference_error: n/a mode=real-timing\n");
    _ = printf("bench: PASS\n");
    return 0;
}

fn qwen3_trim_line(line: &byte) void {
    var len: usize = 0;
    while line[len] != 0 {
        len = len + 1;
    }
    while len > 0 && (line[len - 1] == 10 || line[len - 1] == 13) {
        line[len - 1] = 0;
        len = len - 1;
    }
}

fn qwen3_chat_print_help() void {
    _ = printf("Available Commands:\n");
    _ = printf("  /clear          Clear conversation context\n");
    _ = printf("  /bye            Exit\n");
    _ = printf("  /?, /help       Show this help\n");
    _ = printf("\n");
    _ = printf("Use \"\"\" to begin a multi-line message.\n");
}

fn qwen3_chat_read_line(prompt: &const byte, line: &byte) bool {
    return minicpmo_cpu_read_line(prompt, line, QWEN3_CHAT_LINE_CAP) != 0;
}

fn qwen3_chat_reset_runtime(runtime: &Qwen3Runtime, seed: u32) void {
    runtime.prompt_count = 0;
    runtime.total_tokens = 0;
    runtime.last_hidden_valid = false;
    runtime.seed = seed;
    if runtime.prompt_ids != null && runtime.context_capacity > 0 {
        runtime.prompt_ids[0] = 0;
    }
}

fn qwen3_chat_append_cstr(dest: &byte, dest_cap: usize, pos: &usize, src: &const byte) bool {
    var i: usize = 0;
    while src[i] != 0 {
        if *pos + 1 >= dest_cap {
            if dest_cap > 0 { dest[dest_cap - (1 as usize)] = 0; }
            return false;
        }
        dest[*pos] = src[i];
        *pos = *pos + 1;
        dest[*pos] = 0;
        i = i + 1;
    }
    return true;
}

fn qwen3_chat_read_multiline(line: &byte, dest: &byte, dest_cap: usize, out_closed: &bool) bool {
    dest[0] = 0;
    out_closed[0] = false;
    var pos: usize = 0;
    while qwen3_chat_read_line("... \0" as &const byte, line) {
        qwen3_trim_line(line);
        if qwen3_cstr_eq(line as &const byte, "\"\"\"\0" as &const byte) {
            out_closed[0] = true;
            return true;
        }
        if !qwen3_chat_append_cstr(dest, dest_cap, &pos, line as &const byte) {
            return false;
        }
        if !qwen3_chat_append_cstr(dest, dest_cap, &pos, "\n\0" as &const byte) {
            return false;
        }
    }
    return true;
}

export fn qwen3_generate_cli(path: &const byte, prompt: &const byte) i32 {
    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    var logits: &f32 = qwen3_alloc_logits();
    if logits == null { return 1; }
    if !qwen3_prepare_runtime(path, prompt, &config, &table, &weights, &tok, &runtime, logits) { free(logits as &void); return 1; }
    var sampler: Qwen3SamplerConfig = qwen3_sampler_init();
    if tok.eos_id != QWEN3_TOKENIZER_UNKNOWN_ID { sampler.stop_token = tok.eos_id; }
    _ = printf("generate prompt_tokens:");
    var i: usize = 0;
    while i < runtime.prompt_count { _ = printf(" %u", runtime.prompt_ids[i]); i = i + 1; }
    _ = printf("\n");
    if sampler.dump_hidden && runtime.last_hidden_valid && runtime.total_tokens > 0 {
        qwen3_print_hidden_summary("prompt hidden\0" as &const byte, runtime.total_tokens - (1 as usize), runtime.prompt_ids[runtime.total_tokens - (1 as usize)], runtime.last_hidden as &const f32, runtime.last_hidden_len);
    }
    const rc: i32 = qwen3_generate_tokens(&config, &weights, &runtime, &sampler, &tok, logits, "generated text\0" as &const byte, false);
    if rc == 0 {
        _ = printf("logits[0..4]: %.6f %.6f %.6f %.6f %.6f\n", logits[0] as f64, logits[1] as f64, logits[2] as f64, logits[3] as f64, logits[4] as f64);
    }
    tensor_weight_table_detach_mmap(&table);
    free(logits as &void);
    return rc;
}

export fn qwen3_generate_args_cli(argc: i32, argv: & &byte) i32 {
    if argc < 4 { _ = printf("usage: minicpm-o-uya generate <model.gguf> <prompt> [--max-new-tokens N] [--temperature T] [--top-k K] [--top-p P] [--min-p P] [--repeat-penalty R] [--seed S] [--stop-token ID] [--threads N] [--verbose] [--dump-hidden] [--backend cpu|cuda]\n"); return 1; }
    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    var logits: &f32 = qwen3_alloc_logits();
    if logits == null { return 1; }
    var sampler: Qwen3SamplerConfig = qwen3_sampler_init();
    if !qwen3_parse_sampler_args(argc, argv, 4, &sampler) { _ = printf("error: invalid generate sampler args\n"); free(logits as &void); return 1; }
    qwen3_set_thread_count(sampler.threads);
    runtime.device.backend = sampler.backend;
    if !qwen3_open_runtime(argv[2] as &const byte, &config, &table, &weights, &tok, &runtime) { return 1; }
    if sampler.stop_on_eos && tok.eos_id != QWEN3_TOKENIZER_UNKNOWN_ID { sampler.stop_token = tok.eos_id; }
    runtime.seed = sampler.seed;
    if !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, argv[3] as &const byte, logits) {
        qwen3_runtime_free(&runtime);
        tensor_weight_table_detach_mmap(&table);
        free(logits as &void);
        return 1;
    }
    _ = printf("generate prompt_tokens:");
    var i: usize = 0;
    while i < runtime.prompt_count { _ = printf(" %u", runtime.prompt_ids[i]); i = i + 1; }
    _ = printf("\n");
    if sampler.dump_hidden && runtime.last_hidden_valid && runtime.total_tokens > 0 {
        qwen3_print_hidden_summary("prompt hidden\0" as &const byte, runtime.total_tokens - (1 as usize), runtime.prompt_ids[runtime.total_tokens - (1 as usize)], runtime.last_hidden as &const f32, runtime.last_hidden_len);
    }
    const rc: i32 = qwen3_generate_tokens(&config, &weights, &runtime, &sampler, &tok, logits, "generated text\0" as &const byte, false);
    tensor_weight_table_detach_mmap(&table);
    free(logits as &void);
    return rc;
}

export fn qwen3_chat_cli(argc: i32, argv: & &byte) i32 {
    if argc < 3 { _ = printf("usage: minicpm-o-uya chat <model.gguf> [--max-new-tokens N] [--temperature T] [--top-k K] [--top-p P] [--min-p P] [--repeat-penalty R] [--seed S] [--stop-token ID] [--threads N] [--verbose] [--dump-hidden] [--backend cpu|cuda]\n"); return 1; }
    var config: Qwen3Config = qwen3_config_init();
    var table: TensorWeightTable = tensor_table_init();
    var weights: Qwen3Weights = qwen3_weights_init();
    var tok: Tokenizer = tokenizer_init();
    var runtime: Qwen3Runtime = qwen3_runtime_init();
    var sampler: Qwen3SamplerConfig = qwen3_sampler_init();
    if !qwen3_parse_sampler_args(argc, argv, 3, &sampler) { _ = printf("error: invalid chat sampler args\n"); return 1; }
    qwen3_set_thread_count(sampler.threads);
    runtime.device.backend = sampler.backend;
    if !qwen3_open_runtime(argv[2] as &const byte, &config, &table, &weights, &tok, &runtime) { return 1; }
    if !tokenizer_chat_template_supported(&tok) {
        _ = printf("error: unsupported chat template: %s\n", &tok.chat_template[0]);
        tensor_weight_table_detach_mmap(&table);
        return 1;
    }
    const chat_stop_token: u32 = tokenizer_chat_stop_token(&tok);
    if chat_stop_token != QWEN3_TOKENIZER_UNKNOWN_ID { sampler.stop_token = chat_stop_token; }
    runtime.seed = sampler.seed;
    var logits: &f32 = qwen3_alloc_logits();
    if logits == null { tensor_weight_table_detach_mmap(&table); return 1; }
    var line: [byte: QWEN3_CHAT_LINE_CAP] = [];
    var message: [byte: QWEN3_CHAT_MESSAGE_CAP] = [];
    var turn_prompt: [byte: QWEN3_CHAT_TURN_CAP] = [];
    var close_previous_assistant: bool = false;
    while qwen3_chat_read_line(">>> \0" as &const byte, &line[0]) {
        qwen3_trim_line(&line[0]);
        if line[0] == 0 {
            continue;
        }
        if qwen3_cstr_eq(&line[0] as &const byte, "/bye\0" as &const byte) || qwen3_cstr_eq(&line[0] as &const byte, "/exit\0" as &const byte) || qwen3_cstr_eq(&line[0] as &const byte, "/quit\0" as &const byte) {
            break;
        }
        if qwen3_cstr_eq(&line[0] as &const byte, "/?\0" as &const byte) || qwen3_cstr_eq(&line[0] as &const byte, "/help\0" as &const byte) {
            qwen3_chat_print_help();
            continue;
        }
        if qwen3_cstr_eq(&line[0] as &const byte, "/clear\0" as &const byte) {
            qwen3_chat_reset_runtime(&runtime, sampler.seed);
            close_previous_assistant = false;
            _ = printf("cleared\n");
            continue;
        }
        var user_text: &const byte = &line[0] as &const byte;
        if qwen3_cstr_eq(&line[0] as &const byte, "\"\"\"\0" as &const byte) {
            var multiline_closed: bool = false;
            if !qwen3_chat_read_multiline(&line[0], &message[0], QWEN3_CHAT_MESSAGE_CAP, &multiline_closed) {
                _ = printf("error: multiline chat message exceeds buffer cap=%zu\n", QWEN3_CHAT_MESSAGE_CAP);
                tensor_weight_table_detach_mmap(&table);
                free(logits as &void);
                return 1;
            }
            if !multiline_closed {
                break;
            }
            if message[0] == 0 {
                continue;
            }
            user_text = &message[0] as &const byte;
        } else if line[0] == 47 {
            _ = printf("Unknown command: %s\n", &line[0] as &const byte);
            _ = printf("Type /? for help\n");
            continue;
        }
        if !tokenizer_format_chat_prompt(&tok, user_text, close_previous_assistant, &turn_prompt[0], QWEN3_CHAT_TURN_CAP) {
            _ = printf("error: formatted chat prompt exceeds buffer cap=%zu\n", QWEN3_CHAT_TURN_CAP);
            tensor_weight_table_detach_mmap(&table);
            free(logits as &void);
            return 1;
        }
        if !qwen3_append_prompt_text(&config, &weights, &tok, &runtime, &turn_prompt[0] as &const byte, logits) {
            tensor_weight_table_detach_mmap(&table);
            free(logits as &void);
            return 1;
        }
        if qwen3_generate_tokens(&config, &weights, &runtime, &sampler, &tok, logits, "\0" as &const byte, true) != 0 { tensor_weight_table_detach_mmap(&table); free(logits as &void); return 1; }
        close_previous_assistant = true;
    }
    tensor_weight_table_detach_mmap(&table);
    free(logits as &void);
    return 0;
}

        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "attn.q_norm.weight\0" as &const byte, "flow_matching q_norm\0" as &const byte), 64, "flow_matching q_norm\0" as &const byte) { ok = false; break; }
        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "attn.q_norm.bias\0" as &const byte, "flow_matching q_norm bias\0" as &const byte), 64, "flow_matching q_norm bias\0" as &const byte) { ok = false; break; }
        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "attn.k_norm.weight\0" as &const byte, "flow_matching k_norm\0" as &const byte), 64, "flow_matching k_norm\0" as &const byte) { ok = false; break; }
        if !t2w_check_vec(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "attn.k_norm.bias\0" as &const byte, "flow_matching k_norm bias\0" as &const byte), 64, "flow_matching k_norm bias\0" as &const byte) { ok = false; break; }
        if !t2w_check_matrix(t2w_require_layer(&table, "estimator.blocks.\0" as &const byte, i, "attn.to_q.weight\0" as &const byte, "flow_matching q\0" as &const byte), 512, 512, "flow_matching q\0" as &const byte) { ok = false; break; }
